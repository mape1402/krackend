<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Krackend.EventSourcing</PackageId>
    <Description>Krackend.EventSourcing provides configurable event store primitives, envelopes, routing, and state rehydration support for .NET applications.</Description>
    <PackageTags>event-sourcing;event-store;domain-events;dotnet</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <UseRootPackageReadme>false</UseRootPackageReadme>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\event-sourcing.md" Pack="true" PackagePath="README.md" Link="README.md" />
    <None Include="..\..\assets\image.png" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Krackend.EventSourcing.Abstractions\Krackend.EventSourcing.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
