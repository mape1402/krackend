@page
@model Krackend.Sagas.Orchestrations.Design.WebUI.Areas.OrchestratorDesign.Pages.Domains.IndexModel
@{
    ViewData["Title"] = "Domains";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Domains</h1>
        <p class="od-page-subtitle">Catalog used by orchestration definitions.</p>
    </div>
    <button type="button" class="btn btn-primary js-open-domain-modal" data-mode="create">Create domain</button>
</div>

@if (!Model.Rows.Any())
{
    <section class="od-panel">
        <p class="od-empty">No domains found.</p>
    </section>
}
else
{
    <section class="od-list-shell">
        <div class="od-grid">
            @foreach (var item in Model.Rows.OrderBy(x => x.DisplayName, StringComparer.OrdinalIgnoreCase))
            {
                var statusClass = item.IsActive ? "od-status od-status-active" : "od-status od-status-inactive";
                <article class="od-item-card">
                    <div class="od-item-top">
                        <div>
                            <h2 class="od-item-title">@item.DisplayName</h2>
                            <p class="od-item-meta">@item.Key</p>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            <span class="@statusClass">@(item.IsActive ? "Active" : "Inactive")</span>
                            <div class="dropdown">
                                <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">&#8942;</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <button type="button"
                                                class="dropdown-item js-open-domain-modal"
                                                data-mode="edit"
                                                data-id="@item.Id"
                                                data-key="@item.Key"
                                                data-display-name="@item.DisplayName"
                                                data-description="@item.Description">
                                            Edit
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" asp-page-handler="SetIsActive" class="od-inline-form">
                                            <input type="hidden" name="domainId" value="@item.Id" />
                                            <input type="hidden" name="isActive" value="@(item.IsActive ? "false" : "true")" />
                                            <button type="submit" class="dropdown-item">@(item.IsActive ? "Disable domain" : "Enable domain")</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <p class="od-item-description">@(string.IsNullOrWhiteSpace(item.Description) ? "No description." : item.Description)</p>
                </article>
            }
        </div>
    </section>
}

<div class="modal fade" id="domainModal" tabindex="-1" aria-labelledby="domainModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Upsert">
                <div class="modal-header">
                    <h5 class="modal-title" id="domainModalLabel">Create domain</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input asp-for="Input.DomainId" type="hidden" id="domainIdInput" />
                    <div class="mb-2">
                        <label asp-for="Input.Key" class="form-label"></label>
                        <input asp-for="Input.Key" class="form-control" id="domainKeyInput" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.DisplayName" class="form-label"></label>
                        <input asp-for="Input.DisplayName" class="form-control" id="domainDisplayNameInput" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.Description" class="form-label"></label>
                        <textarea asp-for="Input.Description" class="form-control" rows="3" id="domainDescriptionInput"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="domainModalSubmitButton">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const modalElement = document.getElementById('domainModal');
    const title = document.getElementById('domainModalLabel');
    const submitButton = document.getElementById('domainModalSubmitButton');
    const modal = window.bootstrap?.Modal?.getOrCreateInstance(modalElement);
    if (!modalElement || !title || !submitButton || !modal) return;

    const idInput = document.getElementById('domainIdInput');
    const keyInput = document.getElementById('domainKeyInput');
    const displayNameInput = document.getElementById('domainDisplayNameInput');
    const descriptionInput = document.getElementById('domainDescriptionInput');

    const setValue = (el, value) => { if (el) el.value = value ?? ''; };

    document.querySelectorAll('.js-open-domain-modal').forEach(button => {
        button.addEventListener('click', () => {
            const mode = button.getAttribute('data-mode');
            if (mode === 'edit') {
                title.textContent = 'Edit domain';
                submitButton.textContent = 'Save';
                setValue(idInput, button.getAttribute('data-id'));
                setValue(keyInput, button.getAttribute('data-key'));
                setValue(displayNameInput, button.getAttribute('data-display-name'));
                setValue(descriptionInput, button.getAttribute('data-description'));
                keyInput.readOnly = true;
                modal.show();
                return;
            }

            title.textContent = 'Create domain';
            submitButton.textContent = 'Create';
            setValue(idInput, '');
            setValue(keyInput, '');
            setValue(displayNameInput, '');
            setValue(descriptionInput, '');
            keyInput.readOnly = false;
            modal.show();
        });
    });
})();
</script>
}
