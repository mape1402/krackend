        CompensationRetryableErrorCodes: 'compensationRetryErrorCodesHidden',
        TimeoutReconcileRetryableErrorCodes: 'timeoutReconcileRetryableErrorCodesHidden',
        CompensationTimeoutReconcileRetryableErrorCodes: 'compensationTimeoutReconcileRetryableErrorCodesHidden',
    };

    function setInputValue(propertyName, value) {
        const elementId = fieldIdOverrides[propertyName] ?? `NewTask_${propertyName}`;
        const element = document.getElementById(elementId);
        if (!element) {
            return;
        }

        const type = (element.getAttribute('type') || '').toLowerCase();
        if (type === 'checkbox') {
            element.checked = value === true || value === 'true' || value === 1;
            element.dispatchEvent(new Event('change', { bubbles: true }));
            return;
        }

        element.value = value ?? '';
        element.dispatchEvent(new Event('change', { bubbles: true }));
    }

    function applyPayload(payload) {
        Object.keys(defaultValues).forEach(key => setInputValue(key, defaultValues[key]));
        Object.keys(payload || {}).forEach(key => setInputValue(key, payload[key]));

        if (taskIdInput) {
            taskIdInput.value = payload?.TaskId || '';
        }

        if (taskIdRawInput) {
            taskIdRawInput.value = payload?.TaskId || '';
        }

        document.querySelectorAll('.od-chip-editor[data-chip-editor-for]').forEach(editor => {
            const targetId = editor.getAttribute('data-chip-editor-for');
            const hidden = targetId ? document.getElementById(targetId) : null;
            if (hidden) {
                hidden.dispatchEvent(new Event('change', { bubbles: true }));
            }
        });
    }

    function openModal() {
        if (!modalElement || !window.bootstrap || !window.bootstrap.Modal) {
            return;
        }

        window.bootstrap.Modal.getOrCreateInstance(modalElement).show();
    }

    document.querySelectorAll('.js-open-task-modal').forEach(button => {
        button.addEventListener('click', async () => {
            if (!modalTitle || !submitButton || !taskIdInput || !taskIdRawInput) {
                return;
            }

            const mode = button.getAttribute('data-task-mode') || 'create';
            if (mode === 'edit') {
                const taskId = button.getAttribute('data-task-id') || '';
                if (!taskId) {
                    return;
                }

                const response = await fetch(`${window.location.pathname}?handler=TaskForEdit&taskId=${encodeURIComponent(taskId)}`);
                if (!response.ok) {
                    return;
                }

                const payload = await response.json();
                modalTitle.textContent = 'Edit task';
                submitButton.textContent = 'Save';
                applyPayload(payload);
                openModal();
                return;
            }

            modalTitle.textContent = 'Create task';
            submitButton.textContent = 'Create';
            applyPayload({});
        });
    });

    if (serverEditPayload && modalTitle && submitButton) {
        modalTitle.textContent = 'Edit task';
        submitButton.textContent = 'Save';
        applyPayload(serverEditPayload);

        openModal();
    }
})();

(() => {
    const kindSelector = document.getElementById('taskKindSelector');
    const onErrorPolicySelector = document.getElementById('NewTask_OnErrorPolicy');
    const generalTabButton = document.getElementById('task-general-tab');
    const compensationTabButton = document.getElementById('task-compensation-tab');
    const compensationTabItem = compensationTabButton ? compensationTabButton.closest('.nav-item') : null;
    const compensationTabPane = document.getElementById('task-compensation-pane');
    const compensationKindSelector = document.getElementById('compensationKindSelector');
    const taskDispatchTypeSelector = document.getElementById('taskDispatchTypeSelector');
    const compensationDispatchTypeSelector = document.getElementById('compensationDispatchTypeSelector');
    const timeoutSelector = document.getElementById('timeoutBehaviorSelector');
    const retrySelector = document.getElementById('retryStrategySelector');
    const compensationRetrySelector = document.getElementById('compensationRetryStrategySelector');
    const timeoutReconcileRetrySelector = document.getElementById('timeoutReconcileRetryStrategySelector');
    const compensationTimeoutReconcileRetrySelector = document.getElementById('compensationTimeoutReconcileRetryStrategySelector');
    const conditionEngineSelector = document.getElementById('conditionEngineSelector');
    const transformationEngineSelector = document.getElementById('transformationEngineSelector');
    const compensationTimeoutSelector = document.getElementById('compensationTimeoutBehaviorSelector');
    const engineFallbackWarning = document.getElementById('engineFallbackWarning');
    const retryFallbackWarning = document.getElementById('retryFallbackWarning');
    const hasRetryPolicy = document.getElementById('hasRetryPolicy');
    const hasTimeoutPolicy = document.getElementById('hasTimeoutPolicy');
    const hasExecutionCondition = document.getElementById('hasExecutionCondition');
    const hasTransformation = document.getElementById('hasTransformation');
    const hasCompensation = document.getElementById('hasCompensation');
    const hasCompensationExecutionCondition = document.getElementById('hasCompensationExecutionCondition');
    const hasCompensationTransformation = document.getElementById('hasCompensationTransformation');
    const hasCompensationRetryPolicy = document.getElementById('hasCompensationRetryPolicy');
    const hasCompensationTimeoutPolicy = document.getElementById('hasCompensationTimeoutPolicy');
    const retryPolicySection = document.getElementById('retryPolicySection');
    const timeoutPolicySection = document.getElementById('timeoutPolicySection');
    const executionConditionSection = document.getElementById('executionConditionSection');
    const transformationSection = document.getElementById('transformationSection');
    const compensationSection = document.getElementById('compensationSection');
    const compensationExecutionConditionSection = document.getElementById('compensationExecutionConditionSection');
    const compensationTransformationSection = document.getElementById('compensationTransformationSection');
    const compensationRetrySection = document.getElementById('compensationRetrySection');
    const compensationTimeoutSection = document.getElementById('compensationTimeoutSection');
    const chipEditors = document.querySelectorAll('.od-chip-editor[data-chip-editor-for]');

    if (!kindSelector) {
        return;
    }

    function toggleBySelector(selector, blockSelector, attributeName) {
        if (!selector) {
            return;
        }

        const selected = selector.value;
        document.querySelectorAll(blockSelector).forEach(element => {
            element.classList.toggle('d-none', element.getAttribute(attributeName) !== selected);
        });
    }

    function refreshKind() {
        toggleBySelector(kindSelector, '.task-config-block', 'data-kind');
    }

    function refreshCompensationKind() {
        if (!compensationKindSelector) {
            return;
        }

        toggleBySelector(compensationKindSelector, '.comp-task-config-block', 'data-comp-kind');
    }

    function allowedDispatchTypesByKind(kind) {
        switch (kind) {
            case 'HumanApproval':
                return ['FireAndWaitCallback'];
            case 'Messaging':
                return ['FireAndForget', 'FireAndWaitCallback'];
            case 'Http':
            case 'Plugin':
                return ['FireAndWait', 'FireAndForget', 'FireAndWaitCallback'];
            default:
                return ['FireAndWait', 'FireAndForget', 'FireAndWaitCallback'];
        }
    }

    function refreshDispatchOptions(kindSelect, dispatchSelect) {
        if (!kindSelect || !dispatchSelect) {
            return;
        }

        const allowed = allowedDispatchTypesByKind(kindSelect.value);
        let firstAllowed = '';
        Array.from(dispatchSelect.options).forEach(option => {
            const isAllowed = allowed.includes(option.value);
            option.hidden = !isAllowed;
            option.disabled = !isAllowed;
            if (isAllowed && firstAllowed.length === 0) {
                firstAllowed = option.value;
            }
        });

        if (!allowed.includes(dispatchSelect.value) && firstAllowed.length > 0) {
            dispatchSelect.value = firstAllowed;
        }
    }

    function refreshTimeout() {
        toggleBySelector(timeoutSelector, '.timeout-behavior-block', 'data-timeout');
        refreshTimeoutReconcileRetryFields();
    }

    function refreshRetryFields() {
        toggleBySelector(retrySelector, '.retry-strategy-block', 'data-retry');
    }

    function refreshCompensationRetryFields() {
        if (!compensationRetrySelector) {
            return;
        }

        toggleBySelector(compensationRetrySelector, '.compensation-retry-strategy-block', 'data-comp-retry');
    }

    function refreshCompensationTimeout() {
        if (!compensationTimeoutSelector) {
            return;
        }

        toggleBySelector(compensationTimeoutSelector, '.compensation-timeout-behavior-block', 'data-comp-timeout');
        refreshCompensationTimeoutReconcileRetryFields();
    }

    function refreshTimeoutReconcileRetryFields() {
        if (!timeoutReconcileRetrySelector) {
            return;
        }

        toggleBySelector(timeoutReconcileRetrySelector, '.timeout-reconcile-strategy-block', 'data-timeout-reconcile-retry');
    }

    function refreshCompensationTimeoutReconcileRetryFields() {
        if (!compensationTimeoutReconcileRetrySelector) {
            return;
        }

        toggleBySelector(compensationTimeoutReconcileRetrySelector, '.compensation-timeout-reconcile-strategy-block', 'data-comp-timeout-reconcile-retry');
    }

    function toggleSection(checkbox, section) {
        if (!checkbox || !section) {
            return;
        }

        section.classList.toggle('d-none', !checkbox.checked);
    }

    function refreshOptionalPolicies() {
        const compensationEnabled = hasCompensation && hasCompensation.checked;

        toggleSection(hasRetryPolicy, retryPolicySection);
        toggleSection(hasTimeoutPolicy, timeoutPolicySection);
        toggleSection(hasExecutionCondition, executionConditionSection);
        toggleSection(hasTransformation, transformationSection);
        toggleSection(hasCompensation, compensationSection);
        toggleSection(hasCompensationExecutionCondition, compensationExecutionConditionSection);
        toggleSection(hasCompensationTransformation, compensationTransformationSection);
        toggleSection(hasCompensationRetryPolicy, compensationRetrySection);
        toggleSection(hasCompensationTimeoutPolicy, compensationTimeoutSection);
    }

    function refreshWarnings() {
        if (retryFallbackWarning && hasRetryPolicy) {
            if (!hasRetryPolicy.checked) {
                retryFallbackWarning.classList.add('d-none');
            } else {
            retryFallbackWarning.classList.toggle('d-none', retrySelector.value === 'Fixed');
            }
        }

        if (engineFallbackWarning && (hasExecutionCondition || hasTransformation)) {
            if ((hasExecutionCondition && !hasExecutionCondition.checked) && (hasTransformation && !hasTransformation.checked)) {
                engineFallbackWarning.classList.add('d-none');
            } else {
            const unsupportedEngine = conditionEngineSelector.value !== 'DSL' || transformationEngineSelector.value !== 'DSL';
            engineFallbackWarning.classList.toggle('d-none', !unsupportedEngine);
            }
        }
    }

    function initializeChipEditors() {
        chipEditors.forEach(editor => {
            const targetId = editor.getAttribute('data-chip-editor-for');
            const hiddenInput = document.getElementById(targetId);
            const list = editor.querySelector('.od-chip-list');
            const input = editor.querySelector('.od-chip-input');
            if (!hiddenInput || !list || !input) {
                return;
            }

            const values = new Set(
                (hiddenInput.value || '')
                    .split(',')
                    .map(x => x.trim())
                    .filter(x => x.length > 0));

            function loadFromHidden() {
                values.clear();
                (hiddenInput.value || '')
                    .split(',')
                    .map(x => x.trim())
                    .filter(x => x.length > 0)
                    .forEach(x => values.add(x));
            }

            function syncHidden() {
                hiddenInput.value = Array.from(values).join(',');
            }

            function render() {
                list.innerHTML = '';

                values.forEach(value => {
                    const chip = document.createElement('span');
                    chip.className = 'od-input-chip';

                    const label = document.createElement('span');
                    label.textContent = value;
                    chip.appendChild(label);

                    const remove = document.createElement('button');
                    remove.type = 'button';
                    remove.className = 'od-chip-remove';
                    remove.setAttribute('aria-label', `Remove ${value}`);
                    remove.textContent = '×';
                    remove.addEventListener('click', () => {
                        values.delete(value);
                        syncHidden();
                        render();
                    });

                    chip.appendChild(remove);
                    list.appendChild(chip);
                });
            }

            function addFromInput() {
                const raw = input.value || '';
                const pieces = raw.split(',').map(x => x.trim()).filter(x => x.length > 0);
                if (pieces.length === 0) {
                    input.value = '';
                    return;
                }

                pieces.forEach(piece => values.add(piece));
                input.value = '';
                syncHidden();
                render();
            }

            input.addEventListener('keydown', event => {
                if (event.key === 'Enter' || event.key === ',') {
                    event.preventDefault();
                    addFromInput();
                }
            });

            input.addEventListener('blur', addFromInput);
            hiddenInput.addEventListener('change', () => {
                loadFromHidden();
                render();
            });
            loadFromHidden();
            syncHidden();
            render();
        });
    }

    refreshKind();
    refreshCompensationKind();
    refreshDispatchOptions(kindSelector, taskDispatchTypeSelector);
    refreshDispatchOptions(compensationKindSelector, compensationDispatchTypeSelector);
    refreshTimeout();
    refreshRetryFields();
    refreshCompensationRetryFields();
    refreshCompensationTimeout();
    refreshTimeoutReconcileRetryFields();
    refreshCompensationTimeoutReconcileRetryFields();
    refreshOptionalPolicies();
    refreshWarnings();
    initializeChipEditors();

    kindSelector.addEventListener('change', () => {
        refreshKind();
        refreshDispatchOptions(kindSelector, taskDispatchTypeSelector);
    });
    if (compensationKindSelector) {
        compensationKindSelector.addEventListener('change', () => {
            refreshCompensationKind();
            refreshDispatchOptions(compensationKindSelector, compensationDispatchTypeSelector);
        });
    }
    timeoutSelector.addEventListener('change', refreshTimeout);
    retrySelector.addEventListener('change', () => { refreshRetryFields(); refreshWarnings(); });
    if (compensationRetrySelector) {
        compensationRetrySelector.addEventListener('change', refreshCompensationRetryFields);
    }
    if (compensationTimeoutSelector) {
        compensationTimeoutSelector.addEventListener('change', refreshCompensationTimeout);
    }
    if (timeoutReconcileRetrySelector) {
        timeoutReconcileRetrySelector.addEventListener('change', refreshTimeoutReconcileRetryFields);
    }
    if (compensationTimeoutReconcileRetrySelector) {
        compensationTimeoutReconcileRetrySelector.addEventListener('change', refreshCompensationTimeoutReconcileRetryFields);
    }
    conditionEngineSelector.addEventListener('change', refreshWarnings);
    transformationEngineSelector.addEventListener('change', refreshWarnings);
    hasRetryPolicy.addEventListener('change', () => { refreshOptionalPolicies(); refreshWarnings(); });
    hasTimeoutPolicy.addEventListener('change', refreshOptionalPolicies);
    hasExecutionCondition.addEventListener('change', () => { refreshOptionalPolicies(); refreshWarnings(); });
    hasTransformation.addEventListener('change', () => { refreshOptionalPolicies(); refreshWarnings(); });
    if (onErrorPolicySelector) {
        onErrorPolicySelector.addEventListener('change', refreshOptionalPolicies);
    }
    if (hasCompensation) {
        hasCompensation.addEventListener('change', refreshOptionalPolicies);
    }
    if (hasCompensationExecutionCondition) {
        hasCompensationExecutionCondition.addEventListener('change', refreshOptionalPolicies);
    }
    if (hasCompensationTransformation) {
        hasCompensationTransformation.addEventListener('change', refreshOptionalPolicies);
    }
    if (hasCompensationRetryPolicy) {
        hasCompensationRetryPolicy.addEventListener('change', refreshOptionalPolicies);
    }
    if (hasCompensationTimeoutPolicy) {
        hasCompensationTimeoutPolicy.addEventListener('change', refreshOptionalPolicies);
    }
})();
</script>
}
