@page
@model Krackend.Sagas.Orchestrations.Design.WebUI.Areas.OrchestratorDesign.Pages.OrchestrationStages.DetailsModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@using Krackend.Sagas.Orchestrations.Design.Core
@using Krackend.Sagas.Orchestrations.Design.Core.ConditionConfigurations
@using Krackend.Sagas.Orchestrations.Design.Core.RetryStrategies
@using Krackend.Sagas.Orchestrations.Design.Core.TimeoutBehaviorPolicies
@using Krackend.Sagas.Orchestrations.Abstractions.Primitives
@{
    ViewData["Title"] = "Stage tasks";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">@Model.Stage?.Name</h1>
        <p class="od-page-subtitle">@Model.Stage?.Key | Stage tasks</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="OrchestratorDesign" asp-page="/OrchestrationVersions/Details" asp-route-orchestrationId="@Model.OrchestrationId" asp-route-versionId="@Model.VersionId" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<section class="od-list-shell">
    <div class="od-panel-head">
        <h2 class="od-panel-title">Tasks</h2>
        <span class="od-item-meta">Drag cards to reorder</span>
    </div>

    @if (!Model.Tasks.Any())
    {
        <p class="od-empty">No tasks yet.</p>
    }

    @{
        var orderedTasks = Model.Tasks.OrderBy(t => t.Order).ToList();
        var renderedGroups = new HashSet<string>(StringComparer.Ordinal);
    }
    <div id="taskPipeline" class="od-pipeline">
        @foreach (var task in orderedTasks)
        {
            var grouped = task.ExecutionMode == TaskExecutionMode.Parallel && !string.IsNullOrWhiteSpace(task.ParallelGroupId);
            if (grouped)
            {
                var groupId = task.ParallelGroupId!;
                if (!renderedGroups.Add(groupId))
                {
                    continue;
                }

                var groupTasks = orderedTasks
                    .Where(x => x.ExecutionMode == TaskExecutionMode.Parallel && string.Equals(x.ParallelGroupId, groupId, StringComparison.Ordinal))
                    .ToList();
                var groupName = Model.ParallelGroups
                    .FirstOrDefault(x => string.Equals(x.Id, groupId, StringComparison.Ordinal))?.Name;
                groupName = string.IsNullOrWhiteSpace(groupName) ? "Parallel group" : groupName;

                <article class="od-parallel-group" data-group-id="@groupId" draggable="true">
                    <div class="od-parallel-group-head">
                        <div>
                            <h3 class="od-item-title">@groupName</h3>
                        </div>
                        <div class="dropdown">
                            <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Parallel group actions">&#8942;</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <button type="button" class="dropdown-item js-edit-group">Edit group</button>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <button type="button" class="dropdown-item text-danger js-remove-group">Remove group</button>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="od-group-task-list" data-group-id="@groupId">
                        @foreach (var groupedTask in groupTasks)
                        {
                            var groupedTaskHasExecutionCondition = groupedTask.HasExecutionCondition;
                            var groupedTaskHasTransformation = groupedTask.HasTransformation;

                            <article class="od-pipeline-item" data-task-id="@groupedTask.Id" draggable="true">
                                <div class="od-pipeline-card od-task-card @(groupedTask.IsEnabled ? string.Empty : "od-task-disabled")">
                                    <button type="button"
                                            class="od-task-side-btn od-task-exec-btn js-task-execution-btn @(groupedTaskHasExecutionCondition ? "od-task-exec-btn-active" : "od-task-exec-btn-inactive")"
                                            title="Execution condition"
                                            aria-label="Execution condition"
                                            data-task-id="@groupedTask.Id">
                                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                            <path d="M8.5 1.5a.5.5 0 0 0-.9-.3l-4 6a.5.5 0 0 0 .4.8H7l-1 6a.5.5 0 0 0 .9.3l4-6a.5.5 0 0 0-.4-.8H7.5l1-6z" />
                                        </svg>
                                    </button>
                                    <button type="button"
                                            class="od-task-side-btn od-task-transform-btn js-task-transformation-btn @(groupedTaskHasTransformation ? "od-task-transform-btn-active" : "od-task-transform-btn-inactive")"
                                            title="Transformation"
                                            aria-label="Transformation"
                                            data-task-id="@groupedTask.Id">
                                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                            <path d="M1 3a.5.5 0 0 1 .5-.5h11.793L11.146.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 1 1-.708-.708L13.293 3.5H1.5A.5.5 0 0 1 1 3Zm14 10a.5.5 0 0 1-.5.5H2.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L2.707 12.5H14.5a.5.5 0 0 1 .5.5Z" />
                                        </svg>
                                    </button>
                                    <div class="od-item-top">
                                        <div>
                                            <h3 class="od-item-title">@groupedTask.Key</h3>
                                            <p class="od-item-meta">@groupedTask.Name</p>
                                            <p class="od-item-meta">@groupedTask.Kind</p>
                                        </div>
                                        <div class="dropdown">
                                            <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Task actions">&#8942;</button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <button type="button"
                                                            class="dropdown-item js-open-task-modal"
                                                            data-task-mode="edit"
                                                            data-task-id="@groupedTask.Id">
                                                        Edit task
                                                    </button>
                                                </li>
                                                <li><hr class="dropdown-divider" /></li>
                                                <li>
                                                    <form method="post" asp-page-handler="DeleteTask" class="od-inline-form">
                                                        <input type="hidden" name="orchestrationId" value="@Model.OrchestrationId" />
                                                        <input type="hidden" name="versionId" value="@Model.VersionId" />
                                                        <input type="hidden" name="stageId" value="@Model.StageId" />
                                                        <input type="hidden" name="taskId" value="@groupedTask.Id" />
                                                        <button type="submit" class="dropdown-item text-danger">Delete task</button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="od-task-toggle-row">
                                        <span class="od-task-toggle-label">Enabled</span>
                                        <div class="form-check form-switch od-task-toggle">
                                            <input class="form-check-input js-task-enabled-toggle" type="checkbox" role="switch" data-task-id="@groupedTask.Id" @(groupedTask.IsEnabled ? "checked" : null) aria-label="Toggle task enabled" />
                                        </div>
                                    </div>
                                </div>
                            </article>
                        }
                        <p class="od-group-empty @(groupTasks.Count > 0 ? "d-none" : string.Empty)">Drop tasks here</p>
                    </div>
                </article>
                continue;
            }

            var taskHasExecutionCondition = task.HasExecutionCondition;
            var taskHasTransformation = task.HasTransformation;

            <article class="od-pipeline-item" data-task-id="@task.Id" draggable="true">
                <div class="od-pipeline-card od-task-card @(task.IsEnabled ? string.Empty : "od-task-disabled")">
                    <button type="button"
                            class="od-task-side-btn od-task-exec-btn js-task-execution-btn @(taskHasExecutionCondition ? "od-task-exec-btn-active" : "od-task-exec-btn-inactive")"
                            title="Execution condition"
                            aria-label="Execution condition"
                            data-task-id="@task.Id">
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                            <path d="M8.5 1.5a.5.5 0 0 0-.9-.3l-4 6a.5.5 0 0 0 .4.8H7l-1 6a.5.5 0 0 0 .9.3l4-6a.5.5 0 0 0-.4-.8H7.5l1-6z" />
                        </svg>
                    </button>
                    <button type="button"
                            class="od-task-side-btn od-task-transform-btn js-task-transformation-btn @(taskHasTransformation ? "od-task-transform-btn-active" : "od-task-transform-btn-inactive")"
                            title="Transformation"
                            aria-label="Transformation"
                            data-task-id="@task.Id">
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                            <path d="M1 3a.5.5 0 0 1 .5-.5h11.793L11.146.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L13.293 3.5H1.5A.5.5 0 0 1 1 3Zm14 10a.5.5 0 0 1-.5.5H2.707l2.147 2.146a.5.5 0 1 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L2.707 12.5H14.5a.5.5 0 0 1 .5.5Z" />
                        </svg>
                    </button>
                    <div class="od-item-top">
                        <div>
                            <h3 class="od-item-title">@task.Key</h3>
                            <p class="od-item-meta">@task.Name</p>
                            <p class="od-item-meta">@task.Kind</p>
                        </div>
                        <div class="dropdown">
                            <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Task actions">&#8942;</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <button type="button"
                                            class="dropdown-item js-open-task-modal"
                                            data-task-mode="edit"
                                            data-task-id="@task.Id">
                                        Edit task
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-page-handler="DeleteTask" class="od-inline-form">
                                        <input type="hidden" name="orchestrationId" value="@Model.OrchestrationId" />
                                        <input type="hidden" name="versionId" value="@Model.VersionId" />
                                        <input type="hidden" name="stageId" value="@Model.StageId" />
                                        <input type="hidden" name="taskId" value="@task.Id" />
                                        <button type="submit" class="dropdown-item text-danger">Delete task</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="od-task-toggle-row">
                        <span class="od-task-toggle-label">Enabled</span>
                        <div class="form-check form-switch od-task-toggle">
                            <input class="form-check-input js-task-enabled-toggle" type="checkbox" role="switch" data-task-id="@task.Id" @(task.IsEnabled ? "checked" : null) aria-label="Toggle task enabled" />
                        </div>
                    </div>
                </div>
            </article>
        }

        <article class="od-pipeline-item od-add-item od-add-group-item od-add-actions-item">
            <div class="od-pipeline-card od-add-actions-card">
                <a href="#" id="addParallelGroupButton" class="od-add-link">+ Add parallel group</a>
                <span class="od-add-actions-separator" aria-hidden="true"></span>
                <a href="#" class="od-add-link js-open-task-modal" data-task-mode="create" data-bs-toggle="modal" data-bs-target="#newTaskModal">+ Add task</a>
            </div>
        </article>
    </div>
</section>

<div class="modal fade" id="taskExecutionConditionModal" tabindex="-1" aria-labelledby="taskExecutionConditionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="taskExecutionConditionModalLabel">Execution condition</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="taskExecutionConditionTaskId" />
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="taskHasExecutionConditionQuick" />
                    <label class="form-check-label" for="taskHasExecutionConditionQuick">Enable execution condition</label>
                </div>

                <div id="taskExecutionConditionSectionQuick" class="row g-2">
                    <div class="col-md-12">
                        <label class="form-label" for="taskConditionEngineQuick">Condition engine</label>
                        <select class="form-select" id="taskConditionEngineQuick" asp-items="Model.EngineTypes"></select>
                    </div>

                    <div class="task-condition-config-block col-12" data-engine="DSL">
                        <label class="form-label" for="taskConditionDslExpressionQuick">DSL expression</label>
                        <input class="form-control" id="taskConditionDslExpressionQuick" placeholder="true" />
                    </div>
                </div>

                <div id="taskConditionUnsupportedEngineWarningQuick" class="alert alert-warning mt-3 d-none mb-0">
                    Selected condition engine does not define specific configuration fields yet.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="taskExecutionConditionSaveButton">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="taskTransformationModal" tabindex="-1" aria-labelledby="taskTransformationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="taskTransformationModalLabel">Transformation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="taskTransformationTaskId" />
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="taskHasTransformationQuick" />
                    <label class="form-check-label" for="taskHasTransformationQuick">Enable transformation</label>
                </div>

                <div id="taskTransformationSectionQuick" class="row g-2">
                    <div class="col-md-12">
                        <label class="form-label" for="taskTransformationEngineQuick">Transformation engine</label>
                        <select class="form-select" id="taskTransformationEngineQuick" asp-items="Model.EngineTypes"></select>
                    </div>

                    <div class="task-transformation-config-block col-12" data-engine="DSL">
                        <div class="alert alert-secondary mb-0">
                            DSL transformation does not require additional fields.
                        </div>
                    </div>
                </div>

                <div id="taskTransformationUnsupportedEngineWarningQuick" class="alert alert-warning mt-3 d-none mb-0">
                    Selected transformation engine does not define specific configuration fields yet.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="taskTransformationSaveButton">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editParallelGroupModal" tabindex="-1" aria-labelledby="editParallelGroupModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editParallelGroupModalLabel">Edit parallel group</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editParallelGroupId" />
                <div class="mb-3">
                    <label for="editParallelGroupName" class="form-label">Name</label>
                    <input type="text" class="form-control" id="editParallelGroupName" maxlength="128" />
                </div>
                <div class="mb-3">
                    <label for="editParallelGroupJoinPolicy" class="form-label">Join policy</label>
                    <select class="form-select" id="editParallelGroupJoinPolicy">
                        <option value="WaitAll">WaitAll</option>
                    </select>
                </div>
                <div>
                    <label for="editParallelGroupMaxParallelAgents" class="form-label">Max parallel agents</label>
                    <input type="number" class="form-control" id="editParallelGroupMaxParallelAgents" min="1" step="1" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveParallelGroupButton">Save group</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="newTaskModal" tabindex="-1" aria-labelledby="newTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl od-task-modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateTask" class="od-task-modal-form">
                <div class="modal-header">
                    <h5 class="modal-title" id="newTaskModalLabel">Create task</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="orchestrationId" value="@Model.OrchestrationId" />
                    <input type="hidden" name="versionId" value="@Model.VersionId" />
                    <input type="hidden" name="NewTask.StageId" value="@Model.StageId" />
                    <input asp-for="NewTask.TaskId" type="hidden" id="taskModalTaskId" />
                    <input type="hidden" name="taskId" id="taskModalTaskIdRaw" />
                    <ul class="nav nav-tabs mb-3" id="taskCreateTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="task-general-tab" data-bs-toggle="tab" data-bs-target="#task-general-pane" type="button" role="tab" aria-controls="task-general-pane" aria-selected="true">General</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="task-policies-tab" data-bs-toggle="tab" data-bs-target="#task-policies-pane" type="button" role="tab" aria-controls="task-policies-pane" aria-selected="false">Policies</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="task-compensation-tab" data-bs-toggle="tab" data-bs-target="#task-compensation-pane" type="button" role="tab" aria-controls="task-compensation-pane" aria-selected="false">Rollback</button>
                        </li>
                    </ul>
                    <div class="tab-content" id="taskCreateTabsContent">
                        <div class="tab-pane fade show active" id="task-general-pane" role="tabpanel" aria-labelledby="task-general-tab" tabindex="0">
                            <div class="row g-3 mb-2">
                                <div class="col-md-4">
                                    <label asp-for="NewTask.Key" class="form-label">Key</label>
                                    <input asp-for="NewTask.Key" class="form-control" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="NewTask.Name" class="form-label">Name</label>
                                    <input asp-for="NewTask.Name" class="form-control" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="NewTask.Kind" class="form-label">Task type</label>
                                    <select asp-for="NewTask.Kind" class="form-select" asp-items="Model.TaskKinds" id="taskKindSelector"></select>
                                </div>
                            </div>
                            <hr />
                            <h6 class="mb-2">Task configuration (selected type)</h6>
                            <div class="task-config-block mb-2" data-kind="Http">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label asp-for="NewTask.HttpBaseUrlVariableRef" class="form-label">Base URL variable</label>
                                        <input asp-for="NewTask.HttpBaseUrlVariableRef" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="NewTask.HttpRelativePath" class="form-label">Relative path</label>
                                        <input asp-for="NewTask.HttpRelativePath" class="form-control" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="NewTask.HttpMethod" class="form-label">Method</label>
                                        <input asp-for="NewTask.HttpMethod" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="NewTask.HttpExpectedStatusCodes" class="form-label">Expected status codes</label>
                                        <input asp-for="NewTask.HttpExpectedStatusCodes" class="form-control" placeholder="200,202" />
                                    </div>
                                    <div class="col-md-12 form-check mt-3 ms-2">
                                        <input asp-for="NewTask.HttpAllowSyncResponse" class="form-check-input" />
                                        <label asp-for="NewTask.HttpAllowSyncResponse" class="form-check-label">Allow sync response</label>
                                    </div>
                                    <div class="col-12"><hr class="my-2" /></div>
                                    <div class="col-12">
                                        <h6 class="mb-2">Schema binding</h6>
                                    </div>
                                    <div class="col-md-12 form-check form-switch ms-2">
                                        <input asp-for="NewTask.HasHttpSchemaValidation" class="form-check-input" />
                                        <label asp-for="NewTask.HasHttpSchemaValidation" class="form-check-label">Enable schema validation</label>
                                    </div>
                                    <div class="col-md-5">
                                        <label asp-for="NewTask.HttpSchemaContractKey" class="form-label">Contract key</label>
                                        <input asp-for="NewTask.HttpSchemaContractKey" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="NewTask.HttpSchemaContractVersion" class="form-label">Contract version</label>
                                        <input asp-for="NewTask.HttpSchemaContractVersion" class="form-control" placeholder="1.0.0" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="NewTask.HttpSchemaRegistryProviderId" class="form-label">Registry provider id</label>
                                        <input asp-for="NewTask.HttpSchemaRegistryProviderId" class="form-control" placeholder="ULID (optional)" />
                                    </div>
                                    <div class="col-md-12 form-check mt-2 ms-2">
                                        <input asp-for="NewTask.HttpSchemaStrictMode" class="form-check-input" />
                                        <label asp-for="NewTask.HttpSchemaStrictMode" class="form-check-label">Strict mode</label>
                                    </div>
                                </div>
                            </div>
                            <div class="task-config-block mb-2" data-kind="Messaging">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label asp-for="NewTask.MessagingTopic" class="form-label">Topic</label>
                                        <input asp-for="NewTask.MessagingTopic" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="NewTask.MessagingVersion" class="form-label">Version</label>
                                        <input asp-for="NewTask.MessagingVersion" class="form-control" placeholder="1.0.0" />
                                    </div>
                                    <div class="col-12"><hr class="my-2" /></div>
                                    <div class="col-12">
                                        <h6 class="mb-2">Schema binding</h6>
                                    </div>
                                    <div class="col-md-12 form-check form-switch ms-2">
                                        <input asp-for="NewTask.HasMessagingSchemaValidation" class="form-check-input" />
                                        <label asp-for="NewTask.HasMessagingSchemaValidation" class="form-check-label">Enable schema validation</label>
                                    </div>
                                    <div class="col-md-5">
                                        <label asp-for="NewTask.MessagingSchemaContractKey" class="form-label">Contract key</label>
                                        <input asp-for="NewTask.MessagingSchemaContractKey" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="NewTask.MessagingSchemaContractVersion" class="form-label">Contract version</label>
                                        <input asp-for="NewTask.MessagingSchemaContractVersion" class="form-control" placeholder="1.0.0" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="NewTask.MessagingSchemaRegistryProviderId" class="form-label">Registry provider id</label>
                                        <input asp-for="NewTask.MessagingSchemaRegistryProviderId" class="form-control" placeholder="ULID (optional)" />
                                    </div>
                                    <div class="col-md-12 form-check mt-2 ms-2">
                                        <input asp-for="NewTask.MessagingSchemaStrictMode" class="form-check-input" />
                                        <label asp-for="NewTask.MessagingSchemaStrictMode" class="form-check-label">Strict mode</label>
                                    </div>
                                </div>
                            </div>
                            <div class="task-config-block mb-2" data-kind="Plugin">
                                <div class="row g-2">
                                    <div class="col-md-6">
