@page
@model Krackend.Sagas.Orchestrations.Design.WebUI.Areas.OrchestratorDesign.Pages.Orchestrations.CreateModel
@{
    ViewData["Title"] = "Create orchestration";
}

<div class="od-page-head">
    <h1 class="od-page-title">Create orchestration</h1>
    <a asp-area="OrchestratorDesign" asp-page="/Orchestrations/Index" class="btn btn-outline-secondary">Back</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" class="od-form-shell">
    <div class="row g-3">
        <div class="col-md-6 position-relative">
            <label asp-for="Input.Key" class="form-label"></label>
            <input asp-for="Input.Key" class="form-control" />
            <span asp-validation-for="Input.Key" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Name" class="form-label"></label>
            <input asp-for="Input.Name" class="form-control" />
            <span asp-validation-for="Input.Name" class="text-danger"></span>
        </div>
        <div class="col-md-6 position-relative">
            <label asp-for="Input.DomainText" class="form-label"></label>
            <input asp-for="Input.DomainText" class="form-control js-domain-autocomplete-input" autocomplete="off" data-domain-suggestions-container="createDomainSuggestions" />
            <input asp-for="Input.DomainId" type="hidden" class="js-domain-id-input" />
            <div id="createDomainSuggestions" class="od-autocomplete-list d-none"></div>
            <span asp-validation-for="Input.DomainId" class="text-danger"></span>
        </div>
        <div class="col-md-6 position-relative">
            <label asp-for="Input.OwnerTeamText" class="form-label"></label>
            <input asp-for="Input.OwnerTeamText" class="form-control js-team-autocomplete-input" autocomplete="off" data-team-suggestions-container="createTeamSuggestions" />
            <input asp-for="Input.OwnerTeamId" type="hidden" class="js-team-id-input" />
            <div id="createTeamSuggestions" class="od-autocomplete-list d-none"></div>
            <span asp-validation-for="Input.OwnerTeamId" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Input.Description" class="form-label"></label>
            <textarea asp-for="Input.Description" rows="3" class="form-control"></textarea>
        </div>
        <div class="col-12">
            <label asp-for="Input.Tags" class="form-label"></label>
            <input asp-for="Input.Tags" class="form-control" placeholder="billing,critical" />
        </div>
        <div class="col-md-6">
            <label asp-for="Input.CreatedBy" class="form-label"></label>
            <input asp-for="Input.CreatedBy" class="form-control" />
        </div>
    </div>

    <div class="od-form-actions">
        <button type="submit" class="btn btn-primary">Create</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
<script>
(() => {
    const domainInput = document.querySelector('.js-domain-autocomplete-input');
    const domainHidden = document.querySelector('.js-domain-id-input');
    const domainList = document.getElementById(domainInput?.getAttribute('data-domain-suggestions-container') || '');
    const teamInput = document.querySelector('.js-team-autocomplete-input');
    const teamHidden = document.querySelector('.js-team-id-input');
    const teamList = document.getElementById(teamInput?.getAttribute('data-team-suggestions-container') || '');
    if (!domainInput || !domainHidden || !domainList || !teamInput || !teamHidden || !teamList) return;

    const escapeHtml = (value) => (value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

    const hideList = (list) => {
        list.classList.add('d-none');
        list.innerHTML = '';
    };

    const renderDomain = (rows) => {
        if (!rows.length) {
            hideList(domainList);
            return;
        }

        domainList.innerHTML = rows.map(x => `
            <button type="button" class="od-autocomplete-item"
                data-id="${escapeHtml(x.id)}"
                data-value="${escapeHtml(`${x.displayName} (${x.key})`)}">
                <span class="od-autocomplete-title">${escapeHtml(x.displayName)} (${escapeHtml(x.key)})</span>
                <span class="od-autocomplete-meta">${escapeHtml(x.description || '')}</span>
            </button>`).join('');
        domainList.classList.remove('d-none');
    };

    const renderTeam = (rows) => {
        if (!rows.length) {
            hideList(teamList);
            return;
        }

        teamList.innerHTML = rows.map(x => `
            <button type="button" class="od-autocomplete-item"
                data-id="${escapeHtml(x.id)}"
                data-value="${escapeHtml(`${x.displayName} (${x.key})`)}">
                <span class="od-autocomplete-title">${escapeHtml(x.displayName)} (${escapeHtml(x.key)})</span>
            </button>`).join('');
        teamList.classList.remove('d-none');
    };

    let domainToken = 0;
    const fetchDomainSuggestions = async () => {
        const q = domainInput.value.trim();
        if (!q) {
            domainHidden.value = '';
            hideList(domainList);
            return;
        }

        const currentToken = ++domainToken;
        const url = `${window.location.pathname}?handler=DomainSuggestions&term=${encodeURIComponent(q)}`;
        const response = await fetch(url);
        if (!response.ok || currentToken !== domainToken) return;
        renderDomain(await response.json());
    };

    let teamToken = 0;
    const fetchTeamSuggestions = async () => {
        const q = teamInput.value.trim();
        if (!q) {
            teamHidden.value = '';
            hideList(teamList);
            return;
        }

        const currentToken = ++teamToken;
        const url = `${window.location.pathname}?handler=TeamSuggestions&term=${encodeURIComponent(q)}`;
        const response = await fetch(url);
        if (!response.ok || currentToken !== teamToken) return;
        renderTeam(await response.json());
    };

    domainInput.addEventListener('input', () => {
        domainHidden.value = '';
        fetchDomainSuggestions();
    });

    teamInput.addEventListener('input', () => {
        teamHidden.value = '';
        fetchTeamSuggestions();
    });

    domainInput.addEventListener('blur', () => setTimeout(() => hideList(domainList), 150));
    teamInput.addEventListener('blur', () => setTimeout(() => hideList(teamList), 150));

    domainList.addEventListener('click', event => {
        const item = event.target.closest('.od-autocomplete-item');
        if (!item) return;
        domainHidden.value = item.getAttribute('data-id') || '';
        domainInput.value = item.getAttribute('data-value') || '';
        hideList(domainList);
    });

    teamList.addEventListener('click', event => {
        const item = event.target.closest('.od-autocomplete-item');
        if (!item) return;
        teamHidden.value = item.getAttribute('data-id') || '';
        teamInput.value = item.getAttribute('data-value') || '';
        hideList(teamList);
    });
})();
</script>
}
