@page
@using Zoorce.Web.UI.Abstractions.Data
@using Zoorce.Web.UI.DataGrid
@using Zoorce.Web.UI.Foundation.Components
@using Microsoft.AspNetCore.Html
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Security.Areas.OrchestratorSecurity.Pages.Teams.IndexModel
@{
    ViewData["Title"] = "Teams";
}

<button type="button" class="od-create-floating js-open-team-modal" data-mode="create"><i class="bi bi-plus-lg" aria-hidden="true"></i><span>Create team</span></button>

<form method="post" asp-page-handler="SetIsActive" id="team-status-form" data-orchestrator-busy="true" hidden>
    <input type="hidden" name="teamId" /><input type="hidden" name="isActive" />
</form>
<section class="od-catalog" data-catalog="teams" data-label="teams" data-source="@Url.Page(null, "List")">
    <div class="od-catalog-controls" role="group" aria-label="View mode">
        <button type="button" class="btn btn-outline-secondary" data-catalog-view="grid" aria-label="Grid view" title="Grid view" aria-pressed="true"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
        <button type="button" class="btn btn-outline-secondary" data-catalog-view="cards" aria-label="Card view" title="Card view" aria-pressed="false"><i class="bi bi-grid-3x2-gap" aria-hidden="true"></i></button>
    </div>
    <div data-catalog-grid>
        @await Component.InvokeAsync("ZoorceDataGrid", new ZoorceDataGridOptions
        {
            Id = "teams-grid", AriaLabel = "teams", Binding = new ZoorceDataBindingOptions { Source = Url.Page(null, "List") },
            LoadMode = ZoorceDataLoadMode.InfiniteScroll, PageSize = 25,
            Columns = [new("displayName", "Name"), new("key", "Key"), new("status", "Status"), new("members", "Members", false), new("actions", "Actions", false)]
        })
    </div>
    <div data-catalog-cards hidden>
        <div class="od-catalog-filters">
            <label class="z-search-field"><span aria-hidden="true">&#x2315;</span><input type="search" data-catalog-search aria-label="Search teams" placeholder="Search teams" autocomplete="off" /></label>
            <select class="form-select" data-catalog-sort aria-label="Sort teams">
                <option value="displayName">Name: A to Z</option><option value="displayName:desc">Name: Z to A</option>
                <option value="key">Key</option><option value="status">Status</option>
            </select>
        </div>
        <div class="od-grid" data-catalog-card-items></div>
        <p class="od-empty" data-catalog-empty hidden>No matching teams.</p>
        <p data-catalog-status aria-live="polite"></p>
        <div data-catalog-sentinel aria-hidden="true"></div>
        <button type="button" class="btn btn-outline-secondary" data-catalog-more hidden>Load more</button>
    </div>
</section>

@await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions
{
    Id = "teamModal", Title = "Create team", Eyebrow = null,
    Body = await Html.PartialAsync("_TeamForm", Model),
    Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Cancel</button><button type=\"submit\" form=\"teamForm\" class=\"z-button z-button-primary\" id=\"teamModalSubmitButton\">Create</button>")
})
@await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions
{
    Id = "membersModal", Title = "Team members", Eyebrow = null, Size = "wide",
    Body = await Html.PartialAsync("_TeamMembers", Model),
    Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Close</button>")
})

@section Scripts {
<script src="/_content/Krackend.Sagas.Orchestrations.ControlPlane.WebUI/js/orchestrator-catalog.js" asp-append-version="true"></script>
<script>
(() => {
    const teamModalElement = document.getElementById('teamModal');
    if (!teamModalElement) return;

    const title = document.getElementById('teamModal-title');
    const submitButton = document.getElementById('teamModalSubmitButton');
    const idInput = document.getElementById('teamIdInput');
    const keyInput = document.getElementById('teamKeyInput');
    const displayNameInput = document.getElementById('teamDisplayNameInput');
    const descriptionInput = document.getElementById('teamDescriptionInput');

    const membersModalElement = document.getElementById('membersModal');
    const membersLabel = document.getElementById('membersModal-title');
    const membersList = document.getElementById('membersList');
    const memberTeamIdInput = document.getElementById('memberTeamIdInput');
    const membersSearch = document.getElementById('membersSearch');
    const membersStatus = document.getElementById('membersStatus');
    const membersMore = document.getElementById('membersMore');
    const membersScroll = membersModalElement?.querySelector('[data-z-dialog-focus]');
    let membersPage = 1, membersHasMore = false, membersLoading = false, membersGeneration = 0, searchTimer;

    const setValue = (el, value) => { if (el) el.value = value ?? ''; };
    const escapeHtml = (value) => (value || '')
        .toString()
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

    document.addEventListener('click', event => {
        const button = event.target.closest('.js-open-team-modal');
        if (button) {
            const mode = button.getAttribute('data-mode');
            if (mode === 'edit') {
                title.textContent = 'Edit team';
                submitButton.textContent = 'Save';
                setValue(idInput, button.getAttribute('data-id'));
                setValue(keyInput, button.getAttribute('data-key'));
                setValue(displayNameInput, button.getAttribute('data-display-name'));
                setValue(descriptionInput, button.getAttribute('data-description'));
                keyInput.readOnly = true;
                teamModalElement.open?.(button);
                return;
            }

            title.textContent = 'Create team';
            submitButton.textContent = 'Create';
            setValue(idInput, '');
            setValue(keyInput, '');
            setValue(displayNameInput, '');
            setValue(descriptionInput, '');
            keyInput.readOnly = false;
            teamModalElement.open?.(button);
        }
    });

    const loadMembers = async () => {
        const teamId = memberTeamIdInput?.value;
        if (!membersList || !teamId || membersLoading) return;
        const generation = membersGeneration;
        membersLoading = true;
        membersStatus.textContent = 'Loading members...';
        membersMore.hidden = true;
        try {
            const query = new URLSearchParams({ handler: 'MemberList', teamId, page: membersPage, pageSize: 25, search: membersSearch.value.trim() });
            const response = await fetch(`${window.location.pathname}?${query}`);
            if (!response.ok) throw new Error('Members unavailable');
            const result = await response.json();
            if (generation !== membersGeneration) return;
            membersList.insertAdjacentHTML('beforeend', result.items.map(x => `
            <div class="d-flex align-items-center justify-content-between border rounded p-2">
                <div>
                    <div>${escapeHtml(x.displayName || '')}</div>
                    <div class="text-muted small">${escapeHtml(x.externalUserId || '')}</div>
                </div>
                <form method="post" action="${window.location.pathname}?handler=RemoveMember" data-confirm="true" data-confirm-title="Remove member" data-confirm-message="Remove this member from the team?" data-confirm-accept="Remove" data-confirm-type="warning" data-orchestrator-busy="true" data-busy-title="Removing member" data-busy-message="Security is removing the team member.">
                    <input type="hidden" name="__RequestVerificationToken" value="${escapeHtml(document.querySelector('#team-status-form input[name="__RequestVerificationToken"]')?.value || '')}" />
                    <input type="hidden" name="teamId" value="${escapeHtml(x.teamId || '')}" />
                    <input type="hidden" name="externalUserId" value="${escapeHtml(x.externalUserId || '')}" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                </form>
            </div>`).join(''));
            membersHasMore = result.hasMore;
            membersPage++;
            membersStatus.textContent = result.totalCount === 0 ? 'No matching members.' : `${result.totalCount} members`;
            membersMore.hidden = !membersHasMore;
            if (result.items.length && membersHasMore) requestAnimationFrame(() => {
                if (generation === membersGeneration && membersScroll && membersScroll.scrollTop + membersScroll.clientHeight >= membersScroll.scrollHeight - 48) loadMembers();
            });
        } catch {
            if (generation === membersGeneration) {
                membersStatus.textContent = 'Members could not be loaded. Try again.';
                membersMore.hidden = false;
            }
        } finally {
            if (generation === membersGeneration) membersLoading = false;
        }
    };

    const resetMembers = () => {
        membersGeneration++;
        membersPage = 1;
        membersHasMore = false;
        membersLoading = false;
        membersList.replaceChildren();
        loadMembers();
    };
    membersScroll?.addEventListener('scroll', () => {
        if (membersHasMore && membersScroll.scrollTop + membersScroll.clientHeight >= membersScroll.scrollHeight - 48) loadMembers();
    });
    membersMore?.addEventListener('click', loadMembers);
    membersSearch?.addEventListener('input', () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(resetMembers, 250);
    });

    document.addEventListener('click', async event => {
            const button = event.target.closest('.js-open-members-modal');
            if (!button) return;
            const teamId = button.getAttribute('data-team-id') || '';
            const teamName = button.getAttribute('data-team-name') || '';
            if (!teamId || !membersModalElement || !memberTeamIdInput || !membersLabel) return;

            membersLabel.textContent = `Team members - ${teamName}`;
            memberTeamIdInput.value = teamId;
            clearTimeout(searchTimer);
            membersSearch.value = '';
            membersModalElement.open?.(button);
            resetMembers();
    });
})();
</script>
}
