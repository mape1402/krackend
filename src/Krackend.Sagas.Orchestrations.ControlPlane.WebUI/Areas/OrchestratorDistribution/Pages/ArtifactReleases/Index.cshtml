@page
@using Zoorce.Web.UI.Abstractions.Data
@using Zoorce.Web.UI.DataGrid
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Distribution.Areas.OrchestratorDistribution.Pages.Artifacts.IndexModel
@{ ViewData["Title"] = "Artifacts"; }

<div class="od-page-head">
    <div><h1 class="od-page-title">Artifacts</h1><p class="od-page-subtitle">Deployed orchestration artifacts.</p></div>
    @if (!string.IsNullOrWhiteSpace(Model.OrchestrationId))
    {
        <a class="btn btn-outline-secondary" asp-page="/ArtifactReleases/Index">All artifacts</a>
    }
</div>
<section class="od-catalog" data-catalog="artifacts" data-label="artifacts" data-source="@Url.Page(null, "List", new { orchestrationId = Model.OrchestrationId })" data-detail-source="@Url.Page(null, "Details")">
    <div class="od-catalog-controls" role="group" aria-label="View mode">
        <button type="button" class="btn btn-outline-secondary" data-catalog-view="grid" aria-label="Grid view" title="Grid view" aria-pressed="true"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
        <button type="button" class="btn btn-outline-secondary" data-catalog-view="cards" aria-label="Card view" title="Card view" aria-pressed="false"><i class="bi bi-grid-3x2-gap" aria-hidden="true"></i></button>
    </div>
    <div data-catalog-grid>
        @await Component.InvokeAsync("ZoorceDataGrid", new ZoorceDataGridOptions
        {
            Id = "artifacts-grid", AriaLabel = "artifacts", Binding = new ZoorceDataBindingOptions { Source = Url.Page(null, "List", new { orchestrationId = Model.OrchestrationId }) },
            LoadMode = ZoorceDataLoadMode.InfiniteScroll, PageSize = 25,
            Columns = [new("displayName", "Orchestration"), new("version", "Version", false), new("artifactType", "Type"), new("created", "Created"), new("actions", "Actions", false)]
        })
    </div>
    <div data-catalog-cards hidden>
        <div class="od-catalog-filters">
            <label class="z-search-field"><span aria-hidden="true">&#x2315;</span><input type="search" data-catalog-search aria-label="Search artifacts" placeholder="Search artifacts" autocomplete="off" /></label>
            <select class="form-select" data-catalog-sort aria-label="Sort artifacts">
                <option value="created:desc">Newest first</option><option value="created">Oldest first</option>
                <option value="displayName">Orchestration</option><option value="artifactType">Type</option>
            </select>
        </div>
        <div class="od-grid" data-catalog-card-items></div>
        <p class="od-empty" data-catalog-empty hidden>No matching artifacts.</p>
        <p data-catalog-status aria-live="polite"></p><div data-catalog-sentinel aria-hidden="true"></div>
        <button type="button" class="btn btn-outline-secondary" data-catalog-more hidden>Load more</button>
    </div>
</section>

<div class="modal fade" id="artifactDetailsModal" tabindex="-1" aria-labelledby="artifactDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content artifact-modal">
            <div class="modal-header artifact-modal-header">
                <h5 class="modal-title" id="artifactDetailsModalLabel">Artifact details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body artifact-modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label artifact-label">Orchestration</label>
                        <input class="form-control artifact-readonly" id="artifactDetailDisplayName" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label artifact-label">Artifact Type</label>
                        <input class="form-control artifact-readonly" id="artifactDetailType" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label artifact-label">Version Id</label>
                        <input class="form-control artifact-readonly" id="artifactDetailVersionId" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label artifact-label">Version Number</label>
                        <input class="form-control artifact-readonly" id="artifactDetailVersionNumber" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label artifact-label">Version Label</label>
                        <input class="form-control artifact-readonly" id="artifactDetailVersionLabel" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label artifact-label">Created At</label>
                        <input class="form-control artifact-readonly" id="artifactDetailCreatedAt" readonly />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label artifact-label">Checksum</label>
                        <input class="form-control artifact-readonly" id="artifactDetailChecksum" readonly />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label artifact-label">Payload (JSON)</label>
                        <pre id="artifactDetailPayload" class="od-json-block"></pre>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="/_content/Krackend.Sagas.Orchestrations.ControlPlane.WebUI/js/orchestrator-catalog.js" asp-append-version="true"></script>
<script>
(() => {
    const modalElement = document.getElementById('artifactDetailsModal');
    const modal = window.bootstrap?.Modal?.getOrCreateInstance(modalElement);
    if (!modalElement || !modal) return;

    const fields = {
        displayName: document.getElementById('artifactDetailDisplayName'),
        artifactType: document.getElementById('artifactDetailType'),
        versionId: document.getElementById('artifactDetailVersionId'),
        versionNumber: document.getElementById('artifactDetailVersionNumber'),
        versionLabel: document.getElementById('artifactDetailVersionLabel'),
        createdAt: document.getElementById('artifactDetailCreatedAt'),
        checksum: document.getElementById('artifactDetailChecksum'),
        payload: document.getElementById('artifactDetailPayload')
    };

    const setValue = (element, value) => {
        if (!element) return;
        element.value = value ?? '';
    };

    const setPrettyJson = (element, rawValue) => {
        if (!element) return;
        const value = rawValue ?? '';
        if (!value.trim()) {
            element.textContent = '{}';
            return;
        }

        try {
            const parsed = JSON.parse(value);
            element.textContent = JSON.stringify(parsed, null, 2);
        } catch {
            element.textContent = value;
        }
    };

    document.addEventListener('click', async event => {
        const button = event.target.closest('.js-open-artifact-details');
        if (!button) return;
        Object.values(fields).forEach(element => { if (element !== fields.payload) setValue(element, ''); });
        fields.payload.textContent = 'Loading artifact...';
        modal.show();
        try {
            const url = new URL(document.querySelector('[data-catalog="artifacts"]').dataset.detailSource, location.href);
            url.searchParams.set('artifactId', button.dataset.id);
            const response = await fetch(url);
            if (!response.ok) throw new Error('Artifact details are unavailable.');
            const item = await response.json();
            for (const key of ['displayName', 'artifactType', 'versionId', 'versionNumber', 'versionLabel', 'createdAt', 'checksum'])
                setValue(fields[key], item[key]);
            setPrettyJson(fields.payload, item.payload);
        } catch {
            fields.payload.textContent = 'Artifact details could not be loaded. Please try again.';
        }
    });
})();
</script>
<style>
.od-json-block {
    margin: 0;
    padding: 1rem 1.1rem;
    max-height: 420px;
    overflow: auto;
    border: 1px solid var(--od-border);
    border-radius: 0.65rem;
    background: var(--krackend-code-bg, var(--od-surface-2));
    color: var(--krackend-code-text, var(--od-text));
    font-family: Consolas, "Courier New", monospace;
    font-size: 0.85rem;
    line-height: 1.4;
    white-space: pre;
}

.artifact-modal {
    border: 1px solid var(--od-border);
    background: var(--od-surface);
    color: var(--od-text);
    box-shadow: 0 14px 36px var(--krackend-shadow-color, rgba(24, 39, 74, 0.16));
}

.artifact-modal-header {
    background: var(--od-surface-2);
    color: var(--od-text);
    border-bottom: 1px solid var(--od-border);
}

.artifact-modal-header .modal-title {
    font-weight: 600;
    letter-spacing: 0.01em;
}

.artifact-modal-body {
    background: var(--od-surface);
}

.artifact-label {
    color: var(--od-muted);
    font-weight: 600;
    font-size: 0.83rem;
    letter-spacing: 0.005em;
}

.artifact-readonly {
    background: var(--od-surface-2);
    border-color: var(--od-border);
    color: var(--od-text);
    font-weight: 450;
}

.artifact-readonly:focus {
    border-color: var(--od-primary);
    box-shadow: 0 0 0 0.16rem color-mix(in srgb, var(--od-primary) 20%, transparent);
}

.od-orch-card {
    min-height: 0 !important;
    padding: 0.75rem 0.9rem;
}

.od-orch-title {
    color: var(--od-text);
}

.od-release-detail-headline {
    margin-top: 0.2rem;
}

.od-release-id {
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.2;
    white-space: normal;
    overflow-wrap: anywhere;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: none;
}

.od-distribution-detail-grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
}

.od-artifact-detail-card {
    min-height: 180px;
}

.od-detail-kv {
    display: grid;
    gap: 0.2rem;
    margin-top: auto;
    padding-top: 0.35rem;
    font-size: 0.74rem;
}

.od-detail-kv span {
    color: var(--od-muted);
    font-weight: 650;
}

.od-detail-kv strong {
    color: var(--od-text);
    font-family: Consolas, "Courier New", monospace;
    font-size: 0.7rem;
    font-weight: 600;
    overflow-wrap: anywhere;
}

.od-card-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 0.55rem;
}

.od-release-details-btn {
    border: 1px solid var(--od-border);
    background: var(--od-surface-2);
    color: var(--od-text);
    border-radius: 0.5rem;
    padding: 0.24rem 0.58rem;
    line-height: 1.2;
    font-weight: 600;
}

.od-release-details-btn:hover {
    background: color-mix(in srgb, var(--od-primary) 14%, var(--od-surface));
    border-color: var(--od-primary);
    color: var(--od-text);
}

</style>
}
