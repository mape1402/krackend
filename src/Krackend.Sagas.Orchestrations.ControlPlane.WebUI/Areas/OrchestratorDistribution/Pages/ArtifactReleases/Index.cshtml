@page
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Distribution.Areas.OrchestratorDistribution.Pages.Artifacts.IndexModel
@{
    ViewData["Title"] = "Artifacts";
    var isOrchestrationSelected = !string.IsNullOrWhiteSpace(Model.OrchestrationId);
    var catalogRows = Model.Orchestrations
        .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
        .ToArray();
    var artifactRows = Model.Rows
        .OrderByDescending(x => x.CreatedAtUtc)
        .ToArray();
    var selectedOrchestrationName = Model.SelectedOrchestration?.Name ?? Model.OrchestrationId;
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">
            @(!isOrchestrationSelected
                ? "Artifacts"
                : $"Artifacts - {selectedOrchestrationName}")
        </h1>
        <p class="od-page-subtitle">
            @(!isOrchestrationSelected
                ? "Select an orchestration to view deployed artifacts."
                : "Artifacts already deployed for the selected orchestration.")
        </p>
    </div>
    @if (isOrchestrationSelected)
    {
        <a class="btn btn-outline-secondary"
           asp-area="OrchestratorDistribution"
           asp-page="/ArtifactReleases/Index">
            All orchestrations
        </a>
    }
</div>

@if (!isOrchestrationSelected)
{
    @if (!catalogRows.Any())
    {
        <section class="od-panel">
            <p class="od-empty">No orchestrations available in distribution mirror.</p>
        </section>
    }
    else
    {
        <section class="od-list-shell" data-od-infinite-list>
            <div class="od-grid"
                 data-od-infinite-grid
                 data-od-infinite-label="orchestrations"
                 data-od-infinite-initial-count="24"
                 data-od-infinite-batch-size="24">
                @foreach (var orchestration in catalogRows)
                {
                    var summary = Model.GetSummary(orchestration.Id);
                    <a class="od-item-card od-orch-card od-infinite-item text-decoration-none"
                       asp-area="OrchestratorDistribution"
                       asp-page="/ArtifactReleases/Index"
                       asp-route-orchestrationId="@orchestration.Id">
                        <div class="od-item-top">
                            <div>
                                <h2 class="od-item-title od-orch-title">@orchestration.Name</h2>
                                <p class="od-item-meta">@orchestration.Key</p>
                            </div>
                            <span class="od-status @(orchestration.IsActive ? "od-status-active" : "od-status-inactive")">
                                @(orchestration.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>
                        <div class="od-chip-row">
                            <span class="od-meta-chip">Artifacts: @summary.ArtifactCount</span>
                            @if (summary.LatestCreatedAtUtc.HasValue)
                            {
                                <span class="od-meta-chip">Latest: @summary.LatestCreatedAtUtc.Value.ToString("yyyy-MM-dd HH:mm")</span>
                            }
                        </div>
                    </a>
                }
            </div>
            <div class="od-infinite-scroll-status" data-od-infinite-status>
                Showing <span data-od-infinite-count>@Math.Min(24, catalogRows.Length)</span> of <span data-od-infinite-total>@catalogRows.Length</span> orchestrations
            </div>
            <div class="od-infinite-scroll-sentinel" data-od-infinite-sentinel aria-hidden="true"></div>
        </section>
    }
}
else
{
    <section class="od-list-shell" data-od-infinite-list>
        <div class="od-section-head od-release-detail-headline">
            <div>
                <h2 class="od-section-title">Deployed artifacts</h2>
                <p class="od-item-meta">@artifactRows.Length artifact(s) found</p>
            </div>
        </div>

        @if (!artifactRows.Any())
        {
            <section class="od-panel">
                <p class="od-empty">No artifacts found for this orchestration.</p>
            </section>
        }
        else
        {
            <div class="od-release-board"
                 data-od-infinite-grid
                 data-od-infinite-label="artifacts"
                 data-od-infinite-initial-count="30"
                 data-od-infinite-batch-size="30">
                @foreach (var item in artifactRows)
                {
                    <article class="od-release-row od-infinite-item"
                             data-display-name="@item.OrchestrationDisplayName"
                             data-version-id="@item.OrchestrationVersionId"
                             data-version-label="@item.VersionLabel"
                             data-version-number="@item.VersionNumber"
                             data-artifact-type="@item.ArtifactType"
                             data-checksum="@item.Checksum"
                             data-created-at="@item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")"
                             data-payload="@item.Payload">
                        <div class="od-release-row-main">
                            <div class="od-release-row-head">
                                <span class="od-status od-status-active">@item.ArtifactType</span>
                                <p class="od-item-meta od-release-id">@item.Id</p>
                            </div>
                            <div class="od-chip-row">
                                <span class="od-meta-chip">Version: @item.VersionNumber - @(string.IsNullOrWhiteSpace(item.VersionLabel) ? "Unlabeled" : item.VersionLabel)</span>
                                <span class="od-meta-chip">Created: @item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                        </div>
                        <div class="od-release-row-actions">
                            <button type="button"
                                    class="btn btn-sm od-release-details-btn js-open-artifact-details"
                                    data-display-name="@item.OrchestrationDisplayName"
                                    data-version-id="@item.OrchestrationVersionId"
                                    data-version-number="@item.VersionNumber"
                                    data-version-label="@item.VersionLabel"
                                    data-artifact-type="@item.ArtifactType"
                                    data-checksum="@item.Checksum"
                                    data-created-at="@item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")"
                                    data-payload="@item.Payload">
                                View details
                            </button>
                        </div>
                    </article>
                }
            </div>
            <div class="od-infinite-scroll-status" data-od-infinite-status>
                Showing <span data-od-infinite-count>@Math.Min(30, artifactRows.Length)</span> of <span data-od-infinite-total>@artifactRows.Length</span> artifacts
            </div>
            <div class="od-infinite-scroll-sentinel" data-od-infinite-sentinel aria-hidden="true"></div>
        }
    </section>
}

<div class="modal fade" id="artifactDetailsModal" tabindex="-1" aria-labelledby="artifactDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content artifact-modal">
            <div class="modal-header artifact-modal-header">
                <h5 class="modal-title" id="artifactDetailsModalLabel">Artifact details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body artifact-modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label artifact-label">Orchestration</label>
                        <input class="form-control artifact-readonly" id="artifactDetailDisplayName" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label artifact-label">Artifact Type</label>
                        <input class="form-control artifact-readonly" id="artifactDetailType" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label artifact-label">Version Id</label>
                        <input class="form-control artifact-readonly" id="artifactDetailVersionId" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label artifact-label">Version Number</label>
                        <input class="form-control artifact-readonly" id="artifactDetailVersionNumber" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label artifact-label">Version Label</label>
                        <input class="form-control artifact-readonly" id="artifactDetailVersionLabel" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label artifact-label">Created At</label>
                        <input class="form-control artifact-readonly" id="artifactDetailCreatedAt" readonly />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label artifact-label">Checksum</label>
                        <input class="form-control artifact-readonly" id="artifactDetailChecksum" readonly />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label artifact-label">Payload (JSON)</label>
                        <pre id="artifactDetailPayload" class="od-json-block"></pre>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const modalElement = document.getElementById('artifactDetailsModal');
    const modal = window.bootstrap?.Modal?.getOrCreateInstance(modalElement);
    if (!modalElement || !modal) return;

    const fields = {
        displayName: document.getElementById('artifactDetailDisplayName'),
        artifactType: document.getElementById('artifactDetailType'),
        versionId: document.getElementById('artifactDetailVersionId'),
        versionNumber: document.getElementById('artifactDetailVersionNumber'),
        versionLabel: document.getElementById('artifactDetailVersionLabel'),
        createdAt: document.getElementById('artifactDetailCreatedAt'),
        checksum: document.getElementById('artifactDetailChecksum'),
        payload: document.getElementById('artifactDetailPayload')
    };

    const setValue = (element, value) => {
        if (!element) return;
        element.value = value ?? '';
    };

    const setPrettyJson = (element, rawValue) => {
        if (!element) return;
        const value = rawValue ?? '';
        if (!value.trim()) {
            element.textContent = '{}';
            return;
        }

        try {
            const parsed = JSON.parse(value);
            element.textContent = JSON.stringify(parsed, null, 2);
        } catch {
            element.textContent = value;
        }
    };

    document.querySelectorAll('.js-open-artifact-details').forEach(button => {
        button.addEventListener('click', () => {
            setValue(fields.displayName, button.getAttribute('data-display-name'));
            setValue(fields.artifactType, button.getAttribute('data-artifact-type'));
            setValue(fields.versionId, button.getAttribute('data-version-id'));
            setValue(fields.versionNumber, button.getAttribute('data-version-number'));
            setValue(fields.versionLabel, button.getAttribute('data-version-label'));
            setValue(fields.createdAt, button.getAttribute('data-created-at'));
            setValue(fields.checksum, button.getAttribute('data-checksum'));
            setPrettyJson(fields.payload, button.getAttribute('data-payload'));

            modal.show();
        });
    });
})();
</script>
<style>
.od-json-block {
    margin: 0;
    padding: 1rem 1.1rem;
    max-height: 420px;
    overflow: auto;
    border: 1px solid var(--od-border);
    border-radius: 0.65rem;
    background: var(--krackend-code-bg, var(--od-surface-2));
    color: var(--krackend-code-text, var(--od-text));
    font-family: Consolas, "Courier New", monospace;
    font-size: 0.85rem;
    line-height: 1.4;
    white-space: pre;
}

.artifact-modal {
    border: 1px solid var(--od-border);
    background: var(--od-surface);
    color: var(--od-text);
    box-shadow: 0 14px 36px var(--krackend-shadow-color, rgba(24, 39, 74, 0.16));
}

.artifact-modal-header {
    background: var(--od-surface-2);
    color: var(--od-text);
    border-bottom: 1px solid var(--od-border);
}

.artifact-modal-header .modal-title {
    font-weight: 600;
    letter-spacing: 0.01em;
}

.artifact-modal-body {
    background: var(--od-surface);
}

.artifact-label {
    color: var(--od-muted);
    font-weight: 600;
    font-size: 0.83rem;
    letter-spacing: 0.005em;
}

.artifact-readonly {
    background: var(--od-surface-2);
    border-color: var(--od-border);
    color: var(--od-text);
    font-weight: 450;
}

.artifact-readonly:focus {
    border-color: var(--od-primary);
    box-shadow: 0 0 0 0.16rem color-mix(in srgb, var(--od-primary) 20%, transparent);
}

.od-orch-card {
    min-height: 0 !important;
    padding: 0.75rem 0.9rem;
}

.od-orch-title {
    color: var(--od-text);
}

.od-release-detail-headline {
    margin-top: 0.2rem;
}

.od-release-id {
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    overflow: visible;
    text-overflow: clip;
    max-width: none;
}

.od-release-board {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
}

.od-release-row {
    border: 1px solid var(--od-border);
    border-radius: 0.75rem;
    background: var(--od-surface);
    padding: 1.15rem 1rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.1rem;
    align-items: center;
}

.od-release-row-main {
    min-width: 0;
}

.od-release-row-head {
    display: flex;
    justify-content: flex-start;
    gap: 0.9rem;
    align-items: center;
    margin-bottom: 0.45rem;
}

.od-release-row-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: end;
    padding-left: 0.45rem;
}

.od-release-details-btn {
    border: 1px solid var(--od-border);
    background: var(--od-surface-2);
    color: var(--od-text);
    border-radius: 0.5rem;
    padding: 0.24rem 0.58rem;
    line-height: 1.2;
    font-weight: 600;
}

.od-release-details-btn:hover {
    background: color-mix(in srgb, var(--od-primary) 14%, var(--od-surface));
    border-color: var(--od-primary);
    color: var(--od-text);
}

@@media (max-width: 991.98px) {
    .od-release-row {
        grid-template-columns: 1fr;
    }

    .od-release-row-actions {
        justify-content: flex-end;
    }
}
</style>
}
