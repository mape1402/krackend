@page
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Distribution.Areas.OrchestratorDistribution.Pages.Environments.IndexModel
@{
    ViewData["Title"] = "Environments";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Environments</h1>
        <p class="od-page-subtitle">Logical deployment stages such as Dev, QA and Prod.</p>
    </div>
    <button type="button" class="btn btn-primary js-open-environment-modal" data-mode="create">Create environment</button>
</div>

@if (!Model.Rows.Any())
{
    <section class="od-panel">
        <p class="od-empty">No environments found.</p>
    </section>
}
else
{
    <section class="od-list-shell">
        <div class="od-grid">
            @foreach (var item in Model.Rows)
            {
                var statusClass = item.IsEnabled ? "od-status od-status-active" : "od-status od-status-inactive";
                <article class="od-item-card">
                    <div class="od-item-top">
                        <div>
                            <h2 class="od-item-title">@item.Name</h2>
                            <p class="od-item-meta">@item.Code</p>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            <span class="@statusClass">@(item.IsEnabled ? "Enabled" : "Disabled")</span>
                            <div class="dropdown">
                                <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">&#8942;</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <button type="button"
                                                class="dropdown-item js-open-environment-modal"
                                                data-mode="edit"
                                                data-id="@item.Id"
                                                data-name="@item.Name"
                                                data-code="@item.Code"
                                                data-description="@item.Description">
                                            Edit
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" asp-page-handler="SetEnabled" class="od-inline-form" data-orchestrator-busy="true" data-busy-title="Updating environment" data-busy-message="Distribution is applying the environment status change.">
                                            <input type="hidden" name="environmentId" value="@item.Id" />
                                            <input type="hidden" name="isEnabled" value="@(item.IsEnabled ? "false" : "true")" />
                                            <button type="submit" class="dropdown-item">@(item.IsEnabled ? "Disable environment" : "Enable environment")</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <p class="od-item-description">@(string.IsNullOrWhiteSpace(item.Description) ? "No description." : item.Description)</p>
                    <div class="od-chip-row">
                        <span class="od-meta-chip">Created: @item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                </article>
            }
        </div>
    </section>
}

<div class="modal fade" id="environmentModal" tabindex="-1" aria-labelledby="environmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Upsert" data-orchestrator-validate="true" data-orchestrator-busy="true" data-busy-title="Saving environment" data-busy-message="Distribution is validating and storing the environment.">
                <div class="modal-header">
                    <h5 class="modal-title" id="environmentModalLabel">Create environment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input asp-for="Input.EnvironmentId" type="hidden" id="environmentIdInput" />
                    <div class="mb-2">
                        <label asp-for="Input.Name" class="form-label"></label>
                        <input asp-for="Input.Name" class="form-control" id="environmentNameInput" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.Code" class="form-label"></label>
                        <input asp-for="Input.Code" class="form-control" id="environmentCodeInput" data-orchestrator-key="true" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.Description" class="form-label"></label>
                        <input asp-for="Input.Description" class="form-control" id="environmentDescriptionInput" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="environmentModalSubmitButton">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const modalElement = document.getElementById('environmentModal');
    const title = document.getElementById('environmentModalLabel');
    const submitButton = document.getElementById('environmentModalSubmitButton');
    const modal = window.bootstrap?.Modal?.getOrCreateInstance(modalElement);
    if (!modalElement || !title || !submitButton || !modal) return;

    const idInput = document.getElementById('environmentIdInput');
    const nameInput = document.getElementById('environmentNameInput');
    const codeInput = document.getElementById('environmentCodeInput');
    const descriptionInput = document.getElementById('environmentDescriptionInput');

    const setValue = (el, value) => { if (el) el.value = value ?? ''; };

    document.querySelectorAll('.js-open-environment-modal').forEach(button => {
        button.addEventListener('click', () => {
            const mode = button.getAttribute('data-mode');
            if (mode === 'edit') {
                title.textContent = 'Edit environment';
                submitButton.textContent = 'Save';
                setValue(idInput, button.getAttribute('data-id'));
                setValue(nameInput, button.getAttribute('data-name'));
                setValue(codeInput, button.getAttribute('data-code'));
                setValue(descriptionInput, button.getAttribute('data-description'));
                modal.show();
                return;
            }

            title.textContent = 'Create environment';
            submitButton.textContent = 'Create';
            setValue(idInput, '');
            setValue(nameInput, '');
            setValue(codeInput, '');
            setValue(descriptionInput, '');
            modal.show();
        });
    });
})();
</script>
}
