@page
@using Zoorce.Web.UI.Abstractions.Data
@using Zoorce.Web.UI.DataGrid
@using Zoorce.Web.UI.Foundation.Components
@using Microsoft.AspNetCore.Html
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Distribution.Areas.OrchestratorDistribution.Pages.Environments.IndexModel
@{
    ViewData["Title"] = "Environments";
}

<div class="od-create-floating">@await Component.InvokeAsync("ZoorceFloatingActionButton", new ZoorceFloatingActionButtonOptions { Id = "createEnvironmentButton", Label = "Create environment", Icon = "+" })</div>

<section class="od-catalog" data-catalog="environments" data-label="environments" data-source="@Url.Page(null, "List")">
    <div class="od-catalog-controls" role="group" aria-label="View mode">
        <button type="button" class="z-button z-button-ghost od-catalog-view-button" data-catalog-view="grid" aria-label="Grid view" title="Grid view" aria-pressed="true"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
        <button type="button" class="z-button z-button-ghost od-catalog-view-button" data-catalog-view="cards" aria-label="Card view" title="Card view" aria-pressed="false"><i class="bi bi-grid-3x2-gap" aria-hidden="true"></i></button>
    </div>
    <div data-catalog-grid>
        @await Component.InvokeAsync("ZoorceDataGrid", new ZoorceDataGridOptions
        {
            Id = "environments-grid", AriaLabel = "environments", Binding = new ZoorceDataBindingOptions { Source = Url.Page(null, "List") },
            LoadMode = ZoorceDataLoadMode.InfiniteScroll, PageSize = 25,
            Columns = [new("displayName", "Name"), new("key", "Code"), new("status", "Status"), new("updated", "Updated"), new("actions", "Actions", false)]
        })
    </div>
    <div data-catalog-cards hidden>
        <div class="od-catalog-filters">
            <label class="z-search-field"><span aria-hidden="true">&#x2315;</span><input type="search" data-catalog-search aria-label="Search environments" placeholder="Search environments" autocomplete="off" /></label>
            <select class="z-form-input z-form-select" data-catalog-sort aria-label="Sort environments">
                <option value="displayName">Name: A to Z</option><option value="displayName:desc">Name: Z to A</option>
                <option value="key">Code</option><option value="status">Status</option><option value="updated:desc">Recently updated</option>
            </select>
        </div>
        <div class="od-grid" data-catalog-card-items></div>
        <p class="od-empty" data-catalog-empty hidden>No matching environments.</p>
        <p data-catalog-status aria-live="polite"></p>
        <div data-catalog-sentinel aria-hidden="true"></div>
        <button type="button" class="z-button z-button-ghost" data-catalog-more hidden>Load more</button>
    </div>
</section>

@await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions
{
    Id = "environmentModal",
    Title = "Create environment",
    Eyebrow = null,
    Body = await Html.PartialAsync("_EnvironmentForm", Model),
    Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Cancel</button><button type=\"submit\" form=\"environmentForm\" class=\"z-button z-button-primary\" id=\"environmentSubmitButton\">Create</button>")
})

@section Scripts {
<script src="/_content/Krackend.Sagas.Orchestrations.ControlPlane.WebUI/js/orchestrator-catalog.js" asp-append-version="true"></script>
<script>
(() => {
    const modalElement = document.getElementById('environmentModal');

    const setValue = (id, value) => {
        const element = document.getElementById(id);
        if (element) element.value = value || '';
    };

    const setChecked = (id, value) => {
        const element = document.getElementById(id);
        if (element) element.checked = value === 'True' || value === 'true';
    };

    document.getElementById('createEnvironmentButton')?.addEventListener('click', event => {
        document.getElementById('environmentModal-title').textContent = 'Create environment';
        document.getElementById('environmentSubmitButton').textContent = 'Create';
        setValue('environmentIdInput', '');
        setValue('environmentNameInput', '');
        setValue('environmentCodeInput', '');
        setValue('environmentDescriptionInput', '');
        setChecked('environmentEnabledInput', 'true');
        modalElement?.open?.(event.currentTarget);
    });

    document.addEventListener('click', event => {
            const button = event.target.closest('.js-edit-environment');
            if (!button) return;
            const environment = button.closest('[data-environment]');
            if (!environment || !modalElement) return;

            document.getElementById('environmentModal-title').textContent = 'Edit environment';
            document.getElementById('environmentSubmitButton').textContent = 'Save';
            setValue('environmentIdInput', environment.dataset.id);
            setValue('environmentNameInput', environment.dataset.name);
            setValue('environmentCodeInput', environment.dataset.code);
            setValue('environmentDescriptionInput', environment.dataset.description);
            setChecked('environmentEnabledInput', environment.dataset.isEnabled);
            modalElement.open?.(button);
    });
})();
</script>
}
