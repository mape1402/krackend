@page
@using Zoorce.Web.UI.Abstractions.Data
@using Zoorce.Web.UI.DataGrid
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Distribution.Areas.OrchestratorDistribution.Pages.Environments.IndexModel
@{
    ViewData["Title"] = "Environments";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Environments</h1>
        <p class="od-page-subtitle">Logical deployment groups for runtime nodes.</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#environmentModal">Create environment</button>
</div>

<section class="od-catalog" data-catalog="environments" data-label="environments" data-source="@Url.Page(null, "List")">
    <div class="od-catalog-controls" role="group" aria-label="View mode">
        <button type="button" class="btn btn-outline-secondary" data-catalog-view="grid" aria-label="Grid view" title="Grid view" aria-pressed="true"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
        <button type="button" class="btn btn-outline-secondary" data-catalog-view="cards" aria-label="Card view" title="Card view" aria-pressed="false"><i class="bi bi-grid-3x2-gap" aria-hidden="true"></i></button>
    </div>
    <div data-catalog-grid>
        @await Component.InvokeAsync("ZoorceDataGrid", new ZoorceDataGridOptions
        {
            Id = "environments-grid", AriaLabel = "environments", Binding = new ZoorceDataBindingOptions { Source = Url.Page(null, "List") },
            LoadMode = ZoorceDataLoadMode.InfiniteScroll, PageSize = 25,
            Columns = [new("displayName", "Name"), new("key", "Code"), new("status", "Status"), new("updated", "Updated"), new("actions", "Actions", false)]
        })
    </div>
    <div data-catalog-cards hidden>
        <div class="od-catalog-filters">
            <label class="z-search-field"><span aria-hidden="true">&#x2315;</span><input type="search" data-catalog-search aria-label="Search environments" placeholder="Search environments" autocomplete="off" /></label>
            <select class="form-select" data-catalog-sort aria-label="Sort environments">
                <option value="displayName">Name: A to Z</option><option value="displayName:desc">Name: Z to A</option>
                <option value="key">Code</option><option value="status">Status</option><option value="updated:desc">Recently updated</option>
            </select>
        </div>
        <div class="od-grid" data-catalog-card-items></div>
        <p class="od-empty" data-catalog-empty hidden>No matching environments.</p>
        <p data-catalog-status aria-live="polite"></p>
        <div data-catalog-sentinel aria-hidden="true"></div>
        <button type="button" class="btn btn-outline-secondary" data-catalog-more hidden>Load more</button>
    </div>
</section>

<div class="modal fade" id="environmentModal" tabindex="-1" aria-labelledby="environmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Upsert" data-orchestrator-validate="true" data-orchestrator-busy="true" data-busy-title="Saving environment" data-busy-message="Control Plane is storing the environment.">
                <div class="modal-header">
                    <h5 class="modal-title" id="environmentModalLabel">Create environment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input asp-for="Input.EnvironmentId" type="hidden" id="environmentIdInput" />
                    <div class="mb-3">
                        <label asp-for="Input.Name" class="form-label"></label>
                        <input asp-for="Input.Name" class="form-control" id="environmentNameInput" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Code" class="form-label"></label>
                        <input asp-for="Input.Code" class="form-control" id="environmentCodeInput" data-orchestrator-key="true" />
                        <span asp-validation-for="Input.Code" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Description" class="form-label"></label>
                        <textarea asp-for="Input.Description" class="form-control" id="environmentDescriptionInput" rows="3"></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger"></span>
                    </div>
                    <div class="form-check">
                        <input asp-for="Input.IsEnabled" class="form-check-input" id="environmentEnabledInput" />
                        <label asp-for="Input.IsEnabled" class="form-check-label">Enabled</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="environmentSubmitButton">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="/_content/Krackend.Sagas.Orchestrations.ControlPlane.WebUI/js/orchestrator-catalog.js" asp-append-version="true"></script>
<script>
(() => {
    const modalElement = document.getElementById('environmentModal');
    const modal = window.bootstrap?.Modal?.getOrCreateInstance(modalElement);

    const setValue = (id, value) => {
        const element = document.getElementById(id);
        if (element) element.value = value || '';
    };

    const setChecked = (id, value) => {
        const element = document.getElementById(id);
        if (element) element.checked = value === 'True' || value === 'true';
    };

    document.querySelector('[data-bs-target="#environmentModal"]')?.addEventListener('click', () => {
        document.getElementById('environmentModalLabel').textContent = 'Create environment';
        document.getElementById('environmentSubmitButton').textContent = 'Create';
        setValue('environmentIdInput', '');
        setValue('environmentNameInput', '');
        setValue('environmentCodeInput', '');
        setValue('environmentDescriptionInput', '');
        setChecked('environmentEnabledInput', 'true');
    });

    document.addEventListener('click', event => {
            const button = event.target.closest('.js-edit-environment');
            if (!button) return;
            const environment = button.closest('[data-environment]');
            if (!environment || !modal) return;

            document.getElementById('environmentModalLabel').textContent = 'Edit environment';
            document.getElementById('environmentSubmitButton').textContent = 'Save';
            setValue('environmentIdInput', environment.dataset.id);
            setValue('environmentNameInput', environment.dataset.name);
            setValue('environmentCodeInput', environment.dataset.code);
            setValue('environmentDescriptionInput', environment.dataset.description);
            setChecked('environmentEnabledInput', environment.dataset.isEnabled);
            modal.show();
    });
})();
</script>
}
