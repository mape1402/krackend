@page
@using Krackend.Sagas.Orchestrations.ControlPlane.Application.Distribution
@using Zoorce.Web.UI.Abstractions.Data
@using Zoorce.Web.UI.DataGrid
@using Zoorce.Web.UI.Foundation.Components
@using Microsoft.AspNetCore.Html
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Distribution.Areas.OrchestratorDistribution.Pages.RuntimeNodes.IndexModel
@{
    ViewData["Title"] = "Runtime Nodes";
}

<div class="od-create-floating js-open-runtime-node-setup" data-mode="create">@await Component.InvokeAsync("ZoorceFloatingActionButton", new ZoorceFloatingActionButtonOptions { Id = "createRuntimeNodeButton", Label = "Create runtime node", Icon = "+" })</div>

<form method="post" asp-page-handler="SetStatus" id="runtime-node-status-form" data-orchestrator-busy="true" hidden><input type="hidden" name="runtimeNodeId" /><input type="hidden" name="status" /></form>
<form method="post" asp-page-handler="ValidateConnection" id="runtime-node-check-form" data-orchestrator-busy="true" hidden><input type="hidden" name="runtimeNodeId" /></form>
<form method="post" asp-page-handler="Delete" id="runtime-node-delete-form" data-confirm="true" data-confirm-title="Delete runtime node" data-confirm-message="Delete this runtime node from active configuration? Existing release references will be preserved." data-confirm-accept="Delete" data-confirm-type="warning" data-orchestrator-busy="true" hidden><input type="hidden" name="runtimeNodeId" /></form>
<section class="od-catalog" data-catalog="runtime-nodes" data-label="runtime nodes" data-source="@Url.Page(null, "List")">
    <div class="od-catalog-controls" role="group" aria-label="View mode">
        <button type="button" class="btn btn-outline-secondary" data-catalog-view="grid" aria-label="Grid view" title="Grid view" aria-pressed="true"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
        <button type="button" class="btn btn-outline-secondary" data-catalog-view="cards" aria-label="Card view" title="Card view" aria-pressed="false"><i class="bi bi-grid-3x2-gap" aria-hidden="true"></i></button>
    </div>
    <div data-catalog-grid>
        @await Component.InvokeAsync("ZoorceDataGrid", new ZoorceDataGridOptions
        {
            Id = "runtime-nodes-grid", AriaLabel = "runtime nodes", Binding = new ZoorceDataBindingOptions { Source = Url.Page(null, "List") },
            LoadMode = ZoorceDataLoadMode.InfiniteScroll, PageSize = 25,
            Columns = [new("displayName", "Name"), new("key", "Code"), new("environment", "Environment"), new("status", "Status"), new("credentials", "Credentials", false), new("endpoint", "Endpoint", false), new("actions", "Actions", false)]
        })
    </div>
    <div data-catalog-cards hidden>
        <div class="od-catalog-filters">
            <label class="z-search-field"><span aria-hidden="true">&#x2315;</span><input type="search" data-catalog-search aria-label="Search runtime nodes" placeholder="Search runtime nodes" autocomplete="off" /></label>
            <select class="z-form-input z-form-select" data-catalog-sort aria-label="Sort runtime nodes">
                <option value="displayName">Name: A to Z</option><option value="displayName:desc">Name: Z to A</option>
                <option value="key">Code</option><option value="environment">Environment</option><option value="status">Status</option>
            </select>
        </div>
        <div class="od-grid" data-catalog-card-items></div>
        <p class="od-empty" data-catalog-empty hidden>No matching runtime nodes.</p>
        <p data-catalog-status aria-live="polite"></p><div data-catalog-sentinel aria-hidden="true"></div>
        <button type="button" class="btn btn-outline-secondary" data-catalog-more hidden>Load more</button>
    </div>
</section>

@await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions {
    Id = "runtimeNodeModal", Title = "Create runtime node", Eyebrow = null, Size = "wide",
    Body = await Html.PartialAsync("_RuntimeNodeBasic", Model),
    Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Cancel</button><button type=\"submit\" form=\"runtimeNodeBasicForm\" class=\"z-button z-button-primary\" id=\"runtimeNodeModalSubmitButton\">Create</button>")
})

@await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions {
    Id = "runtimeNodeViewModal", Title = "Runtime node", Eyebrow = null, Size = "full",
    Body = await Html.PartialAsync("_RuntimeNodeView", Model),
    Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-primary js-open-runtime-node-setup\">Configure</button><button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Close</button>")
})
@await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions {
    Id = "runtimeNodeSetupModal", Title = "Configure runtime node", Eyebrow = null, Size = "full",
    Body = await Html.PartialAsync("_RuntimeNodeSetup", Model),
    Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" id=\"setupBackButton\">Back</button><button type=\"button\" class=\"z-button z-button-primary\" id=\"setupNextButton\">Next</button><button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Close</button>")
})
@await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions {
    Id = "runtimeNodeCredentialModal", Title = "Import Runtime credentials", Eyebrow = null, Size = "wide",
    Body = await Html.PartialAsync("_RuntimeNodeCredentials", Model),
    Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Cancel</button><button type=\"submit\" form=\"runtimeNodeCredentialForm\" class=\"z-button z-button-primary\" id=\"runtimeNodeCredentialSubmitButton\">Import and continue</button>")
})
@await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions {
    Id = "generatedCredentialsModal", Title = "Generated credentials", Eyebrow = null, Size = "wide",
    Body = await Html.PartialAsync("_GeneratedCredentials", Model),
    Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" id=\"copyGeneratedCredentialsButton\">Copy</button><button type=\"button\" class=\"z-button z-button-primary\" data-z-dialog-close>Done</button>")
})


@section Scripts {
<script src="/_content/Krackend.Sagas.Orchestrations.ControlPlane.WebUI/js/orchestrator-catalog.js" asp-append-version="true"></script>
<script>
(() => {
    const basicModalElement = document.getElementById('runtimeNodeModal');
    const basicModal = basicModalElement;
    const viewModalElement = document.getElementById('runtimeNodeViewModal');
    const viewModal = viewModalElement;
    const setupModalElement = document.getElementById('runtimeNodeSetupModal');
    const setupModal = setupModalElement;
    const credentialsModalElement = document.getElementById('runtimeNodeCredentialModal');
    const credentialsModal = credentialsModalElement;
    const generatedCredentialsModalElement = document.getElementById('generatedCredentialsModal');
    const generatedCredentialsModal = generatedCredentialsModalElement;
    const hasGeneratedCredentials = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(!string.IsNullOrWhiteSpace(Model.GeneratedCredentialsJson)));

    const setValue = (id, value) => {
        const element = document.getElementById(id);
        if (element) element.value = value || '';
    };

    const setText = (id, value) => {
        const element = document.getElementById(id);
        if (element) element.textContent = value || '-';
    };

    const readNode = trigger => trigger?.closest?.('[data-runtime-node]') || null;
    let currentNode = null;
    let setupSequence = ['basic', 'policy', 'runtimeCredentials', 'designCredentials', 'verify'];
    let setupStep = 'basic';

    const sequences = {
        DesignPublishesToRuntime: ['basic', 'policy', 'runtimeCredentials'],
        RuntimeFetchesFromDesign: ['basic', 'policy', 'designCredentials'],
        HybridSync: ['basic', 'policy', 'runtimeCredentials', 'designCredentials']
    };

    setupModalElement?.addEventListener('zoorce:dialog:close', () => {
        if (currentNode && !currentNode.isConnected) {
            window.location.reload();
        }
    });

    const notify = ({ title, message, type }) => window.OrchestratorMessages?.notify({
        title,
        message,
        type
    });

    const showBusy = ({ title, message }) => window.OrchestratorMessages?.showBusy({
        title,
        message
    }) || (() => {});

    const postWizardForm = async (form, busyTitle, busyMessage) => {
        if (!form) throw new Error('Wizard form was not found.');

        const hideBusy = showBusy({ title: busyTitle, message: busyMessage });
        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: new FormData(form),
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            const responseText = await response.text();
            let payload = {};
            if (responseText) {
                try {
                    payload = JSON.parse(responseText);
                } catch {
                    payload = { message: responseText };
                }
            }

            if (!response.ok) {
                throw new Error(payload.message || 'The wizard operation failed.');
            }

            return payload;
        } finally {
            hideBusy();
        }
    };

    const showWizardError = error => notify({
        title: 'Review the configuration',
        message: error?.message || 'The wizard operation failed.',
        type: 'error'
    });

    const canCheckConnectionFor = (status, mode) =>
        status === 'Enabled' && (mode === 'DesignPublishesToRuntime' || mode === 'HybridSync');

    const environmentPicker = (searchId, selectId, moreId, statusId) => {
        const search = document.getElementById(searchId);
        const select = document.getElementById(selectId);
        const more = document.getElementById(moreId);
        const status = document.getElementById(statusId);
        let page = 0, request = null, timer = 0;
        const load = async reset => {
            if (reset) {
                request?.abort();
                page = 0;
                const selected = select.selectedOptions[0];
                select.replaceChildren(new Option('Select environment', ''));
                if (selected?.value) select.add(selected);
            }
            const controller = new AbortController();
            request = controller;
            status.textContent = 'Loading environments...';
            try {
                const url = new URL(search.dataset.source, location.href);
                url.searchParams.set('page', String(page + 1));
                url.searchParams.set('search', search.value.trim());
                const response = await fetch(url, { signal: controller.signal });
                if (!response.ok) throw new Error('Environments could not be loaded.');
                const result = await response.json();
                if (request !== controller) return;
                result.items.forEach(item => {
                    if (![...select.options].some(option => option.value === item.id))
                        select.add(new Option(`${item.name} (${item.code})`, item.id));
                });
                page++;
                more.hidden = !result.hasMore;
                status.textContent = result.items.length ? '' : 'No matching environments.';
            } catch (error) {
                if (error.name !== 'AbortError') status.textContent = 'Environments could not be loaded. Try again.';
            } finally {
                if (request === controller) request = null;
            }
        };
        search.addEventListener('input', () => {
            clearTimeout(timer);
            timer = setTimeout(() => load(true), 250);
        });
        more.addEventListener('click', () => { if (!request) load(false); });
        return node => {
            select.replaceChildren(new Option('Select environment', ''));
            if (node?.dataset.environmentId)
                select.add(new Option(`${node.dataset.environmentName} (${node.dataset.environmentCode})`, node.dataset.environmentId, true, true));
            search.value = '';
            load(true);
        };
    };
    const loadBasicEnvironments = environmentPicker('environmentSearchInput', 'environmentIdInput', 'environmentMoreButton', 'environmentSearchStatus');
    const loadSetupEnvironments = environmentPicker('setupEnvironmentSearch', 'setupBasicEnvironmentId', 'setupEnvironmentMore', 'setupEnvironmentStatus');

    const updateCardChrome = () => {
        if (!currentNode) return;

        const title = currentNode.querySelector('.od-item-title');
        const meta = currentNode.querySelector('.od-item-top .od-item-meta');
        const description = currentNode.querySelector('.od-item-description');
        const statusBadge = currentNode.querySelector('.od-item-top .od-status');
        if (title) title.textContent = currentNode.dataset.name || '-';
        if (meta) meta.textContent = `${currentNode.dataset.code || '-'} | ${currentNode.dataset.environmentName || '-'}`;
        if (description) description.textContent = currentNode.dataset.description || 'No description.';
        if (statusBadge) {
            statusBadge.textContent = currentNode.dataset.statusLabel || currentNode.dataset.status || '-';
            statusBadge.classList.remove(...statusClassNames);
            statusBadge.classList.add(getStatusClass(currentNode.dataset.status));
        }

        const summaryValues = currentNode.querySelectorAll('.od-runtime-card-summary strong');
        if (summaryValues[0]) summaryValues[0].textContent = currentNode.dataset.environmentName || '-';
        if (summaryValues[1]) summaryValues[1].textContent = currentNode.dataset.distributionModeLabel || '-';

        const checkConnectionAction = currentNode.querySelector('[data-check-connection-action]');
        if (checkConnectionAction) {
            checkConnectionAction.classList.toggle(
                'd-none',
                !canCheckConnectionFor(currentNode.dataset.status, currentNode.dataset.distributionMode));
        }
    };

    const updateCurrentNode = node => {
        if (!node) return;
        if (!currentNode) {
            currentNode = document.createElement('article');
            currentNode.dataset.runtimeNode = 'true';
        }

        Object.entries(node).forEach(([key, value]) => {
            currentNode.dataset[key] = value ?? '';
        });

        updateCardChrome();
        fillReadOnlyFields(currentNode);
        fillSetupFields(currentNode);
        document.dispatchEvent(new CustomEvent('krackend:runtime-node-updated'));
    };

    const getSelectedMode = () =>
        document.querySelector('#runtimeNodeSetupModal input[name="Input.DistributionMode"]:checked')?.value ||
        currentNode?.dataset.distributionMode ||
        'HybridSync';

    const hasActiveCredentials = status => (status || '').toLowerCase() === 'active';
    const isDesignPullMode = mode => mode === 'RuntimeFetchesFromDesign' || mode === 'HybridSync';
    const isDesignPushMode = mode => mode === 'DesignPublishesToRuntime' || mode === 'HybridSync';
    const statusClassNames = ['od-status-active', 'od-status-inactive', 'od-status-inreview'];
    const getStatusClass = status => {
        switch (status) {
            case 'Enabled':
                return 'od-status-active';
            case 'Pending':
                return 'od-status-inreview';
            case 'Suspend':
                return 'od-status-inactive';
            default:
                return 'od-status-inactive';
        }
    };
    const isCurrentNodeConfigured = () => {
        const mode = getSelectedMode();
        const needsDesignCredentials = isDesignPullMode(mode);
        const needsRuntimeCredentials = isDesignPushMode(mode);
        const hasDesignCredentials = hasActiveCredentials(currentNode?.dataset.inboundCredentialStatus);
        const hasRuntimeCredentials = hasActiveCredentials(currentNode?.dataset.outboundCredentialStatus);
        const hasEndpoint = !!(currentNode?.dataset.endpointBaseUri || '').trim();

        return (!needsDesignCredentials || hasDesignCredentials) &&
            (!needsRuntimeCredentials || (hasRuntimeCredentials && hasEndpoint));
    };
    const applyCredentialVisibility = node => {
        const mode = node?.dataset.distributionMode || 'HybridSync';
        const showDesignCredentials = isDesignPullMode(mode);
        const showRuntimeCredentials = isDesignPushMode(mode);
        const credentialsSection = viewModalElement?.querySelector('.od-credential-columns');
        const designPanel = viewModalElement?.querySelector('[data-credential-section="design"]');
        const runtimePanel = viewModalElement?.querySelector('[data-credential-section="runtime"]');

        designPanel?.classList.toggle('d-none', !showDesignCredentials);
        runtimePanel?.classList.toggle('d-none', !showRuntimeCredentials);
        credentialsSection?.classList.toggle('is-single', showDesignCredentials !== showRuntimeCredentials);
    };

    const populateBasicModal = (node, mode) => {
        if (!basicModal) return;

        document.getElementById('runtimeNodeModal-title').textContent = mode === 'edit' ? 'Edit data' : 'Create runtime node';
        document.getElementById('runtimeNodeModalSubmitButton').textContent = mode === 'edit' ? 'Save' : 'Create';

        setValue('runtimeNodeIdInput', mode === 'edit' ? node?.dataset.id : '');
        setValue('nameInput', mode === 'edit' ? node?.dataset.name : '');
        setValue('codeInput', mode === 'edit' ? node?.dataset.code : '');
        loadBasicEnvironments(mode === 'edit' ? node : null);
        setValue('distributionModeInput', mode === 'edit' ? node?.dataset.distributionMode : 'HybridSync');
        setValue('endpointBaseUriInput', mode === 'edit' ? node?.dataset.endpointBaseUri : '');
        setValue('descriptionInput', mode === 'edit' ? node?.dataset.description : '');

        basicModal.open?.();
    };

    const fillReadOnlyFields = node => {
        setText('viewName', node.dataset.name);
        setText('viewCode', node.dataset.code);
        setText('viewEnvironment', node.dataset.environmentName);
        setText('viewStatus', node.dataset.statusLabel || node.dataset.status);
        setText('viewRegisteredAt', node.dataset.registeredAt);
        setText('viewLastUpdatedAt', node.dataset.lastUpdatedAt);
        setText('viewDescription', node.dataset.description);

        setText('viewDistributionModeLabel', node.dataset.distributionModeLabel);
        setText('viewEndpointBaseUri', node.dataset.endpointBaseUri);
        setText('viewEndpointApiPath', node.dataset.endpointApiPath);
        setText('viewAccessTokenTtl', node.dataset.accessTokenTtlSeconds ? `${node.dataset.accessTokenTtlSeconds}s` : '-');
        setText('viewTokenValidationCacheTtl', node.dataset.tokenValidationCacheTtlSeconds ? `${node.dataset.tokenValidationCacheTtlSeconds}s` : '-');

        setText('viewInboundCredentialStatus', node.dataset.inboundCredentialStatusLabel);
        setText('viewInboundClientId', node.dataset.inboundClientId);
        setText('viewInboundKeyId', node.dataset.inboundKeyId);
        setText('viewInboundAllowedScopes', node.dataset.inboundAllowedScopes);
        setText('viewInboundCredentialCreatedAt', node.dataset.inboundCredentialCreatedAt);
        setText('viewInboundLastTokenIssuedAt', node.dataset.inboundLastTokenIssuedAt);

        setText('viewOutboundCredentialStatus', node.dataset.outboundCredentialStatusLabel);
        setText('viewOutboundClientId', node.dataset.outboundClientId);
        setText('viewOutboundKeyId', node.dataset.outboundKeyId);
        setText('viewOutboundRequestedScopes', node.dataset.outboundRequestedScopes);
        setText('viewOutboundCredentialImportedAt', node.dataset.outboundCredentialImportedAt);
        setText('viewOutboundLastTokenReceivedAt', node.dataset.outboundLastTokenReceivedAt);
        applyCredentialVisibility(node);

    };

    const fillSetupFields = node => {
        const isNew = !node;
        const mode = node?.dataset.distributionMode || 'HybridSync';
        setText('runtimeNodeSetupModal-title', isNew ? 'Create runtime node' : 'Configure runtime node');
        setText('runtimeNodeSetupSubtitle', isNew ? 'New Design-side Runtime node' : `${node.dataset.name || '-'} | ${node.dataset.environmentName || '-'} | ${node.dataset.code || '-'}`);

        setValue('setupBasicRuntimeNodeId', node?.dataset.id);
        setValue('setupBasicName', node?.dataset.name);
        setValue('setupBasicCode', node?.dataset.code);
        loadSetupEnvironments(node);
        setValue('setupBasicDescription', node?.dataset.description);
        setValue('setupBasicDistributionMode', mode);
        setValue('setupBasicEndpointBaseUri', node?.dataset.endpointBaseUri);

        setValue('setupPolicyRuntimeNodeId', node?.dataset.id);
        setValue('setupPolicyName', node?.dataset.name);
        setValue('setupPolicyCode', node?.dataset.code);
        setValue('setupPolicyEnvironmentId', node?.dataset.environmentId);
        setValue('setupPolicyDescription', node?.dataset.description);
        setValue('setupPolicyEndpointBaseUri', node?.dataset.endpointBaseUri);
        setValue('setupGenerateRuntimeNodeId', node?.dataset.id);
        setValue('setupValidateRuntimeNodeId', node?.dataset.id);
        setValue('setupStatusRuntimeNodeId', node?.dataset.id);
        setValue('setupStatusValue', 'Enabled');

        document.querySelectorAll('#runtimeNodeSetupModal input[name="Input.DistributionMode"]').forEach(input => {
            input.checked = input.value === mode;
        });

        setText('setupOutboundCredentialStatus', node?.dataset.outboundCredentialStatusLabel);
        setText('setupEndpointBaseUri', node?.dataset.endpointBaseUri);
        setText('setupOutboundClientId', node?.dataset.outboundClientId);
        setText('setupOutboundKeyId', node?.dataset.outboundKeyId);
        setText('setupOutboundRequestedScopes', node?.dataset.outboundRequestedScopes);
        setText('setupOutboundCredentialImportedAt', node?.dataset.outboundCredentialImportedAt);

        setText('setupInboundCredentialStatus', node?.dataset.inboundCredentialStatusLabel);
        setText('setupInboundClientId', node?.dataset.inboundClientId);
        setText('setupInboundKeyId', node?.dataset.inboundKeyId);
        setText('setupInboundAllowedScopes', node?.dataset.inboundAllowedScopes);
        setText('setupInboundCredentialCreatedAt', node?.dataset.inboundCredentialCreatedAt);
        setText('setupInboundLastTokenIssuedAt', node?.dataset.inboundLastTokenIssuedAt);

        applySetupPolicy(mode);
    };

    const populateViewModal = node => {
        if (!viewModal || !node) return;
        currentNode = node;
        setText('runtimeNodeViewModal-title', node.dataset.name);
        setText('runtimeNodeViewSubtitle', `${node.dataset.environmentName || '-'} | ${node.dataset.code || '-'} | ${node.dataset.distributionModeLabel || '-'}`);
        fillReadOnlyFields(node);
        viewModal.open?.();
    };

    const populateSetupModal = node => {
        if (!setupModal) return;
        currentNode = node || null;
        fillSetupFields(node);
        showSetupStep('basic');
        setupModal.open?.();
    };

    const applySetupPolicy = mode => {
        setValue('setupBasicDistributionMode', mode || 'HybridSync');
        const canVerifyConnection = canCheckConnectionFor(currentNode?.dataset.status, mode);
        setupSequence = [...(sequences[mode] || sequences.HybridSync)];
        if (canVerifyConnection) {
            setupSequence.push('verify');
        }

        if (!setupSequence.includes(setupStep)) {
            setupStep = 'basic';
        }

        document.querySelectorAll('[data-setup-step-target]').forEach(button => {
            const target = button.dataset.setupStepTarget;
            const hasSavedNode = !!currentNode?.dataset.id;
            const enabled = setupSequence.includes(target) && (target === 'basic' || hasSavedNode);
            button.disabled = !enabled;
            button.classList.toggle('is-disabled', !enabled);
        });

        const validateButton = document.querySelector('.js-setup-validate-connection');
        if (validateButton) {
            validateButton.disabled = !canVerifyConnection;
        }

        showSetupStep(setupStep);
    };

    const showSetupStep = step => {
        if (!setupSequence.includes(step)) {
            step = setupSequence[0];
        }

        setupStep = step;
        document.querySelectorAll('[data-setup-step-target]').forEach(button => {
            const active = button.dataset.setupStepTarget === setupStep;
            button.classList.toggle('is-active', active);
            if (active) button.setAttribute('aria-current', 'step');
            else button.removeAttribute('aria-current');
            if (active && window.matchMedia('(max-width: 991px)').matches) {
                button.scrollIntoView({ block: 'nearest', inline: 'nearest' });
            }
        });
        document.querySelectorAll('[data-setup-step]').forEach(panel => {
            panel.classList.toggle('is-active', panel.dataset.setupStep === setupStep);
        });

        const index = setupSequence.indexOf(setupStep);
        const backButton = document.getElementById('setupBackButton');
        const nextButton = document.getElementById('setupNextButton');
        if (backButton) backButton.disabled = index <= 0;
        if (nextButton) {
            nextButton.disabled = false;
            nextButton.textContent = 'Next';
        }
    };

    const moveSetup = direction => {
        const index = setupSequence.indexOf(setupStep);
        const next = setupSequence[index + direction];
        if (!next) return false;

        showSetupStep(next);
        return true;
    };

    const enablePendingNodeIfReady = async () => {
        if (currentNode?.dataset.status !== 'Pending') return;

        if (!isCurrentNodeConfigured()) {
            throw new Error('Complete the required credentials before enabling the runtime node.');
        }

        const payload = await postWizardForm(
            document.getElementById('setupStatusForm'),
            'Enabling runtime node',
            'Distribution is validating the completed configuration.');
        updateCurrentNode(payload.node);
    };

    const completeSetup = async () => {
        await enablePendingNodeIfReady();
        setupModal?.close?.();
        if (currentNode && !currentNode.isConnected) {
            window.location.reload();
        }
    };

    const moveNextOrClose = async () => {
        if (!moveSetup(1)) {
            await completeSetup();
        }
    };

    const openRuntimeCredentialsModal = () => {
        if (!currentNode || !credentialsModal) return;
        setValue('credentialRuntimeNodeIdInput', currentNode.dataset.id);
        setValue('credentialsJsonInput', '');
        setText('runtimeNodeCredentialModal-title', `Import Runtime credentials - ${currentNode.dataset.name || 'Runtime node'}`);
        credentialsModal.open?.();
        window.setTimeout(() => document.getElementById('credentialsJsonInput')?.focus(), 160);
    };

    const handleBasicNext = async () => {
        if (!window.OrchestratorMessages.validateForm(document.getElementById('setupBasicForm'))) return;
        const payload = await postWizardForm(
            document.getElementById('setupBasicForm'),
            'Saving basic data',
            'Design is saving the Runtime node identity.');
        updateCurrentNode(payload.node);
        applySetupPolicy(getSelectedMode());
        await moveNextOrClose();
    };

    const handlePolicyNext = async () => {
        if (!currentNode?.dataset.id) {
            throw new Error('Save the basic data before selecting a distribution policy.');
        }

        const payload = await postWizardForm(
            document.getElementById('setupPolicyForm'),
            'Saving policy',
            'Design is saving the selected runtime node policy.');
        updateCurrentNode(payload.node);
        applySetupPolicy(getSelectedMode());
        await moveNextOrClose();
    };

    const handleRuntimeCredentialsNext = async () => {
        if (hasActiveCredentials(currentNode?.dataset.outboundCredentialStatus)) {
            await moveNextOrClose();
            return;
        }

        throw new Error('Import the Runtime credentials before continuing.');
    };

    const handleDesignCredentialsNext = async () => {
        if (hasActiveCredentials(currentNode?.dataset.inboundCredentialStatus)) {
            await moveNextOrClose();
            return;
        }

        throw new Error('Generate the Design credentials before continuing.');
    };

    const generateDesignCredentials = async () => {
        const payload = await postWizardForm(
            document.getElementById('setupGenerateCredentialsForm'),
            'Generating credentials',
            'Design is generating credentials for Runtime.');
        updateCurrentNode(payload.node);
        setText('generatedCredentialsNodeName', currentNode?.dataset.name || 'Runtime node');
        setValue('generatedCredentialsJsonOutput', payload.credentialsJson);
        generatedCredentialsModal?.open?.();
    };

    const handleVerifyNext = async () => {
        await completeSetup();
    };

    const validateConnection = async () => {
        if (!canCheckConnectionFor(currentNode?.dataset.status, getSelectedMode())) {
            throw new Error('Connection check is available only for enabled Push or Hybrid runtime nodes.');
        }

        const payload = await postWizardForm(
            document.getElementById('setupValidateConnectionForm'),
            'Checking connection',
            'Design is requesting a token from Runtime and checking the secured endpoint.');
        updateCurrentNode(payload.node);
        await notify({
            title: payload.succeeded ? 'Connection check succeeded' : 'Connection check failed',
            message: payload.message || '-',
            type: payload.succeeded ? 'success' : 'error'
        });
    };

    const copyGeneratedCredentials = async () => {
        const output = document.getElementById('generatedCredentialsJsonOutput');
        const button = document.getElementById('copyGeneratedCredentialsButton');
        const text = output?.value || '';
        if (!text) return;

        if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(text);
        } else {
            output.select();
            document.execCommand('copy');
            output.setSelectionRange(0, 0);
        }

        if (!button) return;
        const previousText = button.textContent;
        button.textContent = 'Copied';
        window.setTimeout(() => {
            button.textContent = previousText;
        }, 1200);
    };

    const handleNext = async () => {
        try {
            switch (setupStep) {
                case 'basic':
                    await handleBasicNext();
                    break;
                case 'policy':
                    await handlePolicyNext();
                    break;
                case 'runtimeCredentials':
                    await handleRuntimeCredentialsNext();
                    break;
                case 'designCredentials':
                    await handleDesignCredentialsNext();
                    break;
                case 'verify':
                    await handleVerifyNext();
                    break;
            }
        } catch (error) {
            await showWizardError(error);
        }
    };

    document.addEventListener('click', event => {
        const view = event.target.closest('.js-open-runtime-node-view');
        const setup = event.target.closest('.js-open-runtime-node-setup-card');
        if (view) populateViewModal(readNode(view));
        if (setup) populateSetupModal(readNode(setup));
    });

    document.querySelectorAll('.js-open-runtime-node-setup').forEach(button => {
        button.addEventListener('click', () => {
            const node = button.dataset.mode === 'create' ? null : (readNode(button) || currentNode);
            if (button.dataset.mode !== 'create' && !node) return;
            viewModal?.close?.();
            populateSetupModal(node);
        });
    });

    document.querySelectorAll('[data-setup-step-target]').forEach(button => {
        button.addEventListener('click', () => {
            if (!button.disabled) showSetupStep(button.dataset.setupStepTarget);
        });
    });

    document.querySelectorAll('#runtimeNodeSetupModal input[name="Input.DistributionMode"]').forEach(input => {
        input.addEventListener('change', event => applySetupPolicy(event.target.value));
    });

    document.getElementById('setupBackButton')?.addEventListener('click', () => moveSetup(-1));
    document.getElementById('setupNextButton')?.addEventListener('click', handleNext);

    document.querySelector('.js-setup-import-credentials')?.addEventListener('click', openRuntimeCredentialsModal);

    document.querySelector('.js-setup-generate-credentials')?.addEventListener('click', async () => {
        try {
            await generateDesignCredentials();
        } catch (error) {
            await showWizardError(error);
        }
    });

    document.querySelector('.js-setup-validate-connection')?.addEventListener('click', async () => {
        try {
            await validateConnection();
        } catch (error) {
            await showWizardError(error);
        }
    });

    document.getElementById('copyGeneratedCredentialsButton')?.addEventListener('click', async () => {
        try {
            await copyGeneratedCredentials();
        } catch (error) {
            await showWizardError(error);
        }
    });

    document.querySelector('.js-view-edit-basic')?.addEventListener('click', () => {
        viewModal?.close?.();
        populateBasicModal(currentNode, 'edit');
    });

    document.getElementById('runtimeNodeCredentialForm')?.addEventListener('submit', async event => {
        event.preventDefault();
        event.stopPropagation();

        try {
            if (!window.OrchestratorMessages.validateForm(event.currentTarget)) return;
            const payload = await postWizardForm(
                event.currentTarget,
                'Importing credentials',
                'Design is protecting the Runtime credentials.');
            updateCurrentNode(payload.node);
            credentialsModal?.close?.();
        } catch (error) {
            await showWizardError(error);
        }
    });

    if (hasGeneratedCredentials) {
        generatedCredentialsModal?.open?.();
    }
})();
</script>
}
