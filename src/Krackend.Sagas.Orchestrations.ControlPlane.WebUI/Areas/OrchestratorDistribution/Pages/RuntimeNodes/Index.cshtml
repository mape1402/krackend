@page
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Distribution.Areas.OrchestratorDistribution.Pages.RuntimeNodes.IndexModel
@{
    ViewData["Title"] = "Runtime Nodes";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Runtime Nodes</h1>
        <p class="od-page-subtitle">Execution engines available for releases.</p>
    </div>
    <button type="button" class="btn btn-primary js-open-runtime-node-modal" data-mode="create">Create runtime node</button>
</div>

@if (!Model.Rows.Any())
{
    <section class="od-panel">
        <p class="od-empty">No runtime nodes found.</p>
    </section>
}
else
{
    <section class="od-list-shell">
        <div class="od-grid">
            @foreach (var item in Model.Rows)
            {
                var statusClass = item.IsEnabled ? "od-status od-status-active" : "od-status od-status-inactive";
                <article class="od-item-card">
                    <div class="od-item-top">
                        <div>
                            <h2 class="od-item-title">@item.Name</h2>
                            <p class="od-item-meta">@item.Code</p>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            <span class="@statusClass">@(item.IsEnabled ? "Enabled" : "Disabled")</span>
                            <div class="dropdown">
                                <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">&#8942;</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <button type="button"
                                                class="dropdown-item js-open-runtime-node-modal"
                                                data-mode="edit"
                                                data-id="@item.Id"
                                                data-name="@item.Name"
                                                data-code="@item.Code"
                                                data-environment-id="@item.EnvironmentId"
                                                data-distribution-mode="@item.DistributionMode"
                                                data-endpoint-base-uri="@item.EndpointBaseUri"
                                                data-description="@item.Description">
                                            Edit
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" asp-page-handler="SetEnabled" class="od-inline-form" data-orchestrator-busy="true" data-busy-title="Updating runtime node" data-busy-message="Distribution is applying the runtime node status change.">
                                            <input type="hidden" name="runtimeNodeId" value="@item.Id" />
                                            <input type="hidden" name="isEnabled" value="@(item.IsEnabled ? "false" : "true")" />
                                            <button type="submit" class="dropdown-item">@(item.IsEnabled ? "Disable node" : "Enable node")</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <p class="od-item-description">@(string.IsNullOrWhiteSpace(item.Description) ? "No description." : item.Description)</p>
                    <div class="od-chip-row">
                        <span class="od-meta-chip">Environment: @item.EnvironmentName</span>
                        <span class="od-meta-chip">Mode: @item.DistributionMode</span>
                        <span class="od-meta-chip">URI: @(string.IsNullOrWhiteSpace(item.EndpointBaseUri) ? "Not configured" : item.EndpointBaseUri)</span>
                    </div>
                </article>
            }
        </div>
    </section>
}

<div class="modal fade" id="runtimeNodeModal" tabindex="-1" aria-labelledby="runtimeNodeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Upsert" data-orchestrator-validate="true" data-orchestrator-busy="true" data-busy-title="Saving runtime node" data-busy-message="Distribution is validating and storing the runtime node.">
                <div class="modal-header">
                    <h5 class="modal-title" id="runtimeNodeModalLabel">Create runtime node</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input asp-for="Input.RuntimeNodeId" type="hidden" id="runtimeNodeIdInput" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.Name" class="form-label"></label>
                            <input asp-for="Input.Name" class="form-control" id="nameInput" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Code" class="form-label"></label>
                            <input asp-for="Input.Code" class="form-control" id="codeInput" data-orchestrator-key="true" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.EnvironmentId" class="form-label">Environment</label>
                            <select asp-for="Input.EnvironmentId" class="form-select" id="environmentIdInput">
                                <option value="">Select environment</option>
                                @foreach (var env in Model.Environments)
                                {
                                    <option value="@env.Id">@env.Name (@env.Code)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.DistributionMode" class="form-label"></label>
                            <select asp-for="Input.DistributionMode" class="form-select" id="distributionModeInput">
                                @foreach (var mode in Model.DistributionModes)
                                {
                                    <option value="@mode">@mode</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Input.EndpointBaseUri" class="form-label"></label>
                            <input asp-for="Input.EndpointBaseUri" class="form-control" id="endpointBaseUriInput" data-orchestrator-url="true" />
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Input.Description" class="form-label"></label>
                            <input asp-for="Input.Description" class="form-control" id="descriptionInput" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="runtimeNodeModalSubmitButton">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const modalElement = document.getElementById('runtimeNodeModal');
    const title = document.getElementById('runtimeNodeModalLabel');
    const submitButton = document.getElementById('runtimeNodeModalSubmitButton');
    const modal = window.bootstrap?.Modal?.getOrCreateInstance(modalElement);
    if (!modalElement || !title || !submitButton || !modal) return;

    const idInput = document.getElementById('runtimeNodeIdInput');
    const nameInput = document.getElementById('nameInput');
    const codeInput = document.getElementById('codeInput');
    const environmentIdInput = document.getElementById('environmentIdInput');
    const distributionModeInput = document.getElementById('distributionModeInput');
    const endpointBaseUriInput = document.getElementById('endpointBaseUriInput');
    const descriptionInput = document.getElementById('descriptionInput');

    const setValue = (el, value) => { if (el) el.value = value ?? ''; };

    document.querySelectorAll('.js-open-runtime-node-modal').forEach(button => {
        button.addEventListener('click', () => {
            const mode = button.getAttribute('data-mode');
            if (mode === 'edit') {
                title.textContent = 'Edit runtime node';
                submitButton.textContent = 'Save';
                setValue(idInput, button.getAttribute('data-id'));
                setValue(nameInput, button.getAttribute('data-name'));
                setValue(codeInput, button.getAttribute('data-code'));
                setValue(environmentIdInput, button.getAttribute('data-environment-id'));
                setValue(distributionModeInput, button.getAttribute('data-distribution-mode'));
                setValue(endpointBaseUriInput, button.getAttribute('data-endpoint-base-uri'));
                setValue(descriptionInput, button.getAttribute('data-description'));
                modal.show();
                return;
            }

            title.textContent = 'Create runtime node';
            submitButton.textContent = 'Create';
            setValue(idInput, '');
            setValue(nameInput, '');
            setValue(codeInput, '');
            setValue(environmentIdInput, '');
            setValue(distributionModeInput, 'Hybrid');
            setValue(endpointBaseUriInput, '');
            setValue(descriptionInput, '');
            modal.show();
        });
    });
})();
</script>
}
