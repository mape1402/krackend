@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Distribution.Areas.OrchestratorDistribution.Pages.RuntimeNodes.IndexModel
<form method="post" asp-page-handler="WizardImportCredentials" id="runtimeNodeCredentialForm" data-wizard-form="true">
    <input asp-for="Credentials.RuntimeNodeId" type="hidden" id="credentialRuntimeNodeIdInput" />
    <label asp-for="Credentials.CredentialsJson" for="credentialsJsonInput" class="z-form-label">Runtime credentials JSON</label>
    <textarea asp-for="Credentials.CredentialsJson" class="z-form-input od-credentials-textarea" id="credentialsJsonInput" rows="12" data-val-required="Runtime credentials JSON is required." data-orchestrator-json="true"></textarea>
    <span asp-validation-for="Credentials.CredentialsJson" class="text-danger"></span>
</form>
