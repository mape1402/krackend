@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Distribution.Areas.OrchestratorDistribution.Pages.RuntimeNodes.IndexModel
@using Zoorce.Web.UI.Navigation.Wizard
@using Zoorce.Web.UI.Navigation.Stepper
@addTagHelper *, Zoorce.Web.UI
@{
    var setupWizard = new ZoorceWizardOptions {
        Id = "runtimeNodeSetupWizard", AriaLabel = "Runtime node setup",
        Layout = ZoorceWizardLayout.Sidebar, ExecutionMode = ZoorceWizardExecutionMode.Manual,
        PanelHeaderMode = ZoorceWizardPanelHeaderMode.Hidden, AllowFutureNavigation = true,
        Steps = [
            new("basic", "Basic data", State: ZoorceStepperState.Active, FormId: "setupBasicForm"),
            new("policy", "Policy", FormId: "setupPolicyForm"),
            new("runtimeCredentials", "Runtime credentials"),
            new("designCredentials", "Design credentials"),
            new("verify", "Verify")
        ]
    };
}
<p class="od-item-meta mb-2" id="runtimeNodeSetupSubtitle"></p>
<div class="od-runtime-detail-body">
                <zoorce-wizard options="setupWizard" css-class="od-node-setup-wizard">
                    <zoorce-wizard-panel step-id="basic">
                        <section class="od-setup-step is-active" data-setup-step="basic">
                            <div class="od-section-head">
                                <div>
                                    <h2 class="od-section-title">Basic data</h2>
                                    <p class="od-item-meta">Design-local identity for the Runtime node.</p>
                                </div>
                            </div>
                            <form method="post" asp-page-handler="WizardUpsert" id="setupBasicForm" data-wizard-form="true">
                                <input type="hidden" name="Input.RuntimeNodeId" id="setupBasicRuntimeNodeId" />
                                <input type="hidden" name="Input.DistributionMode" id="setupBasicDistributionMode" value="HybridSync" />
                                <input type="hidden" name="Input.EndpointBaseUri" id="setupBasicEndpointBaseUri" />
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="setupBasicName" class="z-form-label">Name</label>
                                        <input name="Input.Name" class="z-form-input" id="setupBasicName" data-val-required="Name is required." maxlength="256" autocomplete="off" />
                                    </div>
                                    <div class="col-md-6">
                                        <label for="setupBasicCode" class="z-form-label">Code</label>
                                        <input name="Input.Code" class="z-form-input" id="setupBasicCode" data-val-required="Code is required." data-val-regex-pattern="^[A-Za-z][A-Za-z0-9]*(?:[.-][A-Za-z0-9]+)*$" data-val-regex="Use letters or numbers separated by dot or dash, starting with a letter." maxlength="128" autocomplete="off" />
                                    </div>
                                    <div class="col-md-6">
                                        <label for="setupBasicEnvironmentId" class="z-form-label">Environment</label>
                                        <input type="search" class="z-form-input mb-2" id="setupEnvironmentSearch" aria-label="Search environments" placeholder="Search environments" autocomplete="off" data-source="@Url.Page(null, "EnvironmentOptions")" />
                                        <select name="Input.EnvironmentId" class="z-form-input z-form-select" id="setupBasicEnvironmentId" data-val-required="Select an environment.">
                                            <option value="">Select environment</option>
                                        </select>
                                        <button type="button" class="btn btn-link btn-sm px-0" id="setupEnvironmentMore" hidden>Load more environments</button>
                                        <div id="setupEnvironmentStatus" class="small" role="status"></div>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="setupBasicDescription" class="z-form-label">Description</label>
                                        <input name="Input.Description" class="z-form-input" id="setupBasicDescription" autocomplete="off" />
                                    </div>
                                </div>
                            </form>
                        </section>

                    </zoorce-wizard-panel>
                    <zoorce-wizard-panel step-id="policy">
                        <section class="od-setup-step" data-setup-step="policy">
                            <div class="od-section-head">
                                <div>
                                    <h2 class="od-section-title">Policy</h2>
                                    <p class="od-item-meta">Choose who starts release movement.</p>
                                </div>
                            </div>
                            <form method="post" asp-page-handler="WizardUpsert" id="setupPolicyForm" data-wizard-form="true">
                                <input type="hidden" name="Input.RuntimeNodeId" id="setupPolicyRuntimeNodeId" />
                                <input type="hidden" name="Input.Name" id="setupPolicyName" />
                                <input type="hidden" name="Input.Code" id="setupPolicyCode" />
                                <input type="hidden" name="Input.EnvironmentId" id="setupPolicyEnvironmentId" />
                                <input type="hidden" name="Input.Description" id="setupPolicyDescription" />
                                <input type="hidden" name="Input.EndpointBaseUri" id="setupPolicyEndpointBaseUri" />
                                <div class="od-policy-options">
                                    @foreach (var mode in Model.DistributionModeOptions)
                                    {
                                        <label class="od-policy-option">
                                            <input type="radio" name="Input.DistributionMode" value="@mode.Value" />
                                            <span>
                                                <strong>@mode.Label</strong>
                                                <small>@mode.Description</small>
                                            </span>
                                        </label>
                                    }
                                </div>
                            </form>
                        </section>

                    </zoorce-wizard-panel>
                    <zoorce-wizard-panel step-id="runtimeCredentials">
                        <section class="od-setup-step" data-setup-step="runtimeCredentials">
                            <div class="od-section-head">
                                <div>
                                    <h2 class="od-section-title">Runtime credentials</h2>
                                    <p class="od-item-meta">Required when Design publishes releases.</p>
                                </div>
                                <button type="button" class="z-button z-button-ghost js-setup-import-credentials">Import credentials</button>
                            </div>
                            <div class="od-info-grid od-info-grid-compact">
                                <div class="od-info-tile"><span>Status</span><strong id="setupOutboundCredentialStatus">-</strong></div>
                                <div class="od-info-tile"><span>Runtime endpoint</span><strong id="setupEndpointBaseUri">-</strong></div>
                                <div class="od-info-tile"><span>Client ID</span><strong id="setupOutboundClientId">-</strong></div>
                                <div class="od-info-tile"><span>Key ID</span><strong id="setupOutboundKeyId">-</strong></div>
                                <div class="od-info-tile"><span>Scopes</span><strong id="setupOutboundRequestedScopes">-</strong></div>
                                <div class="od-info-tile"><span>Imported</span><strong id="setupOutboundCredentialImportedAt">-</strong></div>
                            </div>
                        </section>

                    </zoorce-wizard-panel>
                    <zoorce-wizard-panel step-id="designCredentials">
                        <section class="od-setup-step" data-setup-step="designCredentials">
                            <div class="od-section-head">
                                <div>
                                    <h2 class="od-section-title">Design credentials</h2>
                                    <p class="od-item-meta">Required when Runtime imports releases.</p>
                                </div>
                                <form method="post" asp-page-handler="WizardGenerateCredentials" id="setupGenerateCredentialsForm" class="od-inline-form d-none" data-wizard-form="true">
                                    <input type="hidden" name="runtimeNodeId" id="setupGenerateRuntimeNodeId" />
                                </form>
                                <button type="button" class="z-button z-button-ghost js-setup-generate-credentials">Generate credentials</button>
                            </div>
                            <div class="od-info-grid od-info-grid-compact">
                                <div class="od-info-tile"><span>Status</span><strong id="setupInboundCredentialStatus">-</strong></div>
                                <div class="od-info-tile"><span>Client ID</span><strong id="setupInboundClientId">-</strong></div>
                                <div class="od-info-tile"><span>Key ID</span><strong id="setupInboundKeyId">-</strong></div>
                                <div class="od-info-tile"><span>Scopes</span><strong id="setupInboundAllowedScopes">-</strong></div>
                                <div class="od-info-tile"><span>Created</span><strong id="setupInboundCredentialCreatedAt">-</strong></div>
                                <div class="od-info-tile"><span>Last token</span><strong id="setupInboundLastTokenIssuedAt">-</strong></div>
                            </div>
                        </section>

                    </zoorce-wizard-panel>
                    <zoorce-wizard-panel step-id="verify">
                        <section class="od-setup-step" data-setup-step="verify">
                            <div class="od-section-head">
                                <div>
                                    <h2 class="od-section-title">Verify</h2>
                                    <p class="od-item-meta">Connection check.</p>
                                </div>
                                <form method="post" asp-page-handler="WizardValidateConnection" id="setupValidateConnectionForm" class="od-inline-form d-none" data-wizard-form="true">
                                    <input type="hidden" name="runtimeNodeId" id="setupValidateRuntimeNodeId" />
                                </form>
                                <button type="button" class="z-button z-button-ghost js-setup-validate-connection">Check connection</button>
                            </div>
                        </section>
                    </zoorce-wizard-panel>
                </zoorce-wizard>
            <form method="post" asp-page-handler="WizardSetStatus" id="setupStatusForm" class="d-none" data-wizard-form="true">
                <input type="hidden" name="runtimeNodeId" id="setupStatusRuntimeNodeId" />
                <input type="hidden" name="status" id="setupStatusValue" value="Enabled" />
            </form>
</div>
