@page
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Distribution.Areas.OrchestratorDistribution.Pages.Releases.IndexModel
@{
    ViewData["Title"] = "Releases";
    var releaseRows = Model.Rows
        .OrderByDescending(x => x.CreatedAtUtc)
        .ToArray();
    var jsonOptions = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
    var runtimeNodesById = Model.RuntimeNodes.ToDictionary(x => x.Id, StringComparer.Ordinal);

    string DisplayStageStatus(string status)
    {
        var normalized = (status ?? string.Empty).Trim();
        return normalized.ToLowerInvariant() switch
        {
            "inprogress" => "Queued",
            "pushscheduled" => "Queued",
            "pending" => "Queued",
            "availableforpull" => "Pending",
            _ => string.IsNullOrWhiteSpace(normalized) ? "Pending" : normalized
        };
    }

    string ReleaseStatusClass(string status)
    {
        var normalized = (status ?? string.Empty).Trim().ToLowerInvariant();
        return normalized switch
        {
            "inprogress" or "draft" => "od-status-queued",
            "completed" => "od-status-completed",
            "failed" or "cancelled" => "od-status-failed",
            _ => "od-status-queued"
        };
    }

    bool IsActivated(string status)
        => string.Equals(status, "Activated", StringComparison.OrdinalIgnoreCase);

    bool IsDesignPushMode(string mode)
        => string.Equals(mode, "DesignPublishesToRuntime", StringComparison.OrdinalIgnoreCase)
            || string.Equals(mode, "HybridSync", StringComparison.OrdinalIgnoreCase)
            || string.Equals(mode, "Push", StringComparison.OrdinalIgnoreCase)
            || string.Equals(mode, "Hybrid", StringComparison.OrdinalIgnoreCase);

    bool IsRuntimePullMode(string mode)
        => string.Equals(mode, "RuntimeFetchesFromDesign", StringComparison.OrdinalIgnoreCase)
            || string.Equals(mode, "HybridSync", StringComparison.OrdinalIgnoreCase)
            || string.Equals(mode, "Pull", StringComparison.OrdinalIgnoreCase)
            || string.Equals(mode, "Hybrid", StringComparison.OrdinalIgnoreCase);

    string DisplayDistributionMode(string mode)
    {
        var normalized = (mode ?? string.Empty).Trim();
        return normalized switch
        {
            "DesignPublishesToRuntime" => "Design publishes releases",
            "RuntimeFetchesFromDesign" => "Runtime imports releases",
            "HybridSync" => "Both directions",
            _ => string.IsNullOrWhiteSpace(normalized) ? "Unknown mode" : normalized
        };
    }

    string ResolveReleaseStatus(Krackend.Sagas.Orchestrations.ControlPlane.Application.Distribution.ReleaseModel release)
    {
        var targetStatuses = release.Targets
            .Select(target =>
            {
                Model.ReleaseTargetByReleaseAndNode.TryGetValue($"{release.Id}|{target.RuntimeNodeId}", out var releaseTarget);
                return releaseTarget?.Status ?? target.Status;
            })
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToArray();

        if (targetStatuses.Length == 0)
        {
            return release.Status;
        }

        if (targetStatuses.All(x => string.Equals(x, "Activated", StringComparison.OrdinalIgnoreCase)))
        {
            return "Completed";
        }

        if (targetStatuses.Any(x => string.Equals(x, "Failed", StringComparison.OrdinalIgnoreCase)))
        {
            return "Failed";
        }

        return release.Status;
    }
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">
            @(string.IsNullOrWhiteSpace(Model.OrchestrationId)
                ? "Releases"
                : $"Releases - {Model.SelectedOrchestration?.Name}")
        </h1>
        <p class="od-page-subtitle">Select an orchestration to view and create releases.</p>
    </div>
    <div class="d-flex gap-2">
        @if (!string.IsNullOrWhiteSpace(Model.OrchestrationId))
        {
            <button type="button" class="btn btn-outline-secondary" id="openRuntimeNodesModalButton">Allowed Nodes</button>
        }
        @if (!string.IsNullOrWhiteSpace(Model.OrchestrationId))
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createReleaseModal">Create release</button>
        }
    </div>
</div>

<section class="od-release-split">
    <aside class="od-list-shell od-release-left">
        @if (!Model.Orchestrations.Any())
        {
            <p class="od-empty">No orchestrations available in distribution mirror.</p>
        }
        else
        {
            <div class="od-vertical-cards">
                @foreach (var orchestration in Model.Orchestrations.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                {
                    var isSelected = string.Equals(Model.OrchestrationId, orchestration.Id, StringComparison.Ordinal);
                    <a class="od-item-card od-orch-card text-decoration-none @(isSelected ? "od-selected" : string.Empty)"
                       asp-area="OrchestratorDistribution"
                       asp-page="/Promotions/Index"
                       asp-route-orchestrationId="@orchestration.Id">
                        <div class="od-item-top">
                            <div>
                                <h2 class="od-item-title od-orch-title">@orchestration.Name</h2>
                                <p class="od-item-meta">@orchestration.Key</p>
                            </div>
                            <span class="od-status @(orchestration.IsActive ? "od-status-active" : "od-status-inactive")">
                                @(orchestration.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>
                    </a>
                }
            </div>
        }
    </aside>

    <div class="od-list-shell od-release-right">
        @if (string.IsNullOrWhiteSpace(Model.OrchestrationId))
        {
            <p class="od-empty">Select a pipeline to view its releases.</p>
        }
        else if (!releaseRows.Any())
        {
            <div class="od-empty-state">
                <p class="od-empty">No releases found for this orchestration.</p>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createReleaseModal">
                    Create release
                </button>
            </div>
        }
        else
        {
            <div class="od-release-board">
                @foreach (var item in releaseRows)
                {
                    var artifact = Model.Artifacts.FirstOrDefault(x => x.Id == item.ArtifactId);
                    var releaseStatus = ResolveReleaseStatus(item);
                    <article class="od-release-row">
                        <div class="od-release-row-main">
                            <div class="od-release-row-head">
                                <span class="od-status @ReleaseStatusClass(releaseStatus)">@DisplayStageStatus(releaseStatus)</span>
                                <p class="od-item-meta od-release-id">@item.Id</p>
                            </div>
                            <div class="od-chip-row">
                                <span class="od-meta-chip">Artifact: @(artifact is null ? "No artifact linked" : $"{artifact.ArtifactType} - {artifact.VersionNumber} - {(string.IsNullOrWhiteSpace(artifact.VersionLabel) ? "Unlabeled" : artifact.VersionLabel)}")</span>
                                <span class="od-meta-chip">Created: @item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                            <div class="od-release-stages">
                                @foreach (var target in item.Targets.OrderBy(x => x.CreatedAtUtc))
                                {
                                    var nodeName = target.RuntimeNodeId;
                                    var nodeCode = "Unknown code";
                                    var nodeMode = "Unknown mode";
                                    if (runtimeNodesById.TryGetValue(target.RuntimeNodeId, out var runtimeNode))
                                    {
                                        nodeName = runtimeNode.Name;
                                        nodeCode = runtimeNode.Code;
                                        nodeMode = runtimeNode.DistributionMode;
                                    }
                                    Model.ReleaseTargetByReleaseAndNode.TryGetValue($"{item.Id}|{target.RuntimeNodeId}", out var releaseTarget);
                                    var targetStatus = releaseTarget?.Status ?? target.Status;
                                    var canPushTarget = IsDesignPushMode(nodeMode);
                                    var canPullTarget = IsRuntimePullMode(nodeMode);
                                    var displayNodeMode = DisplayDistributionMode(nodeMode);
                                    var isActivated = IsActivated(targetStatus);
                                    <div class="od-release-stage">
                                        <div class="od-release-stage-name">@nodeName</div>
                                        <div class="od-release-stage-meta">@nodeCode - @displayNodeMode</div>
                                        <div class="od-release-stage-status">@DisplayStageStatus(targetStatus)</div>
                                        @if (canPushTarget && releaseTarget is not null && !isActivated)
                                        {
                                            <form method="post"
                                                  asp-page-handler="Push"
                                                  class="mt-2"
                                                  data-confirm="true"
                                                  data-confirm-title="Promote artifact"
                                                  data-confirm-message="Push this artifact to @nodeName?"
                                                  data-confirm-accept="Push"
                                                  data-confirm-type="warning"
                                                  data-orchestrator-busy="true"
                                                  data-busy-title="Promoting artifact"
                                                  data-busy-message="Distribution is sending the artifact to the selected runtime node.">
                                                <input type="hidden" name="releaseTargetId" value="@releaseTarget.Id" />
                                                <input type="hidden" name="orchestrationId" value="@Model.OrchestrationId" />
                                                <button type="submit" class="btn btn-sm btn-primary w-100">Push</button>
                                            </form>
                                        }
                                        else if (isActivated)
                                        {
                                            <div class="od-release-stage-note">Promoted</div>
                                        }
                                        else if (canPullTarget)
                                        {
                                            <div class="od-release-stage-note">Pull from runtime</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="od-release-row-actions">
                            <button type="button"
                                    class="btn btn-sm od-release-details-btn js-open-release-details"
                                    data-release-id="@item.Id">
                                View details
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.OrchestrationId))
{
    <div class="modal fade" id="createReleaseModal" tabindex="-1" aria-labelledby="createReleaseModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form method="post" asp-page-handler="Create" data-orchestrator-validate="true" data-orchestrator-busy="true" data-busy-title="Creating release" data-busy-message="Distribution is creating the release and resolving the runtime targets.">
                    <div class="modal-header">
                        <h5 class="modal-title" id="createReleaseModalLabel">Create release</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input asp-for="Input.Strategy" type="hidden" value="Immediate" />
                        <input asp-for="Input.OrchestrationDefinitionId" type="hidden" value="@Model.OrchestrationId" />
                        <input asp-for="Input.RequestedBy" type="hidden" />
                        <input asp-for="Input.Notes" type="hidden" />
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="Input.ArtifactId" class="form-label"></label>
                                <select asp-for="Input.ArtifactId" class="form-select" id="releaseArtifactSelect">
                                    <option value="">Select artifact</option>
                                    @foreach (var artifact in Model.SelectedArtifacts)
                                    {
                                        <option value="@artifact.Id"
                                                data-orchestration-id="@artifact.OrchestrationDefinitionId">
                                            @artifact.OrchestrationDisplayName - @artifact.ArtifactType, @artifact.VersionNumber - @(string.IsNullOrWhiteSpace(artifact.VersionLabel) ? "Unlabeled" : artifact.VersionLabel)
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Target runtime nodes</label>
                                <div class="border rounded p-3" style="max-height: 260px; overflow-y: auto;">
                                    @if (!Model.RuntimeNodes.Any())
                                    {
                                        <div class="text-muted small">No enabled runtime nodes found.</div>
                                    }
                                    else
                                    {
                                        <div id="releaseAllowedNodesWarning" class="alert alert-warning py-2 px-3 mb-2 d-none">
                                            No node policy configured for this orchestration. Release is blocked by default.
                                        </div>
                                        <div class="od-stage-picker">
                                            @for (var i = 0; i < Model.RuntimeNodes.Count; i++)
                                            {
                                                var node = Model.RuntimeNodes.ElementAt(i);
                                                <div class="od-stage-option-wrap form-check">
                                                    <input class="form-check-input js-runtime-node-option od-stage-checkbox"
                                                           type="checkbox"
                                                           name="Input.RuntimeNodeIds"
                                                           value="@node.Id"
                                                           data-runtime-node-id="@node.Id"
                                                           id="runtimeNode_@i" />
                                                    <label class="od-stage-option" for="runtimeNode_@i">
                                                        <span class="od-stage-name">@node.Name</span>
                                                        <span class="od-stage-meta">@node.Code</span>
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="createReleaseSubmitButton">Create release</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="allowedNodesModal" tabindex="-1" aria-labelledby="allowedNodesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="SaveAllowedNodes" data-orchestrator-validate="true" data-orchestrator-busy="true" data-busy-title="Saving policy" data-busy-message="Distribution is saving the runtime node policy for this orchestration.">
                <div class="modal-header">
                    <h5 class="modal-title" id="allowedNodesModalLabel">Allowed nodes</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input asp-for="AllowedNodes.OrchestrationDefinitionId" type="hidden" id="allowedNodesOrchestrationId" />
                    <input asp-for="AllowedNodes.UpdatedBy" type="hidden" />
                    <p class="text-muted small mb-2">Only selected nodes will be eligible for releases of this orchestration.</p>
                    <div id="allowedNodesSelectionWarning" class="alert alert-warning py-2 px-3 mb-2 d-none">
                        Orchestration is required to configure runtime nodes.
                    </div>
                    <div class="border rounded p-2" style="max-height: 260px; overflow-y: auto;">
                        @if (!Model.RuntimeNodes.Any())
                        {
                            <div class="text-muted small">No enabled runtime nodes found.</div>
                        }
                        else
                        {
                            @for (var i = 0; i < Model.RuntimeNodes.Count; i++)
                            {
                                var node = Model.RuntimeNodes.ElementAt(i);
                                <div class="form-check">
                                    <input class="form-check-input js-allowed-node-option"
                                           type="checkbox"
                                           name="AllowedNodes.RuntimeNodeIds"
                                           value="@node.Id"
                                           id="allowedPolicyNode_@i" />
                                    <label class="form-check-label" for="allowedPolicyNode_@i">@node.Name (@node.Code)</label>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" id="allowedNodesCancelButton" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="saveAllowedNodesButton">Save policy</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="releaseDetailsModal" tabindex="-1" aria-labelledby="releaseDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="releaseDetailsModalLabel">Release details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="od-release-detail-head">
                    <div>
                        <div class="od-release-detail-title" id="releaseDetailsOrchestrationName"></div>
                        <div class="od-release-detail-sub" id="releaseDetailsReleaseId"></div>
                    </div>
                    <div class="od-release-detail-meta">
                        <span class="od-meta-chip" id="releaseDetailsArtifact"></span>
                        <span class="od-meta-chip" id="releaseDetailsCreated"></span>
                    </div>
                </div>
                <div class="od-stage-grid" id="releaseDetailsTargets"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const artifactSelect = document.getElementById('releaseArtifactSelect');
    const nodeCheckboxes = Array.from(document.querySelectorAll('.js-runtime-node-option'));
    const warning = document.getElementById('releaseAllowedNodesWarning');
    const submitButton = document.getElementById('createReleaseSubmitButton');
    const allowedNodesModalElement = document.getElementById('allowedNodesModal');
    const allowedNodesModalLabel = document.getElementById('allowedNodesModalLabel');
    const allowedNodesOrchestrationIdInput = document.getElementById('allowedNodesOrchestrationId');
    const allowedNodesWarning = document.getElementById('allowedNodesSelectionWarning');
    const allowedNodesCheckboxes = Array.from(document.querySelectorAll('.js-allowed-node-option'));
    const saveAllowedNodesButton = document.getElementById('saveAllowedNodesButton');
    const openRuntimeNodesModalButton = document.getElementById('openRuntimeNodesModalButton');
    const releaseDetailsModalElement = document.getElementById('releaseDetailsModal');
    const releaseDetailsTargetsElement = document.getElementById('releaseDetailsTargets');
    const releaseDetailsOrchestrationNameElement = document.getElementById('releaseDetailsOrchestrationName');
    const releaseDetailsReleaseIdElement = document.getElementById('releaseDetailsReleaseId');
    const releaseDetailsArtifactElement = document.getElementById('releaseDetailsArtifact');
    const releaseDetailsCreatedElement = document.getElementById('releaseDetailsCreated');
    const releaseDetailButtons = Array.from(document.querySelectorAll('.js-open-release-details'));

    if (!window.bootstrap?.Modal) {
        return;
    }

    const allowedNodeIdsByOrchestration = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AllowedNodeIdsByOrchestrationId));
    const allowedNodesModal = allowedNodesModalElement ? window.bootstrap.Modal.getOrCreateInstance(allowedNodesModalElement) : null;
    const releaseDetailsModal = releaseDetailsModalElement ? window.bootstrap.Modal.getOrCreateInstance(releaseDetailsModalElement) : null;
    const selectedOrchestrationId = '@Model.OrchestrationId';
    const releases = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Rows, jsonOptions));
    const artifacts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Artifacts, jsonOptions));
    const runtimeNodes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RuntimeNodes, jsonOptions));
    const releaseTargetsByReleaseAndNode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReleaseTargetByReleaseAndNode, jsonOptions));

    const getSelectedOrchestrationId = () => selectedOrchestrationId;
    const artifactById = new Map(artifacts.map(x => [x.id, x]));
    const runtimeNodeById = new Map(runtimeNodes.map(x => [x.id, x]));
    const releaseById = new Map(releases.map(x => [x.id, x]));

    const updateNodeVisibility = () => {
        if (!artifactSelect || !warning || !submitButton || nodeCheckboxes.length === 0) {
            return;
        }

        const orchestrationId = getSelectedOrchestrationId();
        const allowedNodes = orchestrationId ? (allowedNodeIdsByOrchestration[orchestrationId] ?? []) : [];
        const allowedSet = new Set(allowedNodes);

        if (!orchestrationId || allowedNodes.length === 0) {
            warning.classList.remove('d-none');
            submitButton.disabled = true;
        } else {
            warning.classList.add('d-none');
            submitButton.disabled = false;
        }

        nodeCheckboxes.forEach(checkbox => {
            const nodeId = checkbox.getAttribute('data-runtime-node-id') ?? '';
            const isAllowed = orchestrationId && allowedSet.has(nodeId);

            checkbox.checked = isAllowed ? checkbox.checked : false;
            checkbox.disabled = !isAllowed;
            const wrapper = checkbox.closest('.form-check');
            if (!wrapper) return;
            wrapper.classList.toggle('d-none', !isAllowed);
        });
    };

    const loadAllowedNodesForOrchestration = async (orchestrationId) => {
        if (!orchestrationId) {
            return [];
        }

        const url = `${window.location.pathname}?handler=AllowedNodes&orchestrationId=${encodeURIComponent(orchestrationId)}`;
        const response = await fetch(url, { method: 'GET' });
        if (!response.ok) {
            return allowedNodeIdsByOrchestration[orchestrationId] ?? [];
        }

        const payload = await response.json();
        return payload.runtimeNodeIds ?? [];
    };

    const openAllowedNodesForOrchestration = async (orchestrationId) => {
        if (!allowedNodesModal || !allowedNodesOrchestrationIdInput || !allowedNodesWarning || !saveAllowedNodesButton || !allowedNodesModalLabel) {
            return false;
        }

        allowedNodesOrchestrationIdInput.value = orchestrationId || '';
        allowedNodesModalLabel.textContent = 'Allowed nodes';
        if (!orchestrationId) {
            allowedNodesWarning.classList.remove('d-none');
            saveAllowedNodesButton.disabled = true;
            allowedNodesCheckboxes.forEach(checkbox => {
                checkbox.checked = false;
                checkbox.disabled = true;
            });
            allowedNodesModal.show();
            return false;
        }

        allowedNodesWarning.classList.add('d-none');
        saveAllowedNodesButton.disabled = false;

        const selectedNodes = new Set(await loadAllowedNodesForOrchestration(orchestrationId));
        allowedNodesCheckboxes.forEach(checkbox => {
            checkbox.disabled = false;
            checkbox.checked = selectedNodes.has(checkbox.value);
        });

        allowedNodesModal.show();
        return true;
    };

    const escapeHtml = (value) => {
        return (value ?? '').toString()
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    };

    const getStatusVariant = (status) => {
        const s = (status || '').toLowerCase();
        if (s === 'pending' || s === 'availableforpull') return 'warning';
        if (s === 'inprogress' || s === 'pushscheduled') return 'info';
        if (s === 'delivered' || s === 'acknowledged' || s === 'activated') return 'success';
        if (s === 'failed' || s === 'cancelled') return 'danger';
        return 'neutral';
    };

    const getDisplayStatus = (status) => {
        const s = (status || '').toLowerCase();
        if (s === 'inprogress' || s === 'pushscheduled') return 'Queued';
        if (s === 'availableforpull') return 'Pending';
        return status || 'Pending';
    };

    const isFinalStatus = (status) => {
        const s = (status || '').toLowerCase();
        return s === 'delivered' || s === 'acknowledged' || s === 'activated' || s === 'failed' || s === 'cancelled';
    };

    const canPush = (mode, status) => {
        const modeValue = (mode || '').toLowerCase();
        const isPushMode = modeValue === 'designpublishestoruntime' ||
            modeValue === 'hybridsync' ||
            modeValue === 'push' ||
            modeValue === 'hybrid';
        return isPushMode;
    };

    const canPull = mode => {
        const modeValue = (mode || '').toLowerCase();
        return modeValue === 'runtimefetchesfromdesign' ||
            modeValue === 'hybridsync' ||
            modeValue === 'pull' ||
            modeValue === 'hybrid';
    };

    const getDistributionModeLabel = mode => {
        switch (mode) {
            case 'DesignPublishesToRuntime':
                return 'Design publishes releases';
            case 'RuntimeFetchesFromDesign':
                return 'Runtime imports releases';
            case 'HybridSync':
                return 'Both directions';
            default:
                return mode || 'Unknown mode';
        }
    };

    const showReleaseDetails = (releaseId) => {
        if (!releaseDetailsModal || !releaseDetailsTargetsElement || !releaseById.has(releaseId)) {
            return;
        }

        const release = releaseById.get(releaseId);
        const artifact = artifactById.get(release.artifactId);
        releaseDetailsOrchestrationNameElement.textContent = artifact?.orchestrationDisplayName || 'Release';
        releaseDetailsReleaseIdElement.textContent = `ReleaseId: ${release.id}`;
        releaseDetailsArtifactElement.textContent = `Artifact: ${artifact ? `${artifact.versionNumber} - ${artifact.versionLabel || 'Unlabeled'}` : 'No artifact linked'}`;
        releaseDetailsCreatedElement.textContent = `Created: ${release.createdAtUtc?.replace('T', ' ').slice(0, 16) || ''}`;

        const targets = Array.isArray(release.targets) ? [...release.targets] : [];
        targets.sort((a, b) => {
            const aFinal = isFinalStatus(a.status);
            const bFinal = isFinalStatus(b.status);
            if (aFinal !== bFinal) {
                return aFinal ? 1 : -1;
            }
            return (a.createdAtUtc || '').localeCompare(b.createdAtUtc || '');
        });

        releaseDetailsTargetsElement.innerHTML = targets.map(target => {
            const node = runtimeNodeById.get(target.runtimeNodeId);
            const mode = node?.distributionMode || 'Unknown mode';
            const releaseTarget = releaseTargetsByReleaseAndNode[`${release.id}|${target.runtimeNodeId}`];
            const actualStatus = releaseTarget?.status || target.status;
            const statusVariant = getStatusVariant(actualStatus);
            const displayStatus = getDisplayStatus(actualStatus);
            const pushAllowed = canPush(mode, actualStatus);
            const pullAllowed = canPull(mode);
            const modeLabel = getDistributionModeLabel(mode);

            return `
                <article class="od-stage-card">
                    <div class="od-stage-card-head">
                        <div>
                            <h6 class="od-stage-card-title">${escapeHtml(node?.name || target.runtimeNodeId)}</h6>
                            <p class="od-stage-card-meta">${escapeHtml(node ? `${node.code} - ${node.environmentName}` : target.runtimeNodeId)}</p>
                        </div>
                        <span class="od-stage-badge od-stage-badge-${statusVariant}">${escapeHtml(displayStatus)}</span>
                    </div>
                    <div class="od-stage-card-body">
                        <div class="od-stage-kv"><span>Mode</span><strong>${escapeHtml(modeLabel)}</strong></div>
                    </div>
                    <div class="od-stage-card-foot">
                        ${pushAllowed && pullAllowed
                            ? `<span class="od-stage-note">Push from board or pull by Runtime</span>`
                            : pushAllowed
                                ? `<span class="od-stage-note">Push from release board</span>`
                                : pullAllowed
                                    ? `<span class="od-stage-note">Pull by Runtime</span>`
                                    : `<span class="od-stage-note">No manual action</span>`}
                    </div>
                </article>
            `;
        }).join('');

        releaseDetailsModal.show();
    };

    if (openRuntimeNodesModalButton) {
        openRuntimeNodesModalButton.addEventListener('click', async () => {
            await openAllowedNodesForOrchestration(selectedOrchestrationId);
        });
    }

    releaseDetailButtons.forEach(button => {
        button.addEventListener('click', () => {
            const releaseId = button.getAttribute('data-release-id');
            if (!releaseId) return;
            showReleaseDetails(releaseId);
        });
    });

    if (artifactSelect) {
        artifactSelect.addEventListener('change', updateNodeVisibility);
    }
    updateNodeVisibility();
})();
</script>
