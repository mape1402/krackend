@page
@using Krackend.Sagas.Orchestrations.ControlPlane.Distribution.Enums
@using Zoorce.Web.UI.Abstractions.Data
@using Zoorce.Web.UI.DataGrid
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Distribution.Areas.OrchestratorDistribution.Pages.Releases.IndexModel
@{
    ViewData["Title"] = "Releases";
    var isOrchestrationSelected = !string.IsNullOrWhiteSpace(Model.OrchestrationId);
    var selectedOrchestrationName = Model.SelectedOrchestration?.Name ?? Model.OrchestrationId;
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">
            @(!isOrchestrationSelected
                ? "Releases"
                : $"Releases - {selectedOrchestrationName}")
        </h1>
        <p class="od-page-subtitle">
            @(!isOrchestrationSelected
                ? "Select an orchestration to view and create releases."
                : "Releases created for the selected orchestration.")
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (isOrchestrationSelected)
        {
            <a class="btn btn-outline-secondary"
               asp-area="OrchestratorDistribution"
               asp-page="/Promotions/Index">
                All orchestrations
            </a>
        }
        @if (isOrchestrationSelected)
        {
            <button type="button" class="btn btn-outline-secondary" id="openRuntimeNodesModalButton">Allowed Nodes</button>
        }
        @if (isOrchestrationSelected)
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createReleaseModal">Create release</button>
        }
    </div>
</div>

@if (!isOrchestrationSelected)
{
    <section class="od-catalog" data-catalog="release-orchestrations" data-label="orchestrations" data-source="@Url.Page(null, "OrchestrationList")">
        <div class="od-catalog-controls" role="group" aria-label="View mode">
            <button type="button" class="btn btn-outline-secondary" data-catalog-view="grid" aria-label="Grid view" title="Grid view" aria-pressed="true"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
            <button type="button" class="btn btn-outline-secondary" data-catalog-view="cards" aria-label="Card view" title="Card view" aria-pressed="false"><i class="bi bi-grid-3x2-gap" aria-hidden="true"></i></button>
        </div>
        <div data-catalog-grid>
            @await Component.InvokeAsync("ZoorceDataGrid", new ZoorceDataGridOptions
            {
                Id = "release-orchestrations-grid", AriaLabel = "orchestrations", Binding = new ZoorceDataBindingOptions { Source = Url.Page(null, "OrchestrationList") },
                LoadMode = ZoorceDataLoadMode.InfiniteScroll, PageSize = 25,
                Columns = [new("displayName", "Orchestration"), new("key", "Key"), new("status", "Status"), new("count", "Releases", false), new("latest", "Latest release", false), new("actions", "Actions", false)]
            })
        </div>
        <div data-catalog-cards hidden>
            <div class="od-catalog-filters">
                <label class="z-search-field"><span aria-hidden="true">&#x2315;</span><input type="search" data-catalog-search aria-label="Search orchestrations" placeholder="Search orchestrations" autocomplete="off" /></label>
                <select class="form-select" data-catalog-sort aria-label="Sort orchestrations">
                    <option value="name">Name</option><option value="name:desc">Name descending</option><option value="key">Key</option><option value="status">Status</option>
                </select>
            </div>
            <div class="od-grid" data-catalog-card-items></div>
            <p class="od-empty" data-catalog-empty hidden>No matching orchestrations.</p>
            <p data-catalog-status aria-live="polite"></p><div data-catalog-sentinel aria-hidden="true"></div>
            <button type="button" class="btn btn-outline-secondary" data-catalog-more hidden>Load more</button>
        </div>
    </section>
}
else
{
    <section class="od-catalog" data-catalog="releases" data-label="releases" data-source="@Url.Page(null, "ReleaseList", new { orchestrationId = Model.OrchestrationId })" data-detail-source="@Url.Page(null, "ReleaseDetails", new { orchestrationId = Model.OrchestrationId })">
        <div class="od-catalog-controls" role="group" aria-label="View mode">
            <button type="button" class="btn btn-outline-secondary" data-catalog-view="grid" aria-label="Grid view" title="Grid view" aria-pressed="true"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
            <button type="button" class="btn btn-outline-secondary" data-catalog-view="cards" aria-label="Card view" title="Card view" aria-pressed="false"><i class="bi bi-grid-3x2-gap" aria-hidden="true"></i></button>
        </div>
        <div data-catalog-grid>
            @await Component.InvokeAsync("ZoorceDataGrid", new ZoorceDataGridOptions
            {
                Id = "releases-grid", AriaLabel = "releases", Binding = new ZoorceDataBindingOptions { Source = Url.Page(null, "ReleaseList", new { orchestrationId = Model.OrchestrationId }) },
                LoadMode = ZoorceDataLoadMode.InfiniteScroll, PageSize = 25,
                Columns = [new("artifact", "Artifact", false), new("status", "Status", false), new("strategy", "Strategy"), new("requestedBy", "Requested by"), new("created", "Created"), new("actions", "Actions", false)]
            })
        </div>
        <div data-catalog-cards hidden>
            <div class="od-catalog-filters">
                <label class="z-search-field"><span aria-hidden="true">&#x2315;</span><input type="search" data-catalog-search aria-label="Search releases" placeholder="Search releases" autocomplete="off" /></label>
                <select class="form-select" data-catalog-sort aria-label="Sort releases">
                    <option value="created:desc">Newest first</option><option value="created">Oldest first</option><option value="requestedBy">Requested by</option><option value="strategy">Strategy</option>
                </select>
            </div>
            <div class="od-grid" data-catalog-card-items></div>
            <p class="od-empty" data-catalog-empty hidden>No matching releases.</p>
            <p data-catalog-status aria-live="polite"></p><div data-catalog-sentinel aria-hidden="true"></div>
            <button type="button" class="btn btn-outline-secondary" data-catalog-more hidden>Load more</button>
        </div>
    </section>
}

@if (!string.IsNullOrWhiteSpace(Model.OrchestrationId))
{
    <div class="modal fade" id="createReleaseModal" tabindex="-1" aria-labelledby="createReleaseModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form method="post" asp-page-handler="Create" data-orchestrator-validate="true" data-orchestrator-busy="true" data-busy-title="Creating release" data-busy-message="Distribution is creating the release and resolving the runtime targets.">
                    <div class="modal-header">
                        <h5 class="modal-title" id="createReleaseModalLabel">Create release</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input asp-for="Input.OrchestrationDefinitionId" type="hidden" value="@Model.OrchestrationId" />
                        <input asp-for="Input.RequestedBy" type="hidden" />
                        <input asp-for="Input.Notes" type="hidden" />
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="Input.ArtifactId" class="form-label"></label>
                                <select asp-for="Input.ArtifactId" class="form-select" id="releaseArtifactSelect">
                                    <option value="">Select artifact</option>
                                    @foreach (var artifact in Model.SelectedArtifacts)
                                    {
                                        <option value="@artifact.Id"
                                                data-orchestration-id="@artifact.OrchestrationDefinitionId"
                                                data-artifact-type="@artifact.ArtifactType">
                                            @artifact.OrchestrationDisplayName - @artifact.ArtifactType, @artifact.VersionNumber - @(string.IsNullOrWhiteSpace(artifact.VersionLabel) ? "Unlabeled" : artifact.VersionLabel)
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Strategy" class="form-label">Release strategy</label>
                                <select asp-for="Input.Strategy" class="form-select" id="releaseStrategySelect">
                                    <option value="@ReleaseStrategy.Direct">Direct</option>
                                    <option value="@ReleaseStrategy.Rollout">Rollout</option>
                                </select>
                                <div class="form-text" id="releaseStrategyHint">Direct applies this artifact to the selected runtime nodes.</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Target runtime nodes</label>
                                <div class="border rounded p-3" style="max-height: 260px; overflow-y: auto;">
                                    @if (!Model.RuntimeNodes.Any())
                                    {
                                        <div class="text-muted small">No enabled runtime nodes found.</div>
                                    }
                                    else
                                    {
                                        <div id="releaseAllowedNodesWarning" class="alert alert-warning py-2 px-3 mb-2 d-none">
                                            No node policy configured for this orchestration. Release is blocked by default.
                                        </div>
                                        <div class="od-stage-picker">
                                            @for (var i = 0; i < Model.RuntimeNodes.Count; i++)
                                            {
                                                var node = Model.RuntimeNodes.ElementAt(i);
                                                <div class="od-stage-option-wrap form-check">
                                                    <input class="form-check-input js-runtime-node-option od-stage-checkbox"
                                                           type="checkbox"
                                                           name="Input.RuntimeNodeIds"
                                                           value="@node.Id"
                                                           data-runtime-node-id="@node.Id"
                                                           id="runtimeNode_@i" />
                                                    <label class="od-stage-option" for="runtimeNode_@i">
                                                        <span class="od-stage-name">@node.Name</span>
                                                        <span class="od-stage-meta">@node.Code</span>
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="createReleaseSubmitButton">Create release</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="allowedNodesModal" tabindex="-1" aria-labelledby="allowedNodesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="SaveAllowedNodes" data-orchestrator-validate="true" data-orchestrator-busy="true" data-busy-title="Saving policy" data-busy-message="Distribution is saving the runtime node policy for this orchestration.">
                <div class="modal-header">
                    <h5 class="modal-title" id="allowedNodesModalLabel">Allowed nodes</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input asp-for="AllowedNodes.OrchestrationDefinitionId" type="hidden" id="allowedNodesOrchestrationId" />
                    <input asp-for="AllowedNodes.UpdatedBy" type="hidden" />
                    <p class="text-muted small mb-2">Only selected nodes will be eligible for releases of this orchestration.</p>
                    <div id="allowedNodesSelectionWarning" class="alert alert-warning py-2 px-3 mb-2 d-none">
                        Orchestration is required to configure runtime nodes.
                    </div>
                    <div class="border rounded p-2" style="max-height: 260px; overflow-y: auto;">
                        @if (!Model.RuntimeNodes.Any())
                        {
                            <div class="text-muted small">No enabled runtime nodes found.</div>
                        }
                        else
                        {
                            @for (var i = 0; i < Model.RuntimeNodes.Count; i++)
                            {
                                var node = Model.RuntimeNodes.ElementAt(i);
                                <div class="form-check">
                                    <input class="form-check-input js-allowed-node-option"
                                           type="checkbox"
                                           name="AllowedNodes.RuntimeNodeIds"
                                           value="@node.Id"
                                           id="allowedPolicyNode_@i" />
                                    <label class="form-check-label" for="allowedPolicyNode_@i">@node.Name (@node.Code)</label>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" id="allowedNodesCancelButton" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="saveAllowedNodesButton">Save policy</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="releaseDetailsModal" tabindex="-1" aria-labelledby="releaseDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="releaseDetailsModalLabel">Release details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="od-release-detail-head">
                    <div>
                        <div class="od-release-detail-title" id="releaseDetailsOrchestrationName"></div>
                        <div class="od-release-detail-sub" id="releaseDetailsReleaseId"></div>
                    </div>
                    <div class="od-release-detail-meta">
                        <span class="od-meta-chip" id="releaseDetailsArtifact"></span>
                        <span class="od-meta-chip" id="releaseDetailsCreated"></span>
                    </div>
                </div>
                <div id="releaseDetailsTargets" class="od-stage-grid" aria-live="polite"></div>
                <form method="post" asp-page-handler="Push" id="releasePushForm"
                      data-confirm="true" data-confirm-title="Promote artifact"
                      data-confirm-message="Push this artifact to the selected runtime node?"
                      data-confirm-accept="Push" data-confirm-type="warning"
                      data-orchestrator-busy="true" data-busy-title="Promoting artifact"
                      data-busy-message="Distribution is sending the artifact to the selected runtime node.">
                    <input type="hidden" name="releaseTargetId" />
                    <input type="hidden" name="orchestrationId" value="@Model.OrchestrationId" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="/_content/Krackend.Sagas.Orchestrations.ControlPlane.WebUI/js/orchestrator-catalog.js" asp-append-version="true"></script>
<script>
(() => {
    const artifactSelect = document.getElementById('releaseArtifactSelect');
    const strategySelect = document.getElementById('releaseStrategySelect');
    const strategyHint = document.getElementById('releaseStrategyHint');
    const nodeCheckboxes = Array.from(document.querySelectorAll('.js-runtime-node-option'));
    const warning = document.getElementById('releaseAllowedNodesWarning');
    const submitButton = document.getElementById('createReleaseSubmitButton');
    const allowedNodesModalElement = document.getElementById('allowedNodesModal');
    const allowedNodesModalLabel = document.getElementById('allowedNodesModalLabel');
    const allowedNodesOrchestrationIdInput = document.getElementById('allowedNodesOrchestrationId');
    const allowedNodesWarning = document.getElementById('allowedNodesSelectionWarning');
    const allowedNodesCheckboxes = Array.from(document.querySelectorAll('.js-allowed-node-option'));
    const saveAllowedNodesButton = document.getElementById('saveAllowedNodesButton');
    const openRuntimeNodesModalButton = document.getElementById('openRuntimeNodesModalButton');
    const releaseDetailsModalElement = document.getElementById('releaseDetailsModal');
    const releaseDetailsTargetsElement = document.getElementById('releaseDetailsTargets');
    const releaseDetailsOrchestrationNameElement = document.getElementById('releaseDetailsOrchestrationName');
    const releaseDetailsReleaseIdElement = document.getElementById('releaseDetailsReleaseId');
    const releaseDetailsArtifactElement = document.getElementById('releaseDetailsArtifact');
    const releaseDetailsCreatedElement = document.getElementById('releaseDetailsCreated');
    const releasePushForm = document.getElementById('releasePushForm');

    if (!window.bootstrap?.Modal) {
        return;
    }

    const allowedNodeIdsByOrchestration = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AllowedNodeIdsByOrchestrationId));
    const allowedNodesModal = allowedNodesModalElement ? window.bootstrap.Modal.getOrCreateInstance(allowedNodesModalElement) : null;
    const releaseDetailsModal = releaseDetailsModalElement ? window.bootstrap.Modal.getOrCreateInstance(releaseDetailsModalElement) : null;
    const selectedOrchestrationId = '@Model.OrchestrationId';
    const getSelectedOrchestrationId = () => selectedOrchestrationId;

    const updateNodeVisibility = () => {
        if (!artifactSelect || !warning || !submitButton || nodeCheckboxes.length === 0) {
            return;
        }

        const orchestrationId = getSelectedOrchestrationId();
        const allowedNodes = orchestrationId ? (allowedNodeIdsByOrchestration[orchestrationId] ?? []) : [];
        const allowedSet = new Set(allowedNodes);

        if (!orchestrationId || allowedNodes.length === 0) {
            warning.classList.remove('d-none');
            submitButton.disabled = true;
        } else {
            warning.classList.add('d-none');
            submitButton.disabled = false;
        }

        nodeCheckboxes.forEach(checkbox => {
            const nodeId = checkbox.getAttribute('data-runtime-node-id') ?? '';
            const isAllowed = orchestrationId && allowedSet.has(nodeId);

            checkbox.checked = isAllowed ? checkbox.checked : false;
            checkbox.disabled = !isAllowed;
            const wrapper = checkbox.closest('.form-check');
            if (!wrapper) return;
            wrapper.classList.toggle('d-none', !isAllowed);
        });
    };

    const updateStrategyAvailability = () => {
        if (!artifactSelect || !strategySelect || !strategyHint) {
            return;
        }

        const selected = artifactSelect.options[artifactSelect.selectedIndex];
        const type = selected?.getAttribute('data-artifact-type') ?? '';
        const rolloutAllowed = type === 'orchestration-version.new' || type === 'orchestration-version-snapshot';
        const rolloutOption = Array.from(strategySelect.options).find(option => option.value === 'Rollout');
        if (rolloutOption) {
            rolloutOption.disabled = !rolloutAllowed;
        }

        if (!rolloutAllowed && strategySelect.value === 'Rollout') {
            strategySelect.value = 'Direct';
        }

        strategyHint.textContent = rolloutAllowed
            ? 'Direct applies immediately. Rollout replaces an existing trigger owner in a controlled handoff.'
            : 'Deprecation and archive artifacts are applied directly to preserve a deterministic runtime lifecycle.';
    };

    const loadAllowedNodesForOrchestration = async (orchestrationId) => {
        if (!orchestrationId) {
            return [];
        }

        const url = `${window.location.pathname}?handler=AllowedNodes&orchestrationId=${encodeURIComponent(orchestrationId)}`;
        const response = await fetch(url, { method: 'GET' });
        if (!response.ok) {
            return allowedNodeIdsByOrchestration[orchestrationId] ?? [];
        }

        const payload = await response.json();
        return payload.runtimeNodeIds ?? [];
    };

    const openAllowedNodesForOrchestration = async (orchestrationId) => {
        if (!allowedNodesModal || !allowedNodesOrchestrationIdInput || !allowedNodesWarning || !saveAllowedNodesButton || !allowedNodesModalLabel) {
            return false;
        }

        allowedNodesOrchestrationIdInput.value = orchestrationId || '';
        allowedNodesModalLabel.textContent = 'Allowed nodes';
        if (!orchestrationId) {
            allowedNodesWarning.classList.remove('d-none');
            saveAllowedNodesButton.disabled = true;
            allowedNodesCheckboxes.forEach(checkbox => {
                checkbox.checked = false;
                checkbox.disabled = true;
            });
            allowedNodesModal.show();
            return false;
        }

        allowedNodesWarning.classList.add('d-none');
        saveAllowedNodesButton.disabled = false;

        const selectedNodes = new Set(await loadAllowedNodesForOrchestration(orchestrationId));
        allowedNodesCheckboxes.forEach(checkbox => {
            checkbox.disabled = false;
            checkbox.checked = selectedNodes.has(checkbox.value);
        });

        allowedNodesModal.show();
        return true;
    };

    let detailGeneration = 0;
    const element = (tag, className, text) => {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (text) node.textContent = text;
        return node;
    };
    const showReleaseDetails = async releaseId => {
        const catalog = document.querySelector('[data-catalog="releases"]');
        if (!releaseDetailsModal || !catalog) return;
        const generation = ++detailGeneration;
        releaseDetailsOrchestrationNameElement.textContent = 'Loading release...';
        releaseDetailsReleaseIdElement.textContent = '';
        releaseDetailsArtifactElement.textContent = '';
        releaseDetailsCreatedElement.textContent = '';
        releaseDetailsTargetsElement.replaceChildren();
        releaseDetailsModal.show();
        try {
            const url = new URL(catalog.dataset.detailSource, location.href);
            url.searchParams.set('releaseId', releaseId);
            const response = await fetch(url);
            if (!response.ok) throw new Error('Release unavailable');
            const release = await response.json();
            if (generation !== detailGeneration) return;
            releaseDetailsOrchestrationNameElement.textContent = release.orchestration;
            releaseDetailsReleaseIdElement.textContent = `ReleaseId: ${release.id}`;
            releaseDetailsArtifactElement.textContent = `Artifact: ${release.artifact}`;
            releaseDetailsCreatedElement.textContent = `Created: ${release.created}`;
            if (!release.targets.length) releaseDetailsTargetsElement.append(element('p', 'od-empty', 'No runtime targets.'));
            release.targets.forEach(target => {
                const card = element('article', 'od-stage-card');
                const head = element('div', 'od-stage-card-head');
                const identity = element('div');
                identity.append(element('h6', 'od-stage-card-title', target.name), element('p', 'od-stage-card-meta', `${target.code} - ${target.environment}`));
                const normalized = (target.status || '').toLowerCase();
                const badgeClass = ['delivered', 'acknowledged', 'activated'].includes(normalized) ? 'success' :
                    ['failed', 'cancelled'].includes(normalized) ? 'danger' : ['pending', 'availableforpull'].includes(normalized) ? 'warning' : 'info';
                const label = ['inprogress', 'pushscheduled', 'pending'].includes(normalized) ? 'Queued' : normalized === 'availableforpull' ? 'Pending' : target.status;
                head.append(identity, element('span', `od-stage-badge od-stage-badge-${badgeClass}`, label));
                const body = element('div', 'od-stage-card-body');
                const mode = element('div', 'od-stage-kv');
                const modeLabel = ({ DesignPublishesToRuntime: 'Design publishes releases', RuntimeFetchesFromDesign: 'Runtime imports releases', HybridSync: 'Both directions' })[target.mode] || target.mode || 'Unknown mode';
                mode.append(element('span', '', 'Mode'), element('strong', '', modeLabel));
                body.append(mode);
                const foot = element('div', 'od-stage-card-foot');
                if (target.canPush) {
                    const button = element('button', 'btn btn-sm btn-primary', 'Push');
                    button.type = 'button';
                    button.addEventListener('click', () => {
                        releasePushForm.elements.releaseTargetId.value = target.targetId;
                        releasePushForm.dataset.confirmMessage = `Push this artifact to ${target.name}?`;
                        releasePushForm.requestSubmit();
                    });
                    foot.append(button);
                } else foot.append(element('span', 'od-stage-note', target.activated ? 'Promoted' : target.canPull ? 'Pull by Runtime' : 'No manual action'));
                card.append(head, body, foot);
                releaseDetailsTargetsElement.append(card);
            });
        } catch {
            if (generation === detailGeneration) releaseDetailsTargetsElement.replaceChildren(element('p', 'od-empty', 'Release details could not be loaded. Please try again.'));
        }
    };

    if (openRuntimeNodesModalButton) {
        openRuntimeNodesModalButton.addEventListener('click', async () => {
            await openAllowedNodesForOrchestration(selectedOrchestrationId);
        });
    }

    document.addEventListener('click', event => {
        const button = event.target.closest('.js-open-release-details');
        if (button?.dataset.releaseId) showReleaseDetails(button.dataset.releaseId);
    });

    if (artifactSelect) {
        artifactSelect.addEventListener('change', () => {
            updateNodeVisibility();
            updateStrategyAvailability();
        });
    }
    updateNodeVisibility();
    updateStrategyAvailability();
})();
</script>
<style>
.od-orch-card {
    min-height: 0 !important;
    padding: 0.75rem 0.9rem;
}

.od-release-detail-headline {
    margin-top: 0.2rem;
}

.od-empty-state {
    min-height: 360px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
}

.od-orch-title {
    color: var(--od-text);
}

.od-release-id {
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.2;
    white-space: normal;
    overflow-wrap: anywhere;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: none;
}

.od-distribution-detail-grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
}

.od-release-detail-grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 390px), 1fr));
}

.od-release-detail-card {
    min-height: 170px;
}

.od-release-detail-card .od-status {
    align-self: center;
    white-space: nowrap;
    font-size: 0.74rem;
    padding: 0.18rem 0.62rem;
    border-radius: 999px;
}

.od-card-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: auto;
}

.od-status-queued {
    background: var(--od-warning-bg);
    border: 1px solid var(--od-warning-border);
    color: var(--od-warning-text);
}

.od-status-completed {
    background: var(--od-success-bg);
    border: 1px solid var(--od-success-border);
    color: var(--od-success-text);
}

.od-status-failed {
    background: var(--od-danger-bg);
    border: 1px solid var(--od-danger-border);
    color: var(--od-danger-text);
