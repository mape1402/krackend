@using Krackend.Sagas.Orchestrations.WebUI.Shell.Navigation
@inject OrchestratorNavigationRegistry Navigation
@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Orchestrator";
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? string.Empty;
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;

    var allItems = Navigation.GetItems();
    var designItems = allItems.Where(x => string.Equals(x.Area, "OrchestratorDesign", StringComparison.OrdinalIgnoreCase)).ToArray();
    var distributionItems = allItems.Where(x => string.Equals(x.Area, "OrchestratorDistribution", StringComparison.OrdinalIgnoreCase)).ToArray();
    var runtimeItems = allItems.Where(x => string.Equals(x.Area, "OrchestratorRuntime", StringComparison.OrdinalIgnoreCase)).ToArray();
    var securityItems = allItems.Where(x => string.Equals(x.Area, "OrchestratorSecurity", StringComparison.OrdinalIgnoreCase)).ToArray();

    bool IsActive(OrchestratorNavigationItem item) =>
        string.Equals(currentArea, item.Area, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentPage, item.Page, StringComparison.OrdinalIgnoreCase);

    var designExpanded = designItems.Any(IsActive);
    var distributionExpanded = distributionItems.Any(IsActive);
    var runtimeExpanded = runtimeItems.Any(IsActive);
    var securityExpanded = securityItems.Any(IsActive);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - Orchestrator</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/_content/Krackend.Sagas.Orchestrations.WebUI.Shell/css/orchestrator-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Krackend.Sagas.Orchestrations.ControlPlane.WebUI/css/orchestrator-design.css" asp-append-version="true" />
    @RenderSection("Head", required: false)
</head>
<body>
    <div class="app-shell" id="orchestratorAppShell">
        <nav class="sidebar" id="orchestratorSidebar">
            <div class="sidebar-brand">
                <a class="brand-link" asp-area="OrchestratorDesign" asp-page="/Orchestrations/Index">
                    <span class="brand-icon"><i class="bi bi-diagram-3-fill"></i></span>
                    <span class="brand-name">Orchestrator</span>
                </a>
            </div>
            <div class="sidebar-nav">
                <div class="nav-group">
                    <button class="nav-group-toggle @(designExpanded ? string.Empty : "collapsed")"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#orchestrator-nav-design"
                            aria-expanded="@(designExpanded ? "true" : "false")">
                        <i class="bi bi-vector-pen nav-icon"></i>
                        <span class="nav-label">Design</span>
                        <i class="bi bi-chevron-down nav-caret"></i>
                    </button>
                    <div id="orchestrator-nav-design" class="collapse nav-group-items @(designExpanded ? "show" : string.Empty)">
                        @foreach (var item in designItems)
                        {
                            var active = IsActive(item);
                            <a class="nav-item-link nav-child @(active ? "active" : string.Empty)"
                               asp-area="@item.Area"
                               asp-page="@item.Page"
                               aria-current="@(active ? "page" : null)">
                                <span>@item.Label</span>
                            </a>
                        }
                    </div>
                </div>

                <div class="nav-group">
                    <button class="nav-group-toggle @(distributionExpanded ? string.Empty : "collapsed")"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#orchestrator-nav-distribution"
                            aria-expanded="@(distributionExpanded ? "true" : "false")">
                        <i class="bi bi-signpost-split nav-icon"></i>
                        <span class="nav-label">Distribution</span>
                        <i class="bi bi-chevron-down nav-caret"></i>
                    </button>
                    <div id="orchestrator-nav-distribution" class="collapse nav-group-items @(distributionExpanded ? "show" : string.Empty)">
                        @foreach (var item in distributionItems)
                        {
                            var active = IsActive(item);
                            <a class="nav-item-link nav-child @(active ? "active" : string.Empty)"
                               asp-area="@item.Area"
                               asp-page="@item.Page"
                               aria-current="@(active ? "page" : null)">
                                <span>@item.Label</span>
                            </a>
                        }
                    </div>
                </div>

                <div class="nav-group">
                    <button class="nav-group-toggle @(securityExpanded ? string.Empty : "collapsed")"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#orchestrator-nav-security"
                            aria-expanded="@(securityExpanded ? "true" : "false")">
                        <i class="bi bi-shield-lock nav-icon"></i>
                        <span class="nav-label">Security</span>
                        <i class="bi bi-chevron-down nav-caret"></i>
                    </button>
                    <div id="orchestrator-nav-security" class="collapse nav-group-items @(securityExpanded ? "show" : string.Empty)">
                        @foreach (var item in securityItems)
                        {
                            var active = IsActive(item);
                            <a class="nav-item-link nav-child @(active ? "active" : string.Empty)"
                               asp-area="@item.Area"
                               asp-page="@item.Page"
                               aria-current="@(active ? "page" : null)">
                                <span>@item.Label</span>
                            </a>
                        }
                    </div>
                </div>

                <div class="nav-group">
                    <button class="nav-group-toggle @(runtimeExpanded ? string.Empty : "collapsed")"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#orchestrator-nav-runtime"
                            aria-expanded="@(runtimeExpanded ? "true" : "false")">
                        <i class="bi bi-cpu nav-icon"></i>
                        <span class="nav-label">Runtime</span>
                        <i class="bi bi-chevron-down nav-caret"></i>
                    </button>
                    <div id="orchestrator-nav-runtime" class="collapse nav-group-items @(runtimeExpanded ? "show" : string.Empty)">
                        @foreach (var item in runtimeItems)
                        {
                            var active = IsActive(item);
                            <a class="nav-item-link nav-child @(active ? "active" : string.Empty)"
                               asp-area="@item.Area"
                               asp-page="@item.Page"
                               aria-current="@(active ? "page" : null)">
                                <span>@item.Label</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>

        <div class="content-shell">
            <header class="topbar">
                <div class="topbar-left">
                    <button id="sidebar-toggle" class="hamburger-btn" type="button" aria-label="Toggle sidebar">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="topbar-title">@pageTitle</span>
                </div>
                <div class="topbar-actions">
                    <span class="topbar-badge">Development</span>
                </div>
            </header>
            <main class="content-body">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/_content/Krackend.Sagas.Orchestrations.WebUI.Shell/js/orchestrator-shell.js" asp-append-version="true"></script>
    <script src="~/_content/Krackend.Sagas.Orchestrations.WebUI.Shell/js/orchestrator-messages.js" asp-append-version="true"></script>
    @if (TempData["OrchestratorMessage.Title"] is string messageTitle)
    {
        <script>
            window.OrchestratorMessages?.notify({
                title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(messageTitle)),
                message: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["OrchestratorMessage.Body"]?.ToString() ?? string.Empty)),
                type: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["OrchestratorMessage.Type"]?.ToString() ?? "info"))
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
