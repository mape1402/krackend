@page
@using Zoorce.Web.UI.Abstractions.Data
@using Zoorce.Web.UI.DataGrid
@using Zoorce.Web.UI.Foundation.Components
@using Microsoft.AspNetCore.Html
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Design.Areas.OrchestratorDesign.Pages.Orchestrations.IndexModel
@{
    ViewData["Title"] = "Orchestrations";
}

<div class="od-create-floating">@await Component.InvokeAsync("ZoorceFloatingActionButton", new ZoorceFloatingActionButtonOptions { Id = "createOrchestrationButton", Label = "Create orchestration", Icon = "+" })</div>

<section class="od-catalog" data-catalog="orchestrations" data-label="orchestrations" data-source="@Url.Page(null, "List")">
    <div class="od-catalog-controls" role="group" aria-label="View mode">
        <button type="button" class="btn btn-outline-secondary" data-catalog-view="grid" aria-label="Grid view" title="Grid view" aria-pressed="true"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
        <button type="button" class="btn btn-outline-secondary" data-catalog-view="cards" aria-label="Card view" title="Card view" aria-pressed="false"><i class="bi bi-grid-3x2-gap" aria-hidden="true"></i></button>
    </div>
    <div data-catalog-grid>
        @await Component.InvokeAsync("ZoorceDataGrid", new ZoorceDataGridOptions
        {
            Id = "orchestrations-grid", AriaLabel = "orchestrations", Binding = new ZoorceDataBindingOptions { Source = Url.Page(null, "List") },
            LoadMode = ZoorceDataLoadMode.InfiniteScroll, PageSize = 25,
            Columns = [new("displayName", "Name"), new("key", "Key"), new("domain", "Domain"), new("status", "Status"), new("actions", "Actions", false)]
        })
    </div>
    <div data-catalog-cards hidden>
        <div class="od-catalog-filters">
            <label class="z-search-field"><span aria-hidden="true">⌕</span><input type="search" data-catalog-search aria-label="Search orchestrations" placeholder="Search orchestrations" autocomplete="off" /></label>
            <select class="form-select" data-catalog-sort aria-label="Sort orchestrations">
                <option value="displayName">Name: A to Z</option><option value="displayName:desc">Name: Z to A</option>
                <option value="key">Key: A to Z</option><option value="key:desc">Key: Z to A</option><option value="domain">Domain</option><option value="status">Status</option>
            </select>
        </div>
        <div class="od-grid" data-catalog-card-items></div>
        <p class="od-empty" data-catalog-empty hidden>No matching orchestrations.</p>
        <p data-catalog-status aria-live="polite"></p>
        <div data-catalog-sentinel aria-hidden="true"></div>
        <button type="button" class="btn btn-outline-secondary" data-catalog-more hidden>Load more</button>
    </div>
    <form method="post" asp-page-handler="SetActive" data-catalog-action-form data-active-url="@Url.Page(null, "SetActive")" data-inactive-url="@Url.Page(null, "SetInactive")">
        <input type="hidden" name="orchestrationId" />
    </form>
</section>

@await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions
{
    Id = "createOrchestrationModal", Title = "Create orchestration", Eyebrow = null, Size = "wide",
    Body = await Html.PartialAsync("_OrchestrationForm", Model),
    Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Cancel</button><button type=\"submit\" form=\"orchestrationForm\" class=\"z-button z-button-primary\" id=\"orchestrationModalSubmitButton\">Create</button>")
})

@section Scripts {
<script>
(() => {
    const modalElement = document.getElementById('createOrchestrationModal');
    const modalTitle = document.getElementById('createOrchestrationModal-title');
    const submitButton = document.getElementById('orchestrationModalSubmitButton');
    const orchestrationIdInput = document.getElementById('orchestrationModalOrchestrationId');
    const updatedByInput = document.getElementById('orchestrationModalUpdatedBy');
    const keyInput = document.getElementById('orchestrationModalKey');
    const nameInput = document.getElementById('orchestrationModalName');
    const domainInput = document.getElementById('orchestrationModalDomainText');
    const domainIdInput = document.getElementById('orchestrationModalDomainId');
    const ownerTeamTextInput = document.getElementById('orchestrationModalOwnerTeamText');
    const ownerTeamIdInput = document.getElementById('orchestrationModalOwnerTeamId');
    const descriptionInput = document.getElementById('orchestrationModalDescription');
    const tagsHiddenInput = document.getElementById('orchestrationModalTagsHidden');
    if (!modalElement || !modalTitle || !submitButton || !orchestrationIdInput || !updatedByInput || !keyInput || !nameInput || !domainInput || !domainIdInput || !ownerTeamTextInput || !ownerTeamIdInput || !descriptionInput || !tagsHiddenInput) {
        return;
    }

    const createButton = document.getElementById('createOrchestrationButton');

    function normalize(value) {
        return (value || '').trim();
    }

    function initializeChipEditors() {
        document.querySelectorAll('.od-chip-editor[data-chip-editor-for]').forEach(editor => {
            const targetId = editor.getAttribute('data-chip-editor-for');
            const hiddenInput = targetId ? document.getElementById(targetId) : null;
            const list = editor.querySelector('.od-chip-list');
            const input = editor.querySelector('.od-chip-input');
            if (!hiddenInput || !list || !input) {
                return;
            }

            const values = new Set(
                (hiddenInput.value || '')
                    .split(',')
                    .map(x => x.trim())
                    .filter(x => x.length > 0));

            function loadFromHidden() {
                values.clear();
                (hiddenInput.value || '')
                    .split(',')
                    .map(x => x.trim())
                    .filter(x => x.length > 0)
                    .forEach(x => values.add(x));
            }

            function syncHidden() {
                hiddenInput.value = Array.from(values).join(',');
            }

            function render() {
                list.innerHTML = '';

                values.forEach(value => {
                    const chip = document.createElement('span');
                    chip.className = 'od-input-chip';

                    const label = document.createElement('span');
                    label.textContent = value;
                    chip.appendChild(label);

                    const remove = document.createElement('button');
                    remove.type = 'button';
                    remove.className = 'od-chip-remove';
                    remove.setAttribute('aria-label', `Remove ${value}`);
                    remove.textContent = 'x';
                    remove.addEventListener('click', () => {
                        values.delete(value);
                        syncHidden();
                        render();
                    });

                    chip.appendChild(remove);
                    list.appendChild(chip);
                });
            }

            function addFromInput() {
                const raw = input.value || '';
                const pieces = raw.split(',').map(x => x.trim()).filter(x => x.length > 0);
                if (pieces.length === 0) {
                    input.value = '';
                    return;
                }

                pieces.forEach(piece => values.add(piece));
                input.value = '';
                syncHidden();
                render();
            }

            input.addEventListener('keydown', event => {
                if (event.key === 'Enter' || event.key === ',') {
                    event.preventDefault();
                    addFromInput();
                }
            });

            input.addEventListener('blur', addFromInput);
            hiddenInput.addEventListener('change', () => {
                loadFromHidden();
                render();
            });

            loadFromHidden();
            syncHidden();
            render();
        });
    }

    function openCreateMode(opener) {
        modalTitle.textContent = 'Create orchestration';
        submitButton.textContent = 'Create';
        orchestrationIdInput.value = '';
        updatedByInput.value = 'web-ui';
        keyInput.readOnly = false;
        keyInput.value = '';
        nameInput.value = '';
        domainInput.value = '';
        domainIdInput.value = '';
        ownerTeamTextInput.value = '';
        ownerTeamIdInput.value = '';
        descriptionInput.value = '';
        tagsHiddenInput.value = '';
        tagsHiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
        modalElement.open?.(opener);
    }

    function openEditMode(card, opener) {
        if (!card) {
            return;
        }

        modalTitle.textContent = 'Edit orchestration';
        submitButton.textContent = 'Save';
        orchestrationIdInput.value = normalize(card.getAttribute('data-orchestration-id'));
        updatedByInput.value = 'web-ui';
        keyInput.value = normalize(card.getAttribute('data-orchestration-key'));
        keyInput.readOnly = true;
        nameInput.value = normalize(card.getAttribute('data-orchestration-name'));
        domainInput.value = normalize(card.getAttribute('data-orchestration-domain-display'));
        domainIdInput.value = normalize(card.getAttribute('data-orchestration-domain-id'));
        ownerTeamTextInput.value = normalize(card.getAttribute('data-orchestration-owner-team-display'));
        ownerTeamIdInput.value = normalize(card.getAttribute('data-orchestration-owner-team-id'));
        descriptionInput.value = card.getAttribute('data-orchestration-description') || '';
        tagsHiddenInput.value = normalize(card.getAttribute('data-orchestration-tags'));
        tagsHiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
        modalElement.open?.(opener);
    }

    if (createButton) {
        createButton.addEventListener('click', event => {
            event.preventDefault();
            openCreateMode(createButton);
        });
    }

    document.addEventListener('click', event => {
        const button = event.target.closest('.js-open-orchestration-modal[data-mode="edit"]');
        if (!button) return;
        event.preventDefault();
        openEditMode(button.closest('.js-orchestration-card'), button);
    });

    initializeChipEditors();

    @if (HttpContext.Request.Method == "POST" && string.Equals(HttpContext.Request.Query["handler"], "Upsert", StringComparison.OrdinalIgnoreCase) && !ViewData.ModelState.IsValid)
    {
        <text>
        if (orchestrationIdInput.value) {
            modalTitle.textContent = 'Edit orchestration';
            submitButton.textContent = 'Save';
            keyInput.readOnly = true;
        }
        modalElement.open?.();
        </text>
    }

    const domainSuggestions = document.getElementById(domainInput.getAttribute('data-domain-suggestions-container') || '');
    const teamSuggestions = document.getElementById(ownerTeamTextInput.getAttribute('data-team-suggestions-container') || '');
    if (!domainSuggestions || !teamSuggestions) {
        return;
    }

    const escapeHtml = (value) => (value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

    const hideSuggestions = () => {
        domainSuggestions.classList.add('d-none');
        domainSuggestions.innerHTML = '';
    };

    const renderSuggestions = (rows) => {
        if (!rows.length) {
            hideSuggestions();
            return;
        }

        domainSuggestions.innerHTML = rows.map(x => `
            <button type="button" class="od-autocomplete-item"
                data-id="${escapeHtml(x.id)}"
                data-value="${escapeHtml(`${x.displayName} (${x.key})`)}">
                <span class="od-autocomplete-title">${escapeHtml(x.displayName)} (${escapeHtml(x.key)})</span>
                <span class="od-autocomplete-meta">${escapeHtml(x.description || '')}</span>
            </button>`).join('');
        domainSuggestions.classList.remove('d-none');
    };

    let domainSearchToken = 0;
    const fetchDomainSuggestions = async () => {
        const q = domainInput.value.trim();
        const currentToken = ++domainSearchToken;
        if (!q) {
            domainIdInput.value = '';
            hideSuggestions();
            return;
        }

        const url = `${window.location.pathname}?handler=DomainSuggestions&term=${encodeURIComponent(q)}`;
        try {
            const response = await fetch(url);
            if (!response.ok) throw new Error('Domain suggestions unavailable');
            const rows = await response.json();
            if (currentToken === domainSearchToken) renderSuggestions(rows);
        } catch { if (currentToken === domainSearchToken) hideSuggestions(); }
    };

    domainInput.addEventListener('input', () => {
        domainIdInput.value = '';
        fetchDomainSuggestions();
    });

    domainInput.addEventListener('blur', () => { domainSearchToken++; setTimeout(hideSuggestions, 150); });

    domainSuggestions.addEventListener('click', event => {
        const item = event.target.closest('.od-autocomplete-item');
        if (!item) return;
        domainSearchToken++;
        domainIdInput.value = item.getAttribute('data-id') || '';
        domainInput.value = item.getAttribute('data-value') || '';
        hideSuggestions();
    });

    const hideTeamSuggestions = () => {
        teamSuggestions.classList.add('d-none');
        teamSuggestions.innerHTML = '';
    };

    const renderTeamSuggestions = (rows) => {
        if (!rows.length) {
            hideTeamSuggestions();
            return;
        }

        teamSuggestions.innerHTML = rows.map(x => `
            <button type="button" class="od-autocomplete-item"
                data-id="${escapeHtml(x.id)}"
                data-value="${escapeHtml(`${x.displayName} (${x.key})`)}">
                <span class="od-autocomplete-title">${escapeHtml(x.displayName)} (${escapeHtml(x.key)})</span>
            </button>`).join('');
        teamSuggestions.classList.remove('d-none');
    };

    let teamSearchToken = 0;
    const fetchTeamSuggestions = async () => {
        const q = ownerTeamTextInput.value.trim();
        const currentToken = ++teamSearchToken;
        if (!q) {
            ownerTeamIdInput.value = '';
            hideTeamSuggestions();
            return;
        }

        const url = `${window.location.pathname}?handler=TeamSuggestions&term=${encodeURIComponent(q)}`;
        try {
            const response = await fetch(url);
            if (!response.ok) throw new Error('Team suggestions unavailable');
            const rows = await response.json();
            if (currentToken === teamSearchToken) renderTeamSuggestions(rows);
        } catch { if (currentToken === teamSearchToken) hideTeamSuggestions(); }
    };

    ownerTeamTextInput.addEventListener('input', () => {
        ownerTeamIdInput.value = '';
        fetchTeamSuggestions();
    });

    ownerTeamTextInput.addEventListener('blur', () => { teamSearchToken++; setTimeout(hideTeamSuggestions, 150); });

    teamSuggestions.addEventListener('click', event => {
        const item = event.target.closest('.od-autocomplete-item');
        if (!item) return;
        teamSearchToken++;
        ownerTeamIdInput.value = item.getAttribute('data-id') || '';
        ownerTeamTextInput.value = item.getAttribute('data-value') || '';
        hideTeamSuggestions();
    });
})();
</script>
<script src="~/_content/Krackend.Sagas.Orchestrations.ControlPlane.WebUI/js/orchestrator-catalog.js" asp-append-version="true"></script>
}
