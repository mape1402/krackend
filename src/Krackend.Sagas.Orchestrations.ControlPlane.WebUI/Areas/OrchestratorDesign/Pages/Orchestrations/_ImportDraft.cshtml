@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Design.Areas.OrchestratorDesign.Pages.Orchestrations.DetailsModel
<form id="importDraftForm" method="post" enctype="multipart/form-data" asp-page-handler="ImportDraft" data-orchestrator-validate="true" data-orchestrator-busy="true" data-busy-title="Importing draft" data-busy-message="Krackend is validating the package and building a local Draft.">
    <input type="hidden" name="orchestrationId" value="@Model.OrchestrationId" />
    <div class="d-grid gap-3">
        <div>
            <label class="z-field-label" for="importPackage">Orchestration version package</label>
            <input id="importPackage" class="z-form-input" type="file" name="importPackage" accept="application/json,.json" required />
            <p id="importPackageInspection" class="od-import-inspection" aria-live="polite"></p>
        </div>
        <p class="od-item-meta mb-0">Import creates a fresh Draft in this orchestration only. It never overwrites a version, creates a new orchestration, or deploys anything.</p>
    </div>
</form>
