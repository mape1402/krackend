@page
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Design.Areas.OrchestratorDesign.Pages.Orchestrations.DetailsModel
@using Krackend.Sagas.Orchestrations.Abstractions.Primitives
@using Zoorce.Web.UI.Abstractions.Data
@using Zoorce.Web.UI.DataGrid
@using Zoorce.Web.UI.Foundation.Components
@using Microsoft.AspNetCore.Html
@{ ViewData["Title"] = Model.Orchestration is null ? "Orchestration details" : $"{Model.Orchestration.Name} \u00b7 {Model.Orchestration.Key}"; }
<div class="od-create-floating">@await Component.InvokeAsync("ZoorceFloatingActionButton", new ZoorceFloatingActionButtonOptions { Id = "openNewVersion", Label = "New version", Icon = "+" })</div>
<button type="button" class="z-button z-button-ghost od-portability-action" id="openImportDraft">Import draft</button>

<section class="od-catalog" data-version-catalog data-source="@Url.Page(null, "Versions", new { orchestrationId = Model.OrchestrationId })"
         data-action-url="@Url.Page(null, "VersionAction")" data-orchestration-id="@Model.OrchestrationId"
         data-export-url="@Url.Page(null, "ExportDraft")"
         data-roadmap-url="@Url.Page("/OrchestrationVersions/Details", new { area = "OrchestratorDesign", orchestrationId = Model.OrchestrationId, versionId = "__versionId__" })">
    <div class="od-catalog-controls" role="group" aria-label="View mode">
        <button type="button" class="z-button z-button-ghost od-view-toggle" data-version-view="grid" aria-label="Grid view" title="Grid view" aria-pressed="true"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
        <button type="button" class="z-button z-button-ghost od-view-toggle" data-version-view="cards" aria-label="Card view" title="Card view" aria-pressed="false"><i class="bi bi-grid-3x2-gap" aria-hidden="true"></i></button>
    </div>
    <div data-version-grid>
        @await Component.InvokeAsync("ZoorceDataGrid", new ZoorceDataGridOptions {
            Id = "orchestration-versions-grid", AriaLabel = "orchestration versions", Binding = new ZoorceDataBindingOptions { Source = Url.Page(null, "Versions", new { orchestrationId = Model.OrchestrationId }) },
            LoadMode = ZoorceDataLoadMode.InfiniteScroll, PageSize = 25,
            Columns = [new("version", "Version", false), new("versionLabel", "Label", false), new("statusLabel", "Status", false), new("createdOnUtc", "Created", false), new("actions", "Actions", false)]
        })
    </div>
    <div data-version-cards-view hidden>
        <div class="od-catalog-filters"><label class="z-search-field"><span aria-hidden="true">&#x2315;</span><input type="search" data-version-search aria-label="Search versions" placeholder="Search version or label" /></label></div>
        <div class="od-grid od-versions-grid" data-version-cards></div>
        <p data-version-empty hidden>No matching versions.</p>
        <p data-version-status aria-live="polite"></p>
        <div data-version-sentinel aria-hidden="true"></div>
        <button type="button" class="z-button z-button-ghost" data-version-more hidden>Load more</button>
    </div>
    <form method="post" id="version-catalog-token" hidden>@Html.AntiForgeryToken()</form>
</section>

@await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions {
    Id = "newVersionModal", Title = "Create draft", Eyebrow = null,
    Body = await Html.PartialAsync("_CreateDraft", Model),
    Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Cancel</button><button type=\"submit\" form=\"createDraftForm\" class=\"z-button z-button-primary\" id=\"versionModalSubmitButton\">Create draft</button>")
})

@await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions {
    Id = "importDraftModal", Title = "Import draft", Eyebrow = "Portable orchestration version", Size = "medium",
    Body = await Html.PartialAsync("_ImportDraft", Model),
    Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Cancel</button><button type=\"submit\" form=\"importDraftForm\" class=\"z-button z-button-primary\" id=\"importDraftSubmit\" disabled>Import draft</button>")
})

@section Scripts {
<script src="~/_content/Krackend.Sagas.Orchestrations.ControlPlane.WebUI/js/orchestrator-versions.js" asp-append-version="true"></script>
<script>
document.getElementById('openNewVersion')?.addEventListener('click', event =>
    document.getElementById('newVersionModal')?.open?.(event.currentTarget));
document.getElementById('openImportDraft')?.addEventListener('click', event =>
    document.getElementById('importDraftModal')?.open?.(event.currentTarget));

(() => {
    const input = document.getElementById('importPackage');
    const message = document.getElementById('importPackageInspection');
    const submit = document.getElementById('importDraftSubmit');
    const newTarget = document.getElementById('importNewTarget');
    const importAsNew = document.getElementById('importAsNew');
    const name = document.getElementById('importNewName');
    const description = document.getElementById('importNewDescription');
    if (!input || !message || !submit || !newTarget || !importAsNew || !name || !description) return;
    const setTargetVisibility = () => {
        const enabled = importAsNew.checked;
        newTarget.hidden = !enabled;
        newTarget.querySelectorAll('[data-import-target-required]').forEach(field => field.required = enabled);
    };
    importAsNew.addEventListener('change', setTargetVisibility);
    setTargetVisibility();
    input.addEventListener('change', async () => {
        submit.disabled = true;
        if (!input.files?.length) { message.textContent = ''; return; }
        message.textContent = 'Checking package…';
        const data = new FormData(); data.append('importPackage', input.files[0]);
        const token = document.querySelector('#version-catalog-token input[name="__RequestVerificationToken"]')?.value;
        try {
            const response = await fetch('@Url.Page(null, "InspectImport")', { method: 'POST', headers: token ? { RequestVerificationToken: token } : {}, body: data });
            const result = await response.json();
            message.textContent = result.message || 'Package could not be inspected.';
            message.classList.toggle('od-import-invalid', !result.isValid);
            submit.disabled = !result.isValid;
            if (result.isValid) {
                if (!name.value) name.value = result.orchestrationName || result.orchestrationKey || '';
                if (!description.value) description.value = result.orchestrationDescription || '';
            }
        } catch { message.textContent = 'Package could not be inspected.'; message.classList.add('od-import-invalid'); }
    });
})();

(() => {
    const escapeHtml = value => (value || '').replace(/[&<>"']/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);
    const bindAutocomplete = (textId, valueId, suggestionsId, endpoint, includeDescription) => {
        const text = document.getElementById(textId);
        const value = document.getElementById(valueId);
        const suggestions = document.getElementById(suggestionsId);
        if (!text || !value || !suggestions) return;
        let requestToken = 0;
        const hide = () => { suggestions.classList.add('d-none'); suggestions.innerHTML = ''; };
        const search = async () => {
            const query = text.value.trim();
            const token = ++requestToken;
            value.value = '';
            if (!query) { hide(); return; }
            const url = new URL(endpoint, window.location.origin);
            url.searchParams.set('term', query);
            try {
                const response = await fetch(url);
                const rows = response.ok ? await response.json() : [];
                if (token !== requestToken || !rows.length) { if (token === requestToken) hide(); return; }
                suggestions.innerHTML = rows.map(row => `<button type="button" class="od-autocomplete-item" data-id="${escapeHtml(row.id)}" data-value="${escapeHtml(`${row.displayName} (${row.key})`)}"><span class="od-autocomplete-title">${escapeHtml(row.displayName)} (${escapeHtml(row.key)})</span>${includeDescription ? `<span class="od-autocomplete-meta">${escapeHtml(row.description || '')}</span>` : ''}</button>`).join('');
                suggestions.classList.remove('d-none');
            } catch { if (token === requestToken) hide(); }
        };
        text.addEventListener('input', search);
        text.addEventListener('blur', () => { requestToken++; setTimeout(hide, 150); });
        suggestions.addEventListener('click', event => {
            const item = event.target.closest('.od-autocomplete-item');
            if (!item) return;
            requestToken++;
            value.value = item.dataset.id || '';
            text.value = item.dataset.value || '';
            hide();
        });
    };
    bindAutocomplete('importNewDomainText', 'importNewDomainId', 'importDomainSuggestions', '@Url.Page(null, "ImportDomainSuggestions")', true);
    bindAutocomplete('importNewTeamText', 'importNewTeamId', 'importTeamSuggestions', '@Url.Page(null, "ImportTeamSuggestions")', false);
})();
</script>
}

