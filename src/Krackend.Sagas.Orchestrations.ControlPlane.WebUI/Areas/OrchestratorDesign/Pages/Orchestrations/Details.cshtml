@page
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Design.Areas.OrchestratorDesign.Pages.Orchestrations.DetailsModel
@using Krackend.Sagas.Orchestrations.Abstractions.Primitives
@{
    ViewData["Title"] = "Orchestration details";

    string StatusClass(OrchestrationVersionStatus status)
    {
        return status switch
        {
            OrchestrationVersionStatus.Draft => "od-status od-status-draft",
            OrchestrationVersionStatus.PendingDeployment or OrchestrationVersionStatus.PendingDeprecation or OrchestrationVersionStatus.PendingArchive => "od-status od-status-inreview",
            OrchestrationVersionStatus.Deployed => "od-status od-status-deployed",
            OrchestrationVersionStatus.Deprecated => "od-status od-status-deprecated",
            OrchestrationVersionStatus.Archived or OrchestrationVersionStatus.Abandoned => "od-status od-status-archived",
            _ => "od-status od-status-draft"
        };
    }

    string StatusLabel(OrchestrationVersionStatus status)
    {
        return status switch
        {
            OrchestrationVersionStatus.PendingDeployment => "Pending deployment review",
            OrchestrationVersionStatus.PendingDeprecation => "Pending deprecation review",
            OrchestrationVersionStatus.PendingArchive => "Pending archive review",
            _ => status.ToString()
        };
    }

    string ActionLabel(string action)
    {
        return action switch
        {
            "RequestDeployment" => "Send to deployment review",
            "RequestDeprecation" => "Request deprecation",
            "RequestArchive" => "Request archive",
            "OpenReview" => "Open review",
            "Abandon" => "Abandon draft",
            _ => action
        };
    }

    string FormatTimestamp(string value)
    {
        if (DateTimeOffset.TryParse(value, out var parsed))
        {
            return parsed.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
        }

        return value;
    }
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">@Model.Orchestration?.Name</h1>
        <p class="od-page-subtitle">@Model.Orchestration?.Key</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="OrchestratorDesign" asp-page="/Orchestrations/Index" class="btn btn-outline-secondary">Back</a>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newVersionModal">New version</button>
    </div>
</div>

<section class="od-list-shell">
    @if (!Model.Versions.Any())
    {
        <p class="od-empty">No versions yet.</p>
    }
    else
    {
        <div class="od-grid od-versions-grid">
            @foreach (var version in Model.Versions)
            {
                <article class="od-item-card od-version-card"
                         data-version-id="@version.Id"
                         data-open-url="@Url.Page("/OrchestrationVersions/Details", new { area = "OrchestratorDesign", orchestrationId = Model.OrchestrationId, versionId = version.Id })">
                    <div class="od-item-top">
                        <div>
                            <h3 class="od-item-title">@(string.IsNullOrWhiteSpace(version.Version) ? "Draft" : version.Version)</h3>
                            <p class="od-item-meta">@version.VersionLabel</p>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            <span class="@StatusClass(version.Status)">@StatusLabel(version.Status)</span>
                            <div class="dropdown">
                                <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Version actions">&#8942;</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="OrchestratorDesign"
                                           asp-page="/OrchestrationVersions/Details"
                                           asp-route-orchestrationId="@Model.OrchestrationId"
                                           asp-route-versionId="@version.Id">Open roadmap</a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    @foreach (var action in Model.GetAllowedActions(version.Status))
                                    {
                                        <li>
                                            <form method="post" asp-page-handler="VersionAction" class="od-inline-form" data-orchestrator-validate="false" data-orchestrator-busy="true" data-busy-title="Updating version" data-busy-message="Design is applying the selected version transition.">
                                                <input type="hidden" name="orchestrationId" value="@Model.OrchestrationId" />
                                                <input type="hidden" name="versionId" value="@version.Id" />
                                                <input type="hidden" name="action" value="@action" />
                                                <button type="submit" formnovalidate class="dropdown-item @(action == "Abandon" ? "text-danger" : string.Empty)">@ActionLabel(action)</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                    <p class="od-item-description">@version.Description</p>
                    <p class="od-item-meta od-item-time mt-auto">Created: @FormatTimestamp(version.CreatedOnUtc)</p>
                </article>
            }
        </div>
    }
</section>

<div class="modal fade" id="newVersionModal" tabindex="-1" aria-labelledby="newVersionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateVersion" data-orchestrator-validate="true" data-orchestrator-busy="true" data-busy-title="Saving version" data-busy-message="Design is validating and storing the orchestration version.">
                <div class="modal-header">
                    <h5 class="modal-title" id="newVersionModalLabel">Create version</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="orchestrationId" value="@Model.OrchestrationId" />
                    <p class="mb-0">Create a new editable draft from the latest non-archived roadmap. Its version number, label, and description are set only when an approved deployment review is applied.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="versionModalSubmitButton">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.querySelectorAll('.od-version-card[data-open-url]').forEach(card => {
    card.addEventListener('click', event => {
        if (event.target.closest('a, button, input, textarea, select, label, form, .dropdown')) return;
        window.location.href = card.getAttribute('data-open-url') || window.location.href;
    });
});
</script>
}

