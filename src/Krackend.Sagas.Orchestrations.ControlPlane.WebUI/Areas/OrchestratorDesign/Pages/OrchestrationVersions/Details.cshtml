<meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />

@section Scripts {
<script src="/_content/ButterMorph.Web.Razor/buttermorph/buttermorph-host.js?v=2.0.0"></script>
<script>
const orchestrationVersionCanEdit = @Model.CanEdit.ToString().ToLowerInvariant();
const orchestrationVersionId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SelectedVersion?.Id ?? Model.VersionId));

function setVersionModalReadOnly(modalElement, readOnly, submitButton) {
    if (!modalElement) {
        return;
    }

    modalElement.querySelectorAll('input, textarea, select').forEach(element => {
        const type = (element.getAttribute('type') || '').toLowerCase();
        if (type === 'hidden') {
            return;
        }

        if (element.tagName === 'TEXTAREA' || (element.tagName === 'INPUT' && type !== 'checkbox' && type !== 'radio')) {
            element.readOnly = readOnly;
            element.toggleAttribute('readonly', readOnly);
            return;
        }

        element.disabled = readOnly;
    });

    if (submitButton) {
        submitButton.classList.toggle('d-none', readOnly);
        submitButton.disabled = readOnly;
    }

    const dismissButton = modalElement.querySelector('.modal-footer [data-bs-dismiss="modal"]');
    if (dismissButton) {
        dismissButton.textContent = readOnly ? 'Close' : 'Cancel';
    }
}

(() => {
    const pipeline = document.getElementById('stagePipeline');
    if (!pipeline) return;

    const canEdit = orchestrationVersionCanEdit;

    const antiForgeryToken = document.querySelector('meta[name="request-verification-token"]')?.getAttribute('content') || '';
    let dragged = null;

    pipeline.addEventListener('dragstart', event => {
        if (!canEdit) {
            event.preventDefault();
            return;
        }

        const card = event.target.closest('.od-pipeline-item');
        if (!card || card.classList.contains('od-add-item')) {
            event.preventDefault();
            return;
        }

        dragged = card;
        card.classList.add('dragging');
        event.dataTransfer.effectAllowed = 'move';
        event.dataTransfer.setData('text/plain', card.dataset.stageId || '');
    });

    pipeline.addEventListener('dragend', async () => {
        if (!canEdit) {
            return;
        }

        if (!dragged) {
            return;
        }

        dragged.classList.remove('dragging');
        dragged = null;
        await persistOrder();
    });

    pipeline.addEventListener('dragover', event => {
        if (!canEdit) {
            return;
        }

        event.preventDefault();
        if (!dragged) {
            return;
        }

        const target = event.target.closest('.od-pipeline-item');
        if (!target || target === dragged) {
            return;
        }

        if (target.classList.contains('od-add-item')) {
            pipeline.insertBefore(dragged, target);
            return;
        }

        const targetRect = target.getBoundingClientRect();
        const shouldPlaceBefore = event.clientX < targetRect.left + (targetRect.width / 2);
        pipeline.insertBefore(dragged, shouldPlaceBefore ? target : target.nextSibling);
    });

    pipeline.addEventListener('click', event => {
        if (event.target.closest('a, button, input, select, textarea, label, .form-check')) {
            return;
        }

        if (event.target.closest('.js-stage-execution-btn')) {
            return;
        }

        if (event.target.closest('.dropdown')) {
            return;
        }

        const card = event.target.closest('.od-pipeline-item');
        if (!card || card.classList.contains('od-add-item') || card.classList.contains('dragging')) {
            return;
        }

        const stageId = card.dataset.stageId;
        if (!stageId) {
            return;
        }

        const url = '@Url.Page("/OrchestrationStages/Details", new { area = "OrchestratorDesign", orchestrationId = Model.OrchestrationId, versionId = Model.SelectedVersion?.Id, stageId = "__stageId__" })';
        window.location.href = url.replace('__stageId__', encodeURIComponent(stageId));
    });

    async function persistOrder() {
        const stageIds = Array.from(pipeline.querySelectorAll('.od-pipeline-item[data-stage-id]')).map(x => x.dataset.stageId);
        if (stageIds.length === 0) {
            return;
        }

        await fetch(`${window.location.pathname}?handler=ReorderStages`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': antiForgeryToken
            },
            body: JSON.stringify({ versionId: '@Model.VersionId', stageIds: stageIds })
        });
    }
})();

(() => {
    const stageModalElement = document.getElementById('newStageModal');
    const stageModalTitle = document.getElementById('newStageModalLabel');
    const stageSubmitButton = document.getElementById('stageModalSubmitButton');
    const stageIdInput = document.getElementById('stageModalStageId');
    const stageForm = stageModalElement?.querySelector('form');
    const canEdit = orchestrationVersionCanEdit;
    if (!stageModalElement || !stageModalTitle || !stageSubmitButton || !stageIdInput) {
        return;
    }

    if (stageForm && !canEdit) {
        stageForm.addEventListener('submit', event => event.preventDefault());
    }

    const defaultValues = {
        StageId: '',
        Key: '',
        Name: '',
        Description: '',
    };
    const payloadFieldAliases = {
        stageId: 'StageId',
        key: 'Key',
        name: 'Name',
        description: 'Description',
    };

    function setInputValue(propertyName, value) {
        const element = document.getElementById(`NewStage_${propertyName}`);
        if (!element) {
            return;
        }

        element.value = value ?? '';
    }

    function applyPayload(payload) {
        Object.keys(defaultValues).forEach(key => setInputValue(key, defaultValues[key]));
        Object.keys(payload || {}).forEach(key => {
            const fieldName = payloadFieldAliases[key] || key;
            setInputValue(fieldName, payload[key]);
        });

        stageIdInput.value = payload?.stageId || payload?.StageId || '';
    }

    function openModal() {
        if (!window.bootstrap || !window.bootstrap.Modal) {
            return;
        }

        window.bootstrap.Modal.getOrCreateInstance(stageModalElement).show();
    }

    document.querySelectorAll('.js-open-stage-modal').forEach(button => {
        button.addEventListener('click', async () => {
            const mode = button.getAttribute('data-stage-mode') || 'create';

            if (mode === 'edit') {
                const stageId = button.getAttribute('data-stage-id') || '';
                if (!stageId) {
                    return;
                }

                const response = await fetch(`${window.location.pathname}?handler=StageForEdit&stageId=${encodeURIComponent(stageId)}`);
                if (!response.ok) {
                    return;
                }

                const payload = await response.json();
                stageModalTitle.textContent = canEdit ? 'Edit stage' : 'Stage configuration';
                stageSubmitButton.textContent = 'Save';
                applyPayload(payload);
                setVersionModalReadOnly(stageModalElement, !canEdit, stageSubmitButton);
                openModal();
                return;
            }

            if (!canEdit) {
                return;
            }

            stageModalTitle.textContent = 'Create stage';
            stageSubmitButton.textContent = 'Create';
            applyPayload({});
            setVersionModalReadOnly(stageModalElement, false, stageSubmitButton);
            openModal();
        });
    });
})();

(() => {
    async function openExecutionConditionModal(stageId) {
        if (!stageId) {
            return;
        }

        if (!window.ButterMorphHost?.openFrame) {
            window.OrchestratorMessages?.notify({
                title: 'ButterMorph unavailable',
                message: 'The ButterMorph condition designer could not be loaded.',
                type: 'error'
            });
            return;
        }

        const mode = orchestrationVersionCanEdit ? 'edit' : 'view';
        const contextKey = `orchestration-stage-execution-condition:${orchestrationVersionId}:${stageId}`;
        const designerUrl = `/buttermorph/validations/designer?context=${encodeURIComponent(contextKey)}&mode=${mode}`;
        window.ButterMorphHost.openFrame(designerUrl, {
            title: 'ButterMorph execution condition',
            width: '96vw',
            height: '92vh'
        });
    }

    document.querySelectorAll('.js-stage-execution-btn').forEach(button => {
        button.addEventListener('click', async () => {
            const stageId = button.getAttribute('data-stage-id') || '';
            if (!stageId) {
                return;
            }

            await openExecutionConditionModal(stageId);
        });
    });
})();

(() => {
    const antiForgeryToken = document.querySelector('meta[name="request-verification-token"]')?.getAttribute('content') || '';
    const toggles = document.querySelectorAll('.js-stage-enabled-toggle');
    if (!toggles.length) {
        return;
    }

    async function setStageEnabled(stageId, isEnabled) {
        const response = await fetch(`${window.location.pathname}?handler=SetStageEnabled`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': antiForgeryToken
            },
            body: JSON.stringify({ stageId: stageId, isEnabled: isEnabled })
        });

        return response.ok;
    }

    toggles.forEach(toggle => {
        toggle.addEventListener('change', async event => {
            const input = event.target;
            const stageId = input.getAttribute('data-stage-id') || '';
            if (!stageId) {
                return;
            }

            const nextValue = !!input.checked;
            const success = await setStageEnabled(stageId, nextValue);
            if (!success) {
                input.checked = !nextValue;
                return;
            }

            const card = input.closest('.od-pipeline-item');
            if (card) {
                card.classList.toggle('od-task-disabled', !nextValue);
            }
        });
    });
})();

window.addEventListener('message', event => {
    if (event.origin !== window.location.origin || !event.data) {
        return;
    }

    if (event.data.type === 'ButterMorphValidationDesignerSaved') {
        window.location.reload();
    }
});

(() => {
    const triggerTypeSelector = document.getElementById('triggerTypeSelector');
    const triggerModalElement = document.getElementById('triggerModal');
    const triggerModalTitle = document.getElementById('triggerModalLabel');
    const triggerSubmitButton = document.getElementById('triggerModalSubmitButton');
    const triggerIdInput = document.getElementById('triggerModalTriggerId');
    const unsupportedWarning = document.getElementById('triggerUnsupportedTypeWarning');
    const generalTabButton = document.getElementById('trigger-general-tab');
    const compensationTabButton = document.getElementById('trigger-compensation-tab');
    const compensationTabItem = document.getElementById('trigger-compensation-tab-item');
    const compensationTabPane = document.getElementById('trigger-compensation-pane');
    const compensationRetrySelector = document.getElementById('triggerCompensationRetryStrategySelector');
    const compensationTimeoutSelector = document.getElementById('triggerCompensationTimeoutBehaviorSelector');
    const compensationTimeoutReconcileRetrySelector = document.getElementById('triggerCompensationTimeoutReconcileRetryStrategySelector');
    const triggerForm = triggerModalElement?.querySelector('form');
    const canEdit = orchestrationVersionCanEdit;
    if (!triggerTypeSelector || !triggerModalElement || !triggerModalTitle || !triggerSubmitButton || !triggerIdInput) {
        return;
    }

    if (triggerForm && !canEdit) {
        triggerForm.addEventListener('submit', event => event.preventDefault());
    }

    const defaultValues = {
        TriggerId: '',
