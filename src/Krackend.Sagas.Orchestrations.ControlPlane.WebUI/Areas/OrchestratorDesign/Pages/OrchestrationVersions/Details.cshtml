@page
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Design.Areas.OrchestratorDesign.Pages.OrchestrationVersions.DetailsModel
@using Krackend.Sagas.Orchestrations.Abstractions.Primitives
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Version roadmap";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">@Model.Orchestration?.Name</h1>
        <p class="od-page-subtitle">Roadmap @Model.SelectedVersion?.Version</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="OrchestratorDesign" asp-page="/Orchestrations/Details" asp-route-orchestrationId="@Model.OrchestrationId" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

@if (!Model.CanEdit)
{
    <div class="alert alert-secondary">This version is read-only because its status is @Model.SelectedVersion?.Status.</div>
}

<div class="od-roadmap-layout">
    <aside class="od-list-shell od-roadmap-side">
        <div class="od-trigger-shell">
            <div class="od-trigger-head">
                <h2 class="od-panel-title">Triggers</h2>
            </div>

            <div class="od-vertical-cards">
                @foreach (var trigger in Model.TriggerBindings)
                {
                    <article class="od-trigger-item @(trigger.IsEnabled ? string.Empty : "od-task-disabled")">
                        <div class="od-item-top">
                            <div>
                                <h3 class="od-item-title">@trigger.Key</h3>
                                <p class="od-item-meta">@trigger.TriggerType</p>
                            </div>
                            <div class="dropdown">
                                <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Trigger actions">&#8942;</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <button type="button"
                                                class="dropdown-item js-open-trigger-modal"
                                                data-trigger-mode="edit"
                                                data-trigger-id="@trigger.Id">
                                            @(Model.CanEdit ? "Edit trigger" : "View trigger")
                                        </button>
                                    </li>
                                    @if (Model.CanEdit)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form method="post" asp-page-handler="DeleteTrigger" class="od-inline-form" data-confirm="true" data-confirm-title="Delete trigger" data-confirm-message="Delete this trigger from the orchestration version?" data-confirm-accept="Delete" data-confirm-type="warning" data-orchestrator-busy="true" data-busy-title="Deleting trigger" data-busy-message="Design is removing the trigger binding.">
                                                <input type="hidden" name="orchestrationId" value="@Model.OrchestrationId" />
                                                <input type="hidden" name="versionId" value="@Model.SelectedVersion?.Id" />
                                                <input type="hidden" name="triggerId" value="@trigger.Id" />
                                                <button type="submit" class="dropdown-item text-danger">Delete trigger</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                        @if (Model.CanEdit)
                        {
                            <div class="od-task-toggle-row">
                                <span class="od-task-toggle-label">Enabled</span>
                                <div class="form-check form-switch od-task-toggle">
                                    <input class="form-check-input js-trigger-enabled-toggle" type="checkbox" role="switch" data-trigger-id="@trigger.Id" @(trigger.IsEnabled ? "checked" : null) aria-label="Toggle trigger enabled" />
                                </div>
                            </div>
                        }
                    </article>
                }

                @if (!Model.TriggerBindings.Any())
                {
                    <p class="od-empty">No triggers yet.</p>
                }

                @if (Model.CanEdit)
                {
                    <article class="od-trigger-item od-trigger-empty-item">
                        <button type="button" class="od-add-link js-open-trigger-modal" data-trigger-mode="create">+ Add trigger</button>
                    </article>
                }
            </div>
        </div>
    </aside>

    <section class="od-list-shell od-roadmap-main">
        <div class="od-panel-head">
            <h2 class="od-panel-title">Stages</h2>
            <span class="od-item-meta">@(Model.CanEdit ? "Drag cards to reorder, click a card to open" : "Click a card to open")</span>
        </div>

        @if (!Model.Stages.Any())
        {
            <p class="od-empty">No stages yet.</p>
        }

        <div id="stagePipeline" class="od-pipeline">
            @foreach (var stage in Model.Stages.OrderBy(s => s.Order))
            {
                var hasStageExecutionCondition = stage.HasExecutionCondition;

                <article class="od-pipeline-item @(stage.IsEnabled ? string.Empty : "od-task-disabled")" data-stage-id="@stage.Id" draggable="@Model.CanEdit.ToString().ToLowerInvariant()">
                    <div class="od-pipeline-card od-stage-card">
                        <button type="button"
                                class="od-stage-exec-btn js-stage-execution-btn @(hasStageExecutionCondition ? "od-stage-exec-btn-active" : "od-stage-exec-btn-inactive")"
                                title="Execution condition"
                                aria-label="Execution condition"
                                data-stage-id="@stage.Id">
                            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                <path d="M8.5 1.5a.5.5 0 0 0-.9-.3l-4 6a.5.5 0 0 0 .4.8H7l-1 6a.5.5 0 0 0 .9.3l4-6a.5.5 0 0 0-.4-.8H7.5l1-6z" />
                            </svg>
                        </button>
                        <div class="od-item-top">
                            <div class="od-stage-head-main">
                                <div class="od-stage-texts">
                                    <h3 class="od-item-title">@stage.Key</h3>
                                    <p class="od-item-meta">@stage.Name</p>
                                </div>
                            </div>
                            <div class="dropdown">
                                <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Stage actions">&#8942;</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <button type="button"
                                                class="dropdown-item js-open-stage-modal"
                                                data-stage-mode="edit"
                                                data-stage-id="@stage.Id">
                                            @(Model.CanEdit ? "Edit stage" : "View stage")
                                        </button>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="OrchestratorDesign"
                                           asp-page="/OrchestrationStages/Details"
                                           asp-route-orchestrationId="@Model.OrchestrationId"
                                           asp-route-versionId="@Model.SelectedVersion?.Id"
                                           asp-route-stageId="@stage.Id">Open stage</a>
                                    </li>
                                    @if (Model.CanEdit)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form method="post" asp-page-handler="DeleteStage" class="od-inline-form" data-confirm="true" data-confirm-title="Delete stage" data-confirm-message="Delete this stage from the orchestration version?" data-confirm-accept="Delete" data-confirm-type="warning" data-orchestrator-busy="true" data-busy-title="Deleting stage" data-busy-message="Design is removing the stage definition.">
                                                <input type="hidden" name="orchestrationId" value="@Model.OrchestrationId" />
                                                <input type="hidden" name="versionId" value="@Model.SelectedVersion?.Id" />
                                                <input type="hidden" name="stageId" value="@stage.Id" />
                                                <button type="submit" class="dropdown-item text-danger">Delete stage</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                        <div class="od-stage-task-count-row">
                            <span class="od-stage-task-count-badge">@((Model.StageTaskCounts.TryGetValue(stage.Id, out var count) ? count : 0)) tasks</span>
                        </div>
                        @if (Model.CanEdit)
                        {
                            <div class="od-task-toggle-row">
                                <span class="od-task-toggle-label">Enabled</span>
                                <div class="form-check form-switch od-task-toggle">
                                    <input class="form-check-input js-stage-enabled-toggle" type="checkbox" role="switch" data-stage-id="@stage.Id" @(stage.IsEnabled ? "checked" : null) aria-label="Toggle stage enabled" />
                                </div>
                            </div>
                        }
                    </div>
                </article>
            }

            @if (Model.CanEdit)
            {
                <article class="od-pipeline-item od-add-item">
                    <div class="od-pipeline-card">
                        <button type="button" class="od-add-link js-open-stage-modal" data-stage-mode="create">+ Add stage</button>
                    </div>
                </article>
            }
        </div>
    </section>
</div>

<div class="modal fade" id="newStageModal" tabindex="-1" aria-labelledby="newStageModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="UpsertStage" data-orchestrator-validate="true" data-orchestrator-busy="true" data-busy-title="Saving stage" data-busy-message="Design is validating and storing the stage definition.">
                <div class="modal-header">
                    <h5 class="modal-title" id="newStageModalLabel">Create stage</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="orchestrationId" value="@Model.OrchestrationId" />
                    <input type="hidden" name="versionId" value="@Model.SelectedVersion?.Id" />
                    <input asp-for="NewStage.StageId" type="hidden" id="stageModalStageId" />
                    <div class="mb-2">
                        <label asp-for="NewStage.Key" class="form-label"></label>
                        <input asp-for="NewStage.Key" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="NewStage.Name" class="form-label"></label>
                        <input asp-for="NewStage.Name" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="NewStage.Description" class="form-label"></label>
                        <textarea asp-for="NewStage.Description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="stageModalSubmitButton">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="triggerModal" tabindex="-1" aria-labelledby="triggerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" asp-page-handler="UpsertTrigger" data-orchestrator-validate="true" data-orchestrator-busy="true" data-busy-title="Saving trigger" data-busy-message="Design is validating and storing the trigger binding.">
                <div class="modal-header">
                    <h5 class="modal-title" id="triggerModalLabel">Create trigger</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="orchestrationId" value="@Model.OrchestrationId" />
                    <input type="hidden" name="versionId" value="@Model.SelectedVersion?.Id" />
                    <input asp-for="TriggerInput.TriggerId" type="hidden" id="triggerModalTriggerId" />

                    <ul class="nav nav-tabs mb-3" id="triggerTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="trigger-general-tab" data-bs-toggle="tab" data-bs-target="#trigger-general-pane" type="button" role="tab" aria-controls="trigger-general-pane" aria-selected="true">Trigger</button>
                        </li>
                        <li class="nav-item" role="presentation" id="trigger-compensation-tab-item">
                            <button class="nav-link" id="trigger-compensation-tab" data-bs-toggle="tab" data-bs-target="#trigger-compensation-pane" type="button" role="tab" aria-controls="trigger-compensation-pane" aria-selected="false">Compensation task</button>
                        </li>
                    </ul>
                    <div class="tab-content" id="triggerTabsContent">
                        <div class="tab-pane fade show active" id="trigger-general-pane" role="tabpanel" aria-labelledby="trigger-general-tab" tabindex="0">
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label asp-for="TriggerInput.Key" class="form-label">Key</label>
                                    <input asp-for="TriggerInput.Key" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="TriggerInput.TriggerType" class="form-label">Trigger type</label>
                                    <select asp-for="TriggerInput.TriggerType" class="form-select" asp-items="Model.TriggerTypes" id="triggerTypeSelector"></select>
                                </div>
                                <div class="col-md-5">
                                    <label asp-for="TriggerInput.Description" class="form-label">Description</label>
                                    <input asp-for="TriggerInput.Description" class="form-control" />
                                </div>
                            </div>

                            <div class="trigger-config-block" data-trigger-type="Event">
                                <hr />
                                <h6 class="mb-2">Event channel</h6>
                                <div class="row g-2">
                                    <div class="col-md-7">
                                        <label asp-for="TriggerInput.EventTopic" class="form-label">Topic</label>
                                        <input asp-for="TriggerInput.EventTopic" class="form-control" />
                                    </div>
                                    <div class="col-md-5">
                                        <label asp-for="TriggerInput.EventVersion" class="form-label">Version</label>
                                        <input asp-for="TriggerInput.EventVersion" class="form-control" data-orchestrator-version="true" />
                                    </div>
                                    <div class="col-12"><hr class="my-2" /></div>
                                    <div class="col-12">
                                        <h6 class="mb-2">Schema binding</h6>
                                    </div>
                                    <input asp-for="TriggerInput.HasEventSchemaValidation" type="hidden" />
                                    <div class="col-md-6">
                                        <label asp-for="TriggerInput.EventSchemaContractKey" class="form-label">Contract key</label>
                                        <input asp-for="TriggerInput.EventSchemaContractKey"
                                               class="form-control"
                                               data-schema-contract-key="true"
                                               data-schema-contract-kind="Event"
                                               data-schema-version-target="TriggerInput_EventSchemaContractVersion" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="TriggerInput.EventSchemaContractVersion" class="form-label">Contract version</label>
                                        <input asp-for="TriggerInput.EventSchemaContractVersion" class="form-control" data-orchestrator-version="true" />
                                    </div>
                                    <input asp-for="TriggerInput.EventSchemaRegistryProviderId" type="hidden" />
                                    <input asp-for="TriggerInput.EventSchemaStrictMode" type="hidden" />
                                    <input asp-for="TriggerInput.HasEventValidation" type="hidden" />
                                    <input asp-for="TriggerInput.EventValidationErrorCode" type="hidden" />
                                    <input asp-for="TriggerInput.EventValidationDsl" type="hidden" />
                                </div>
                            </div>

                            <div id="triggerUnsupportedTypeWarning" class="alert alert-warning mt-3 d-none mb-0">
                                Selected trigger type does not define specific channel fields yet.
                            </div>

                            <hr />
                            <div class="form-check form-switch mb-0">
                                <input asp-for="TriggerInput.HasCompensation" class="form-check-input" id="hasTriggerCompensation" />
                                <label asp-for="TriggerInput.HasCompensation" class="form-check-label">Enable trigger compensation</label>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="trigger-compensation-pane" role="tabpanel" aria-labelledby="trigger-compensation-tab" tabindex="0">
                            <input asp-for="TriggerInput.CompensationConditionDslExpression" type="hidden" />
                            <input asp-for="TriggerInput.CompensationTransformationDsl" type="hidden" />
                            <div id="triggerCompensationSection">
                                <div class="row g-2">
                                    <div class="col-md-2">
                                        <label asp-for="TriggerInput.CompensationKind" class="form-label">Task type</label>
                                        <select asp-for="TriggerInput.CompensationKind" class="form-select" asp-items="Model.CompensationTaskKinds" id="triggerCompensationKindSelector"></select>
                                    </div>
                                    <div class="col-md-2">
                                        <label asp-for="TriggerInput.CompensationDispatchType" class="form-label">Dispatch type</label>
                                        <select asp-for="TriggerInput.CompensationDispatchType" class="form-select" asp-items="Model.CompensationDispatchTypes" id="triggerCompensationDispatchTypeSelector"></select>
                                    </div>
                                    <div class="col-md-2">
                                        <label asp-for="TriggerInput.CompensationOnErrorPolicy" class="form-label">On error policy</label>
                                        <select asp-for="TriggerInput.CompensationOnErrorPolicy" class="form-select" asp-items="Model.CompensationOnErrorPolicies"></select>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="TriggerInput.CompensationMessagingTopic" class="form-label">Topic</label>
                                        <input asp-for="TriggerInput.CompensationMessagingTopic" class="form-control" />
                                    </div>
                                    <div class="col-md-2">
                                        <label asp-for="TriggerInput.CompensationMessagingVersion" class="form-label">Version</label>
                                        <input asp-for="TriggerInput.CompensationMessagingVersion" class="form-control" data-orchestrator-version="true" />
                                    </div>
                                    <div class="col-12"><hr class="my-2" /></div>
                                    <div class="col-12">
                                        <h6 class="mb-2">Schema binding</h6>
                                    </div>
                                    <div class="col-md-8">
                                        <label asp-for="TriggerInput.CompensationSchemaContractKey" class="form-label">Command key</label>
                                        <input asp-for="TriggerInput.CompensationSchemaContractKey"
                                               class="form-control"
                                               data-schema-contract-key="true"
                                               data-schema-contract-kind="Command"
                                               data-schema-version-target="TriggerInput_CompensationSchemaContractVersion" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="TriggerInput.CompensationSchemaContractVersion" class="form-label">Command version</label>
                                        <input asp-for="TriggerInput.CompensationSchemaContractVersion" class="form-control" data-orchestrator-version="true" />
                                    </div>
                                    <input asp-for="TriggerInput.CompensationSchemaRegistryProviderId" type="hidden" />
                                    <input asp-for="TriggerInput.CompensationSchemaStrictMode" type="hidden" />
                                    <input asp-for="TriggerInput.HasCompensationSchemaValidation" type="hidden" />

                                    <div class="col-12"><hr class="my-2" /></div>
                                    <div class="col-md-6">
                                        <div class="form-check form-switch">
                                            <input asp-for="TriggerInput.HasCompensationExecutionCondition" class="form-check-input" id="hasTriggerCompensationExecutionCondition" />
                                            <label asp-for="TriggerInput.HasCompensationExecutionCondition" class="form-check-label">Enable execution condition</label>
                                        </div>
                                        <div id="triggerCompensationConditionSection" class="mt-2">
                                            <button type="button" class="btn btn-outline-secondary btn-sm" id="openTriggerCompensationConditionDesignerButton">Open ButterMorph condition</button>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check form-switch">
                                            <input asp-for="TriggerInput.HasCompensationTransformation" class="form-check-input" id="hasTriggerCompensationTransformation" />
                                            <label asp-for="TriggerInput.HasCompensationTransformation" class="form-check-label">Enable transformation</label>
                                        </div>
                                        <div id="triggerCompensationTransformationSection" class="mt-2">
                                            <button type="button" class="btn btn-outline-secondary btn-sm" id="openTriggerCompensationTransformationDesignerButton">Open ButterMorph transformation</button>
                                        </div>
                                    </div>

                                    <div class="col-12"><hr class="my-2" /></div>
                                    <div class="col-md-12">
                                        <div class="form-check form-switch">
                                            <input asp-for="TriggerInput.HasCompensationRetryPolicy" class="form-check-input" id="hasTriggerCompensationRetryPolicy" />
                                            <label asp-for="TriggerInput.HasCompensationRetryPolicy" class="form-check-label">Enable retry policy</label>
                                        </div>
                                    </div>
                                    <div id="triggerCompensationRetrySection" class="row g-2">
                                        <div class="col-md-3">
                                            <label asp-for="TriggerInput.CompensationRetryStrategyType" class="form-label">Retry strategy</label>
                                            <select asp-for="TriggerInput.CompensationRetryStrategyType" class="form-select" asp-items="Model.RetryStrategyTypes" id="triggerCompensationRetryStrategySelector"></select>
                                        </div>
                                        <div class="col-md-3 trigger-compensation-retry-strategy-block" data-trigger-comp-retry="Fixed">
                                            <label asp-for="TriggerInput.CompensationRetryDelaySeconds" class="form-label">Retry delay (sec)</label>
                                            <input asp-for="TriggerInput.CompensationRetryDelaySeconds" class="form-control" type="number" min="0" step="0.1" />
                                        </div>
                                        <div class="col-md-3">
                                            <label asp-for="TriggerInput.CompensationRetryMaxRetries" class="form-label">Retries</label>
                                            <input asp-for="TriggerInput.CompensationRetryMaxRetries" class="form-control" type="number" min="0" />
                                        </div>
                                        <div class="col-md-12">
                                            <label asp-for="TriggerInput.CompensationRetryableErrorCodes" class="form-label">Retry errors</label>
                                            <input asp-for="TriggerInput.CompensationRetryableErrorCodes" type="hidden" id="triggerCompensationRetryErrorCodesHidden" />
                                            <div class="od-chip-editor" data-chip-editor-for="triggerCompensationRetryErrorCodesHidden">
                                                <div class="od-chip-list"></div>
                                                <input type="text" class="od-chip-input" placeholder="Error code + Enter" />
                                            </div>
                                        </div>
                                        <div class="col-md-12 form-check mt-2 ms-2">
                                            <input asp-for="TriggerInput.CompensationRetryStopOnNonRetryableError" class="form-check-input" />
                                            <label asp-for="TriggerInput.CompensationRetryStopOnNonRetryableError" class="form-check-label">Stop on non-retryable</label>
                                        </div>
                                    </div>

                                    <div class="col-12"><hr class="my-2" /></div>
                                    <div class="col-md-12">
                                        <div class="form-check form-switch">
                                            <input asp-for="TriggerInput.HasCompensationTimeoutPolicy" class="form-check-input" id="hasTriggerCompensationTimeoutPolicy" />
                                            <label asp-for="TriggerInput.HasCompensationTimeoutPolicy" class="form-check-label">Enable timeout policy</label>
                                        </div>
                                    </div>
                                    <div id="triggerCompensationTimeoutSection" class="row g-2">
                                        <div class="col-md-3">
                                            <label asp-for="TriggerInput.CompensationTimeoutSeconds" class="form-label">Timeout (sec)</label>
                                            <input asp-for="TriggerInput.CompensationTimeoutSeconds" class="form-control" type="number" min="1" step="0.1" />
                                        </div>
                                        <div class="col-md-3">
                                            <label asp-for="TriggerInput.CompensationTimeoutBehavior" class="form-label">Timeout behavior</label>
                                            <select asp-for="TriggerInput.CompensationTimeoutBehavior" class="form-select" asp-items="Model.TimeoutBehaviors" id="triggerCompensationTimeoutBehaviorSelector"></select>
                                        </div>
                                        <div class="col-md-3">
                                            <label asp-for="TriggerInput.CompensationTimeoutAction" class="form-label">Action on timeout</label>
                                            <select asp-for="TriggerInput.CompensationTimeoutAction" class="form-select" asp-items="Model.TimeoutActions"></select>
                                        </div>
                                        <div class="col-md-6 trigger-compensation-timeout-behavior-block" data-trigger-comp-timeout="Fail">
                                            <label asp-for="TriggerInput.CompensationTimeoutFailErrorCode" class="form-label">Fail error code</label>
                                            <input asp-for="TriggerInput.CompensationTimeoutFailErrorCode" class="form-control" />
                                        </div>
                                        <div class="col-md-6 trigger-compensation-timeout-behavior-block" data-trigger-comp-timeout="Wait">
                                            <label asp-for="TriggerInput.CompensationTimeoutWaitSeconds" class="form-label">Wait seconds</label>
                                            <input asp-for="TriggerInput.CompensationTimeoutWaitSeconds" class="form-control" type="number" min="1" step="0.1" />
                                        </div>
                                        <div class="col-md-3 trigger-compensation-timeout-behavior-block" data-trigger-comp-timeout="Reconcile">
                                            <label asp-for="TriggerInput.CompensationTimeoutReconcileRetryStrategyType" class="form-label">Reconcile retry strategy</label>
                                            <select asp-for="TriggerInput.CompensationTimeoutReconcileRetryStrategyType" class="form-select" asp-items="Model.RetryStrategyTypes" id="triggerCompensationTimeoutReconcileRetryStrategySelector"></select>
                                        </div>
                                        <div class="col-md-3 trigger-compensation-timeout-behavior-block" data-trigger-comp-timeout="Reconcile">
                                            <label asp-for="TriggerInput.CompensationTimeoutReconcileRetries" class="form-label">Reconcile retries</label>
                                            <input asp-for="TriggerInput.CompensationTimeoutReconcileRetries" class="form-control" type="number" min="0" />
                                        </div>
                                        <div class="col-md-3 trigger-compensation-timeout-behavior-block trigger-compensation-timeout-reconcile-strategy-block" data-trigger-comp-timeout="Reconcile" data-trigger-comp-timeout-reconcile-retry="Fixed">
                                            <label asp-for="TriggerInput.CompensationTimeoutReconcileDelaySeconds" class="form-label">Reconcile delay (sec)</label>
                                            <input asp-for="TriggerInput.CompensationTimeoutReconcileDelaySeconds" class="form-control" type="number" min="0" step="0.1" />
                                        </div>
