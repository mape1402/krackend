        HasCompensation: false,
        CompensationKind: 'Messaging',
        CompensationDispatchType: 'FireAndForget',
        CompensationOnErrorPolicy: 'Stop',
        CompensationMessagingTopic: '',
        CompensationMessagingVersion: '1.0.0',
        HasCompensationSchemaValidation: false,
        CompensationSchemaContractKey: '',
        CompensationSchemaContractVersion: '1.0.0',
        CompensationSchemaRegistryProviderId: '',
        CompensationSchemaStrictMode: false,
        HasCompensationExecutionCondition: false,
        CompensationConditionDslExpression: 'true',
        HasCompensationTransformation: false,
        CompensationTransformationDsl: '',
        HasCompensationRetryPolicy: false,
        CompensationRetryStrategyType: 'Fixed',
        CompensationRetryMaxRetries: 0,
        CompensationRetryDelaySeconds: 1,
        CompensationRetryableErrorCodes: '',
        CompensationRetryStopOnNonRetryableError: false,
        HasCompensationTimeoutPolicy: false,
        CompensationTimeoutSeconds: 30,
        CompensationTimeoutBehavior: 'Fail',
        CompensationTimeoutFailErrorCode: 'TIMEOUT',
        CompensationTimeoutWaitSeconds: 15,
        CompensationTimeoutAction: 'Block',
        CompensationTimeoutReconcileRetryStrategyType: 'Fixed',
        CompensationTimeoutReconcileRetries: 3,
        CompensationTimeoutReconcileDelaySeconds: 5,
        CompensationTimeoutReconcileRetryableErrorCodes: '',
        CompensationTimeoutReconcileStopOnNonRetryableError: false,
    };
    const payloadFieldAliases = {
        triggerId: 'TriggerId',
        key: 'Key',
        triggerType: 'TriggerType',
        description: 'Description',
        eventTopic: 'EventTopic',
        eventVersion: 'EventVersion',
        hasEventSchemaValidation: 'HasEventSchemaValidation',
        eventSchemaContractKey: 'EventSchemaContractKey',
        eventSchemaContractVersion: 'EventSchemaContractVersion',
        eventSchemaRegistryProviderId: 'EventSchemaRegistryProviderId',
        eventSchemaStrictMode: 'EventSchemaStrictMode',
        hasEventValidation: 'HasEventValidation',
        eventValidationDsl: 'EventValidationDsl',
        eventValidationErrorCode: 'EventValidationErrorCode',
        hasCompensation: 'HasCompensation',
        compensationKind: 'CompensationKind',
        compensationDispatchType: 'CompensationDispatchType',
        compensationOnErrorPolicy: 'CompensationOnErrorPolicy',
        compensationMessagingTopic: 'CompensationMessagingTopic',
        compensationMessagingVersion: 'CompensationMessagingVersion',
        hasCompensationSchemaValidation: 'HasCompensationSchemaValidation',
        compensationSchemaContractKey: 'CompensationSchemaContractKey',
        compensationSchemaContractVersion: 'CompensationSchemaContractVersion',
        compensationSchemaRegistryProviderId: 'CompensationSchemaRegistryProviderId',
        compensationSchemaStrictMode: 'CompensationSchemaStrictMode',
        hasCompensationExecutionCondition: 'HasCompensationExecutionCondition',
        compensationConditionDslExpression: 'CompensationConditionDslExpression',
        hasCompensationTransformation: 'HasCompensationTransformation',
        compensationTransformationDsl: 'CompensationTransformationDsl',
        hasCompensationRetryPolicy: 'HasCompensationRetryPolicy',
        compensationRetryStrategyType: 'CompensationRetryStrategyType',
        compensationRetryMaxRetries: 'CompensationRetryMaxRetries',
        compensationRetryDelaySeconds: 'CompensationRetryDelaySeconds',
        compensationRetryableErrorCodes: 'CompensationRetryableErrorCodes',
        compensationRetryStopOnNonRetryableError: 'CompensationRetryStopOnNonRetryableError',
        hasCompensationTimeoutPolicy: 'HasCompensationTimeoutPolicy',
        compensationTimeoutSeconds: 'CompensationTimeoutSeconds',
        compensationTimeoutBehavior: 'CompensationTimeoutBehavior',
        compensationTimeoutFailErrorCode: 'CompensationTimeoutFailErrorCode',
        compensationTimeoutWaitSeconds: 'CompensationTimeoutWaitSeconds',
        compensationTimeoutAction: 'CompensationTimeoutAction',
        compensationTimeoutReconcileRetryStrategyType: 'CompensationTimeoutReconcileRetryStrategyType',
        compensationTimeoutReconcileRetries: 'CompensationTimeoutReconcileRetries',
        compensationTimeoutReconcileDelaySeconds: 'CompensationTimeoutReconcileDelaySeconds',
        compensationTimeoutReconcileRetryableErrorCodes: 'CompensationTimeoutReconcileRetryableErrorCodes',
        compensationTimeoutReconcileStopOnNonRetryableError: 'CompensationTimeoutReconcileStopOnNonRetryableError',
    };
    const fieldIdOverrides = {
        HasCompensation: 'hasTriggerCompensation',
        CompensationKind: 'triggerCompensationKindSelector',
        CompensationDispatchType: 'triggerCompensationDispatchTypeSelector',
        HasCompensationExecutionCondition: 'hasTriggerCompensationExecutionCondition',
        HasCompensationTransformation: 'hasTriggerCompensationTransformation',
        HasCompensationRetryPolicy: 'hasTriggerCompensationRetryPolicy',
        HasCompensationTimeoutPolicy: 'hasTriggerCompensationTimeoutPolicy',
        CompensationRetryStrategyType: 'triggerCompensationRetryStrategySelector',
        CompensationRetryableErrorCodes: 'triggerCompensationRetryErrorCodesHidden',
        CompensationTimeoutBehavior: 'triggerCompensationTimeoutBehaviorSelector',
        CompensationTimeoutReconcileRetryStrategyType: 'triggerCompensationTimeoutReconcileRetryStrategySelector',
        CompensationTimeoutReconcileRetryableErrorCodes: 'triggerCompensationTimeoutReconcileRetryableErrorCodesHidden',
    };

    function setInputValue(propertyName, value) {
        const element = document.getElementById(fieldIdOverrides[propertyName] ?? `TriggerInput_${propertyName}`);
        if (!element) {
            return;
        }

        const type = (element.getAttribute('type') || '').toLowerCase();
        if (type === 'checkbox') {
            element.checked = value === true || value === 'true' || value === 1;
            element.dispatchEvent(new Event('change', { bubbles: true }));
            return;
        }

        element.value = value ?? '';
        element.dispatchEvent(new Event('change', { bubbles: true }));
    }

    function applyPayload(payload) {
        Object.keys(defaultValues).forEach(key => setInputValue(key, defaultValues[key]));
        Object.keys(payload || {}).forEach(key => {
            const fieldName = payloadFieldAliases[key] || key;
            setInputValue(fieldName, payload[key]);
        });

        triggerIdInput.value = payload?.triggerId || payload?.TriggerId || '';
        refreshTriggerType();
        refreshTriggerCompensation();

        triggerModalElement.querySelectorAll('.od-chip-editor[data-chip-editor-for]').forEach(editor => {
            const targetId = editor.getAttribute('data-chip-editor-for');
            const hidden = targetId ? document.getElementById(targetId) : null;
            if (hidden) {
                hidden.dispatchEvent(new Event('change', { bubbles: true }));
            }
        });
    }

    function refreshTriggerType() {
        const selectedType = (triggerTypeSelector.value || '').toLowerCase();
        let hasVisibleConfig = false;

        document.querySelectorAll('.trigger-config-block[data-trigger-type]').forEach(element => {
            const configType = (element.getAttribute('data-trigger-type') || '').toLowerCase();
            const visible = configType === selectedType;
            element.classList.toggle('d-none', !visible);
            hasVisibleConfig = hasVisibleConfig || visible;
        });

        if (unsupportedWarning) {
            unsupportedWarning.classList.toggle('d-none', hasVisibleConfig);
        }
    }

    function refreshTriggerCompensation() {
        const hasCompensation = document.getElementById('hasTriggerCompensation');
        const section = document.getElementById('triggerCompensationSection');
        const hasCondition = document.getElementById('hasTriggerCompensationExecutionCondition');
        const conditionSection = document.getElementById('triggerCompensationConditionSection');
        const hasTransformation = document.getElementById('hasTriggerCompensationTransformation');
        const transformationSection = document.getElementById('triggerCompensationTransformationSection');
        const hasRetry = document.getElementById('hasTriggerCompensationRetryPolicy');
        const retrySection = document.getElementById('triggerCompensationRetrySection');
        const hasTimeout = document.getElementById('hasTriggerCompensationTimeoutPolicy');
        const timeoutSection = document.getElementById('triggerCompensationTimeoutSection');
        const compensationEnabled = !!hasCompensation?.checked;

        if (section) {
            section.classList.toggle('d-none', !compensationEnabled);
        }

        if (compensationTabItem && compensationTabButton) {
            compensationTabButton.disabled = !compensationEnabled;
            compensationTabButton.setAttribute('aria-disabled', (!compensationEnabled).toString());
            compensationTabItem.classList.toggle('d-none', !compensationEnabled);
        }

        if (!compensationEnabled && compensationTabPane?.classList.contains('active') && generalTabButton && window.bootstrap?.Tab) {
            window.bootstrap.Tab.getOrCreateInstance(generalTabButton).show();
        }

        if (conditionSection && hasCondition) {
            conditionSection.classList.toggle('d-none', !hasCondition.checked);
        }

        if (transformationSection && hasTransformation) {
            transformationSection.classList.toggle('d-none', !hasTransformation.checked);
        }

        if (retrySection && hasRetry) {
            retrySection.classList.toggle('d-none', !hasRetry.checked);
        }

        if (timeoutSection && hasTimeout) {
            timeoutSection.classList.toggle('d-none', !hasTimeout.checked);
        }

        refreshTriggerCompensationRetryFields();
        refreshTriggerCompensationTimeout();
    }

    function toggleBySelector(selector, blockSelector, attributeName) {
        if (!selector) {
            return;
        }

        const selected = selector.value;
        document.querySelectorAll(blockSelector).forEach(element => {
            element.classList.toggle('d-none', element.getAttribute(attributeName) !== selected);
        });
    }

    function refreshTriggerCompensationRetryFields() {
        toggleBySelector(compensationRetrySelector, '.trigger-compensation-retry-strategy-block', 'data-trigger-comp-retry');
    }

    function refreshTriggerCompensationTimeout() {
        toggleBySelector(compensationTimeoutSelector, '.trigger-compensation-timeout-behavior-block', 'data-trigger-comp-timeout');
        refreshTriggerCompensationTimeoutReconcileRetryFields();
    }

    function refreshTriggerCompensationTimeoutReconcileRetryFields() {
        toggleBySelector(
            compensationTimeoutReconcileRetrySelector,
            '.trigger-compensation-timeout-reconcile-strategy-block',
            'data-trigger-comp-timeout-reconcile-retry');
    }

    function initializeTriggerChipEditors() {
        triggerModalElement.querySelectorAll('.od-chip-editor[data-chip-editor-for]').forEach(editor => {
            const targetId = editor.getAttribute('data-chip-editor-for');
            const hiddenInput = targetId ? document.getElementById(targetId) : null;
            const list = editor.querySelector('.od-chip-list');
            const input = editor.querySelector('.od-chip-input');
            if (!hiddenInput || !list || !input) {
                return;
            }

            const values = new Set();

            function loadFromHidden() {
                values.clear();
                (hiddenInput.value || '')
                    .split(',')
                    .map(x => x.trim())
                    .filter(x => x.length > 0)
                    .forEach(x => values.add(x));
            }

            function syncHidden() {
                hiddenInput.value = Array.from(values).join(',');
            }

            function render() {
                list.innerHTML = '';

                values.forEach(value => {
                    const chip = document.createElement('span');
                    chip.className = 'od-input-chip';

                    const label = document.createElement('span');
                    label.textContent = value;
                    chip.appendChild(label);

                    const remove = document.createElement('button');
                    remove.type = 'button';
                    remove.className = 'od-chip-remove';
                    remove.setAttribute('aria-label', `Remove ${value}`);
                    remove.textContent = '×';
                    remove.disabled = !canEdit;
                    remove.classList.toggle('d-none', !canEdit);
                    remove.addEventListener('click', () => {
                        if (!canEdit) {
                            return;
                        }

                        values.delete(value);
                        syncHidden();
                        render();
                    });

                    chip.appendChild(remove);
                    list.appendChild(chip);
                });
            }

            function addFromInput() {
                const pieces = (input.value || '')
                    .split(',')
                    .map(x => x.trim())
                    .filter(x => x.length > 0);

                if (pieces.length === 0) {
                    input.value = '';
                    return;
                }

                pieces.forEach(piece => values.add(piece));
                input.value = '';
                syncHidden();
                render();
            }

            input.addEventListener('keydown', event => {
                if (!canEdit) {
                    event.preventDefault();
                    return;
                }

                if (event.key === 'Enter' || event.key === ',') {
                    event.preventDefault();
                    addFromInput();
                }
            });

            input.addEventListener('blur', () => {
                if (canEdit) {
                    addFromInput();
                }
            });

            hiddenInput.addEventListener('change', () => {
                loadFromHidden();
                render();
            });

            loadFromHidden();
            syncHidden();
            render();
            input.readOnly = !canEdit;
            input.disabled = !canEdit;
        });
    }

    function notifyMissingTrigger() {
        window.OrchestratorMessages?.notify({
            title: 'Save the trigger first',
            message: 'ButterMorph can be opened after the trigger has been saved.',
            type: 'warning'
        });
    }

    function openTriggerButterMorph(kind) {
        const triggerId = triggerIdInput.value || '';
        if (!triggerId) {
            notifyMissingTrigger();
            return;
        }

        if (!window.ButterMorphHost?.openFrame) {
            window.OrchestratorMessages?.notify({
                title: 'ButterMorph unavailable',
                message: 'The ButterMorph designer could not be loaded.',
                type: 'error'
            });
            return;
        }

        const mode = canEdit ? 'edit' : 'view';
        const prefix = kind === 'condition'
            ? 'orchestration-trigger-compensation-execution-condition'
            : 'orchestration-trigger-compensation-transform';
        const route = kind === 'condition' ? '/buttermorph/validations/designer' : '/buttermorph/designer';
        const contextKey = `${prefix}:${orchestrationVersionId}:${triggerId}`;
        window.ButterMorphHost.openFrame(`${route}?context=${encodeURIComponent(contextKey)}&mode=${mode}`, {
            title: kind === 'condition' ? 'ButterMorph trigger compensation condition' : 'ButterMorph trigger compensation transformation',
            width: '96vw',
            height: '92vh'
        });
    }

    function openModal() {
        if (!window.bootstrap || !window.bootstrap.Modal) {
            return;
        }

        window.bootstrap.Modal.getOrCreateInstance(triggerModalElement).show();
    }

    triggerTypeSelector.addEventListener('change', refreshTriggerType);
    document.getElementById('hasTriggerCompensation')?.addEventListener('change', refreshTriggerCompensation);
    document.getElementById('hasTriggerCompensationExecutionCondition')?.addEventListener('change', refreshTriggerCompensation);
    document.getElementById('hasTriggerCompensationTransformation')?.addEventListener('change', refreshTriggerCompensation);
    document.getElementById('hasTriggerCompensationRetryPolicy')?.addEventListener('change', refreshTriggerCompensation);
    document.getElementById('hasTriggerCompensationTimeoutPolicy')?.addEventListener('change', refreshTriggerCompensation);
    compensationRetrySelector?.addEventListener('change', refreshTriggerCompensationRetryFields);
    compensationTimeoutSelector?.addEventListener('change', refreshTriggerCompensationTimeout);
    compensationTimeoutReconcileRetrySelector?.addEventListener('change', refreshTriggerCompensationTimeoutReconcileRetryFields);
    document.getElementById('openTriggerCompensationConditionDesignerButton')?.addEventListener('click', () => openTriggerButterMorph('condition'));
    document.getElementById('openTriggerCompensationTransformationDesignerButton')?.addEventListener('click', () => openTriggerButterMorph('transformation'));

    document.querySelectorAll('.js-open-trigger-modal').forEach(button => {
        button.addEventListener('click', async () => {
            const mode = button.getAttribute('data-trigger-mode') || 'create';

            if (mode === 'edit') {
                const triggerId = button.getAttribute('data-trigger-id') || '';
                if (!triggerId) {
                    return;
                }

                const response = await fetch(`${window.location.pathname}?handler=TriggerForEdit&triggerId=${encodeURIComponent(triggerId)}`);
                if (!response.ok) {
                    return;
                }

                const payload = await response.json();
                triggerModalTitle.textContent = canEdit ? 'Edit trigger' : 'Trigger configuration';
                triggerSubmitButton.textContent = 'Save';
                applyPayload(payload);
                setVersionModalReadOnly(triggerModalElement, !canEdit, triggerSubmitButton);
                openModal();
                return;
            }

            if (!canEdit) {
                return;
            }

            triggerModalTitle.textContent = 'Create trigger';
            triggerSubmitButton.textContent = 'Create';
            applyPayload({});
            setVersionModalReadOnly(triggerModalElement, false, triggerSubmitButton);
            openModal();
        });
    });

    refreshTriggerType();
    refreshTriggerCompensation();
    initializeTriggerChipEditors();
})();

(() => {
    const antiForgeryToken = document.querySelector('meta[name="request-verification-token"]')?.getAttribute('content') || '';
    const toggles = document.querySelectorAll('.js-trigger-enabled-toggle');
    if (!toggles.length) {
        return;
    }

    async function setTriggerEnabled(triggerId, isEnabled) {
        const response = await fetch(`${window.location.pathname}?handler=SetTriggerEnabled`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': antiForgeryToken
            },
            body: JSON.stringify({ triggerId: triggerId, isEnabled: isEnabled })
        });

        return response.ok;
    }

    toggles.forEach(toggle => {
        toggle.addEventListener('change', async event => {
            const input = event.target;
            const triggerId = input.getAttribute('data-trigger-id') || '';
            if (!triggerId) {
                return;
            }

            const nextValue = !!input.checked;
            const success = await setTriggerEnabled(triggerId, nextValue);
            if (!success) {
                input.checked = !nextValue;
                return;
            }

            const card = input.closest('.od-trigger-item');
            if (card) {
                card.classList.toggle('od-task-disabled', !nextValue);
            }
        });
    });
})();

(() => {
    const emptyCard = document.querySelector('.od-trigger-empty-item');
    if (!emptyCard) {
        return;
    }

    function syncAddTriggerCardHeight() {
        const firstRealCard = document.querySelector('.od-trigger-item:not(.od-trigger-empty-item)');
        if (!firstRealCard) {
            emptyCard.style.removeProperty('height');
            emptyCard.style.removeProperty('width');
            return;
        }

        const rect = firstRealCard.getBoundingClientRect();
        const height = rect.height;
        const width = rect.width;
        if (height > 0) {
            emptyCard.style.height = `${Math.ceil(height)}px`;
        }
        if (width > 0) {
            emptyCard.style.width = `${Math.ceil(width)}px`;
        }
    }

    syncAddTriggerCardHeight();
    window.addEventListener('resize', syncAddTriggerCardHeight);
})();
</script>
}
