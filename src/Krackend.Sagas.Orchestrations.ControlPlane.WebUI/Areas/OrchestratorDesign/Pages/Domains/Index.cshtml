@page
@using Zoorce.Web.UI.Abstractions.Data
@using Zoorce.Web.UI.DataGrid
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Design.Areas.OrchestratorDesign.Pages.Domains.IndexModel
@{
    ViewData["Title"] = "Domains";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Domains</h1>
        <p class="od-page-subtitle">Catalog used by orchestration definitions.</p>
    </div>
    <button type="button" class="btn btn-primary js-open-domain-modal" data-mode="create">Create domain</button>
</div>

<section class="od-catalog" data-catalog="domains" data-label="domains" data-source="@Url.Page(null, "List")">
    <div class="od-catalog-controls" role="group" aria-label="View mode">
        <button type="button" class="btn btn-outline-secondary" data-catalog-view="grid" aria-label="Grid view" title="Grid view" aria-pressed="true"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
        <button type="button" class="btn btn-outline-secondary" data-catalog-view="cards" aria-label="Card view" title="Card view" aria-pressed="false"><i class="bi bi-grid-3x2-gap" aria-hidden="true"></i></button>
    </div>
    <div data-catalog-grid>
        @await Component.InvokeAsync("ZoorceDataGrid", new ZoorceDataGridOptions
        {
            Id = "domains-grid", AriaLabel = "domains", Binding = new ZoorceDataBindingOptions { Source = Url.Page(null, "List") },
            LoadMode = ZoorceDataLoadMode.InfiniteScroll, PageSize = 25,
            Columns = [new("displayName", "Name"), new("key", "Key"), new("status", "Status"), new("description", "Description"), new("actions", "Actions", false)]
        })
    </div>
    <div data-catalog-cards hidden>
        <div class="od-catalog-filters">
            <label class="z-search-field"><span aria-hidden="true">⌕</span><input type="search" data-catalog-search aria-label="Search domains" placeholder="Search domains" autocomplete="off" /></label>
            <select class="form-select" data-catalog-sort aria-label="Sort domains">
                <option value="displayName">Name: A to Z</option><option value="displayName:desc">Name: Z to A</option>
                <option value="key">Key: A to Z</option><option value="key:desc">Key: Z to A</option>
                <option value="status">Status</option>
            </select>
        </div>
        <div class="od-grid" data-catalog-card-items></div>
        <p class="od-empty" data-catalog-empty hidden>No matching domains.</p>
        <p data-catalog-status aria-live="polite"></p>
        <div data-catalog-sentinel aria-hidden="true"></div>
        <button type="button" class="btn btn-outline-secondary" data-catalog-more hidden>Load more</button>
    </div>
    <form method="post" asp-page-handler="SetIsActive" data-catalog-action-form>
        <input type="hidden" name="domainId" />
        <input type="hidden" name="isActive" />
    </form>
</section>

<div class="modal fade" id="domainModal" tabindex="-1" aria-labelledby="domainModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Upsert" data-orchestrator-validate="true" data-orchestrator-busy="true" data-busy-title="Saving domain" data-busy-message="Design is validating and storing the domain.">
                <div class="modal-header">
                    <h5 class="modal-title" id="domainModalLabel">Create domain</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input asp-for="Input.DomainId" type="hidden" id="domainIdInput" />
                    <div class="mb-2">
                        <label asp-for="Input.Key" class="form-label"></label>
                        <input asp-for="Input.Key" class="form-control" id="domainKeyInput" data-orchestrator-key="true" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.DisplayName" class="form-label"></label>
                        <input asp-for="Input.DisplayName" class="form-control" id="domainDisplayNameInput" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.Description" class="form-label"></label>
                        <textarea asp-for="Input.Description" class="form-control" rows="3" id="domainDescriptionInput"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="domainModalSubmitButton">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const modalElement = document.getElementById('domainModal');
    const title = document.getElementById('domainModalLabel');
    const submitButton = document.getElementById('domainModalSubmitButton');
    const modal = window.bootstrap?.Modal?.getOrCreateInstance(modalElement);
    if (!modalElement || !title || !submitButton || !modal) return;

    const idInput = document.getElementById('domainIdInput');
    const keyInput = document.getElementById('domainKeyInput');
    const displayNameInput = document.getElementById('domainDisplayNameInput');
    const descriptionInput = document.getElementById('domainDescriptionInput');

    const setValue = (el, value) => { if (el) el.value = value ?? ''; };

    document.addEventListener('click', event => {
        const button = event.target.closest('.js-open-domain-modal');
        if (!button) return;
            const mode = button.getAttribute('data-mode');
            if (mode === 'edit') {
                title.textContent = 'Edit domain';
                submitButton.textContent = 'Save';
                setValue(idInput, button.getAttribute('data-id'));
                setValue(keyInput, button.getAttribute('data-key'));
                setValue(displayNameInput, button.getAttribute('data-display-name'));
                setValue(descriptionInput, button.getAttribute('data-description'));
                keyInput.readOnly = true;
                modal.show();
                return;
            }

            title.textContent = 'Create domain';
            submitButton.textContent = 'Create';
            setValue(idInput, '');
            setValue(keyInput, '');
            setValue(displayNameInput, '');
            setValue(descriptionInput, '');
            keyInput.readOnly = false;
            modal.show();
    });
})();
</script>
<script src="~/_content/Krackend.Sagas.Orchestrations.ControlPlane.WebUI/js/orchestrator-catalog.js" asp-append-version="true"></script>
}
