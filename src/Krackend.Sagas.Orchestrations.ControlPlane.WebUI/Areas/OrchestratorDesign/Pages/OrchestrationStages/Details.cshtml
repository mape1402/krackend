    };

    function setInputValue(propertyName, value) {
        const elementId = fieldIdOverrides[propertyName] ?? `NewTask_${propertyName}`;
        const element = document.getElementById(elementId);
        if (!element) {
            return;
        }

        const type = (element.getAttribute('type') || '').toLowerCase();
        if (type === 'checkbox') {
            element.checked = value === true || value === 'true' || value === 1;
            element.dispatchEvent(new Event('change', { bubbles: true }));
            return;
        }

        element.value = value ?? '';
        element.dispatchEvent(new Event('change', { bubbles: true }));
    }

    function applyPayload(payload) {
        Object.keys(defaultValues).forEach(key => setInputValue(key, defaultValues[key]));
        Object.keys(payload || {}).forEach(key => setInputValue(key, payload[key]));

        if (taskIdInput) {
            taskIdInput.value = payload?.TaskId || '';
        }

        if (taskIdRawInput) {
            taskIdRawInput.value = payload?.TaskId || '';
        }

        document.querySelectorAll('.od-chip-editor[data-chip-editor-for]').forEach(editor => {
            const targetId = editor.getAttribute('data-chip-editor-for');
            const hidden = targetId ? document.getElementById(targetId) : null;
