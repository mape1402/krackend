@page
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Design.Areas.OrchestratorDesign.Pages.OrchestrationStages.DetailsModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@using Krackend.Sagas.Orchestrations.ControlPlane.Design.Core
@using Krackend.Sagas.Orchestrations.ControlPlane.Design.Core.ConditionConfigurations
@using Krackend.Sagas.Orchestrations.ControlPlane.Design.Core.RetryStrategies
@using Krackend.Sagas.Orchestrations.ControlPlane.Design.Core.TimeoutBehaviorPolicies
@using Krackend.Sagas.Orchestrations.Abstractions.Primitives
@using Zoorce.Web.UI.Foundation.Components
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = $"{Model.Stage?.Name ?? "Stage"} · Tasks";
}

@if (!Model.CanEdit)
{
    <div class="alert alert-secondary">This version is read-only because its status is @Model.SelectedVersion?.Status.</div>
    <style>
        .od-task-toggle-row,
        .od-add-actions-item {
            display: none !important;
        }
    </style>
}

<section class="od-list-shell">
    <div class="od-panel-head">
        <h2 class="od-panel-title">Tasks</h2>
        <span class="od-item-meta">@(Model.CanEdit ? "Drag cards to reorder" : "Read-only tasks")</span>
    </div>

    @if (!Model.Tasks.Any())
    {
        <p class="od-empty">No tasks yet.</p>
    }

    @{
        var orderedTasks = Model.Tasks.OrderBy(t => t.Order).ToList();
        var renderedGroups = new HashSet<string>(StringComparer.Ordinal);
    }
    <div id="taskPipeline" class="od-pipeline">
        @foreach (var task in orderedTasks)
        {
            var grouped = task.ExecutionMode == TaskExecutionMode.Parallel && !string.IsNullOrWhiteSpace(task.ParallelGroupId);
            if (grouped)
            {
                var groupId = task.ParallelGroupId!;
                if (!renderedGroups.Add(groupId))
                {
                    continue;
                }

                var groupTasks = orderedTasks
                    .Where(x => x.ExecutionMode == TaskExecutionMode.Parallel && string.Equals(x.ParallelGroupId, groupId, StringComparison.Ordinal))
                    .ToList();
                var groupName = Model.ParallelGroups
                    .FirstOrDefault(x => string.Equals(x.Id, groupId, StringComparison.Ordinal))?.Name;
                groupName = string.IsNullOrWhiteSpace(groupName) ? "Parallel group" : groupName;

                <article class="od-parallel-group" data-group-id="@groupId" draggable="@Model.CanEdit.ToString().ToLowerInvariant()">
                    <div class="od-parallel-group-head">
                        <div>
                            <h3 class="od-item-title">@groupName</h3>
                        </div>
                        <div class="dropdown">
                            <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Parallel group actions">&#8942;</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <button type="button" class="dropdown-item js-edit-group">@(Model.CanEdit ? "Edit group" : "View group")</button>
                                </li>
                                @if (Model.CanEdit)
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <button type="button" class="dropdown-item text-danger js-remove-group">Remove group</button>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                    <div class="od-group-task-list" data-group-id="@groupId">
                        @foreach (var groupedTask in groupTasks)
                        {
                            var groupedTaskHasExecutionCondition = groupedTask.HasExecutionCondition;
                            var groupedTaskHasTransformation = groupedTask.HasTransformation;

                            <article class="od-pipeline-item" data-task-id="@groupedTask.Id" draggable="@Model.CanEdit.ToString().ToLowerInvariant()">
                                <div class="od-pipeline-card od-task-card @(groupedTask.IsEnabled ? string.Empty : "od-task-disabled")">
                                    <button type="button"
                                            class="od-task-side-btn od-task-exec-btn js-task-execution-btn @(groupedTaskHasExecutionCondition ? "od-task-exec-btn-active" : "od-task-exec-btn-inactive")"
                                            title="Execution condition"
                                            aria-label="Execution condition"
                                            data-task-id="@groupedTask.Id">
                                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                            <path d="M8.5 1.5a.5.5 0 0 0-.9-.3l-4 6a.5.5 0 0 0 .4.8H7l-1 6a.5.5 0 0 0 .9.3l4-6a.5.5 0 0 0-.4-.8H7.5l1-6z" />
                                        </svg>
                                    </button>
                                    <button type="button"
                                            class="od-task-side-btn od-task-transform-btn js-task-transformation-btn @(groupedTaskHasTransformation ? "od-task-transform-btn-active" : "od-task-transform-btn-inactive")"
                                            title="Transformation"
                                            aria-label="Transformation"
                                            data-task-id="@groupedTask.Id">
                                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                            <path d="M1 3a.5.5 0 0 1 .5-.5h11.793L11.146.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 1 1-.708-.708L13.293 3.5H1.5A.5.5 0 0 1 1 3Zm14 10a.5.5 0 0 1-.5.5H2.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L2.707 12.5H14.5a.5.5 0 0 1 .5.5Z" />
                                        </svg>
                                    </button>
                                    <div class="od-item-top">
                                        <div>
                                            <h3 class="od-item-title">@groupedTask.Key</h3>
                                            <p class="od-item-meta">@groupedTask.Name</p>
                                            <p class="od-item-meta">@groupedTask.Kind</p>
                                        </div>
                                        <div class="dropdown">
                                            <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Task actions">&#8942;</button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <button type="button"
                                                    class="dropdown-item js-open-task-modal"
                                                    data-task-mode="edit"
                                                    data-task-id="@groupedTask.Id">
                                                        @(Model.CanEdit ? "Edit task" : "View task")
                                                    </button>
                                                </li>
                                                @if (Model.CanEdit)
                                                {
                                                    <li><hr class="dropdown-divider" /></li>
                                                    <li>
                                                        <form method="post" asp-page-handler="DeleteTask" class="od-inline-form" data-confirm="true" data-confirm-title="Delete task" data-confirm-message="Delete this task from the stage?" data-confirm-accept="Delete" data-confirm-type="warning" data-orchestrator-busy="true" data-busy-title="Deleting task" data-busy-message="Design is removing the task definition.">
                                                            <input type="hidden" name="orchestrationId" value="@Model.OrchestrationId" />
                                                            <input type="hidden" name="versionId" value="@Model.VersionId" />
                                                            <input type="hidden" name="stageId" value="@Model.StageId" />
                                                            <input type="hidden" name="taskId" value="@groupedTask.Id" />
                                                            <button type="submit" class="dropdown-item text-danger">Delete task</button>
                                                        </form>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                    @if (Model.CanEdit)
                                    {
                                        <div class="od-task-toggle-row">
                                            <span class="od-task-toggle-label">Enabled</span>
                                            <div class="form-check form-switch od-task-toggle">
                                                <input class="form-check-input js-task-enabled-toggle" type="checkbox" role="switch" data-task-id="@groupedTask.Id" @(groupedTask.IsEnabled ? "checked" : null) aria-label="Toggle task enabled" />
                                            </div>
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                        <p class="od-group-empty @(groupTasks.Count > 0 ? "d-none" : string.Empty)">Drop tasks here</p>
                    </div>
                </article>
                continue;
            }

            var taskHasExecutionCondition = task.HasExecutionCondition;
            var taskHasTransformation = task.HasTransformation;

            <article class="od-pipeline-item" data-task-id="@task.Id" draggable="@Model.CanEdit.ToString().ToLowerInvariant()">
                <div class="od-pipeline-card od-task-card @(task.IsEnabled ? string.Empty : "od-task-disabled")">
                    <button type="button"
                            class="od-task-side-btn od-task-exec-btn js-task-execution-btn @(taskHasExecutionCondition ? "od-task-exec-btn-active" : "od-task-exec-btn-inactive")"
                            title="Execution condition"
                            aria-label="Execution condition"
                            data-task-id="@task.Id">
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                            <path d="M8.5 1.5a.5.5 0 0 0-.9-.3l-4 6a.5.5 0 0 0 .4.8H7l-1 6a.5.5 0 0 0 .9.3l4-6a.5.5 0 0 0-.4-.8H7.5l1-6z" />
                        </svg>
                    </button>
                    <button type="button"
                            class="od-task-side-btn od-task-transform-btn js-task-transformation-btn @(taskHasTransformation ? "od-task-transform-btn-active" : "od-task-transform-btn-inactive")"
                            title="Transformation"
                            aria-label="Transformation"
                            data-task-id="@task.Id">
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                            <path d="M1 3a.5.5 0 0 1 .5-.5h11.793L11.146.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L13.293 3.5H1.5A.5.5 0 0 1 1 3Zm14 10a.5.5 0 0 1-.5.5H2.707l2.147 2.146a.5.5 0 1 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L2.707 12.5H14.5a.5.5 0 0 1 .5.5Z" />
                        </svg>
                    </button>
                    <div class="od-item-top">
                        <div>
                            <h3 class="od-item-title">@task.Key</h3>
                            <p class="od-item-meta">@task.Name</p>
                            <p class="od-item-meta">@task.Kind</p>
                        </div>
                        <div class="dropdown">
                            <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Task actions">&#8942;</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <button type="button"
                                            class="dropdown-item js-open-task-modal"
                                            data-task-mode="edit"
                                            data-task-id="@task.Id">
                                        @(Model.CanEdit ? "Edit task" : "View task")
                                    </button>
                                </li>
                                @if (Model.CanEdit)
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" asp-page-handler="DeleteTask" class="od-inline-form" data-confirm="true" data-confirm-title="Delete task" data-confirm-message="Delete this task from the stage?" data-confirm-accept="Delete" data-confirm-type="warning" data-orchestrator-busy="true" data-busy-title="Deleting task" data-busy-message="Design is removing the task definition.">
                                            <input type="hidden" name="orchestrationId" value="@Model.OrchestrationId" />
                                            <input type="hidden" name="versionId" value="@Model.VersionId" />
                                            <input type="hidden" name="stageId" value="@Model.StageId" />
                                            <input type="hidden" name="taskId" value="@task.Id" />
                                            <button type="submit" class="dropdown-item text-danger">Delete task</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                    @if (Model.CanEdit)
                    {
                        <div class="od-task-toggle-row">
                            <span class="od-task-toggle-label">Enabled</span>
                            <div class="form-check form-switch od-task-toggle">
                                <input class="form-check-input js-task-enabled-toggle" type="checkbox" role="switch" data-task-id="@task.Id" @(task.IsEnabled ? "checked" : null) aria-label="Toggle task enabled" />
                            </div>
                        </div>
                    }
                </div>
            </article>
        }

        @if (Model.CanEdit)
        {
            <article class="od-pipeline-item od-add-item od-add-group-item od-add-actions-item">
                <div class="od-pipeline-card od-add-actions-card">
                    <a href="#" id="addParallelGroupButton" class="od-add-link">+ Add parallel group</a>
                    <span class="od-add-actions-separator" aria-hidden="true"></span>
                    <button type="button" class="od-add-link js-open-task-modal" data-task-mode="create">+ Add task</button>
                </div>
            </article>
        }
    </div>
</section>

@await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions {
    Id = "editParallelGroupModal", Title = "Edit parallel group", Eyebrow = null,
    Body = await Html.PartialAsync("_ParallelGroupForm"),
    Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Cancel</button><button type=\"button\" class=\"z-button z-button-primary\" id=\"saveParallelGroupButton\">Save group</button>")
})

@await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions {
    Id = "newTaskModal", Title = "Create task", Eyebrow = null, Size = "full",
    Body = await Html.PartialAsync("_TaskForm", Model),
    Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Cancel</button><button type=\"submit\" form=\"taskForm\" class=\"z-button z-button-primary\" id=\"taskModalSubmitButton\">Create</button>")
})

<meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />
@if (Model.ShouldOpenEditModal)
{
    <script>
        window.__odServerEditTaskPayload = @Html.Raw(Model.EditTaskPayloadJson);
    </script>
}

@section Scripts {
<script src="/_content/ButterMorph.Web.Razor/buttermorph/buttermorph-host.js?v=2.1.3"></script>
<script src="/_content/Krackend.Sagas.Orchestrations.ControlPlane.WebUI/js/orchestrator-buttermorph-contrast.js" asp-append-version="true"></script>
<script>
const orchestrationStageCanEdit = @Model.CanEdit.ToString().ToLowerInvariant();
const orchestrationStageVersionId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VersionId));

function setStageModalReadOnly(modalElement, readOnly, submitButton) {
    if (!modalElement) {
        return;
    }

    modalElement.querySelectorAll('input, textarea, select').forEach(element => {
        const type = (element.getAttribute('type') || '').toLowerCase();
        if (type === 'hidden') {
            return;
        }

        if (element.tagName === 'TEXTAREA' || (element.tagName === 'INPUT' && type !== 'checkbox' && type !== 'radio')) {
            element.readOnly = readOnly;
            element.toggleAttribute('readonly', readOnly);
            return;
        }

        element.disabled = readOnly;
    });

    modalElement.querySelectorAll('.od-chip-input').forEach(input => {
        input.readOnly = readOnly;
        input.disabled = readOnly;
    });

    modalElement.querySelectorAll('.od-chip-remove').forEach(button => {
        button.disabled = readOnly;
        button.classList.toggle('d-none', readOnly);
    });

    if (submitButton) {
        submitButton.classList.toggle('d-none', readOnly);
        submitButton.disabled = readOnly;
    }

    const dismissButton = modalElement.querySelector('footer [data-z-dialog-close], .modal-footer [data-bs-dismiss="modal"]');
    if (dismissButton) {
        dismissButton.textContent = readOnly ? 'Close' : 'Cancel';
    }
}

(() => {
    const pipeline = document.getElementById('taskPipeline');
    if (!pipeline) return;

    const canEdit = orchestrationStageCanEdit;

    const antiForgeryToken = document.querySelector('meta[name="request-verification-token"]')?.getAttribute('content') || '';
    const addParallelGroupButton = document.getElementById('addParallelGroupButton');
    const editGroupModalElement = document.getElementById('editParallelGroupModal');
    const editGroupModalTitle = document.getElementById('editParallelGroupModal-title');
    const editGroupIdInput = document.getElementById('editParallelGroupId');
    const editGroupNameInput = document.getElementById('editParallelGroupName');
    const editGroupJoinPolicyInput = document.getElementById('editParallelGroupJoinPolicy');
    const editGroupMaxParallelAgentsInput = document.getElementById('editParallelGroupMaxParallelAgents');
    const saveParallelGroupButton = document.getElementById('saveParallelGroupButton');
    setStageModalReadOnly(editGroupModalElement, !canEdit, saveParallelGroupButton);

    let draggedTask = null;
    let draggedGroup = null;
    let groupNameCounter = getInitialGroupNameCounter();

    function getSortableTasksInGroup(groupList) {
        return Array.from(groupList.querySelectorAll(':scope > .od-pipeline-item[data-task-id]:not(.dragging)'));
    }

    function getAfterElement(listItems, y) {
        let closest = { offset: Number.NEGATIVE_INFINITY, element: null };
        listItems.forEach(element => {
            const box = element.getBoundingClientRect();
            const offset = y - (box.top + box.height / 2);
            if (offset < 0 && offset > closest.offset) {
                closest = { offset, element };
            }
        });

        return closest.element;
    }

    function updateGroupEmptyStates() {
        pipeline.querySelectorAll('.od-parallel-group').forEach(group => {
            const groupList = group.querySelector('.od-group-task-list');
            const emptyHint = group.querySelector('.od-group-empty');
            if (!groupList || !emptyHint) {
                return;
            }

            const hasTasks = groupList.querySelector('.od-pipeline-item[data-task-id]') !== null;
            emptyHint.classList.toggle('d-none', hasTasks);
        });
    }

    function getInitialGroupNameCounter() {
        let maxNumber = 0;
        pipeline.querySelectorAll('.od-parallel-group .od-item-title').forEach(title => {
            const text = (title.textContent || '').trim();
            const match = /^Group(\d+)$/i.exec(text);
            if (!match) {
                return;
            }

            const number = Number.parseInt(match[1], 10);
            if (Number.isFinite(number) && number > maxNumber) {
                maxNumber = number;
            }
        });

        return maxNumber;
    }

    function getNextDefaultGroupName() {
        groupNameCounter += 1;
        return `Group${groupNameCounter}`;
    }

    function normalizeGroupName(value, fallback = 'Parallel group') {
        const normalized = (value || '').trim();
        if (!normalized) {
            return fallback;
        }

        return normalized.length > 128 ? normalized.substring(0, 128) : normalized;
    }

    function createParallelGroupElement(groupData) {
        const group = document.createElement('article');
        group.className = 'od-parallel-group';
        group.dataset.groupId = groupData.id;
        group.draggable = canEdit;
        const groupName = normalizeGroupName(groupData.name, 'Parallel group');
        group.innerHTML = `
            <div class="od-parallel-group-head">
                <div>
                    <h3 class="od-item-title">${groupName}</h3>
                </div>
                <div class="dropdown">
                    <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Parallel group actions">&#8942;</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <button type="button" class="dropdown-item js-edit-group">${canEdit ? 'Edit group' : 'View group'}</button>
                        </li>
                        ${canEdit ? `
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <button type="button" class="dropdown-item text-danger js-remove-group">Remove group</button>
                        </li>
                        ` : ''}
                    </ul>
                </div>
            </div>
            <div class="od-group-task-list" data-group-id="${groupData.id}">
                <p class="od-group-empty">Drop tasks here</p>
            </div>`;

        return group;
    }

    async function postJson(handler, payload) {
        const response = await fetch(`${window.location.pathname}?handler=${handler}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': antiForgeryToken
            },
            body: JSON.stringify(payload || {})
        });

        if (!response.ok) {
            return null;
        }

        return response.json();
    }

    async function openTaskExecutionConditionModal(taskId) {
        if (!taskId) {
            return;
        }

        if (!window.ButterMorphHost?.openFrame) {
            window.OrchestratorMessages?.notify({
                title: 'ButterMorph unavailable',
                message: 'The ButterMorph condition designer could not be loaded.',
                type: 'error'
            });
            return;
        }

        const contextKey = `orchestration-task-execution-condition:${orchestrationStageVersionId}:${taskId}`;
        const designerUrl = canEdit
            ? `/buttermorph/validations/designer?context=${encodeURIComponent(contextKey)}&mode=edit`
            : `/buttermorph/validations/viewer?context=${encodeURIComponent(contextKey)}`;
        window.ButterMorphHost.openFrame(designerUrl, {
            title: 'ButterMorph execution condition',
            width: '96vw',
            height: '92vh'
        });
    }

    async function openTaskTransformationModal(taskId) {
        if (!taskId) {
            return;
        }

        if (!window.ButterMorphHost?.openFrame) {
            window.OrchestratorMessages?.notify({
                title: 'ButterMorph unavailable',
                message: 'The ButterMorph designer could not be loaded.',
                type: 'error'
            });
            return;
        }

        const contextKey = `orchestration-task-transform:${orchestrationStageVersionId}:${taskId}`;
        const designerUrl = canEdit
            ? `/buttermorph/designer?context=${encodeURIComponent(contextKey)}&mode=edit`
            : `/buttermorph/mappings/viewer?context=${encodeURIComponent(contextKey)}`;
        window.ButterMorphHost.openFrame(designerUrl, {
            title: 'ButterMorph transformation',
            width: '96vw',
            height: '92vh'
        });
    }

    async function openTaskCompensationConditionModal(taskId) {
        if (!taskId) {
            notifyMissingSavedTask();
            return;
        }

        if (!window.ButterMorphHost?.openFrame) {
            window.OrchestratorMessages?.notify({
                title: 'ButterMorph unavailable',
                message: 'The ButterMorph condition designer could not be loaded.',
                type: 'error'
            });
            return;
        }

        const contextKey = `orchestration-task-compensation-execution-condition:${orchestrationStageVersionId}:${taskId}`;
        const designerUrl = canEdit
            ? `/buttermorph/validations/designer?context=${encodeURIComponent(contextKey)}&mode=edit`
            : `/buttermorph/validations/viewer?context=${encodeURIComponent(contextKey)}`;
        window.ButterMorphHost.openFrame(designerUrl, {
            title: 'ButterMorph compensation condition',
            width: '96vw',
            height: '92vh'
        });
    }

    async function openTaskCompensationTransformationModal(taskId) {
        if (!taskId) {
            notifyMissingSavedTask();
            return;
        }

        if (!window.ButterMorphHost?.openFrame) {
            window.OrchestratorMessages?.notify({
                title: 'ButterMorph unavailable',
                message: 'The ButterMorph designer could not be loaded.',
                type: 'error'
            });
            return;
        }

        const contextKey = `orchestration-task-compensation-transform:${orchestrationStageVersionId}:${taskId}`;
        const designerUrl = canEdit
            ? `/buttermorph/designer?context=${encodeURIComponent(contextKey)}&mode=edit`
            : `/buttermorph/mappings/viewer?context=${encodeURIComponent(contextKey)}`;
        window.ButterMorphHost.openFrame(designerUrl, {
            title: 'ButterMorph compensation transformation',
            width: '96vw',
            height: '92vh'
        });
    }

    function getTaskModalTaskId() {
        return document.getElementById('taskModalTaskIdRaw')?.value ||
            document.getElementById('taskModalTaskId')?.value ||
            '';
    }

    function notifyMissingSavedTask() {
        window.OrchestratorMessages?.notify({
            title: 'Save the task first',
            message: 'ButterMorph can be opened after the compensation owner task has been saved.',
            type: 'warning'
        });
    }

    document.getElementById('openCompensationConditionDesignerButton')?.addEventListener('click', async () => {
        await openTaskCompensationConditionModal(getTaskModalTaskId());
    });

    document.getElementById('openCompensationTransformationDesignerButton')?.addEventListener('click', async () => {
        await openTaskCompensationTransformationModal(getTaskModalTaskId());
    });

    function getRootDropTarget(target) {
        if (!target) {
            return null;
        }

        const candidate = target.closest('.od-parallel-group, .od-pipeline-item');
        if (!candidate || !pipeline.contains(candidate) || candidate.classList.contains('dragging')) {
            return null;
        }

        if (candidate.classList.contains('od-parallel-group')) {
            return candidate;
        }

        if (candidate.matches('.od-pipeline-item[data-task-id]')) {
            return candidate;
        }

        if (candidate.classList.contains('od-add-item') || candidate.classList.contains('od-add-group-item')) {
            return candidate;
        }

        return null;
    }

    function insertInRootByTarget(item, target, x) {
        if (!item) {
            return;
        }

        if (!target) {
            const addGroupCard = pipeline.querySelector('.od-add-group-item');
            if (addGroupCard) {
                pipeline.insertBefore(item, addGroupCard);
            } else {
                pipeline.appendChild(item);
            }

            return;
        }

        if (target === item) {
            return;
        }

        if (target.classList.contains('od-add-item') || target.classList.contains('od-add-group-item')) {
            pipeline.insertBefore(item, target);
            return;
        }

        const targetRect = target.getBoundingClientRect();
        const shouldPlaceBefore = x < targetRect.left + (targetRect.width / 2);
        pipeline.insertBefore(item, shouldPlaceBefore ? target : target.nextSibling);
    }

    function insertInGroupByPointer(groupList, y) {
        const candidates = getSortableTasksInGroup(groupList);
        const after = getAfterElement(candidates, y);
        if (!after) {
            groupList.appendChild(draggedTask);
            return;
        }

        groupList.insertBefore(draggedTask, after);
    }

    pipeline.addEventListener('dragstart', event => {
        if (!canEdit) {
            event.preventDefault();
            return;
        }

        const task = event.target.closest('.od-pipeline-item[data-task-id]');
        if (task) {
            draggedTask = task;
            draggedGroup = null;
            draggedTask.classList.add('dragging');
            event.dataTransfer.effectAllowed = 'move';
            event.dataTransfer.setData('text/plain', task.dataset.taskId || '');
            return;
        }

        const group = event.target.closest('.od-parallel-group');
        if (!group || !pipeline.contains(group)) {
            event.preventDefault();
            return;
        }

        draggedGroup = group;
        draggedTask = null;
        draggedGroup.classList.add('dragging');
        event.dataTransfer.effectAllowed = 'move';
        event.dataTransfer.setData('text/plain', group.dataset.groupId || '');
    });

    pipeline.addEventListener('dragover', event => {
        if (!canEdit) {
            return;
        }

        if (!draggedTask && !draggedGroup) {
            return;
        }

        event.preventDefault();
        const groupList = draggedTask ? event.target.closest('.od-group-task-list') : null;
        if (groupList) {
            insertInGroupByPointer(groupList, event.clientY);
            updateGroupEmptyStates();
            return;
        }

        const rootTarget = getRootDropTarget(event.target);
        insertInRootByTarget(draggedGroup || draggedTask, rootTarget, event.clientX);
        updateGroupEmptyStates();
    });

    pipeline.addEventListener('dragend', async () => {
        if (!canEdit) {
            return;
        }

        if (!draggedTask && !draggedGroup) {
            return;
        }

        if (draggedTask) {
            draggedTask.classList.remove('dragging');
            draggedTask = null;
        }

        if (draggedGroup) {
            draggedGroup.classList.remove('dragging');
            draggedGroup = null;
        }

        updateGroupEmptyStates();
        await persistOrder();
    });

    pipeline.addEventListener('click', async event => {
        const executionConditionButton = event.target.closest('.js-task-execution-btn');
        if (executionConditionButton) {
            event.preventDefault();
            const taskId = executionConditionButton.getAttribute('data-task-id') || '';
            if (!taskId) {
                return;
            }

            await openTaskExecutionConditionModal(taskId);
            return;
        }

        const transformationButton = event.target.closest('.js-task-transformation-btn');
        if (transformationButton) {
            event.preventDefault();
            const taskId = transformationButton.getAttribute('data-task-id') || '';
            if (!taskId) {
                return;
            }

            await openTaskTransformationModal(taskId);
            return;
        }

        const editButton = event.target.closest('.js-edit-group');
        if (editButton) {
            event.preventDefault();
            const group = editButton.closest('.od-parallel-group');
            const groupId = group?.getAttribute('data-group-id') || '';
            if (!groupId) {
                return;
            }

            const response = await fetch(`${window.location.pathname}?handler=ParallelGroupForEdit&groupId=${encodeURIComponent(groupId)}`);
            if (!response.ok) {
                return;
            }

            const payload = await response.json();
            if (!editGroupIdInput || !editGroupNameInput || !editGroupJoinPolicyInput || !editGroupMaxParallelAgentsInput) {
                return;
            }

            editGroupIdInput.value = payload.id || groupId;
            editGroupNameInput.value = normalizeGroupName(payload.name, 'Parallel group');
            editGroupJoinPolicyInput.value = payload.joinPolicy || 'WaitAll';
            editGroupMaxParallelAgentsInput.value = payload.maxParallelAgents == null ? '' : payload.maxParallelAgents;
            if (editGroupModalTitle) {
                editGroupModalTitle.textContent = canEdit ? 'Edit parallel group' : 'Parallel group configuration';
            }

            setStageModalReadOnly(editGroupModalElement, !canEdit, saveParallelGroupButton);

            editGroupModalElement?.open?.();

            return;
        }

        const removeButton = event.target.closest('.js-remove-group');
        if (!removeButton) {
            return;
        }

        event.preventDefault();
        if (!canEdit) {
            return;
        }

        const group = removeButton.closest('.od-parallel-group');
        if (!group) {
            return;
        }
        const groupId = group.getAttribute('data-group-id') || '';
        if (!groupId) {
            return;
        }

        const deleteResult = await postJson('DeleteParallelGroup', { stageId: '@Model.StageId', groupId });
        if (!deleteResult?.success) {
            return;
        }

        const tasks = Array.from(group.querySelectorAll('.od-pipeline-item[data-task-id]'));
        const addGroupCard = pipeline.querySelector('.od-add-group-item');
        tasks.forEach(task => {
            if (addGroupCard) {
                pipeline.insertBefore(task, addGroupCard);
            } else {
                pipeline.appendChild(task);
            }
        });

        group.remove();
        updateGroupEmptyStates();
        await persistOrder();
    });

    pipeline.addEventListener('change', async event => {
        if (!canEdit) {
            event.preventDefault();
            return;
        }

        const toggle = event.target.closest('.js-task-enabled-toggle');
        if (!toggle) {
            return;
        }

        const taskId = toggle.getAttribute('data-task-id') || '';
        if (!taskId) {
            return;
        }

        const previousValue = !toggle.checked;
        const card = toggle.closest('.od-pipeline-card');
        toggle.disabled = true;
        const updateResult = await postJson('SetTaskEnabled', {
            taskId,
            isEnabled: toggle.checked
        });

        if (!updateResult?.success) {
            toggle.checked = previousValue;
        } else if (card) {
            card.classList.toggle('od-task-disabled', !toggle.checked);
        }

        toggle.disabled = false;
    });

    window.addEventListener('message', event => {
        if (event.origin !== window.location.origin || !event.data) {
            return;
        }

        if (event.data.type === 'ButterMorphDesignerSaved' || event.data.type === 'ButterMorphValidationDesignerSaved') {
            window.location.reload();
        }
    });

    if (saveParallelGroupButton) {
        saveParallelGroupButton.addEventListener('click', async () => {
            if (!canEdit) {
                return;
            }

            if (!editGroupIdInput || !editGroupNameInput || !editGroupJoinPolicyInput || !editGroupMaxParallelAgentsInput) {
                return;
            }

            const groupId = editGroupIdInput.value || '';
            if (!groupId) {
                return;
            }

            const name = normalizeGroupName(editGroupNameInput.value, 'Parallel group');
            const joinPolicy = editGroupJoinPolicyInput.value || 'WaitAll';
            const maxParallelAgentsText = (editGroupMaxParallelAgentsInput.value || '').trim();
            const maxParallelAgents = maxParallelAgentsText.length === 0
                ? null
                : Number.parseInt(maxParallelAgentsText, 10);

            const updateResult = await postJson('UpdateParallelGroup', {
                stageId: '@Model.StageId',
                groupId,
                name,
                joinPolicy,
                maxParallelAgents: Number.isFinite(maxParallelAgents) && maxParallelAgents > 0 ? maxParallelAgents : null
            });

            if (!updateResult?.success) {
                return;
            }

            const groupElement = pipeline.querySelector(`.od-parallel-group[data-group-id="${groupId}"]`);
            const title = groupElement?.querySelector('.od-item-title');
            if (title) {
                title.textContent = name;
            }

            editGroupModalElement?.close?.();
        });
    }

    if (addParallelGroupButton) {
        addParallelGroupButton.addEventListener('click', async event => {
            event.preventDefault();
            if (!canEdit) {
                return;
            }

            const defaultName = getNextDefaultGroupName();
            const createResult = await postJson('CreateParallelGroup', {
                stageId: '@Model.StageId',
                name: defaultName
            });

            if (!createResult?.success || !createResult.group) {
                return;
            }

            const groupElement = createParallelGroupElement(createResult.group);
            const addGroupCard = pipeline.querySelector('.od-add-group-item');
            if (addGroupCard) {
                pipeline.insertBefore(groupElement, addGroupCard);
            } else {
                pipeline.appendChild(groupElement);
            }

            updateGroupEmptyStates();
        });
    }

    async function persistOrder() {
        if (!canEdit) {
            return;
        }

        const items = [];
        const rootItems = Array.from(pipeline.children).filter(
            x => !x.classList.contains('od-add-item') && !x.classList.contains('od-add-group-item'));

        rootItems.forEach(element => {
            if (element.matches('.od-pipeline-item[data-task-id]')) {
                items.push({
                    taskId: element.dataset.taskId || '',
                    parallelGroupId: ''
                });

                return;
            }

            if (element.classList.contains('od-parallel-group')) {
                const groupId = element.getAttribute('data-group-id') || '';
                const groupTasks = element.querySelectorAll('.od-group-task-list > .od-pipeline-item[data-task-id]');
                groupTasks.forEach(task => {
                    items.push({
                        taskId: task.getAttribute('data-task-id') || '',
                        parallelGroupId: groupId
                    });
                });
            }
        });

        if (items.length === 0) {
            return;
        }

        await postJson('ReorderTasks', { stageId: '@Model.StageId', items });
    }

    updateGroupEmptyStates();
})();

