            if (!canEdit) {
                return;
            }

            modalTitle.textContent = 'Create task';
            submitButton.textContent = 'Create';
            applyPayload({});
            setStageModalReadOnly(modalElement, false, submitButton);
            openModal();
        });
    });

    if (serverEditPayload && modalTitle && submitButton) {
        modalTitle.textContent = canEdit ? 'Edit task' : 'Task configuration';
        submitButton.textContent = 'Save';
        applyPayload(serverEditPayload);
        setStageModalReadOnly(modalElement, !canEdit, submitButton);

        openModal();
    }
})();

