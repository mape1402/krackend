@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Design.Areas.OrchestratorDesign.Pages.OrchestrationStages.DetailsModel
<form id="taskForm" method="post" asp-page-handler="CreateTask" class="od-task-modal-form" data-orchestrator-validate="true" data-orchestrator-busy="true" data-busy-title="Saving task" data-busy-message="Design is validating and storing the task definition.">
                    <input type="hidden" name="orchestrationId" value="@Model.OrchestrationId" />
                    <input type="hidden" name="versionId" value="@Model.VersionId" />
                    <input type="hidden" name="NewTask.StageId" value="@Model.StageId" />
                    <input asp-for="NewTask.TaskId" type="hidden" id="taskModalTaskId" />
                    <input type="hidden" name="taskId" id="taskModalTaskIdRaw" />
                    <ul class="z-tabs mb-3" id="taskCreateTabs" role="tablist" data-z-tabs>
                        <li class="nav-item" role="presentation">
                            <button class="z-tab" id="task-general-tab" type="button" role="tab" aria-controls="task-general-pane" aria-selected="true">General</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="z-tab" id="task-policies-tab" type="button" role="tab" aria-controls="task-policies-pane" aria-selected="false">Policies</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="z-tab" id="task-compensation-tab" type="button" role="tab" aria-controls="task-compensation-pane" aria-selected="false">Compensation</button>
                        </li>
                    </ul>
                    <div class="tab-content" id="taskCreateTabsContent">
                        <div class="z-tab-panel" id="task-general-pane" role="tabpanel" aria-labelledby="task-general-tab" tabindex="0">
                            <div class="row g-3 mb-2">
                                <div class="col-md-4">
                                    <label asp-for="NewTask.Key" class="z-form-label">Key</label>
                                    <input asp-for="NewTask.Key" class="z-form-input" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="NewTask.Name" class="z-form-label">Name</label>
                                    <input asp-for="NewTask.Name" class="z-form-input" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="NewTask.Kind" class="z-form-label">Task type</label>
                                    <select asp-for="NewTask.Kind" class="z-form-input z-form-select" asp-items="Model.TaskKinds" id="taskKindSelector"></select>
                                </div>
                            </div>
                            <hr />
                            <h6 class="mb-2">Task configuration (selected type)</h6>
                            <div class="task-config-block mb-2" data-kind="Http">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label asp-for="NewTask.HttpBaseUrlVariableRef" class="z-form-label">Base URL variable</label>
                                        <input asp-for="NewTask.HttpBaseUrlVariableRef" class="z-form-input" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="NewTask.HttpRelativePath" class="z-form-label">Relative path</label>
                                        <input asp-for="NewTask.HttpRelativePath" class="z-form-input" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="NewTask.HttpMethod" class="z-form-label">Method</label>
                                        <input asp-for="NewTask.HttpMethod" class="z-form-input" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="NewTask.HttpExpectedStatusCodes" class="z-form-label">Expected status codes</label>
                                        <input asp-for="NewTask.HttpExpectedStatusCodes" class="z-form-input" data-orchestrator-status-codes="true" />
                                    </div>
                                    <div class="col-md-12 form-check mt-3 ms-2">
                                        <input asp-for="NewTask.HttpAllowSyncResponse" class="form-check-input" />
                                        <label asp-for="NewTask.HttpAllowSyncResponse" class="form-check-label">Allow sync response</label>
                                    </div>
                                    <div class="col-12"><hr class="my-2" /></div>
                                    <div class="col-12">
                                        <h6 class="mb-2">Schema binding</h6>
                                    </div>
                                    <div class="col-md-8">
                                        <label asp-for="NewTask.HttpSchemaContractKey" class="z-form-label">Contract key</label>
                                        <input asp-for="NewTask.HttpSchemaContractKey"
                                               class="z-form-input"
                                               data-schema-contract-key="true"
                                               data-schema-contract-kind="CommandRequest"
                                               data-schema-version-target="NewTask_HttpSchemaContractVersion" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="NewTask.HttpSchemaContractVersion" class="z-form-label">Contract version</label>
                                        <input asp-for="NewTask.HttpSchemaContractVersion" class="z-form-input" data-orchestrator-version="true" />
                                    </div>
                                    <input asp-for="NewTask.HttpSchemaRegistryProviderId" type="hidden" />
                                </div>
                            </div>
                            <div class="task-config-block mb-2" data-kind="Messaging">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label asp-for="NewTask.MessagingTopic" class="z-form-label">Topic</label>
                                        <input asp-for="NewTask.MessagingTopic" class="z-form-input" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="NewTask.MessagingVersion" class="z-form-label">Version</label>
                                        <input asp-for="NewTask.MessagingVersion" class="z-form-input" data-orchestrator-version="true" />
                                    </div>
                                    <div class="col-12"><hr class="my-2" /></div>
                                    <div class="col-12">
                                        <h6 class="mb-2">Schema binding</h6>
                                    </div>
                                    <div class="col-md-8">
                                        <label asp-for="NewTask.MessagingSchemaContractKey" class="z-form-label">Command key</label>
                                        <input asp-for="NewTask.MessagingSchemaContractKey"
                                               class="z-form-input"
                                               data-schema-contract-key="true"
                                               data-schema-contract-kind="Command"
                                               data-schema-version-target="NewTask_MessagingSchemaContractVersion" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="NewTask.MessagingSchemaContractVersion" class="z-form-label">Command version</label>
                                        <input asp-for="NewTask.MessagingSchemaContractVersion" class="z-form-input" data-orchestrator-version="true" />
                                    </div>
                                    <input asp-for="NewTask.MessagingSchemaRegistryProviderId" type="hidden" />
                                </div>
                            </div>
                            <div class="task-config-block mb-2" data-kind="Plugin">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label asp-for="NewTask.PluginId" class="z-form-label">Plugin id</label>
                                        <input asp-for="NewTask.PluginId" class="z-form-input" data-orchestrator-ulid="true" />
                                    </div>
                                </div>
                            </div>
                            <div class="task-config-block alert alert-secondary mb-2" data-kind="HumanApproval">
                                Human approval has no additional typed fields for now.
                            </div>
                            <hr />
                            <h6 class="mb-2">Execution settings</h6>
                            <div class="row g-2 mb-3">
                                <input asp-for="NewTask.ExecutionMode" type="hidden" />
                                <input asp-for="NewTask.ParallelGroupId" type="hidden" />
                                <div class="col-md-3">
                                    <label asp-for="NewTask.DispatchType" class="z-form-label">Dispatch type</label>
                                    <select asp-for="NewTask.DispatchType" class="z-form-input z-form-select" asp-items="Model.DispatchTypes" id="taskDispatchTypeSelector"></select>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="NewTask.OnErrorPolicy" class="z-form-label">On error policy</label>
                                    <select asp-for="NewTask.OnErrorPolicy" class="z-form-input z-form-select" asp-items="Model.OnErrorPolicies"></select>
                                </div>
                            </div>
                            <hr />
                            <div class="row g-2">
                                <div class="col-md-12">
                                    <label asp-for="NewTask.Notes" class="z-form-label">Notes</label>
                                    <textarea asp-for="NewTask.Notes" class="z-form-input" rows="3"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="z-tab-panel" id="task-policies-pane" role="tabpanel" aria-labelledby="task-policies-tab" tabindex="0" hidden>
                            <div class="form-check form-switch mb-2">
                                <input asp-for="NewTask.HasExecutionCondition" class="form-check-input" id="hasExecutionCondition" />
                                <label asp-for="NewTask.HasExecutionCondition" class="form-check-label">Enable execution condition</label>
                            </div>
                            <input asp-for="NewTask.ConditionEngine" type="hidden" id="conditionEngineSelector" />
                            <input asp-for="NewTask.ConditionDslExpression" type="hidden" />
                            <hr />
                            <div class="form-check form-switch mb-2">
                                <input asp-for="NewTask.HasTransformation" class="form-check-input" id="hasTransformation" />
                                <label asp-for="NewTask.HasTransformation" class="form-check-label">Enable transformation</label>
                            </div>
                            <input asp-for="NewTask.TransformationEngine" type="hidden" id="transformationEngineSelector" />
                            <input asp-for="NewTask.TransformationDsl" type="hidden" />
                            <hr />
                            <div class="form-check form-switch mb-2">
                                <input asp-for="NewTask.HasRetryPolicy" class="form-check-input" id="hasRetryPolicy" />
                                <label asp-for="NewTask.HasRetryPolicy" class="form-check-label">Enable retry policy</label>
                            </div>
                            <div id="retryPolicySection">
                                <h6 class="mb-2">Retry policy</h6>
                                <div class="row g-2 mb-3">
                                    <div class="col-md-3">
                                        <label asp-for="NewTask.RetryStrategyType" class="z-form-label">Retry strategy</label>
                                        <select asp-for="NewTask.RetryStrategyType" class="z-form-input z-form-select" asp-items="Model.RetryStrategyTypes" id="retryStrategySelector"></select>
                                    </div>
                                    <div class="col-md-3 retry-strategy-block" data-retry="Fixed">
                                        <label asp-for="NewTask.RetryDelaySeconds" class="z-form-label">Retry delay (sec)</label>
                                        <input asp-for="NewTask.RetryDelaySeconds" class="z-form-input" type="number" min="0" step="0.1" />
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="NewTask.RetryMaxRetries" class="z-form-label">Retries</label>
                                        <input asp-for="NewTask.RetryMaxRetries" class="z-form-input" type="number" min="0" />
                                    </div>
                                    <div class="col-md-12">
                                        <label asp-for="NewTask.RetryableErrorCodes" class="z-form-label">Retry errors</label>
                                        <input asp-for="NewTask.RetryableErrorCodes" type="hidden" id="retryErrorCodesHidden" />
                                        <div class="od-chip-editor" data-chip-editor-for="retryErrorCodesHidden">
                                            <div class="od-chip-list"></div>
                                            <input type="text" class="od-chip-input" placeholder="Error code + Enter" />
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-check mt-3 ms-2">
                                        <input asp-for="NewTask.RetryStopOnNonRetryableError" class="form-check-input" />
                                        <label asp-for="NewTask.RetryStopOnNonRetryableError" class="form-check-label">Stop on non-retryable</label>
                                    </div>
                                </div>
                            </div>
                            <hr />
                            <div class="form-check form-switch mb-2">
                                <input asp-for="NewTask.HasTimeoutPolicy" class="form-check-input" id="hasTimeoutPolicy" />
                                <label asp-for="NewTask.HasTimeoutPolicy" class="form-check-label">Enable timeout policy</label>
                            </div>
                            <div id="timeoutPolicySection">
                                <h6 class="mb-2">Timeout policy</h6>
                                <div class="row g-2 mb-2">
                                    <div class="col-md-3">
                                        <label asp-for="NewTask.TimeoutSeconds" class="z-form-label">Timeout (sec)</label>
                                        <input asp-for="NewTask.TimeoutSeconds" class="z-form-input" type="number" min="1" step="0.1" />
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="NewTask.TimeoutBehavior" class="z-form-label">Timeout behavior</label>
                                        <select asp-for="NewTask.TimeoutBehavior" class="z-form-input z-form-select" asp-items="Model.TimeoutBehaviors" id="timeoutBehaviorSelector"></select>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="NewTask.TimeoutAction" class="z-form-label">Action on timeout</label>
                                        <select asp-for="NewTask.TimeoutAction" class="z-form-input z-form-select" asp-items="Model.TimeoutActions"></select>
                                    </div>
                                </div>
                                <div class="row g-2 mb-2 timeout-behavior-block" data-timeout="Fail">
                                    <div class="col-md-6">
                                        <label asp-for="NewTask.TimeoutFailErrorCode" class="z-form-label">Fail error code</label>
                                        <input asp-for="NewTask.TimeoutFailErrorCode" class="z-form-input" />
                                    </div>
                                </div>
                                <div class="row g-2 mb-2 timeout-behavior-block" data-timeout="Wait">
                                    <div class="col-md-6">
                                        <label asp-for="NewTask.TimeoutWaitSeconds" class="z-form-label">Wait seconds</label>
                                        <input asp-for="NewTask.TimeoutWaitSeconds" class="z-form-input" type="number" min="1" step="0.1" />
                                    </div>
                                </div>
                                <div class="row g-2 mb-3 timeout-behavior-block" data-timeout="Reconcile">
                                    <div class="col-md-3">
                                        <label asp-for="NewTask.TimeoutReconcileRetryStrategyType" class="z-form-label">Reconcile retry strategy</label>
                                        <select asp-for="NewTask.TimeoutReconcileRetryStrategyType" class="z-form-input z-form-select" asp-items="Model.RetryStrategyTypes" id="timeoutReconcileRetryStrategySelector"></select>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="NewTask.TimeoutReconcileRetries" class="z-form-label">Reconcile retries</label>
                                        <input asp-for="NewTask.TimeoutReconcileRetries" class="z-form-input" type="number" min="0" />
                                    </div>
                                    <div class="col-md-3 timeout-reconcile-strategy-block" data-timeout-reconcile-retry="Fixed">
                                        <label asp-for="NewTask.TimeoutReconcileDelaySeconds" class="z-form-label">Reconcile delay (sec)</label>
                                        <input asp-for="NewTask.TimeoutReconcileDelaySeconds" class="z-form-input" type="number" min="1" step="0.1" />
                                    </div>
                                    <div class="col-md-12">
                                        <label asp-for="NewTask.TimeoutReconcileRetryableErrorCodes" class="z-form-label">Reconcile retry errors</label>
                                        <input asp-for="NewTask.TimeoutReconcileRetryableErrorCodes" type="hidden" id="timeoutReconcileRetryableErrorCodesHidden" />
                                        <div class="od-chip-editor" data-chip-editor-for="timeoutReconcileRetryableErrorCodesHidden">
                                            <div class="od-chip-list"></div>
                                            <input type="text" class="od-chip-input" placeholder="Error code + Enter" />
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-check mt-2 ms-2">
                                        <input asp-for="NewTask.TimeoutReconcileStopOnNonRetryableError" class="form-check-input" />
                                        <label asp-for="NewTask.TimeoutReconcileStopOnNonRetryableError" class="form-check-label">Stop on non-retryable</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="z-tab-panel" id="task-compensation-pane" role="tabpanel" aria-labelledby="task-compensation-tab" tabindex="0" hidden>
                            <div class="form-check form-switch mb-2">
                                <input asp-for="NewTask.HasCompensation" class="form-check-input" id="hasCompensation" />
                                <label asp-for="NewTask.HasCompensation" class="form-check-label">Enable compensation for this completed task</label>
                            </div>
                            <div class="alert alert-secondary py-2 mb-3">
                                Compensation belongs to this forward task after it completes. It runs later only when a downstream failure starts compensation.
                            </div>
                            <div class="row g-2" id="compensationSection">
                                <div class="col-md-4">
                                    <label asp-for="NewTask.CompensationKind" class="z-form-label">Compensation task type</label>
                                    <select asp-for="NewTask.CompensationKind" class="z-form-input z-form-select" asp-items="Model.TaskKinds" id="compensationKindSelector"></select>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="NewTask.CompensationDispatchType" class="z-form-label">Dispatch type</label>
                                    <select asp-for="NewTask.CompensationDispatchType" class="z-form-input z-form-select" asp-items="Model.CompensationDispatchTypes" id="compensationDispatchTypeSelector"></select>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="NewTask.CompensationOnErrorPolicy" class="z-form-label">On error policy</label>
                                    <select asp-for="NewTask.CompensationOnErrorPolicy" class="z-form-input z-form-select" asp-items="Model.CompensationOnErrorPolicies"></select>
                                </div>
                                <div class="col-md-12">
                                    <h6 class="mb-2 mt-1">Compensation task configuration</h6>
                                </div>
                                <div class="col-12 comp-task-config-block mb-2" data-comp-kind="Http">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label asp-for="NewTask.CompensationHttpBaseUrlVariableRef" class="z-form-label">Base URL variable</label>
                                            <input asp-for="NewTask.CompensationHttpBaseUrlVariableRef" class="z-form-input" />
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="NewTask.CompensationHttpRelativePath" class="z-form-label">Relative path</label>
                                            <input asp-for="NewTask.CompensationHttpRelativePath" class="z-form-input" />
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="NewTask.CompensationHttpMethod" class="z-form-label">Method</label>
                                            <input asp-for="NewTask.CompensationHttpMethod" class="z-form-input" />
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="NewTask.CompensationHttpExpectedStatusCodes" class="z-form-label">Expected status codes</label>
                                            <input asp-for="NewTask.CompensationHttpExpectedStatusCodes" class="z-form-input" data-orchestrator-status-codes="true" />
                                        </div>
                                        <div class="col-md-12 form-check mt-3 ms-2">
                                            <input asp-for="NewTask.CompensationHttpAllowSyncResponse" class="form-check-input" />
                                            <label asp-for="NewTask.CompensationHttpAllowSyncResponse" class="form-check-label">Allow sync response</label>
                                        </div>
                                        <div class="col-12"><hr class="my-2" /></div>
                                        <div class="col-12">
                                            <h6 class="mb-2">Schema binding</h6>
                                        </div>
                                        <div class="col-md-8">
                                            <label asp-for="NewTask.CompensationHttpSchemaContractKey" class="z-form-label">Contract key</label>
                                            <input asp-for="NewTask.CompensationHttpSchemaContractKey"
                                                   class="z-form-input"
                                                   data-schema-contract-key="true"
                                                   data-schema-contract-kind="CommandRequest"
                                                   data-schema-version-target="NewTask_CompensationHttpSchemaContractVersion" />
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="NewTask.CompensationHttpSchemaContractVersion" class="z-form-label">Contract version</label>
                                            <input asp-for="NewTask.CompensationHttpSchemaContractVersion" class="z-form-input" data-orchestrator-version="true" />
                                        </div>
                                        <input asp-for="NewTask.CompensationHttpSchemaRegistryProviderId" type="hidden" />
                                    </div>
                                </div>
                                <div class="col-12 comp-task-config-block mb-2" data-comp-kind="Messaging">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label asp-for="NewTask.CompensationMessagingTopic" class="z-form-label">Topic</label>
                                            <input asp-for="NewTask.CompensationMessagingTopic" class="z-form-input" />
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="NewTask.CompensationMessagingVersion" class="z-form-label">Version</label>
                                            <input asp-for="NewTask.CompensationMessagingVersion" class="z-form-input" data-orchestrator-version="true" />
                                        </div>
                                        <div class="col-12"><hr class="my-2" /></div>
                                        <div class="col-12">
                                            <h6 class="mb-2">Schema binding</h6>
                                        </div>
                                        <div class="col-md-8">
                                            <label asp-for="NewTask.CompensationMessagingSchemaContractKey" class="z-form-label">Command key</label>
                                            <input asp-for="NewTask.CompensationMessagingSchemaContractKey"
                                                   class="z-form-input"
                                                   data-schema-contract-key="true"
                                                   data-schema-contract-kind="Command"
                                                   data-schema-version-target="NewTask_CompensationMessagingSchemaContractVersion" />
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="NewTask.CompensationMessagingSchemaContractVersion" class="z-form-label">Command version</label>
                                            <input asp-for="NewTask.CompensationMessagingSchemaContractVersion" class="z-form-input" data-orchestrator-version="true" />
                                        </div>
                                        <input asp-for="NewTask.CompensationMessagingSchemaRegistryProviderId" type="hidden" />
                                    </div>
                                </div>
                                <div class="col-12 comp-task-config-block mb-2" data-comp-kind="Plugin">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label asp-for="NewTask.CompensationPluginId" class="z-form-label">Plugin id</label>
                                            <input asp-for="NewTask.CompensationPluginId" class="z-form-input" data-orchestrator-ulid="true" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 comp-task-config-block alert alert-secondary mb-2" data-comp-kind="HumanApproval">
                                    Human approval has no additional typed fields for now.
                                </div>

                                <div class="col-12"><hr class="my-2" /></div>
                                <div class="col-md-12">
                                    <div class="form-check form-switch">
                                        <input asp-for="NewTask.HasCompensationExecutionCondition" class="form-check-input" id="hasCompensationExecutionCondition" />
                                        <label asp-for="NewTask.HasCompensationExecutionCondition" class="form-check-label">Enable execution condition</label>
                                    </div>
                                </div>
                                <div id="compensationExecutionConditionSection" class="row g-2">
                                    <input asp-for="NewTask.CompensationConditionEngine" type="hidden" />
                                    <input asp-for="NewTask.CompensationConditionDslExpression" type="hidden" />
                                    <div class="col-12">
                                        <button type="button" class="z-button z-button-secondary" id="openCompensationConditionDesignerButton">Open ButterMorph condition</button>
                                    </div>
                                </div>

                                <div class="col-12"><hr class="my-2" /></div>
                                <div class="col-md-12">
                                    <div class="form-check form-switch">
                                        <input asp-for="NewTask.HasCompensationTransformation" class="form-check-input" id="hasCompensationTransformation" />
                                        <label asp-for="NewTask.HasCompensationTransformation" class="form-check-label">Enable transformation</label>
                                    </div>
                                </div>
                                <div id="compensationTransformationSection" class="row g-2">
                                    <input asp-for="NewTask.CompensationTransformationEngine" type="hidden" />
                                    <input asp-for="NewTask.CompensationTransformationDsl" type="hidden" />
                                    <div class="col-12">
                                        <button type="button" class="z-button z-button-secondary" id="openCompensationTransformationDesignerButton">Open ButterMorph transformation</button>
                                    </div>
                                </div>

                                <div class="col-12"><hr class="my-2" /></div>
                                <div class="col-md-12">
                                    <div class="form-check form-switch">
                                        <input asp-for="NewTask.HasCompensationRetryPolicy" class="form-check-input" id="hasCompensationRetryPolicy" />
                                        <label asp-for="NewTask.HasCompensationRetryPolicy" class="form-check-label">Enable retry policy</label>
                                    </div>
                                </div>
                                <div id="compensationRetrySection" class="row g-2">
                                    <div class="col-md-3">
                                        <label asp-for="NewTask.CompensationRetryStrategyType" class="z-form-label">Retry strategy</label>
                                        <select asp-for="NewTask.CompensationRetryStrategyType" class="z-form-input z-form-select" asp-items="Model.RetryStrategyTypes" id="compensationRetryStrategySelector"></select>
                                    </div>
                                    <div class="col-md-3 compensation-retry-strategy-block" data-comp-retry="Fixed">
                                        <label asp-for="NewTask.CompensationRetryDelaySeconds" class="z-form-label">Retry delay (sec)</label>
                                        <input asp-for="NewTask.CompensationRetryDelaySeconds" class="z-form-input" type="number" min="0" step="0.1" />
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="NewTask.CompensationRetryMaxRetries" class="z-form-label">Retries</label>
                                        <input asp-for="NewTask.CompensationRetryMaxRetries" class="z-form-input" type="number" min="0" />
                                    </div>
                                    <div class="col-md-12">
                                        <label asp-for="NewTask.CompensationRetryableErrorCodes" class="z-form-label">Retry errors</label>
                                        <input asp-for="NewTask.CompensationRetryableErrorCodes" type="hidden" id="compensationRetryErrorCodesHidden" />
                                        <div class="od-chip-editor" data-chip-editor-for="compensationRetryErrorCodesHidden">
                                            <div class="od-chip-list"></div>
                                            <input type="text" class="od-chip-input" placeholder="Error code + Enter" />
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-check mt-2 ms-2">
                                        <input asp-for="NewTask.CompensationRetryStopOnNonRetryableError" class="form-check-input" />
                                        <label asp-for="NewTask.CompensationRetryStopOnNonRetryableError" class="form-check-label">Stop on non-retryable</label>
                                    </div>
                                </div>

                                <div class="col-12"><hr class="my-2" /></div>
                                <div class="col-md-12">
                                    <div class="form-check form-switch">
                                        <input asp-for="NewTask.HasCompensationTimeoutPolicy" class="form-check-input" id="hasCompensationTimeoutPolicy" />
                                        <label asp-for="NewTask.HasCompensationTimeoutPolicy" class="form-check-label">Enable timeout policy</label>
                                    </div>
                                </div>
                                <div id="compensationTimeoutSection" class="row g-2">
                                    <div class="col-md-3">
                                        <label asp-for="NewTask.CompensationTimeoutSeconds" class="z-form-label">Timeout (sec)</label>
                                        <input asp-for="NewTask.CompensationTimeoutSeconds" class="z-form-input" type="number" min="1" step="0.1" />
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="NewTask.CompensationTimeoutBehavior" class="z-form-label">Timeout behavior</label>
                                        <select asp-for="NewTask.CompensationTimeoutBehavior" class="z-form-input z-form-select" asp-items="Model.TimeoutBehaviors" id="compensationTimeoutBehaviorSelector"></select>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="NewTask.CompensationTimeoutAction" class="z-form-label">Action on timeout</label>
                                        <select asp-for="NewTask.CompensationTimeoutAction" class="z-form-input z-form-select" asp-items="Model.TimeoutActions"></select>
                                    </div>
                                    <div class="col-md-6 compensation-timeout-behavior-block" data-comp-timeout="Fail">
                                        <label asp-for="NewTask.CompensationTimeoutFailErrorCode" class="z-form-label">Fail error code</label>
                                        <input asp-for="NewTask.CompensationTimeoutFailErrorCode" class="z-form-input" />
                                    </div>
                                    <div class="col-md-6 compensation-timeout-behavior-block" data-comp-timeout="Wait">
                                        <label asp-for="NewTask.CompensationTimeoutWaitSeconds" class="z-form-label">Wait seconds</label>
                                        <input asp-for="NewTask.CompensationTimeoutWaitSeconds" class="z-form-input" type="number" min="1" step="0.1" />
                                    </div>
                                    <div class="col-md-3 compensation-timeout-behavior-block" data-comp-timeout="Reconcile">
                                        <label asp-for="NewTask.CompensationTimeoutReconcileRetryStrategyType" class="z-form-label">Reconcile retry strategy</label>
                                        <select asp-for="NewTask.CompensationTimeoutReconcileRetryStrategyType" class="z-form-input z-form-select" asp-items="Model.RetryStrategyTypes" id="compensationTimeoutReconcileRetryStrategySelector"></select>
                                    </div>
                                    <div class="col-md-3 compensation-timeout-behavior-block" data-comp-timeout="Reconcile">
                                        <label asp-for="NewTask.CompensationTimeoutReconcileRetries" class="z-form-label">Reconcile retries</label>
                                        <input asp-for="NewTask.CompensationTimeoutReconcileRetries" class="z-form-input" type="number" min="0" />
                                    </div>
                                    <div class="col-md-3 compensation-timeout-behavior-block compensation-timeout-reconcile-strategy-block" data-comp-timeout="Reconcile" data-comp-timeout-reconcile-retry="Fixed">
                                        <label asp-for="NewTask.CompensationTimeoutReconcileDelaySeconds" class="z-form-label">Reconcile delay (sec)</label>
                                        <input asp-for="NewTask.CompensationTimeoutReconcileDelaySeconds" class="z-form-input" type="number" min="1" step="0.1" />
                                    </div>
                                    <div class="col-md-12 compensation-timeout-behavior-block" data-comp-timeout="Reconcile">
                                        <label asp-for="NewTask.CompensationTimeoutReconcileRetryableErrorCodes" class="z-form-label">Reconcile retry errors</label>
                                        <input asp-for="NewTask.CompensationTimeoutReconcileRetryableErrorCodes" type="hidden" id="compensationTimeoutReconcileRetryableErrorCodesHidden" />
                                        <div class="od-chip-editor" data-chip-editor-for="compensationTimeoutReconcileRetryableErrorCodesHidden">
                                            <div class="od-chip-list"></div>
                                            <input type="text" class="od-chip-input" placeholder="Error code + Enter" />
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-check mt-2 ms-2 compensation-timeout-behavior-block" data-comp-timeout="Reconcile">
                                        <input asp-for="NewTask.CompensationTimeoutReconcileStopOnNonRetryableError" class="form-check-input" />
                                        <label asp-for="NewTask.CompensationTimeoutReconcileStopOnNonRetryableError" class="form-check-label">Stop on non-retryable</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
</form>
