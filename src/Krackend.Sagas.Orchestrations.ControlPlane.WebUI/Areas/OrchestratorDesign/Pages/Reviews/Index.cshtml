@page
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Design.Areas.OrchestratorDesign.Pages.Reviews.IndexModel
@{
    ViewData["Title"] = "Lifecycle reviews";

    string VersionLabel(Krackend.Sagas.Orchestrations.ControlPlane.Application.Design.OrchestrationVersionModel version)
        => version is null || string.IsNullOrWhiteSpace(version.Version) ? "Draft roadmap" : $"Version {version.Version}";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Lifecycle reviews</h1>
        <p class="od-page-subtitle">Review, approve, and apply orchestration lifecycle requests.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<section class="od-list-shell" aria-label="Lifecycle reviews">
    @if (!Model.Rows.Any())
    {
        <p class="od-empty mb-0">No lifecycle reviews have been requested.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Operation</th>
                        <th scope="col">Roadmap</th>
                        <th scope="col">Approval</th>
                        <th scope="col">Application</th>
                        <th scope="col">Requested</th>
                        <th scope="col"><span class="visually-hidden">Open</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td><strong>@row.Review.Operation</strong></td>
                            <td>
                                @if (row.Version is not null)
                                {
                                    <a asp-area="OrchestratorDesign"
                                       asp-page="/OrchestrationVersions/Details"
                                       asp-route-orchestrationId="@row.Version.OrchestrationDefinitionId"
                                       asp-route-versionId="@row.Version.Id">@VersionLabel(row.Version)</a>
                                    <div class="od-item-meta">@row.Version.Status</div>
                                }
                                else
                                {
                                    <span class="text-muted">Roadmap unavailable</span>
                                }
                            </td>
                            <td>@row.Review.ApprovalStatus</td>
                            <td>@row.Review.ApplicationStatus</td>
                            <td>
                                <div>@row.Review.RequestedOnUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                <div class="od-item-meta">@row.Review.RequestedBy</div>
                            </td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-area="OrchestratorDesign" asp-page="/Reviews/Details" asp-route-reviewId="@row.Review.Id">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Lifecycle review pages">
        <ul class="pagination mb-0">
            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : string.Empty)">
                <a class="page-link" asp-route-pageNumber="@(Model.PageNumber - 1)">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Model.PageNumber of @Model.TotalPages</span></li>
            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : string.Empty)">
                <a class="page-link" asp-route-pageNumber="@(Model.PageNumber + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
