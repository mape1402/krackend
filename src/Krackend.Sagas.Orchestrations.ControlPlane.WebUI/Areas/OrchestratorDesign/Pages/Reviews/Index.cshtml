@page
@using Zoorce.Web.UI.Abstractions.Data
@using Zoorce.Web.UI.DataGrid
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Design.Areas.OrchestratorDesign.Pages.Reviews.IndexModel
@{ ViewData["Title"] = "Lifecycle reviews"; }

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Lifecycle reviews</h1>
        <p class="od-page-subtitle">Review, approve, and apply orchestration lifecycle requests.</p>
    </div>
</div>

<section class="od-catalog" data-catalog="reviews" data-label="reviews" data-source="@Url.Page(null, "List")">
    <div class="od-catalog-controls" role="group" aria-label="View mode">
        <button type="button" class="btn btn-outline-secondary" data-catalog-view="grid" aria-label="Grid view" title="Grid view" aria-pressed="true"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
        <button type="button" class="btn btn-outline-secondary" data-catalog-view="cards" aria-label="Card view" title="Card view" aria-pressed="false"><i class="bi bi-grid-3x2-gap" aria-hidden="true"></i></button>
    </div>
    <div data-catalog-grid>
        @await Component.InvokeAsync("ZoorceDataGrid", new ZoorceDataGridOptions
        {
            Id = "reviews-grid", AriaLabel = "lifecycle reviews", Binding = new ZoorceDataBindingOptions { Source = Url.Page(null, "List") },
            LoadMode = ZoorceDataLoadMode.InfiniteScroll, PageSize = 25,
            Columns = [new("operation", "Operation"), new("orchestration", "Orchestration"), new("version", "Roadmap"),
                new("approval", "Approval"), new("application", "Application"), new("requested", "Requested"), new("actions", "Actions", false)]
        })
    </div>
    <div data-catalog-cards hidden>
        <div class="od-catalog-filters">
            <label class="z-search-field"><span aria-hidden="true">&#x2315;</span><input type="search" data-catalog-search aria-label="Search reviews" placeholder="Search reviews" autocomplete="off" /></label>
            <select class="form-select" data-catalog-sort aria-label="Sort reviews">
                <option value="requested:desc">Newest first</option><option value="requested">Oldest first</option>
                <option value="orchestration">Orchestration</option><option value="operation">Operation</option>
                <option value="approval">Approval</option><option value="application">Application</option>
            </select>
        </div>
        <div class="od-grid" data-catalog-card-items></div>
        <p class="od-empty" data-catalog-empty hidden>No matching reviews.</p>
        <p data-catalog-status aria-live="polite"></p>
        <div data-catalog-sentinel aria-hidden="true"></div>
        <button type="button" class="btn btn-outline-secondary" data-catalog-more hidden>Load more</button>
    </div>
</section>

@section Scripts {
    <script src="/_content/Krackend.Sagas.Orchestrations.ControlPlane.WebUI/js/orchestrator-catalog.js" asp-append-version="true"></script>
}
