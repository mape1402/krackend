<form method="post" id="catalogReviewAbortForm" data-review-post="Abort" data-orchestrator-validate="true">
    @Html.AntiForgeryToken()<input type="hidden" name="reviewId" /><input type="hidden" name="ReturnToCatalog" value="true" />
    <div class="z-form-field"><label class="z-form-label" for="catalogReviewAbortReason">Reason (optional)</label>
        <textarea id="catalogReviewAbortReason" name="AbortReason" class="z-form-input z-form-textarea" maxlength="2000" rows="4"></textarea></div>
</form>
