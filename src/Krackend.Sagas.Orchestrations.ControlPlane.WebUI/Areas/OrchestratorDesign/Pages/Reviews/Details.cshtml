@page
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Design.Areas.OrchestratorDesign.Pages.Reviews.DetailsModel
@using Krackend.Sagas.Orchestrations.ControlPlane.Design.Core
@{
    ViewData["Title"] = "Lifecycle review";
    var isDeployment = Model.Review?.Operation == OrchestrationVersionReviewOperation.Deploy;
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Lifecycle review</h1>
        <p class="od-page-subtitle">@Model.Review?.Operation for @(string.IsNullOrWhiteSpace(Model.Version?.Version) ? "Draft roadmap" : $"version {Model.Version.Version}")</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-area="OrchestratorDesign" asp-page="/Reviews/Index" class="btn btn-outline-secondary">Back to reviews</a>
        <a asp-area="OrchestratorDesign" asp-page="/OrchestrationVersions/Details" asp-route-orchestrationId="@Model.OrchestrationId" asp-route-versionId="@Model.Review?.OrchestrationVersionId" class="btn btn-outline-secondary">Open roadmap</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<section class="od-list-shell p-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Requested operation</dt><dd class="col-sm-9">@Model.Review?.Operation</dd>
        <dt class="col-sm-3">Version state</dt><dd class="col-sm-9">@Model.Version?.Status</dd>
        <dt class="col-sm-3">Approval</dt><dd class="col-sm-9">@Model.Review?.ApprovalStatus</dd>
        <dt class="col-sm-3">Application</dt><dd class="col-sm-9">@Model.Review?.ApplicationStatus</dd>
        <dt class="col-sm-3">Requested by</dt><dd class="col-sm-9">@Model.Review?.RequestedBy</dd>
        <dt class="col-sm-3">Requested on</dt><dd class="col-sm-9">@Model.Review?.RequestedOnUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
        @if (!string.IsNullOrWhiteSpace(Model.Review?.RejectionComment))
        {
            <dt class="col-sm-3">Rejection comment</dt><dd class="col-sm-9">@Model.Review.RejectionComment</dd>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Review?.AbortReason))
        {
            <dt class="col-sm-3">Abort reason</dt><dd class="col-sm-9">@Model.Review.AbortReason</dd>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Review?.DeployedArtifactId))
        {
            <dt class="col-sm-3">Deployed artifact</dt><dd class="col-sm-9"><code>@Model.Review.DeployedArtifactId</code></dd>
        }
    </dl>
</section>

@if (Model.CanApprove || Model.CanAbort || Model.CanApply)
{
    <section class="od-list-shell p-3 mt-3">
        <h2 class="od-panel-title">Review actions</h2>
        <div class="d-flex flex-wrap gap-2 mt-3">
            @if (Model.CanApprove)
            {
                <form method="post" asp-page-handler="Approve" class="od-inline-form" data-orchestrator-validate="false">
                    <input type="hidden" name="reviewId" value="@Model.ReviewId" />
                    <button type="submit" class="btn btn-primary">Approve</button>
                </form>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">Reject</button>
            }
            @if (Model.CanAbort)
            {
                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#abortModal">Abort</button>
            }
        </div>

        @if (Model.CanApply)
        {
            <form method="post" asp-page-handler="Apply" class="mt-4" data-orchestrator-validate="true" data-orchestrator-busy="true" data-busy-title="Applying review" data-busy-message="Design is creating the deployed artifact.">
                <input type="hidden" name="reviewId" value="@Model.ReviewId" />
                @if (isDeployment)
                {
                    <div class="row g-3">
                        <div class="col-md-4"><label asp-for="ApplyInput.Version" class="form-label">Version</label><input asp-for="ApplyInput.Version" class="form-control" placeholder="1.0.0" /></div>
                        <div class="col-md-8"><label asp-for="ApplyInput.VersionLabel" class="form-label">Label</label><input asp-for="ApplyInput.VersionLabel" class="form-control" /></div>
                        <div class="col-12"><label asp-for="ApplyInput.Description" class="form-label">Description</label><textarea asp-for="ApplyInput.Description" rows="2" class="form-control"></textarea></div>
                        <div class="col-12"><label asp-for="ApplyInput.Notes" class="form-label">Comment</label><textarea asp-for="ApplyInput.Notes" rows="2" class="form-control"></textarea></div>
                    </div>
                }
                <button type="submit" class="btn btn-primary mt-3">Apply approved review</button>
            </form>
        }
    </section>
}

<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" asp-page-handler="Reject"><div class="modal-header"><h2 class="modal-title fs-5">Reject review</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="reviewId" value="@Model.ReviewId" /><label asp-for="RejectionComment" class="form-label">Comment</label><textarea asp-for="RejectionComment" class="form-control" rows="3"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Reject</button></div></form></div></div></div>
<div class="modal fade" id="abortModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" asp-page-handler="Abort"><div class="modal-header"><h2 class="modal-title fs-5">Abort review</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="reviewId" value="@Model.ReviewId" /><label asp-for="AbortReason" class="form-label">Reason</label><textarea asp-for="AbortReason" class="form-control" rows="3"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-outline-danger">Abort</button></div></form></div></div></div>
