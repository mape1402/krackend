@page
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Design.Areas.OrchestratorDesign.Pages.Reviews.DetailsModel
@using Krackend.Sagas.Orchestrations.ControlPlane.Design.Core
@using Zoorce.Web.UI.Foundation.Components
@using Microsoft.AspNetCore.Html
@{
    var isDeployment = Model.Review?.Operation == OrchestrationVersionReviewOperation.Deploy;
    var reviewTarget = Model.Orchestration?.Name ?? "Orchestration";
    ViewData["Title"] = $"Review · {reviewTarget}";
    var approvalTone = Model.Review?.ApprovalStatus.ToString() switch { "Approved" => "success", "Rejected" => "danger", _ => "warning" };
    var applicationTone = Model.Review?.ApplicationStatus.ToString() switch { "Applied" => "success", "Aborted" => "danger", _ => "warning" };
    var applyLabel = Model.Review?.Operation switch
    {
        OrchestrationVersionReviewOperation.Deploy => "Deploy approved version",
        OrchestrationVersionReviewOperation.Deprecate => "Apply approved deprecation",
        OrchestrationVersionReviewOperation.Archive => "Apply approved archive",
        _ => "Apply approved review",
    };
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="z-message z-message-danger" role="alert">@Model.ErrorMessage</div>
}

<section class="od-review-detail" aria-label="Review details">
    <div class="od-review-summary">
        <div>
            <span class="od-review-eyebrow">@Model.Review?.Operation review</span>
            <h1>@(string.IsNullOrWhiteSpace(Model.Version?.Version) ? "Draft roadmap" : $"Version {Model.Version.Version}")</h1>
            <p>@Model.Orchestration?.Key</p>
        </div>
        <a asp-area="OrchestratorDesign" asp-page="/OrchestrationVersions/Details" asp-route-orchestrationId="@Model.OrchestrationId" asp-route-versionId="@Model.Review?.OrchestrationVersionId" class="z-button z-button-secondary">Open roadmap</a>
    </div>
    <div class="od-review-states">
        <div><span>Approval</span><strong class="z-status z-status-@approvalTone">@Model.Review?.ApprovalStatus</strong></div>
        <div><span>Application</span><strong class="z-status z-status-@applicationTone">@Model.Review?.ApplicationStatus</strong></div>
        <div><span>Version state</span><strong>@Model.Version?.Status</strong></div>
    </div>
    <dl class="od-review-metadata">
        <div><dt>Requested by</dt><dd>@Model.Review?.RequestedBy</dd></div>
        <div><dt>Requested on</dt><dd>@Model.Review?.RequestedOnUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd></div>
        @if (!string.IsNullOrWhiteSpace(Model.Review?.RejectionComment))
        {
            <div><dt>Rejection comment</dt><dd>@Model.Review.RejectionComment</dd></div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Review?.AbortReason))
        {
            <div><dt>Abort reason</dt><dd>@Model.Review.AbortReason</dd></div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Review?.DeployedArtifactId))
        {
            <div><dt>Deployed artifact</dt><dd><code>@Model.Review.DeployedArtifactId</code></dd></div>
        }
    </dl>
</section>

@if (Model.CanApprove || Model.CanAbort || Model.CanApply)
{
    <section class="od-review-actions">
        <h2 class="od-panel-title">Review actions</h2>
        <div class="d-flex flex-wrap gap-2 mt-3">
            @if (Model.CanApprove)
            {
                <form method="post" asp-page-handler="Approve" class="od-inline-form" data-orchestrator-validate="false">
                    <input type="hidden" name="reviewId" value="@Model.ReviewId" />
                    <button type="submit" class="z-button z-button-primary">Approve</button>
                </form>
                <button type="button" class="z-button z-button-danger" data-review-dialog="rejectModal">Reject</button>
            }
            @if (Model.CanAbort)
            {
                <button type="button" class="z-button z-button-secondary" data-review-dialog="abortModal">Abort</button>
            }
        </div>

        @if (Model.CanApply)
        {
            <p class="od-item-meta mt-3 mb-0">Approval is complete. The lifecycle change and its deployed artifact will be created only when this action is applied.</p>
            @if (isDeployment)
            {
                <button type="button" class="z-button z-button-primary mt-3" data-review-dialog="deployModal">@applyLabel</button>
            }
            else
            {
                <form method="post" asp-page-handler="Apply" class="mt-3" data-orchestrator-validate="false" data-orchestrator-busy="true" data-busy-title="Applying review" data-busy-message="Design is creating the deployed artifact.">
                    <input type="hidden" name="reviewId" value="@Model.ReviewId" />
                    <button type="submit" class="z-button z-button-primary">@applyLabel</button>
                </form>
            }
        }
    </section>
}

@if (Model.CanApprove)
{
    @await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions
    {
        Id = "rejectModal", Title = "Reject review", Eyebrow = null,
        Body = await Html.PartialAsync("_RejectReview", Model),
        Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Cancel</button><button type=\"submit\" form=\"rejectReviewForm\" class=\"z-button z-button-danger\">Reject</button>")
    })
}
@if (Model.CanAbort)
{
    @await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions
    {
        Id = "abortModal", Title = "Abort review", Eyebrow = null,
        Body = await Html.PartialAsync("_AbortReview", Model),
        Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Cancel</button><button type=\"submit\" form=\"abortReviewForm\" class=\"z-button z-button-danger\">Abort</button>")
    })
}
@if (Model.CanApply && isDeployment)
{
    @await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions
    {
        Id = "deployModal", Title = "Deploy approved version", Eyebrow = null, Size = "wide",
        Body = await Html.PartialAsync("_DeployReview", Model),
        Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Cancel</button><button type=\"submit\" form=\"deployReviewForm\" class=\"z-button z-button-primary\">Deploy version</button>")
    })
}

@section Scripts {
<script>
document.addEventListener('click', event => {
    const button = event.target.closest('[data-review-dialog]');
    if (button) document.getElementById(button.dataset.reviewDialog)?.open?.(button);
});
@if (Model.CanApply && isDeployment && HttpContext.Request.Method == "POST" &&
    string.Equals(HttpContext.Request.Query["handler"], "Apply", StringComparison.OrdinalIgnoreCase) &&
    (!ViewData.ModelState.IsValid || !string.IsNullOrWhiteSpace(Model.ErrorMessage)))
{
    <text>document.getElementById('deployModal')?.open?.();</text>
}
</script>
}
