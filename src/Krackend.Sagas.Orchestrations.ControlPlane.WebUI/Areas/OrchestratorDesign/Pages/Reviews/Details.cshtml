@page
@model Krackend.Sagas.Orchestrations.ControlPlane.WebUI.Design.Areas.OrchestratorDesign.Pages.Reviews.DetailsModel
@using Krackend.Sagas.Orchestrations.ControlPlane.Design.Core
@using Zoorce.Web.UI.Foundation.Components
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Lifecycle review";
    var isDeployment = Model.Review?.Operation == OrchestrationVersionReviewOperation.Deploy;
    var reviewTarget = Model.Orchestration?.Name ?? "Orchestration";
    var applyLabel = Model.Review?.Operation switch
    {
        OrchestrationVersionReviewOperation.Deploy => "Deploy approved version",
        OrchestrationVersionReviewOperation.Deprecate => "Apply approved deprecation",
        OrchestrationVersionReviewOperation.Archive => "Apply approved archive",
        _ => "Apply approved review",
    };
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">@reviewTarget</h1>
        <p class="od-page-subtitle">Lifecycle review: @Model.Review?.Operation for @(string.IsNullOrWhiteSpace(Model.Version?.Version) ? "Draft roadmap" : $"version {Model.Version.Version}")</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-area="OrchestratorDesign" asp-page="/Reviews/Index" class="btn btn-outline-secondary">Back to reviews</a>
        <a asp-area="OrchestratorDesign" asp-page="/OrchestrationVersions/Details" asp-route-orchestrationId="@Model.OrchestrationId" asp-route-versionId="@Model.Review?.OrchestrationVersionId" class="btn btn-outline-secondary">Open roadmap</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<section class="od-list-shell p-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Orchestration</dt>
        <dd class="col-sm-9">
            <a asp-area="OrchestratorDesign" asp-page="/Orchestrations/Details" asp-route-orchestrationId="@Model.OrchestrationId">@Model.Orchestration?.Name</a>
            <div class="od-item-meta">@Model.Orchestration?.Key</div>
        </dd>
        <dt class="col-sm-3">Requested operation</dt><dd class="col-sm-9">@Model.Review?.Operation</dd>
        <dt class="col-sm-3">Version state</dt><dd class="col-sm-9">@Model.Version?.Status</dd>
        <dt class="col-sm-3">Approval</dt><dd class="col-sm-9">@Model.Review?.ApprovalStatus</dd>
        <dt class="col-sm-3">Application</dt><dd class="col-sm-9">@Model.Review?.ApplicationStatus</dd>
        <dt class="col-sm-3">Requested by</dt><dd class="col-sm-9">@Model.Review?.RequestedBy</dd>
        <dt class="col-sm-3">Requested on</dt><dd class="col-sm-9">@Model.Review?.RequestedOnUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
        @if (!string.IsNullOrWhiteSpace(Model.Review?.RejectionComment))
        {
            <dt class="col-sm-3">Rejection comment</dt><dd class="col-sm-9">@Model.Review.RejectionComment</dd>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Review?.AbortReason))
        {
            <dt class="col-sm-3">Abort reason</dt><dd class="col-sm-9">@Model.Review.AbortReason</dd>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Review?.DeployedArtifactId))
        {
            <dt class="col-sm-3">Deployed artifact</dt><dd class="col-sm-9"><code>@Model.Review.DeployedArtifactId</code></dd>
        }
    </dl>
</section>

@if (Model.CanApprove || Model.CanAbort || Model.CanApply)
{
    <section class="od-list-shell p-3 mt-3">
        <h2 class="od-panel-title">Review actions</h2>
        <div class="d-flex flex-wrap gap-2 mt-3">
            @if (Model.CanApprove)
            {
                <form method="post" asp-page-handler="Approve" class="od-inline-form" data-orchestrator-validate="false">
                    <input type="hidden" name="reviewId" value="@Model.ReviewId" />
                    <button type="submit" class="btn btn-primary">Approve</button>
                </form>
                <button type="button" class="btn btn-outline-danger" data-review-dialog="rejectModal">Reject</button>
            }
            @if (Model.CanAbort)
            {
                <button type="button" class="btn btn-outline-secondary" data-review-dialog="abortModal">Abort</button>
            }
        </div>

        @if (Model.CanApply)
        {
            <p class="od-item-meta mt-3 mb-0">Approval is complete. The lifecycle change and its deployed artifact will be created only when this action is applied.</p>
            @if (isDeployment)
            {
                <button type="button" class="btn btn-primary mt-3" data-review-dialog="deployModal">@applyLabel</button>
            }
            else
            {
                <form method="post" asp-page-handler="Apply" class="mt-3" data-orchestrator-validate="false" data-orchestrator-busy="true" data-busy-title="Applying review" data-busy-message="Design is creating the deployed artifact.">
                    <input type="hidden" name="reviewId" value="@Model.ReviewId" />
                    <button type="submit" class="btn btn-primary">@applyLabel</button>
                </form>
            }
        }
    </section>
}

@if (Model.CanApprove)
{
    @await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions
    {
        Id = "rejectModal", Title = "Reject review", Eyebrow = null,
        Body = await Html.PartialAsync("_RejectReview", Model),
        Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Cancel</button><button type=\"submit\" form=\"rejectReviewForm\" class=\"btn btn-danger\">Reject</button>")
    })
}
@if (Model.CanAbort)
{
    @await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions
    {
        Id = "abortModal", Title = "Abort review", Eyebrow = null,
        Body = await Html.PartialAsync("_AbortReview", Model),
        Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Cancel</button><button type=\"submit\" form=\"abortReviewForm\" class=\"btn btn-outline-danger\">Abort</button>")
    })
}
@if (Model.CanApply && isDeployment)
{
    @await Component.InvokeAsync("ZoorceDialog", new ZoorceDialogOptions
    {
        Id = "deployModal", Title = "Deploy approved version", Eyebrow = null, Size = "wide",
        Body = await Html.PartialAsync("_DeployReview", Model),
        Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Cancel</button><button type=\"submit\" form=\"deployReviewForm\" class=\"z-button z-button-primary\">Deploy version</button>")
    })
}

@section Scripts {
<script>
document.addEventListener('click', event => {
    const button = event.target.closest('[data-review-dialog]');
    if (button) document.getElementById(button.dataset.reviewDialog)?.open?.(button);
});
@if (Model.CanApply && isDeployment && HttpContext.Request.Method == "POST" &&
    string.Equals(HttpContext.Request.Query["handler"], "Apply", StringComparison.OrdinalIgnoreCase) &&
    (!ViewData.ModelState.IsValid || !string.IsNullOrWhiteSpace(Model.ErrorMessage)))
{
    <text>document.getElementById('deployModal')?.open?.();</text>
}
</script>
}
