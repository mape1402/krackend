@page
@using System.Text.Json
@using Zoorce.Web.UI.Foundation.Components
@using Microsoft.AspNetCore.Html
@model Krackend.Sagas.Orchestrations.Runtime.WebUI.Areas.OrchestratorRuntime.Pages.Instances.IndexModel
@{
    ViewData["Title"] = "Instances";
    var counters = new[] { ("total", "Total instances", "layers", "primary", ""), ("running", "Running", "activity", "info", "running"), ("idle", "Idle", "pause-circle", "warning", "idle"),
        ("completed", "Completed", "check2-circle", "success", "completed"), ("deadLettered", "Dead lettered", "inbox", "warning", "deadlettered"), ("failed", "Failed", "exclamation-circle", "danger", "failed") };
}
@section Head {
    <link rel="stylesheet" href="/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/css/orchestrator-runtime.css" asp-append-version="true" />
    <link rel="stylesheet" href="/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/css/runtime-reference.css" asp-append-version="true" />
}
<section class="runtime-reference instances-reference" data-runtime-catalog data-source="@Url.Page(null, "List")" data-counts-source="@Url.Page(null, "Counts")" data-activity-source="@Url.Page("/Dashboard/Index", "Activity", new { area = "OrchestratorRuntime" })" data-stages-source="@Url.Page(null, "InspectorStages")" data-detail-template="@Url.Page("/Instances/Detail", new { area = "OrchestratorRuntime", instanceId = "__instance_id__" })">
    <div class="od-monitor-counters instance-metrics" aria-label="Instance totals" aria-live="polite">
        @foreach (var counter in counters) {
            <button type="button" class="fleet-card" style="--accent:var(--@counter.Item4)" data-status-group="@counter.Item5" aria-pressed="@(counter.Item5 == "" ? "true" : "false")"><span class="fleet-label"><i class="bi bi-@counter.Item3 fleet-icon"></i>@counter.Item2</span><span data-monitor-metric-skeleton="@counter.Item1"><span class="z-skeleton z-skeleton-line z-skeleton-animate"></span></span><span class="fleet-value-line" data-monitor-metric-data="@counter.Item1" hidden><strong data-monitor-count="@counter.Item1">0</strong><small class="fleet-share" data-monitor-share="@counter.Item1"></small></span><span data-metric-spark="@counter.Item1" title="Observed status transitions in the selected period"></span></button>
        }
    </div>
    <p class="metric-context instance-metric-context">Counts: current status of instances started in the selected period · Mini charts: recorded transitions for those instances.</p>
    <div class="instances-workspace" data-workspace>
        <section class="grid-surface" aria-label="Instances data grid">
            <div class="grid-commandbar">
                <label class="search-box"><i class="bi bi-search"></i><input data-instance-search type="search" placeholder="Search orchestration, correlation, saga…" aria-label="Search instances" /></label>
                <div class="status-tabs" role="group" aria-label="Status filter">
                    @foreach (var filter in new[] { ("", "All"), ("attention", "Attention"), ("running", "Running"), ("idle", "Idle"), ("completed", "Completed") }) {
                        <button type="button" data-status-group="@filter.Item1" aria-pressed="@(filter.Item1 == "" ? "true" : "false")">@filter.Item2</button>
                    }
                </div>
                <div class="commandbar-end">
                    <div class="time-range" role="group" aria-label="Instance time range">
                        @foreach (var hours in new[] { 1, 3, 6, 12, 24 }) { <button type="button" data-runtime-scope-value="@hours" aria-pressed="@(hours == 24 ? "true" : "false")">@(hours)h</button> }
                    </div>
                    <button class="icon-button subtle" type="button" data-runtime-refresh title="Refresh" aria-label="Refresh"><i class="bi bi-arrow-clockwise"></i></button>
                    <button class="icon-button subtle" type="button" data-density title="Toggle density" aria-label="Toggle density"><i class="bi bi-arrows-collapse"></i></button>
                    <button class="icon-button subtle" type="button" data-fit-columns title="Fit columns" aria-label="Fit columns"><i class="bi bi-layout-three-columns"></i></button>
                </div>
            </div>
            <div class="selection-bar" data-selection-bar hidden><span><strong data-selection-count>0</strong> selected</span><button type="button" data-inspect-selected><i class="bi bi-layout-sidebar-inset-reverse"></i> Inspect first</button><button type="button" data-copy-selected><i class="bi bi-copy"></i> Copy IDs</button><span data-selection-message role="status"></span><button type="button" class="danger-ghost" data-clear-selection><i class="bi bi-x-lg"></i> Clear</button></div>
            <div id="instancesGrid" aria-label="Runtime instances grid"></div>
            <div class="grid-footer"><div class="od-live-indicator" data-live-state="connecting"><span class="od-live-dot"></span><span data-live-label>Connecting</span></div><span data-runtime-loaded-copy aria-live="polite"></span></div>
        </section>
        @await Html.PartialAsync("_InstanceInspector")
    </div>
</section>
@section Scripts {
    <script>window.KrackendRuntimeMonitor = { hubPath: @Html.Raw(JsonSerializer.Serialize(Model.LiveHubPath)) };</script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@36.3.0/dist/ag-grid-community.min.js"></script>
    <script src="/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/js/orchestrator-runtime-sparklines.js" asp-append-version="true"></script>
    <script src="/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/js/orchestrator-runtime-inspector.js" asp-append-version="true"></script>
    <script src="/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/js/orchestrator-runtime-ag-grid.js" asp-append-version="true"></script>
    <script src="/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/js/orchestrator-runtime-monitor.js" asp-append-version="true"></script>
}
