@page
@using System.Text.Json
@model Krackend.Sagas.Orchestrations.Runtime.WebUI.Areas.OrchestratorRuntime.Pages.Instances.IndexModel
@{
    ViewData["Title"] = "Runtime Diagnostics";
    var dashboardConfig = new
    {
        environmentKey = Model.EnvironmentKey,
        hubPath = Model.LiveHubPath,
        detailPath = Url.Page("/Instances/Index", new { area = "OrchestratorRuntime", handler = "Detail" }),
        traffic = Model.Traffic,
        instances = Model.Instances
    };
}

@section Head {
    <link rel="stylesheet" href="~/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/css/orchestrator-runtime.css" asp-append-version="true" />
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Runtime Diagnostics</h1>
        <p class="od-page-subtitle">Environment: @Model.EnvironmentKey</p>
    </div>
    <div class="od-live-indicator" data-live-state="connecting">
        <span class="od-live-dot"></span>
        <span data-live-label>Connecting</span>
    </div>
</div>

<section class="od-runtime-hero" aria-label="Runtime traffic">
    <div class="od-chart-head">
        <div>
            <h2 class="od-section-title">Traffic</h2>
            <p class="od-item-meta">Reactive transitions per minute</p>
        </div>
        <div class="od-metric-strip">
            <span>Active <strong data-counter="active">0</strong></span>
            <span>Waiting <strong data-counter="waiting">0</strong></span>
            <span>Completed <strong data-counter="completed">0</strong></span>
            <span>Failed <strong data-counter="failed">0</strong></span>
        </div>
    </div>
    <canvas class="od-traffic-chart" data-traffic-chart height="170"></canvas>
</section>

<section class="od-panel od-instances-panel">
    <div class="od-section-head">
        <div>
            <h2 class="od-section-title">Instances</h2>
            <p class="od-item-meta">Click an instance to inspect stages, tasks, attempts, input, output, dispatch and timeline.</p>
        </div>
        <span class="od-item-meta"><span data-instance-count>@Model.Instances.Count</span> visible</span>
    </div>

    <div class="od-instance-table-wrap">
        <table class="od-instance-table">
            <thead>
                <tr>
                    <th>Instance</th>
                    <th>Status</th>
                    <th>Stage</th>
                    <th>Task</th>
                    <th>Started</th>
                    <th>Updated</th>
                </tr>
            </thead>
            <tbody data-instance-grid>
                @foreach (var instance in Model.Instances)
                {
                    <tr data-instance-id="@instance.Id" data-instance-status="@instance.Status" tabindex="0">
                        <td>
                            <strong>@instance.OrchestrationDefinitionKey</strong>
                            <small>@instance.CorrelationId</small>
                            <small>@instance.Id</small>
                        </td>
                        <td><span class="od-status @instance.StatusClass" data-instance-status-label>@instance.Status</span></td>
                        <td data-instance-stage>@(instance.CurrentStageKey ?? "-")</td>
                        <td data-instance-task>@(instance.CurrentTaskKey ?? "-")</td>
                        <td>@instance.StartedOnUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td data-instance-updated>@instance.LastUpdatedOnUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<div class="modal fade od-detail-modal" id="runtimeInstanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen-lg-down modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title" data-detail-title>Instance detail</h2>
                    <p class="od-item-meta" data-detail-subtitle></p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" data-detail-body>
                <p class="od-empty">Select an instance to inspect its trace.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.KrackendRuntimeDashboard = @Html.Raw(JsonSerializer.Serialize(dashboardConfig));
    </script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/js/orchestrator-runtime-instances.js" asp-append-version="true"></script>
}
