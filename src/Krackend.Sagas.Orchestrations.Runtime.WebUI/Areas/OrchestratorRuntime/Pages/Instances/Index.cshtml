@page
@using System.Text.Json
@using Zoorce.Web.UI.Abstractions.Data
@using Zoorce.Web.UI.DataGrid
@using Zoorce.Web.UI.Foundation.Components
@using Microsoft.AspNetCore.Html
@model Krackend.Sagas.Orchestrations.Runtime.WebUI.Areas.OrchestratorRuntime.Pages.Instances.IndexModel
@{
    ViewData["Title"] = "Instances";
    var counters = new[] {
        ("running", "Running", "activity"), ("waiting", "Waiting", "hourglass-split"),
        ("completed", "Completed", "check2-circle"), ("deadLettered", "Dead lettered", "inbox"), ("failed", "Failed", "exclamation-circle")
    };
}

@section Head {
    <link rel="stylesheet" href="/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/css/orchestrator-runtime.css" asp-append-version="true" />
}

<section class="od-panel od-instances-panel">
    <div data-runtime-catalog data-source="@Url.Page(null, "List")" data-counts-source="@Url.Page(null, "Counts")" data-detail-template="@Url.Page("/Instances/Detail", new { area = "OrchestratorRuntime", instanceId = "__instance_id__" })">
        <div class="od-monitor-counters" aria-label="Instance totals" aria-live="polite">
            @foreach (var counter in counters)
            {
                @await Component.InvokeAsync("ZoorceCard", new ZoorceCardOptions { Id = $"monitor-metric-{counter.Item1}", Title = counter.Item2,
                    Body = new HtmlString($"<div class=\"od-dashboard-metric-body\"><span class=\"od-metric-icon\" aria-hidden=\"true\"><i class=\"bi bi-{counter.Item3}\"></i></span><span class=\"od-dashboard-metric-skeleton\" data-monitor-metric-skeleton=\"{counter.Item1}\"><span class=\"z-skeleton z-skeleton-line z-skeleton-animate\"></span></span><div class=\"od-dashboard-metric-data\" data-monitor-metric-data=\"{counter.Item1}\" hidden><strong data-monitor-count=\"{counter.Item1}\">0</strong><small data-monitor-share=\"{counter.Item1}\"></small></div></div>") })
            }
        </div>
        <div class="od-runtime-view-controls" role="group" aria-label="Instance filters">
            <span class="od-grid-loaded-copy" data-runtime-loaded-copy aria-live="polite">Loading rows...</span>
            <button type="button" class="btn btn-outline-secondary" data-runtime-refresh aria-label="Refresh instances" title="Refresh instances"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button>
            <label class="od-monitor-scope">Time range <select class="z-form-input z-form-select" data-runtime-scope aria-label="Instance time range"><option value="1">Last hour</option><option value="6">Last 6 hours</option><option value="24" selected>Last 24 hours</option><option value="168">Last 7 days</option><option value="active">All active instances</option></select></label>
            <div class="od-live-indicator" data-live-state="connecting"><span class="od-live-dot"></span><span data-live-label>Connecting</span></div>
        </div>
        <div data-runtime-grid-view>
            @await Component.InvokeAsync("ZoorceDataGrid", new ZoorceDataGridOptions
            {
                Id = "runtime-instances-grid", AriaLabel = "runtime instances", Binding = new ZoorceDataBindingOptions { Source = Url.Page(null, "List", new { recentHours = 24 }) },
                LoadMode = ZoorceDataLoadMode.InfiniteScroll, PageSize = 25,
                Columns = [new("orchestrationLabel", "Orchestration"), new("correlationId", "Correlation ID"), new("sagaId", "Saga ID"),
                    new("status", "Status"), new("currentStageKey", "Stage", false), new("currentTaskKey", "Task", false),
                    new("startedOnUtc", "Started"), new("lastUpdatedOnUtc", "Updated"), new("actions", "Actions", false)]
            })
        </div>
    </div>
</section>

@section Scripts {
    <script>window.KrackendRuntimeMonitor = { hubPath: @Html.Raw(JsonSerializer.Serialize(Model.LiveHubPath)) };</script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/js/orchestrator-runtime-catalog.js" asp-append-version="true"></script>
    <script src="/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/js/orchestrator-runtime-monitor.js" asp-append-version="true"></script>
}
