@page
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Text.Json.Nodes
@using Zoorce.Web.UI.Timelines
@using Krackend.Sagas.Orchestrations.Runtime.Diagnostics
@model Krackend.Sagas.Orchestrations.Runtime.WebUI.Areas.OrchestratorRuntime.Pages.Instances.DetailModel
@{
    var detail = Model.Detail;
    var instance = detail.Instance;
    var id = instance.Id;
    var section = Model.Section;
    var active = section is "stage" or "task" or "attempt" ? "execution" : section;
    // The shell owns the route title. The orchestration identity is already
    // presented in the fixed saga overview, so duplicating it in the top bar
    // makes the detail page harder to scan.
    ViewData["Title"] = "Saga details";
    string Timestamp(DateTime? value) => value.HasValue ? $"{value.Value:yyyy-MM-dd HH:mm:ss} UTC" : "—";
    DateTime? ExecutionTimestamp(params DateTime?[] timestamps) => timestamps.FirstOrDefault(timestamp => timestamp.HasValue);
    DateTimeOffset TimelineTime(DateTime value) => new(DateTime.SpecifyKind(value, DateTimeKind.Utc));
    string MetadataValue(string metadata, string key)
    {
        if (string.IsNullOrWhiteSpace(metadata) || metadata == "—") return string.Empty;
        try
        {
            return FindMetadataValue(JsonNode.Parse(metadata), key);
        }
        catch
        {
            return string.Empty;
        }
    }
    string FindMetadataValue(JsonNode node, string key)
    {
        if (node is JsonObject obj && obj[key] is JsonValue value && value.TryGetValue<string>(out var text)) return text ?? string.Empty;
        return string.Empty;
    }
    ZoorceTimelineTone Tone(string status) => status?.ToLowerInvariant() switch {
        "completed" or "succeeded" => ZoorceTimelineTone.Success,
        "failed" or "timedout" or "deadlettered" => ZoorceTimelineTone.Danger,
        "running" or "waiting" or "waitingresponse" => ZoorceTimelineTone.Info,
        "skipped" or "disabled" => ZoorceTimelineTone.Warning,
        _ => ZoorceTimelineTone.Neutral
    };
    IHtmlContent CopyValue(string value, string label)
    {
        var container = new TagBuilder("span");
        container.AddCssClass("od-copy-reference");
        var text = new TagBuilder("code");
        text.AddCssClass("od-copy-reference-value");
        text.InnerHtml.Append(string.IsNullOrWhiteSpace(value) ? "—" : value);
        container.InnerHtml.AppendHtml(text);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var button = new TagBuilder("button");
            button.Attributes["type"] = "button";
            button.Attributes["data-copy-value"] = value;
            button.Attributes["aria-label"] = $"Copy {label}";
            button.Attributes["title"] = $"Copy {label}";
            button.AddCssClass("od-copy-button");
            button.InnerHtml.AppendHtml("<i class=\"bi bi-copy\" aria-hidden=\"true\"></i>");
            container.InnerHtml.AppendHtml(button);
        }
        return container;
    }
    ZoorceTimelineItem[] ActivityItems() => detail.Transitions.OrderBy(item => item.OccurredOnUtc).Select(item => new ZoorceTimelineItem(
        item.Id, new DateTimeOffset(DateTime.SpecifyKind(item.OccurredOnUtc, DateTimeKind.Utc)), item.TransitionType,
        $"{Timestamp(item.OccurredOnUtc)} · {item.Message}", Tone: Tone(item.ToStatus),
        Metadata: new Dictionary<string, string> { ["Status"] = $"{item.FromStatus} → {item.ToStatus}" })).ToArray();
    ZoorceTimelineItem[] CompensationItems() => detail.Compensations
        .Select(item => new { Item = item, Timestamp = ExecutionTimestamp(item.StartedOnUtc, item.CompletedOnUtc, item.FailedOnUtc) })
        .Where(entry => entry.Timestamp.HasValue)
        .OrderBy(entry => entry.Timestamp)
        .Select(entry => new ZoorceTimelineItem(
            entry.Item.Id, TimelineTime(entry.Timestamp!.Value), entry.Item.CompensationTaskKey,
            $"{entry.Item.Status} · source: {entry.Item.SourceTaskKey}", Tone: Tone(entry.Item.Status),
            Metadata: new Dictionary<string, string> { ["Source task"] = entry.Item.SourceTaskKey }))
        .ToArray();
}
@section Head {
    <link rel="stylesheet" href="/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/css/orchestrator-runtime.css" asp-append-version="true" />
}

<main class="od-instance-trace" data-instance-detail data-instance-id="@id" data-live-hub="@Model.LiveHubPath">
    <header class="od-instance-overview" aria-label="Saga overview">
        <div class="od-instance-overview-heading">
            <div>
                <p class="od-instance-overview-kicker">Orchestration execution</p>
                <h1>@instance.OrchestrationLabel</h1>
            </div>
            <span class="od-status @instance.StatusClass" data-instance-status>@instance.Status</span>
        </div>
        <div class="od-instance-overview-facts">
            <section class="od-instance-reference-group" aria-label="Saga references">
                <div class="od-instance-reference-list">
                    <div><span>Saga ID</span>@CopyValue(instance.SagaId, "saga ID")</div>
                    <div><span>Correlation ID</span>@CopyValue(instance.CorrelationId, "correlation ID")</div>
                    @if (!string.IsNullOrWhiteSpace(Model.TraceId)) { <div><span>Trace ID</span>@CopyValue(Model.TraceId, "trace ID")</div> }
                </div>
            </section>
            <section class="od-instance-lifecycle-group" aria-label="Saga lifecycle">
                <div><span>Started</span><strong>@Timestamp(instance.StartedOnUtc)</strong></div>
                <div><span>Last updated</span><strong data-instance-last-updated>@Timestamp(instance.LastUpdatedOnUtc)</strong></div>
                <div><span>Progress</span><strong data-instance-progress data-completed-tasks="@instance.CompletedTaskCount" data-total-tasks="@instance.TotalTaskCount">@instance.CompletedTaskCount/@instance.TotalTaskCount enabled tasks</strong></div>
            </section>
        </div>
        <p class="od-instance-live-update" data-instance-live-update hidden aria-live="polite">
            <span class="od-live-dot" aria-hidden="true"></span><span data-instance-live-update-text></span>
        </p>
        @if (Model.CanRecover)
        {
            <button type="button" class="z-button z-button-primary od-instance-replay" data-recover-dialog-open>
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i><span>Recover saga</span>
            </button>
        }
        @if (!string.IsNullOrWhiteSpace(Model.RecoveryMessage))
        {
            <p class="od-instance-operation-message od-instance-operation-@((TempData["RecoveryTone"]?.ToString()) ?? "neutral")">@Model.RecoveryMessage</p>
        }
    </header>

    <nav class="od-instance-nav" aria-label="Saga sections">
        <a asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="execution" aria-current="@(active == "execution" ? "page" : null)">Execution</a>
        <a asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="activity" aria-current="@(active == "activity" ? "page" : null)">Activity</a>
        <a asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="data" aria-current="@(active == "data" ? "page" : null)">Data</a>
        <a asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="compensations" aria-current="@(active == "compensations" ? "page" : null)">Compensations</a>
    </nav>

    <div class="od-trace-content">
    @if (section == "activity")
    {
        <section class="od-trace-section od-activity-workspace" aria-label="Saga activity">
            <div class="od-trace-heading"><div><h2>Activity</h2><p>Every persisted transition, ordered by its full UTC timestamp.</p></div><button type="button" class="z-button z-button-secondary" data-transition-drawer-toggle aria-expanded="false">Transition details</button></div>
            <div class="od-activity-timeline">
            @await Component.InvokeAsync("ZoorceTimeline", new ZoorceTimelineOptions { Id = "instance-activity-timeline", AriaLabel = "Saga activity", Variant = ZoorceTimelineVariant.Rail, Orientation = ZoorceTimelineOrientation.Vertical, OverflowMode = ZoorceTimelineOverflowMode.Stack, ShowOverflowControls = false, GroupBy = ZoorceTimelineGroupBy.None, Density = ZoorceTimelineDensity.Compact, ShowTimestamp = true, ShowRelativeTime = false, ShowMetadata = true, Interaction = ZoorceTimelineInteraction.Select, Items = ActivityItems(), EmptyMessage = "No activity has been recorded." })
            </div>
            <aside class="od-transition-drawer" data-transition-drawer hidden aria-label="Selected transition">
                <div class="od-transition-drawer-heading"><strong>Transition details</strong><button type="button" class="z-button z-button-ghost" data-transition-drawer-close aria-label="Close transition details"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
                <p data-transition-placeholder>Select an item from the timeline.</p>
                @foreach (var transition in detail.Transitions.OrderBy(x => x.OccurredOnUtc))
                {
                    <article data-transition-details="@transition.Id" hidden>
                        <dl class="od-trace-fields"><dt>Transition</dt><dd>@transition.TransitionType</dd><dt>At</dt><dd>@Timestamp(transition.OccurredOnUtc)</dd><dt>Status</dt><dd>@transition.FromStatus → @transition.ToStatus</dd><dt>Stage</dt><dd>@transition.StageKey</dd><dt>Task</dt><dd>@transition.TaskKey</dd><dt>Attempt ID</dt><dd>@CopyValue(transition.TaskExecutionAttemptId, "attempt ID")</dd><dt>Source</dt><dd>@transition.ProducedBy</dd><dt>Message</dt><dd>@transition.Message</dd></dl>
                        @if (!string.IsNullOrEmpty(transition.StageKey)) { <a class="z-button z-button-secondary" asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="@(string.IsNullOrEmpty(transition.TaskKey) ? "stage" : "task")" asp-route-stageKey="@transition.StageKey" asp-route-taskKey="@transition.TaskKey">Open execution</a> }
                        <div class="od-json-block"><div><span>Payload</span>@CopyValue(transition.Payload, "transition payload")</div><pre class="od-json-view" data-json-view>@transition.Payload</pre></div>
                    </article>
                }
            </aside>
        </section>
    }
    else if (section == "execution")
    {
        var recordedStages = detail.Stages
            .Select(stage => new { Stage = stage, Timestamp = ExecutionTimestamp(stage.StartedOnUtc, stage.CompletedOnUtc, stage.FailedOnUtc) })
            .Where(entry => entry.Timestamp.HasValue)
            .OrderBy(entry => entry.Timestamp)
            .ToArray();
        var stages = recordedStages.Select((entry, index) => new ZoorceTimelineItem($"stage-{index}", TimelineTime(entry.Timestamp!.Value), entry.Stage.ConfiguredName ?? entry.Stage.StageKey, entry.Stage.Status, Tone: Tone(entry.Stage.Status), TargetUrl: Url.Page("./Detail", new { instanceId = id, section = "stage", stageKey = entry.Stage.StageKey }))).ToArray();
        var skippedStages = detail.Stages.Where(stage => !ExecutionTimestamp(stage.StartedOnUtc, stage.CompletedOnUtc, stage.FailedOnUtc).HasValue && (stage.WasSkipped || string.Equals(stage.Status, "Skipped", StringComparison.OrdinalIgnoreCase) || string.Equals(stage.Status, "Disabled", StringComparison.OrdinalIgnoreCase))).OrderBy(stage => stage.Order).ToArray();
        <section class="od-trace-section od-trace-timeline"><div class="od-trace-heading"><div><h2>Stages</h2><p>Each stage is a durable step in this saga.</p></div><span class="od-trace-count">@detail.Stages.Count stages</span></div>
            @await Component.InvokeAsync("ZoorceTimeline", new ZoorceTimelineOptions { Id = "instance-stages-timeline", AriaLabel = "Stages", Variant = ZoorceTimelineVariant.Rail, Orientation = ZoorceTimelineOrientation.Vertical, OverflowMode = ZoorceTimelineOverflowMode.Stack, ShowOverflowControls = false, GroupBy = ZoorceTimelineGroupBy.None, Density = ZoorceTimelineDensity.Compact, ShowTimestamp = true, ShowRelativeTime = false, ShowMetadata = false, Interaction = ZoorceTimelineInteraction.Navigate, Items = stages, EmptyMessage = "No persisted stage execution has been recorded." })
            @if (skippedStages.Length > 0)
            {
                <div class="od-trace-unrecorded" aria-label="Stages skipped by design"><span>Skipped by design</span>@foreach (var skippedStage in skippedStages) { <a asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="stage" asp-route-stageKey="@skippedStage.StageKey"><strong>@(skippedStage.ConfiguredName ?? skippedStage.StageKey)</strong><span class="od-status @skippedStage.StatusClass">@skippedStage.Status</span><small>@(string.IsNullOrWhiteSpace(skippedStage.SkipReason) ? "No stage execution was scheduled." : skippedStage.SkipReason)</small></a> }</div>
            }
        </section>
    }
    else if (section == "stage")
    {
        var stage = Model.Stage;
        <nav class="od-trace-breadcrumb" aria-label="Execution path"><a class="od-trace-breadcrumb-root" asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="execution"><i class="bi bi-diagram-3" aria-hidden="true"></i><span>Stages</span></a><i class="bi bi-chevron-right od-trace-breadcrumb-separator" aria-hidden="true"></i><span class="od-trace-breadcrumb-current">@(stage.ConfiguredName ?? stage.StageKey)</span></nav>
        <section class="od-trace-section od-trace-context-panel"><div class="od-trace-heading"><div><h2>@(stage.ConfiguredName ?? stage.StageKey)</h2><p>Stage context and enabled work.</p></div><span class="od-status @stage.StatusClass">@stage.Status</span></div><div class="od-trace-summary"><div><span>Stage ID</span>@CopyValue(stage.Id, "stage ID")</div><div><span>Started</span><strong>@Timestamp(stage.StartedOnUtc)</strong></div><div><span>Completed</span><strong>@Timestamp(stage.CompletedOnUtc)</strong></div><div><span>Condition</span><strong>@stage.ExecutionConditionResult</strong></div></div>@if (!string.IsNullOrWhiteSpace(stage.ErrorSummary)) { <p class="od-trace-error">@stage.ErrorSummary</p> }@if (!string.IsNullOrWhiteSpace(stage.Metadata) && stage.Metadata != "—") { <div class="od-json-block"><div><span>Stage metadata</span>@CopyValue(stage.Metadata, "stage metadata")</div><pre class="od-json-view" data-json-view>@stage.Metadata</pre></div> }</section>
        var recordedTasks = stage.Tasks
            .Select(task => new { Task = task, Timestamp = ExecutionTimestamp(task.StartedOnUtc, task.WaitingSinceUtc, task.CompletedOnUtc, task.FailedOnUtc, task.TimedOutOnUtc) })
            .Where(entry => entry.Timestamp.HasValue)
            .OrderBy(entry => entry.Timestamp)
            .ToArray();
        var tasks = recordedTasks.Select((entry, index) => new ZoorceTimelineItem($"task-{index}", TimelineTime(entry.Timestamp!.Value), entry.Task.ConfiguredName ?? entry.Task.TaskKey, entry.Task.Status, Tone: Tone(entry.Task.Status), TargetUrl: Url.Page("./Detail", new { instanceId = id, section = "task", stageKey = stage.StageKey, taskKey = entry.Task.TaskKey }))).ToArray();
        var skippedTasks = stage.Tasks.Where(task => !ExecutionTimestamp(task.StartedOnUtc, task.WaitingSinceUtc, task.CompletedOnUtc, task.FailedOnUtc, task.TimedOutOnUtc).HasValue && (task.WasSkipped || string.Equals(task.Status, "Skipped", StringComparison.OrdinalIgnoreCase) || string.Equals(task.Status, "Disabled", StringComparison.OrdinalIgnoreCase))).OrderBy(task => task.Order).ToArray();
        <section class="od-trace-section od-trace-timeline"><div class="od-trace-heading"><div><h2>Tasks</h2><p>Tasks run within this stage. Disabled design tasks are explicitly marked as skipped.</p></div><span class="od-trace-count">@stage.Tasks.Count tasks</span></div>
            @await Component.InvokeAsync("ZoorceTimeline", new ZoorceTimelineOptions { Id = "stage-tasks-timeline", AriaLabel = "Tasks", Variant = ZoorceTimelineVariant.Activity, Orientation = ZoorceTimelineOrientation.Vertical, OverflowMode = ZoorceTimelineOverflowMode.Stack, ShowOverflowControls = false, GroupBy = ZoorceTimelineGroupBy.None, Density = ZoorceTimelineDensity.Compact, ShowTimestamp = true, ShowRelativeTime = false, ShowMetadata = false, Interaction = ZoorceTimelineInteraction.Navigate, Items = tasks, EmptyMessage = "No tasks have been recorded." })
            @if (skippedTasks.Length > 0)
            {
                <div class="od-trace-unrecorded" aria-label="Tasks skipped by design"><span>Skipped by design</span>@foreach (var skippedTask in skippedTasks) { <a asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="task" asp-route-stageKey="@stage.StageKey" asp-route-taskKey="@skippedTask.TaskKey"><strong>@(skippedTask.ConfiguredName ?? skippedTask.TaskKey)</strong><span class="od-status @RuntimeDiagnosticsReader.StatusClass(skippedTask.Status)">@skippedTask.Status</span><small>@(string.IsNullOrWhiteSpace(skippedTask.SkipReason) ? "No task execution was scheduled." : skippedTask.SkipReason)</small></a> }</div>
            }
        </section>
    }
    else if (section == "task")
    {
        var stage = Model.Stage; var task = Model.Task;
        <nav class="od-trace-breadcrumb" aria-label="Execution path"><a class="od-trace-breadcrumb-root" asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="execution"><i class="bi bi-diagram-3" aria-hidden="true"></i><span>Stages</span></a><i class="bi bi-chevron-right od-trace-breadcrumb-separator" aria-hidden="true"></i><a class="od-trace-breadcrumb-parent" asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="stage" asp-route-stageKey="@stage.StageKey">@(stage.ConfiguredName ?? stage.StageKey)</a><i class="bi bi-chevron-right od-trace-breadcrumb-separator" aria-hidden="true"></i><span class="od-trace-breadcrumb-current">@(task.ConfiguredName ?? task.TaskKey)</span></nav>
        <section class="od-trace-section od-trace-context-panel"><div class="od-trace-heading"><div><h2>@(task.ConfiguredName ?? task.TaskKey)</h2><p>@task.TaskKind · @task.ExecutionMode</p></div><span class="od-status @RuntimeDiagnosticsReader.StatusClass(task.Status)">@task.Status</span></div><div class="od-trace-summary"><div><span>Task ID</span>@CopyValue(task.Id, "task ID")</div><div><span>Started</span><strong>@Timestamp(task.StartedOnUtc)</strong></div><div><span>Completed</span><strong>@Timestamp(task.CompletedOnUtc)</strong></div><div><span>Attempts</span><strong>@task.Attempts.Count</strong></div></div>@if (!string.IsNullOrWhiteSpace(task.ErrorSummary)) { <p class="od-trace-error">@task.ErrorSummary</p> }</section>
        var attempts = task.Attempts
            .Select(attempt => new { Attempt = attempt, Timestamp = ExecutionTimestamp(attempt.StartedOnUtc, attempt.WaitingSinceUtc, attempt.CompletedOnUtc, attempt.FailedOnUtc, attempt.TimedOutOnUtc) })
            .Where(entry => entry.Timestamp.HasValue)
            .OrderBy(entry => entry.Attempt.AttemptNumber)
            .Select(entry => new ZoorceTimelineItem($"attempt-{entry.Attempt.AttemptNumber}", TimelineTime(entry.Timestamp!.Value), $"Attempt {entry.Attempt.AttemptNumber}", entry.Attempt.Status, Tone: Tone(entry.Attempt.Status), TargetUrl: Url.Page("./Detail", new { instanceId = id, section = "attempt", stageKey = stage.StageKey, taskKey = task.TaskKey, attempt = entry.Attempt.AttemptNumber })))
            .ToArray();
        <section class="od-trace-section od-trace-timeline od-attempt-timeline"><div class="od-trace-heading"><div><h2>Attempts</h2><p>Each retry is recorded chronologically.</p></div><span class="od-trace-count">@attempts.Length attempts</span></div>
            @await Component.InvokeAsync("ZoorceTimeline", new ZoorceTimelineOptions { Id = "task-attempts-timeline", AriaLabel = "Attempts", Variant = ZoorceTimelineVariant.Milestones, Orientation = ZoorceTimelineOrientation.Horizontal, OverflowMode = ZoorceTimelineOverflowMode.Scroll, ShowOverflowControls = true, GroupBy = ZoorceTimelineGroupBy.None, Density = ZoorceTimelineDensity.Compact, ShowTimestamp = true, ShowRelativeTime = false, ShowMetadata = false, Interaction = ZoorceTimelineInteraction.Navigate, Items = attempts, EmptyMessage = "No attempts have been recorded." })
        </section>
    }
    else if (section == "attempt")
    {
        var stage = Model.Stage; var task = Model.Task; var attempt = Model.Attempt;
        var exceptionDetails = MetadataValue(attempt.Metadata, "ExecutionExceptionDetails");
        <nav class="od-trace-breadcrumb" aria-label="Execution path"><a class="od-trace-breadcrumb-root" asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="execution"><i class="bi bi-diagram-3" aria-hidden="true"></i><span>Stages</span></a><i class="bi bi-chevron-right od-trace-breadcrumb-separator" aria-hidden="true"></i><a class="od-trace-breadcrumb-parent" asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="stage" asp-route-stageKey="@stage.StageKey">@(stage.ConfiguredName ?? stage.StageKey)</a><i class="bi bi-chevron-right od-trace-breadcrumb-separator" aria-hidden="true"></i><a class="od-trace-breadcrumb-parent" asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="task" asp-route-stageKey="@stage.StageKey" asp-route-taskKey="@task.TaskKey">@(task.ConfiguredName ?? task.TaskKey)</a><i class="bi bi-chevron-right od-trace-breadcrumb-separator" aria-hidden="true"></i><span class="od-trace-breadcrumb-current">Attempt @attempt.AttemptNumber</span></nav>
        <div class="od-trace-layout">
            <section class="od-trace-section"><div class="od-trace-heading"><div><h2>Attempt @attempt.AttemptNumber</h2><p>Task execution record</p></div><span class="od-status @RuntimeDiagnosticsReader.StatusClass(attempt.Status)">@attempt.Status</span></div><dl class="od-trace-fields"><dt>Attempt ID</dt><dd>@CopyValue(attempt.Id, "attempt ID")</dd><dt>Started</dt><dd>@Timestamp(attempt.StartedOnUtc)</dd><dt>Waiting since</dt><dd>@Timestamp(attempt.WaitingSinceUtc)</dd><dt>Completed</dt><dd>@Timestamp(attempt.CompletedOnUtc)</dd><dt>Failed</dt><dd>@Timestamp(attempt.FailedOnUtc)</dd><dt>Timed out</dt><dd>@Timestamp(attempt.TimedOutOnUtc)</dd><dt>Error code</dt><dd>@attempt.ErrorCode</dd><dt>Error</dt><dd class="od-trace-error">@attempt.ErrorMessage</dd></dl>@if (!string.IsNullOrWhiteSpace(exceptionDetails)) { <div class="od-json-block"><div><span>Exception diagnostics</span>@CopyValue(exceptionDetails, "exception diagnostics")</div><pre class="od-json-view" data-json-view>@exceptionDetails</pre></div> }<div class="od-json-block"><div><span>Request</span>@CopyValue(attempt.RequestPayload, "request payload")</div><pre class="od-json-view" data-json-view>@attempt.RequestPayload</pre></div><div class="od-json-block"><div><span>Response</span>@CopyValue(attempt.ResponsePayload, "response payload")</div><pre class="od-json-view" data-json-view>@attempt.ResponsePayload</pre></div><div class="od-json-block"><div><span>Attempt metadata</span>@CopyValue(attempt.Metadata, "attempt metadata")</div><pre class="od-json-view" data-json-view>@attempt.Metadata</pre></div></section>
            @if (attempt.Dispatch is { } dispatch) { <section class="od-trace-section"><div class="od-trace-heading"><div><h2>Dispatch</h2><p>@dispatch.DispatchType · @dispatch.DispatchStatus</p></div></div><dl class="od-trace-fields"><dt>Dispatch ID</dt><dd>@CopyValue(dispatch.Id, "dispatch ID")</dd><dt>Destination</dt><dd>@dispatch.Destination</dd><dt>Command ID</dt><dd>@CopyValue(dispatch.CommandId, "command ID")</dd><dt>Correlation ID</dt><dd>@CopyValue(dispatch.CorrelationId, "correlation ID")</dd><dt>Sent</dt><dd>@Timestamp(dispatch.SentOnUtc)</dd><dt>Acknowledged</dt><dd>@Timestamp(dispatch.AcknowledgedOnUtc)</dd><dt>Failed</dt><dd>@Timestamp(dispatch.FailedOnUtc)</dd><dt>Failure</dt><dd class="od-trace-error">@dispatch.FailureReason</dd></dl><div class="od-json-block"><div><span>Payload</span>@CopyValue(dispatch.RequestPayload, "dispatch payload")</div><pre class="od-json-view" data-json-view>@dispatch.RequestPayload</pre></div><div class="od-json-block"><div><span>Dispatch metadata</span>@CopyValue(dispatch.Metadata, "dispatch metadata")</div><pre class="od-json-view" data-json-view>@dispatch.Metadata</pre></div></section> }
        </div>
    }
    else if (section == "data")
    {
        <section class="od-data-workspace" aria-label="Initial saga data"><article class="od-trace-section"><div class="od-trace-heading"><div><h2>Payload</h2><p>Business data captured at ingress.</p></div>@CopyValue(detail.SnapshotPayload, "trigger payload")</div><pre class="od-json-view od-json-view-expanded" data-json-view>@detail.SnapshotPayload</pre></article><article class="od-trace-section"><div class="od-trace-heading"><div><h2>Metadata</h2><p>Context captured at orchestration ingress.</p></div>@CopyValue(detail.Metadata, "trigger metadata")</div><pre class="od-json-view od-json-view-expanded" data-json-view>@detail.Metadata</pre></article></section>
    }
    else if (section == "compensations")
    {
        var compensations = CompensationItems();
        <section class="od-trace-section od-compensation-workspace" aria-label="Compensation execution">
            <div class="od-trace-heading"><div><h2>Compensations</h2><p>Rollback work is recorded in the same execution order as the source tasks.</p></div><span class="od-trace-count">@compensations.Length records</span></div>
            <div class="od-compensation-timeline">
                @await Component.InvokeAsync("ZoorceTimeline", new ZoorceTimelineOptions { Id = "instance-compensations-timeline", AriaLabel = "Compensations", Variant = ZoorceTimelineVariant.Activity, Orientation = ZoorceTimelineOrientation.Vertical, OverflowMode = ZoorceTimelineOverflowMode.Stack, ShowOverflowControls = false, GroupBy = ZoorceTimelineGroupBy.None, Density = ZoorceTimelineDensity.Compact, ShowTimestamp = true, ShowRelativeTime = false, ShowMetadata = true, Interaction = ZoorceTimelineInteraction.Select, Items = compensations, EmptyMessage = "No compensations were required for this saga." })
            </div>
            <aside class="od-transition-drawer od-compensation-drawer" data-compensation-drawer hidden aria-label="Selected compensation">
                <div class="od-transition-drawer-heading"><strong>Compensation details</strong><button type="button" class="z-button z-button-ghost" data-compensation-drawer-close aria-label="Close compensation details"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
                <p data-compensation-placeholder>Select a compensation from the timeline.</p>
                @foreach (var compensation in detail.Compensations.OrderBy(item => item.StartedOnUtc ?? item.CompletedOnUtc ?? item.FailedOnUtc))
                {
                    <article data-compensation-details="@compensation.Id" hidden>
                        <div class="od-compensation-detail-summary"><strong>@compensation.CompensationTaskKey</strong><span class="od-status @RuntimeDiagnosticsReader.StatusClass(compensation.Status)">@compensation.Status</span></div>
                        <dl class="od-trace-fields"><dt>Compensation ID</dt><dd>@CopyValue(compensation.Id, "compensation ID")</dd><dt>Source task</dt><dd>@compensation.SourceTaskKey</dd><dt>Source task ID</dt><dd>@CopyValue(compensation.SourceTaskExecutionId, "source task ID")</dd><dt>Started</dt><dd>@Timestamp(compensation.StartedOnUtc)</dd><dt>Completed</dt><dd>@Timestamp(compensation.CompletedOnUtc)</dd><dt>Failed</dt><dd>@Timestamp(compensation.FailedOnUtc)</dd><dt>Error</dt><dd class="od-trace-error">@compensation.ErrorMessage</dd></dl>
                        <div class="od-json-block"><div><span>Request</span>@CopyValue(compensation.RequestPayload, "compensation request")</div><pre class="od-json-view" data-json-view>@compensation.RequestPayload</pre></div>
                        <div class="od-json-block"><div><span>Response</span>@CopyValue(compensation.ResponsePayload, "compensation response")</div><pre class="od-json-view" data-json-view>@compensation.ResponsePayload</pre></div>
                        <div class="od-json-block"><div><span>Metadata</span>@CopyValue(compensation.Metadata, "compensation metadata")</div><pre class="od-json-view" data-json-view>@compensation.Metadata</pre></div>
                    </article>
                }
            </aside>
        </section>
    }
    </div>
</main>

@if (Model.CanRecover)
{
    <form method="post" asp-page-handler="Recover" id="recover-saga-form" data-orchestrator-busy="true" data-busy-title="Recovering saga">
        <input type="hidden" name="instanceId" value="@id" />
    </form>
    @await Component.InvokeAsync("ZoorceDialog", new Zoorce.Web.UI.Foundation.Components.ZoorceDialogOptions
    {
        Id = "recoverSagaDialog",
        Title = "Recover saga",
        Eyebrow = "Terminal recovery",
        Size = "medium",
        Body = await Html.PartialAsync("_RecoverSaga", Model),
        Footer = new HtmlString("<button type=\"button\" class=\"z-button z-button-ghost\" data-z-dialog-close>Cancel</button><button type=\"submit\" form=\"recover-saga-form\" class=\"z-button z-button-primary\" id=\"recoverSagaButton\">Recover saga</button>")
    })
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="/_content/Zoorce.Web.UI.Timelines/js/zoorce-timeline.js" asp-append-version="true"></script>
    <script src="/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/js/orchestrator-runtime-detail.js" asp-append-version="true"></script>
}
