@page
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Mvc.Rendering
@using Zoorce.Web.UI.Timelines
@using Krackend.Sagas.Orchestrations.Runtime.Diagnostics
@model Krackend.Sagas.Orchestrations.Runtime.WebUI.Areas.OrchestratorRuntime.Pages.Instances.DetailModel
@{
    var detail = Model.Detail;
    var instance = detail.Instance;
    var id = instance.Id;
    var section = Model.Section;
    var active = section is "stage" or "task" or "attempt" ? "execution" : section;
    ViewData["Title"] = instance.OrchestrationLabel;
    string Timestamp(DateTime? value) => value.HasValue ? $"{value.Value:yyyy-MM-dd HH:mm:ss} UTC" : "—";
    DateTimeOffset TimelineTime(DateTime? value, int order) => new(DateTime.SpecifyKind(value ?? instance.LastUpdatedOnUtc.AddTicks(Math.Max(0, order) + 1), DateTimeKind.Utc));
    ZoorceTimelineTone Tone(string status) => status?.ToLowerInvariant() switch {
        "completed" or "succeeded" => ZoorceTimelineTone.Success,
        "failed" or "timedout" or "deadlettered" => ZoorceTimelineTone.Danger,
        "running" or "waiting" or "waitingresponse" => ZoorceTimelineTone.Info,
        "skipped" or "disabled" => ZoorceTimelineTone.Warning,
        _ => ZoorceTimelineTone.Neutral
    };
    IHtmlContent CopyValue(string value, string label)
    {
        var container = new TagBuilder("span");
        container.AddCssClass("od-copy-reference");
        var text = new TagBuilder("code");
        text.AddCssClass("od-copy-reference-value");
        text.InnerHtml.Append(string.IsNullOrWhiteSpace(value) ? "—" : value);
        container.InnerHtml.AppendHtml(text);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var button = new TagBuilder("button");
            button.Attributes["type"] = "button";
            button.Attributes["data-copy-value"] = value;
            button.Attributes["aria-label"] = $"Copy {label}";
            button.Attributes["title"] = $"Copy {label}";
            button.AddCssClass("od-copy-button");
            button.InnerHtml.AppendHtml("<i class=\"bi bi-copy\" aria-hidden=\"true\"></i>");
            container.InnerHtml.AppendHtml(button);
        }
        return container;
    }
    ZoorceTimelineItem[] ActivityItems() => detail.Transitions.OrderBy(item => item.OccurredOnUtc).Select(item => new ZoorceTimelineItem(
        item.Id, new DateTimeOffset(DateTime.SpecifyKind(item.OccurredOnUtc, DateTimeKind.Utc)), item.TransitionType,
        $"{Timestamp(item.OccurredOnUtc)} · {item.Message}", Tone: Tone(item.ToStatus),
        Metadata: new Dictionary<string, string> { ["Status"] = $"{item.FromStatus} → {item.ToStatus}" })).ToArray();
}
@section Head {
    <link rel="stylesheet" href="/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/css/orchestrator-runtime.css" asp-append-version="true" />
}

<main class="od-instance-trace" data-instance-detail data-instance-id="@id" data-live-hub="@Model.LiveHubPath">
    <header class="od-instance-overview" aria-label="Saga overview">
        <div class="od-instance-overview-heading">
            <div>
                <p class="od-instance-overview-kicker">Orchestration execution</p>
                <h1>@instance.OrchestrationLabel</h1>
            </div>
            <span class="od-status @instance.StatusClass">@instance.Status</span>
        </div>
        <div class="od-instance-overview-facts">
            <div><span>Saga ID</span>@CopyValue(instance.SagaId, "saga ID")</div>
            <div><span>Correlation ID</span>@CopyValue(instance.CorrelationId, "correlation ID")</div>
            @if (!string.IsNullOrWhiteSpace(Model.TraceId)) { <div><span>Trace ID</span>@CopyValue(Model.TraceId, "trace ID")</div> }
            <div><span>Started</span><strong>@Timestamp(instance.StartedOnUtc)</strong></div>
            <div><span>Last updated</span><strong>@Timestamp(instance.LastUpdatedOnUtc)</strong></div>
            <div><span>Progress</span><strong>@instance.CompletedTaskCount/@instance.TotalTaskCount enabled tasks</strong></div>
        </div>
        @if (Model.CanReplay)
        {
            <form method="post" asp-page-handler="Replay" class="od-instance-replay" data-orchestrator-busy="true" data-busy-title="Requesting replay">
                <input type="hidden" name="instanceId" value="@id" />
                @await Component.InvokeAsync("ZoorceProgressButton", new Zoorce.Web.UI.Foundation.Components.ZoorceProgressButtonOptions { Id = "replaySagaButton", Text = "Replay orchestration", Tone = "primary" })
            </form>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ReplayMessage))
        {
            <p class="od-instance-operation-message od-instance-operation-@((TempData["ReplayTone"]?.ToString()) ?? "neutral")">@Model.ReplayMessage</p>
        }
    </header>

    <nav class="od-instance-nav" aria-label="Saga sections">
        <a asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="execution" aria-current="@(active == "execution" ? "page" : null)">Execution</a>
        <a asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="activity" aria-current="@(active == "activity" ? "page" : null)">Activity</a>
        <a asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="data" aria-current="@(active == "data" ? "page" : null)">Data</a>
        <a asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="compensations" aria-current="@(active == "compensations" ? "page" : null)">Compensations</a>
    </nav>

    <div class="od-trace-content">
    @if (section == "activity")
    {
        <section class="od-trace-section od-activity-workspace" aria-label="Saga activity">
            <div class="od-trace-heading"><div><h2>Activity</h2><p>Every persisted transition, ordered by its full UTC timestamp.</p></div><button type="button" class="z-button z-button-secondary" data-transition-drawer-toggle aria-expanded="false">Transition details</button></div>
            <div class="od-activity-timeline">
                @await Component.InvokeAsync("ZoorceTimeline", new ZoorceTimelineOptions { Id = "instance-activity-timeline", AriaLabel = "Saga activity", Variant = ZoorceTimelineVariant.Rail, Orientation = ZoorceTimelineOrientation.Vertical, Density = ZoorceTimelineDensity.Compact, ShowTimestamp = true, ShowMetadata = true, Interaction = ZoorceTimelineInteraction.Select, Items = ActivityItems(), EmptyMessage = "No activity has been recorded." })
            </div>
            <aside class="od-transition-drawer" data-transition-drawer hidden aria-label="Selected transition">
                <div class="od-transition-drawer-heading"><strong>Transition details</strong><button type="button" class="z-button z-button-ghost" data-transition-drawer-close aria-label="Close transition details"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
                <p data-transition-placeholder>Select an item from the timeline.</p>
                @foreach (var transition in detail.Transitions.OrderBy(x => x.OccurredOnUtc))
                {
                    <article data-transition-details="@transition.Id" hidden>
                        <dl class="od-trace-fields"><dt>Transition</dt><dd>@transition.TransitionType</dd><dt>At</dt><dd>@Timestamp(transition.OccurredOnUtc)</dd><dt>Status</dt><dd>@transition.FromStatus → @transition.ToStatus</dd><dt>Stage</dt><dd>@transition.StageKey</dd><dt>Task</dt><dd>@transition.TaskKey</dd><dt>Attempt ID</dt><dd>@CopyValue(transition.TaskExecutionAttemptId, "attempt ID")</dd><dt>Source</dt><dd>@transition.ProducedBy</dd><dt>Message</dt><dd>@transition.Message</dd></dl>
                        @if (!string.IsNullOrEmpty(transition.StageKey)) { <a class="z-button z-button-secondary" asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="@(string.IsNullOrEmpty(transition.TaskKey) ? "stage" : "task")" asp-route-stageKey="@transition.StageKey" asp-route-taskKey="@transition.TaskKey">Open execution</a> }
                        <div class="od-json-block"><div><span>Payload</span>@CopyValue(transition.Payload, "transition payload")</div><pre class="od-json-view" data-json-view>@transition.Payload</pre></div>
                    </article>
                }
            </aside>
        </section>
    }
    else if (section == "execution")
    {
        var stages = detail.Stages.OrderBy(x => x.Order).Select((stage, index) => new ZoorceTimelineItem($"stage-{index}", TimelineTime(stage.StartedOnUtc, index), stage.ConfiguredName ?? stage.StageKey, $"{stage.Status} · {Timestamp(stage.StartedOnUtc)}", Tone: Tone(stage.Status), TargetUrl: Url.Page("./Detail", new { instanceId = id, section = "stage", stageKey = stage.StageKey }))).ToArray();
        <section class="od-trace-section od-trace-timeline"><div class="od-trace-heading"><div><h2>Stages</h2><p>Each stage is a durable step in this saga.</p></div><span class="od-trace-count">@stages.Length stages</span></div>
            @await Component.InvokeAsync("ZoorceTimeline", new ZoorceTimelineOptions { Id = "instance-stages-timeline", AriaLabel = "Stages", Variant = ZoorceTimelineVariant.Rail, Orientation = ZoorceTimelineOrientation.Vertical, Density = ZoorceTimelineDensity.Compact, ShowTimestamp = true, ShowMetadata = false, Interaction = ZoorceTimelineInteraction.Navigate, Items = stages, EmptyMessage = "No stages have been recorded." })
        </section>
    }
    else if (section == "stage")
    {
        var stage = Model.Stage;
        <nav class="od-trace-breadcrumb" aria-label="Execution path"><a asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="execution">Stages</a><i class="bi bi-chevron-right" aria-hidden="true"></i><span>@(stage.ConfiguredName ?? stage.StageKey)</span></nav>
        <section class="od-trace-section od-trace-context-panel"><div class="od-trace-heading"><div><h2>@(stage.ConfiguredName ?? stage.StageKey)</h2><p>Stage context and enabled work.</p></div><span class="od-status @stage.StatusClass">@stage.Status</span></div><div class="od-trace-summary"><div><span>Stage ID</span>@CopyValue(stage.Id, "stage ID")</div><div><span>Started</span><strong>@Timestamp(stage.StartedOnUtc)</strong></div><div><span>Completed</span><strong>@Timestamp(stage.CompletedOnUtc)</strong></div><div><span>Condition</span><strong>@stage.ExecutionConditionResult</strong></div></div>@if (!string.IsNullOrWhiteSpace(stage.ErrorSummary)) { <p class="od-trace-error">@stage.ErrorSummary</p> }<div class="od-json-block"><div><span>Stage metadata</span>@CopyValue(stage.Metadata, "stage metadata")</div><pre class="od-json-view" data-json-view>@stage.Metadata</pre></div></section>
        var tasks = stage.Tasks.OrderBy(x => x.Order).Select((task, index) => new ZoorceTimelineItem($"task-{index}", TimelineTime(task.StartedOnUtc, index), task.ConfiguredName ?? task.TaskKey, $"{task.Status} · {Timestamp(task.StartedOnUtc)}", Tone: Tone(task.Status), TargetUrl: Url.Page("./Detail", new { instanceId = id, section = "task", stageKey = stage.StageKey, taskKey = task.TaskKey }))).ToArray();
        <section class="od-trace-section od-trace-timeline"><div class="od-trace-heading"><div><h2>Tasks</h2><p>Tasks run within this stage. Disabled design tasks are explicitly marked as skipped.</p></div><span class="od-trace-count">@tasks.Length tasks</span></div>
            @await Component.InvokeAsync("ZoorceTimeline", new ZoorceTimelineOptions { Id = "stage-tasks-timeline", AriaLabel = "Tasks", Variant = ZoorceTimelineVariant.Activity, Orientation = ZoorceTimelineOrientation.Vertical, Density = ZoorceTimelineDensity.Compact, ShowTimestamp = true, ShowMetadata = false, Interaction = ZoorceTimelineInteraction.Navigate, Items = tasks, EmptyMessage = "No tasks have been recorded." })
        </section>
    }
    else if (section == "task")
    {
        var stage = Model.Stage; var task = Model.Task;
        <nav class="od-trace-breadcrumb" aria-label="Execution path"><a asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="execution">Stages</a><i class="bi bi-chevron-right" aria-hidden="true"></i><a asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="stage" asp-route-stageKey="@stage.StageKey">@(stage.ConfiguredName ?? stage.StageKey)</a><i class="bi bi-chevron-right" aria-hidden="true"></i><span>@(task.ConfiguredName ?? task.TaskKey)</span></nav>
        <section class="od-trace-section od-trace-context-panel"><div class="od-trace-heading"><div><h2>@(task.ConfiguredName ?? task.TaskKey)</h2><p>@task.TaskKind · @task.ExecutionMode</p></div><span class="od-status @RuntimeDiagnosticsReader.StatusClass(task.Status)">@task.Status</span></div><div class="od-trace-summary"><div><span>Task ID</span>@CopyValue(task.Id, "task ID")</div><div><span>Started</span><strong>@Timestamp(task.StartedOnUtc)</strong></div><div><span>Completed</span><strong>@Timestamp(task.CompletedOnUtc)</strong></div><div><span>Attempts</span><strong>@task.Attempts.Count</strong></div></div>@if (!string.IsNullOrWhiteSpace(task.ErrorSummary)) { <p class="od-trace-error">@task.ErrorSummary</p> }</section>
        var attempts = task.Attempts.OrderBy(x => x.AttemptNumber).Select(attempt => new ZoorceTimelineItem($"attempt-{attempt.AttemptNumber}", TimelineTime(attempt.StartedOnUtc, attempt.AttemptNumber), $"Attempt {attempt.AttemptNumber}", $"{attempt.Status} · {Timestamp(attempt.StartedOnUtc)}", Tone: Tone(attempt.Status), TargetUrl: Url.Page("./Detail", new { instanceId = id, section = "attempt", stageKey = stage.StageKey, taskKey = task.TaskKey, attempt = attempt.AttemptNumber }))).ToArray();
        <section class="od-trace-section od-trace-timeline od-attempt-timeline"><div class="od-trace-heading"><div><h2>Attempts</h2><p>Each retry is recorded chronologically.</p></div><span class="od-trace-count">@attempts.Length attempts</span></div>
            @await Component.InvokeAsync("ZoorceTimeline", new ZoorceTimelineOptions { Id = "task-attempts-timeline", AriaLabel = "Attempts", Variant = ZoorceTimelineVariant.Milestones, Orientation = ZoorceTimelineOrientation.Horizontal, Density = ZoorceTimelineDensity.Compact, ShowTimestamp = true, ShowMetadata = false, Interaction = ZoorceTimelineInteraction.Navigate, Items = attempts, EmptyMessage = "No attempts have been recorded." })
        </section>
    }
    else if (section == "attempt")
    {
        var stage = Model.Stage; var task = Model.Task; var attempt = Model.Attempt;
        <nav class="od-trace-breadcrumb" aria-label="Execution path"><a asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="execution">Stages</a><i class="bi bi-chevron-right" aria-hidden="true"></i><a asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="stage" asp-route-stageKey="@stage.StageKey">@(stage.ConfiguredName ?? stage.StageKey)</a><i class="bi bi-chevron-right" aria-hidden="true"></i><a asp-page="./Detail" asp-route-instanceId="@id" asp-route-section="task" asp-route-stageKey="@stage.StageKey" asp-route-taskKey="@task.TaskKey">@(task.ConfiguredName ?? task.TaskKey)</a><i class="bi bi-chevron-right" aria-hidden="true"></i><span>Attempt @attempt.AttemptNumber</span></nav>
        <div class="od-trace-layout">
            <section class="od-trace-section"><div class="od-trace-heading"><div><h2>Attempt @attempt.AttemptNumber</h2><p>Task execution record</p></div><span class="od-status @RuntimeDiagnosticsReader.StatusClass(attempt.Status)">@attempt.Status</span></div><dl class="od-trace-fields"><dt>Attempt ID</dt><dd>@CopyValue(attempt.Id, "attempt ID")</dd><dt>Started</dt><dd>@Timestamp(attempt.StartedOnUtc)</dd><dt>Waiting since</dt><dd>@Timestamp(attempt.WaitingSinceUtc)</dd><dt>Completed</dt><dd>@Timestamp(attempt.CompletedOnUtc)</dd><dt>Failed</dt><dd>@Timestamp(attempt.FailedOnUtc)</dd><dt>Timed out</dt><dd>@Timestamp(attempt.TimedOutOnUtc)</dd><dt>Error code</dt><dd>@attempt.ErrorCode</dd><dt>Error</dt><dd class="od-trace-error">@attempt.ErrorMessage</dd></dl><div class="od-json-block"><div><span>Request</span>@CopyValue(attempt.RequestPayload, "request payload")</div><pre class="od-json-view" data-json-view>@attempt.RequestPayload</pre></div><div class="od-json-block"><div><span>Response</span>@CopyValue(attempt.ResponsePayload, "response payload")</div><pre class="od-json-view" data-json-view>@attempt.ResponsePayload</pre></div><div class="od-json-block"><div><span>Attempt metadata</span>@CopyValue(attempt.Metadata, "attempt metadata")</div><pre class="od-json-view" data-json-view>@attempt.Metadata</pre></div></section>
            @if (attempt.Dispatch is { } dispatch) { <section class="od-trace-section"><div class="od-trace-heading"><div><h2>Dispatch</h2><p>@dispatch.DispatchType · @dispatch.DispatchStatus</p></div></div><dl class="od-trace-fields"><dt>Dispatch ID</dt><dd>@CopyValue(dispatch.Id, "dispatch ID")</dd><dt>Destination</dt><dd>@dispatch.Destination</dd><dt>Command ID</dt><dd>@CopyValue(dispatch.CommandId, "command ID")</dd><dt>Correlation ID</dt><dd>@CopyValue(dispatch.CorrelationId, "correlation ID")</dd><dt>Sent</dt><dd>@Timestamp(dispatch.SentOnUtc)</dd><dt>Acknowledged</dt><dd>@Timestamp(dispatch.AcknowledgedOnUtc)</dd><dt>Failed</dt><dd>@Timestamp(dispatch.FailedOnUtc)</dd><dt>Failure</dt><dd class="od-trace-error">@dispatch.FailureReason</dd></dl><div class="od-json-block"><div><span>Payload</span>@CopyValue(dispatch.RequestPayload, "dispatch payload")</div><pre class="od-json-view" data-json-view>@dispatch.RequestPayload</pre></div><div class="od-json-block"><div><span>Dispatch metadata</span>@CopyValue(dispatch.Metadata, "dispatch metadata")</div><pre class="od-json-view" data-json-view>@dispatch.Metadata</pre></div></section> }
        </div>
    }
    else if (section == "data")
    {
        <section class="od-data-workspace" aria-label="Initial saga data"><article class="od-trace-section"><div class="od-trace-heading"><div><h2>Trigger payload</h2><p>The business payload that started this saga.</p></div>@CopyValue(detail.SnapshotPayload, "trigger payload")</div><pre class="od-json-view od-json-view-expanded" data-json-view>@detail.SnapshotPayload</pre></article><article class="od-trace-section"><div class="od-trace-heading"><div><h2>Trigger metadata</h2><p>Metadata captured at orchestration ingress.</p></div>@CopyValue(detail.Metadata, "trigger metadata")</div><pre class="od-json-view od-json-view-expanded" data-json-view>@detail.Metadata</pre></article></section>
    }
    else if (section == "compensations")
    {
        <section class="od-trace-section"><div class="od-trace-heading"><div><h2>Compensations</h2><p>Compensation work follows the same durable execution model.</p></div><span class="od-trace-count">@detail.Compensations.Count records</span></div>
            @if (!detail.Compensations.Any()) { <p class="od-item-meta">No compensations recorded.</p> }
            <div class="od-compensation-list">@foreach (var compensation in detail.Compensations) { <article class="od-compensation-item"><div><strong>@compensation.CompensationTaskKey</strong><span class="od-status @RuntimeDiagnosticsReader.StatusClass(compensation.Status)">@compensation.Status</span></div><dl class="od-trace-fields"><dt>Source task</dt><dd>@compensation.SourceTaskKey</dd><dt>Started</dt><dd>@Timestamp(compensation.StartedOnUtc)</dd><dt>Completed</dt><dd>@Timestamp(compensation.CompletedOnUtc)</dd><dt>Failed</dt><dd>@Timestamp(compensation.FailedOnUtc)</dd><dt>Error</dt><dd class="od-trace-error">@compensation.ErrorMessage</dd></dl><div class="od-json-block"><div><span>Request</span>@CopyValue(compensation.RequestPayload, "compensation request")</div><pre class="od-json-view" data-json-view>@compensation.RequestPayload</pre></div><div class="od-json-block"><div><span>Response</span>@CopyValue(compensation.ResponsePayload, "compensation response")</div><pre class="od-json-view" data-json-view>@compensation.ResponsePayload</pre></div></article> }</div>
        </section>
    }
    </div>
</main>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="/_content/Zoorce.Web.UI.Timelines/js/zoorce-timeline.js" asp-append-version="true"></script>
    <script src="/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/js/orchestrator-runtime-detail.js" asp-append-version="true"></script>
}
