<aside class="instance-inspector" data-inspector aria-label="Instance inspector" aria-hidden="true" inert>
    <div class="inspector-head"><div><span class="eyebrow">Instance inspector</span><h2 data-inspector-title>Select an instance</h2></div><button class="icon-button subtle" type="button" data-close-inspector aria-label="Close inspector"><i class="bi bi-x-lg"></i></button></div>
    <div class="inspector-content" data-inspector-content hidden>
        <div class="inspector-status-row"><span data-inspector-status></span><span data-inspector-updated></span></div>
        <div class="inspector-progress"><div><strong>Execution progress</strong><span data-inspector-progress-label></span></div><div class="progress-track"><span data-inspector-progress></span></div></div>
        <dl class="metadata-grid" data-inspector-metadata></dl>
        <div class="inspector-section"><div class="section-title"><h3>Recorded stages</h3><span data-inspector-duration></span></div><div class="execution-timeline" data-inspector-stages aria-live="polite"></div><button type="button" class="z-button z-button-ghost" data-inspector-retry hidden>Retry</button><small data-inspector-more hidden>More stages are available in the full detail.</small></div>
        <div class="inspector-actions"><a class="z-button z-button-secondary" data-inspector-activity>Open history</a><a class="z-button z-button-primary" data-inspector-detail>Full detail</a></div>
    </div>
</aside>
