@page
@using System.Text.Json
@using Microsoft.AspNetCore.Html
@using Zoorce.Web.UI.Charts
@using Zoorce.Web.UI.Foundation.Components
@using Zoorce.Web.UI.Foundation.Skeleton
@model Krackend.Sagas.Orchestrations.Runtime.WebUI.Areas.OrchestratorRuntime.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var metrics = new[]
    {
        ("Total instances", "layers", "total"), ("In progress", "activity", "running"),
        ("Waiting", "hourglass-split", "waiting"), ("Completed", "check2-circle", "completed"),
        ("Dead lettered", "inbox", "deadLettered"), ("Failed", "exclamation-circle", "failed")
    };
    var emptySeries = new[] { new ZoorceChartSeries("Loading", new[] { new ZoorceChartPoint("", 0) }) };
}
@section Head {
    <link rel="stylesheet" href="/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/css/orchestrator-runtime.css" asp-append-version="true" />
}

<section class="od-dashboard" data-runtime-dashboard
         data-cohort-url="@Url.Page(null, "Cohort")"
         data-activity-url="@Url.Page(null, "Activity")"
         data-days="@Model.Days">
    <div class="od-dashboard-metrics" data-dashboard-metrics aria-live="polite">
        @foreach (var metric in metrics)
        {
            @await Component.InvokeAsync("ZoorceCard", new ZoorceCardOptions
            {
                Id = $"runtime-metric-{metric.Item3}",
                Title = metric.Item1,
                Body = new HtmlString($"<div class=\"od-dashboard-metric-body\"><span class=\"od-metric-icon\" aria-hidden=\"true\"><i class=\"bi bi-{metric.Item2}\"></i></span><span class=\"od-dashboard-metric-skeleton\" data-dashboard-metric-skeleton=\"{metric.Item3}\"><span class=\"z-skeleton z-skeleton-line z-skeleton-animate\"></span></span><div class=\"od-dashboard-metric-data\" data-dashboard-metric-data=\"{metric.Item3}\" hidden><strong data-dashboard-metric=\"{metric.Item3}\">0</strong><small data-dashboard-metric-share=\"{metric.Item3}\"></small></div></div>")
            })
        }
    </div>

    <div class="od-dashboard-charts">
        <section class="od-dashboard-activity" data-dashboard-panel="activity">
            <div class="od-dashboard-panel-toolbar">
                <div class="od-dashboard-period" data-dashboard-period role="group" aria-label="Statistics period">
                    @foreach (var period in new[] { (1, "24h"), (7, "7d"), (30, "30d"), (90, "90d") })
                    {
                        <button type="button" class="od-dashboard-period-option" data-dashboard-period-value="@period.Item1"
                                aria-pressed="@(period.Item1 == Model.Days ? "true" : "false")">@period.Item2</button>
                    }
                </div>
            </div>
            <div class="od-dashboard-chart-shell">
                @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions
                {
                    Id = "runtime-activity-chart", Title = "Observed activity", Summary = "Completed, dead-lettered and failed transitions.",
                    Kind = ZoorceChartKind.Area, Size = ZoorceChartSize.Wide, MinimumValue = 0, Series = emptySeries
                })
                <div class="od-dashboard-skeleton" data-dashboard-loading="activity">
                    @await Component.InvokeAsync("ZoorceSkeleton", new ZoorceSkeletonOptions { Shape = ZoorceSkeletonShape.Block, Height = "11rem", AriaLabel = "Loading activity" })
                </div>
            </div>
            <p class="od-dashboard-panel-error" data-dashboard-error="activity" hidden></p>
        </section>

        <section class="od-dashboard-chart-shell" data-dashboard-panel="status">
            @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions
            {
                Id = "runtime-status-chart", Title = "Current status", Summary = "Current status distribution for instances started in the selected period.",
                Kind = ZoorceChartKind.Donut, Series = emptySeries
            })
            <div class="od-dashboard-skeleton" data-dashboard-loading="status">
                    @await Component.InvokeAsync("ZoorceSkeleton", new ZoorceSkeletonOptions { Shape = ZoorceSkeletonShape.Block, Height = "10rem", AriaLabel = "Loading current status" })
            </div>
            <p class="od-dashboard-panel-error" data-dashboard-error="status" hidden></p>
        </section>

        <section class="od-dashboard-chart-shell" data-dashboard-panel="funnel">
            @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions
            {
                Id = "runtime-funnel-chart", Title = "Completion path", Summary = "Current completion outcome for instances started in the selected period.",
                Kind = ZoorceChartKind.Funnel, ShowLegend = false, Series = emptySeries
            })
            <div class="od-dashboard-outcome" data-dashboard-outcome hidden></div>
            <div class="od-dashboard-skeleton" data-dashboard-loading="funnel">
                    @await Component.InvokeAsync("ZoorceSkeleton", new ZoorceSkeletonOptions { Shape = ZoorceSkeletonShape.Block, Height = "10rem", AriaLabel = "Loading completion path" })
            </div>
            <p class="od-dashboard-panel-error" data-dashboard-error="funnel" hidden></p>
        </section>

    </div>
</section>

@section Scripts {
    <script>window.KrackendRuntimeDashboard = { hubPath: @Html.Raw(JsonSerializer.Serialize(Model.LiveHubPath)) };</script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/js/orchestrator-runtime-dashboard.js" asp-append-version="true"></script>
}
