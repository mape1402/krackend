<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Runtime") - Orchestrator Runtime</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f4f7fb; color: #182235; }
        .rt-shell { min-height: 100vh; display: grid; grid-template-columns: 240px minmax(0, 1fr); }
        .rt-sidebar { background: #172033; color: #e9eef8; padding: 1rem; }
        .rt-brand { font-weight: 700; font-size: 1.05rem; margin-bottom: 1.2rem; }
        .rt-nav a { color: #d9e2f2; display: block; text-decoration: none; padding: .55rem .65rem; border-radius: .45rem; }
        .rt-nav a:hover, .rt-nav a.active { background: #263752; color: #fff; }
        .rt-main { padding: 1.25rem; }
        .rt-page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
        .rt-title { margin: 0; font-size: 1.45rem; font-weight: 700; }
        .rt-subtitle { margin: .2rem 0 0; color: #63728a; }
        .rt-panel { background: #fff; border: 1px solid #d9e2f0; border-radius: .55rem; padding: .9rem; }
        .rt-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: .8rem; }
        .rt-card { background: #fff; border: 1px solid #d5deed; border-radius: .55rem; padding: .85rem; }
        .rt-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: .75rem; }
        .rt-card-title { margin: 0; font-size: .98rem; font-weight: 700; color: #1c2a42; }
        .rt-meta { color: #64748b; font-size: .78rem; overflow-wrap: anywhere; }
        .rt-chip-row { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .65rem; }
        .rt-chip { border: 1px solid #d3ddec; background: #f7faff; border-radius: 999px; padding: .18rem .5rem; font-size: .76rem; color: #344760; }
        .rt-status { border-radius: 999px; padding: .18rem .55rem; font-size: .72rem; font-weight: 700; white-space: nowrap; border: 1px solid transparent; }
        .rt-status-active { background: #e7f8ef; color: #1f7a4f; border-color: #a7dfc1; }
        .rt-status-inactive { background: #f0f3f8; color: #455a80; border-color: #d0d8e8; }
        .rt-empty { color: #64748b; margin: 0; }
        @@media (max-width: 800px) { .rt-shell { grid-template-columns: 1fr; } .rt-sidebar { min-height: auto; } .rt-page-head { flex-direction: column; } }
    </style>
</head>
<body>
    <div class="rt-shell">
        <aside class="rt-sidebar">
            <div class="rt-brand">Runtime</div>
            <nav class="rt-nav">
                <a asp-area="OrchestratorRuntime" asp-page="/Instances/Index">Instances</a>
                <a asp-area="OrchestratorRuntime" asp-page="/Artifacts/Index">Artifacts</a>
                <a asp-area="OrchestratorRuntime" asp-page="/DesignNodes/Index">Design Nodes</a>
            </nav>
        </aside>
        <main class="rt-main">
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
