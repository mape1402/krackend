@using Microsoft.Extensions.Options
@using Krackend.Sagas.Orchestrations.WebUI.Shell
@inject IOptions<OrchestratorWebUIThemeOptions> ThemeOptions
@inject IOrchestratorThemeCssRenderer ThemeCssRenderer
@inject IOrchestratorThemeModeAccessor ThemeModeAccessor
@{
    var theme = ThemeOptions.Value;
    var cssMode = ThemeModeAccessor.GetCssMode(theme);
    var nextCssMode = string.Equals(cssMode, "dark", StringComparison.OrdinalIgnoreCase) ? "light" : "dark";
    var themeModeText = string.Equals(cssMode, "dark", StringComparison.OrdinalIgnoreCase) ? "Light" : "Dark";
    var themeToggleLabel = string.Equals(cssMode, "dark", StringComparison.OrdinalIgnoreCase) ? "Switch to light mode" : "Switch to dark mode";
    var themeToggleIcon = string.Equals(cssMode, "dark", StringComparison.OrdinalIgnoreCase) ? "bi-sun" : "bi-moon";
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="@cssMode" data-krackend-theme="@cssMode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Runtime") - Orchestrator Runtime</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>@Html.Raw(ThemeCssRenderer.RenderThemeRules(theme))</style>
    <style>
        body { background: var(--krackend-content-bg, #f4f7fb); color: var(--krackend-text, #182235); color-scheme: var(--krackend-color-scheme, light); }
        .rt-shell { min-height: 100vh; display: grid; grid-template-columns: 240px minmax(0, 1fr); }
        .rt-sidebar { background: var(--krackend-sidebar-bg, #172033); color: var(--krackend-sidebar-text, #e9eef8); padding: 1rem; }
        .rt-brand-row { display: flex; align-items: center; justify-content: space-between; gap: .8rem; margin-bottom: 1.2rem; }
        .rt-brand { font-weight: 700; font-size: 1.05rem; }
        .rt-theme-control { display: inline-flex; align-items: center; gap: .45rem; }
        .rt-theme-form { margin: 0; }
        .rt-theme-toggle { display: inline-flex; align-items: center; justify-content: center; gap: .35rem; min-width: 76px; height: 32px; padding: 0 .65rem; border: 1px solid color-mix(in srgb, var(--krackend-sidebar-text, #e9eef8) 18%, transparent); border-radius: .45rem; background: color-mix(in srgb, var(--krackend-sidebar-text, #e9eef8) 8%, transparent); color: var(--krackend-sidebar-text, #e9eef8); font-size: .75rem; font-weight: 700; line-height: 1; cursor: pointer; }
        .rt-theme-toggle i { font-size: 1rem; line-height: 1; }
        .rt-theme-toggle:hover, .rt-theme-toggle:focus-visible { background: var(--krackend-primary, #4856d7); border-color: var(--krackend-primary, #4856d7); color: #fff; }
        .rt-nav a { color: var(--krackend-sidebar-text, #d9e2f2); display: block; text-decoration: none; padding: .55rem .65rem; border-radius: .45rem; }
        .rt-nav a:hover, .rt-nav a.active { background: color-mix(in srgb, var(--krackend-sidebar-text, #e9eef8) 14%, transparent); color: #fff; }
        .rt-main { padding: 1.25rem; }
        .rt-page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
        .rt-title { margin: 0; font-size: 1.45rem; font-weight: 700; }
        .rt-subtitle { margin: .2rem 0 0; color: var(--krackend-muted-text, #63728a); }
        .rt-panel { background: var(--krackend-surface, #fff); border: 1px solid var(--krackend-border, #d9e2f0); border-radius: .55rem; padding: .9rem; }
        .rt-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: .8rem; }
        .rt-card { background: var(--krackend-surface, #fff); border: 1px solid var(--krackend-border, #d5deed); border-radius: .55rem; padding: .85rem; }
        .rt-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: .75rem; }
        .rt-card-title { margin: 0; font-size: .98rem; font-weight: 700; color: var(--krackend-text, #1c2a42); }
        .rt-meta { color: var(--krackend-muted-text, #64748b); font-size: .78rem; overflow-wrap: anywhere; }
        .rt-chip-row { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .65rem; }
        .rt-chip { border: 1px solid var(--krackend-border, #d3ddec); background: var(--krackend-subtle-bg, #f7faff); border-radius: 999px; padding: .18rem .5rem; font-size: .76rem; color: var(--krackend-text, #344760); }
        .rt-status { border-radius: 999px; padding: .18rem .55rem; font-size: .72rem; font-weight: 700; white-space: nowrap; border: 1px solid transparent; }
        .rt-status-active { background: #e7f8ef; color: #1f7a4f; border-color: #a7dfc1; }
        .rt-status-inactive { background: #f0f3f8; color: #455a80; border-color: #d0d8e8; }
        .rt-empty { color: var(--krackend-muted-text, #64748b); margin: 0; }
        @@media (max-width: 800px) { .rt-shell { grid-template-columns: 1fr; } .rt-sidebar { min-height: auto; } .rt-page-head { flex-direction: column; } }
    </style>
</head>
<body>
    <div class="rt-shell">
        <aside class="rt-sidebar">
            <div class="rt-brand-row">
                <div class="rt-brand">Runtime</div>
                <div class="rt-theme-control">
                    <form class="rt-theme-form" method="post" asp-area="OrchestratorShell" asp-page="/Theme">
                        <input type="hidden" name="mode" value="@nextCssMode" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button class="rt-theme-toggle" type="submit" title="@themeToggleLabel" aria-label="@themeToggleLabel">
                            <i class="bi @themeToggleIcon"></i>
                            <span>@themeModeText</span>
                        </button>
                    </form>
                </div>
            </div>
            <nav class="rt-nav">
                <a asp-area="OrchestratorRuntime" asp-page="/Instances/Index">Instances</a>
                <a asp-area="OrchestratorRuntime" asp-page="/Artifacts/Index">Artifacts</a>
                <a asp-area="OrchestratorRuntime" asp-page="/DesignNodes/Index">Design Nodes</a>
            </nav>
        </aside>
        <main class="rt-main">
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/_content/Krackend.Sagas.Orchestrations.WebUI.Shell/js/orchestrator-shell.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
