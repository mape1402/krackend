@page
@using Zoorce.Web.UI.Abstractions.Data
@using Zoorce.Web.UI.DataGrid
@model Krackend.Sagas.Orchestrations.Runtime.WebUI.Areas.OrchestratorRuntime.Pages.Artifacts.IndexModel
@{
    ViewData["Title"] = "Runtime Artifacts";
    var hasSelection = !string.IsNullOrWhiteSpace(Model.OrchestrationKey);
    var source = hasSelection ? Url.Page(null, "Versions", new { orchestrationKey = Model.OrchestrationKey }) : Url.Page(null, "Groups");
}

@section Head {
    <link rel="stylesheet" href="~/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/css/orchestrator-runtime.css" asp-append-version="true" />
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">@(hasSelection ? Model.OrchestrationKey : "Runtime Artifacts")</h1>
        <p class="od-page-subtitle">@(hasSelection ? "Deployed versions and release history" : "Orchestration versions on this runtime node")</p>
    </div>
    @if (hasSelection) { <a class="btn btn-outline-secondary" asp-page="/Artifacts/Index" asp-area="OrchestratorRuntime">All orchestrations</a> }
</div>

<section class="od-panel" data-artifact-catalog data-source="@source" data-kind="@(hasSelection ? "versions" : "groups")"
         data-history-source="@Url.Page(null, "History")" data-index-url="@Url.Page(null, new { area = "OrchestratorRuntime" })">
    <div class="od-runtime-view-controls" role="group" aria-label="View mode">
        <button type="button" class="btn btn-outline-secondary" data-artifact-view="grid" aria-label="Grid view" title="Grid view" aria-pressed="true"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
        <button type="button" class="btn btn-outline-secondary" data-artifact-view="cards" aria-label="Card view" title="Card view" aria-pressed="false"><i class="bi bi-grid-3x2-gap" aria-hidden="true"></i></button>
    </div>
    <div data-artifact-grid>
        @if (!hasSelection)
        {
            @await Component.InvokeAsync("ZoorceDataGrid", new ZoorceDataGridOptions {
                Id = "runtime-artifact-groups-grid", AriaLabel = "runtime orchestrations", Binding = new ZoorceDataBindingOptions { Source = source },
                LoadMode = ZoorceDataLoadMode.InfiniteScroll, PageSize = 25,
                Columns = [new("displayName", "Orchestration", false), new("versionCount", "Versions", false), new("activeCount", "Active", false), new("latest", "Latest deployment", false), new("actions", "Actions", false)]
            })
        }
        else
        {
            @await Component.InvokeAsync("ZoorceDataGrid", new ZoorceDataGridOptions {
                Id = "runtime-artifact-versions-grid", AriaLabel = "runtime artifact versions", Binding = new ZoorceDataBindingOptions { Source = source },
                LoadMode = ZoorceDataLoadMode.InfiniteScroll, PageSize = 25,
                Columns = [new("version", "Version", false), new("lifecycleStatus", "Lifecycle", false), new("status", "Runtime state", false), new("deployed", "Deployed", false), new("lastReleaseId", "Release", false), new("actions", "Actions", false)]
            })
        }
    </div>
    <div data-artifact-cards-view hidden>
        <label class="z-search-field"><span aria-hidden="true">&#x2315;</span><input type="search" data-artifact-search aria-label="Search artifacts" placeholder="@(hasSelection ? "Search version or release ID" : "Search orchestrations")" /></label>
        <div class="od-runtime-cards" data-artifact-cards></div>
        <p data-artifact-empty hidden>No matching artifacts.</p>
        <p data-artifact-status aria-live="polite"></p>
        <div data-artifact-sentinel aria-hidden="true"></div>
        <button type="button" class="btn btn-outline-secondary" data-artifact-more hidden>Load more</button>
    </div>
</section>

<form method="post" asp-page-handler="RequestStandup" id="artifact-standup-form" data-orchestrator-busy="true" data-busy-title="Requesting standup">
    <input type="hidden" name="artifactId" />
</form>

<div class="modal fade" id="artifactHistoryModal" tabindex="-1" aria-labelledby="artifactHistoryTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="artifactHistoryTitle">Artifact history</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body">
            <div id="artifactHistoryDetails"></div>
            <h3 class="fs-6 mt-3">Release history</h3>
            <div id="artifactHistoryItems" class="od-artifact-timeline"></div>
            <p id="artifactHistoryStatus" aria-live="polite"></p>
            <button type="button" class="btn btn-outline-secondary" id="artifactHistoryMore" hidden>Load more history</button>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button></div>
    </div></div>
</div>

@section Scripts {
    <script src="~/_content/Krackend.Sagas.Orchestrations.Runtime.WebUI/js/orchestrator-runtime-artifacts.js" asp-append-version="true"></script>
}
