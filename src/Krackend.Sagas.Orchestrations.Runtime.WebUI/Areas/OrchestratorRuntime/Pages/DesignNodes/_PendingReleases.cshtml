@model Krackend.Sagas.Orchestrations.Runtime.WebUI.Areas.OrchestratorRuntime.Pages.DesignNodes.IndexModel
<div id="pendingReleasesCatalog" data-source="@Url.Page(null, "PendingPage")" data-initial-source="@Model.SourceKey">
    <p class="od-item-meta mb-2" data-pending-source-label></p>
    <p class="od-empty" data-pending-status role="status"></p>
    <div class="od-pending-release-grid" data-pending-items></div>
    <div class="text-center mt-3"><button type="button" class="z-button z-button-ghost" data-pending-more hidden>Load more releases</button></div>
    <div data-pending-sentinel aria-hidden="true"></div>
</div>
<form method="post" asp-page-handler="ApplyRelease" id="pendingReleaseApplyForm" data-confirm="true" data-confirm-title="Apply release" data-confirm-message="Pull and install this release in the runtime?" data-confirm-accept="Apply" data-confirm-type="warning" data-orchestrator-busy="true" data-busy-title="Applying release" data-busy-message="Runtime is pulling the artifact, installing it, and projecting ingress configuration.">
    <input type="hidden" name="sourceKey" />
    <input type="hidden" name="releaseTargetId" />
</form>
