@model Krackend.Sagas.Orchestrations.Runtime.WebUI.Areas.OrchestratorRuntime.Pages.DesignNodes.IndexModel
<p class="od-item-meta mb-2">Paste the JSON generated by Design.</p>
<form method="post" asp-page-handler="WizardImportCredentials" id="designNodeCredentialForm" data-wizard-form="true">
    <input asp-for="CredentialPackage.DesignNodeId" type="hidden" id="credentialDesignNodeIdInput" />
    <label asp-for="CredentialPackage.CredentialsJson" for="credentialsJsonInput" class="z-form-label">Design credentials JSON</label>
    <textarea asp-for="CredentialPackage.CredentialsJson" class="z-form-input od-credentials-textarea" id="credentialsJsonInput" rows="12" data-val-required="Design credentials JSON is required." data-orchestrator-json="true"></textarea>
    <span asp-validation-for="CredentialPackage.CredentialsJson" class="text-danger"></span>
</form>
