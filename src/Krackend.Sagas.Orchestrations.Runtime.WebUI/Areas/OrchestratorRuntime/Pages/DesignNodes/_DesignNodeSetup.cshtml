@model Krackend.Sagas.Orchestrations.Runtime.WebUI.Areas.OrchestratorRuntime.Pages.DesignNodes.IndexModel
<p class="od-item-meta mb-2" id="designNodeSetupSubtitle"></p>
<div class="od-runtime-wizard-body">
                <div class="od-runtime-wizard-layout">
                    <aside class="od-runtime-wizard-nav">
                        <button type="button" class="od-runtime-wizard-step" data-setup-step-target="basic"><span>1</span><strong>Basic data</strong></button>
                        <button type="button" class="od-runtime-wizard-step" data-setup-step-target="policy"><span>2</span><strong>Policy</strong></button>
                        <button type="button" class="od-runtime-wizard-step" data-setup-step-target="runtimeCredentials"><span>3</span><strong>Runtime credentials</strong></button>
                        <button type="button" class="od-runtime-wizard-step" data-setup-step-target="designCredentials"><span>4</span><strong>Design credentials</strong></button>
                        <button type="button" class="od-runtime-wizard-step" data-setup-step-target="verify"><span>5</span><strong>Verify</strong></button>
                    </aside>
                    <div class="od-runtime-wizard-content">
                        <section class="od-setup-step" data-setup-step="basic">
                            <div class="od-section-head">
                                <div>
                                    <h2 class="od-section-title">Basic data</h2>
                                    <p class="od-item-meta">Runtime-local identity for the Design node.</p>
                                </div>
                            </div>
                            <form method="post" asp-page-handler="WizardUpsert" id="setupBasicForm" class="od-setup-inner-form" data-wizard-form="true">
                                <input asp-for="Input.DesignNodeId" type="hidden" id="setupDesignNodeId" />
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="Input.Key" for="setupDesignNodeKey" class="z-form-label"></label>
                                        <input asp-for="Input.Key" class="z-form-input" id="setupDesignNodeKey" data-orchestrator-key="true" autocomplete="off" />
                                        <span asp-validation-for="Input.Key" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Input.Name" for="setupDesignNodeName" class="z-form-label"></label>
                                        <input asp-for="Input.Name" class="z-form-input" id="setupDesignNodeName" autocomplete="off" />
                                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="Input.Description" for="setupDesignNodeDescription" class="z-form-label"></label>
                                        <textarea asp-for="Input.Description" class="z-form-input" id="setupDesignNodeDescription" rows="3"></textarea>
                                        <span asp-validation-for="Input.Description" class="text-danger"></span>
                                    </div>
                                </div>
                            </form>
                        </section>

                        <section class="od-setup-step" data-setup-step="policy">
                            <div class="od-section-head">
                                <div>
                                    <h2 class="od-section-title">Distribution policy</h2>
                                    <p class="od-item-meta">Choose how this Runtime and Design node exchange releases.</p>
                                </div>
                            </div>
                            <form method="post" asp-page-handler="WizardPolicy" id="setupPolicyForm" class="od-setup-inner-form" data-wizard-form="true">
                                <input asp-for="Policy.DesignNodeId" type="hidden" id="setupPolicyDesignNodeId" />
                                <div class="od-mode-options">
                                    @foreach (var mode in Model.DistributionModeOptions)
                                    {
                                        <label class="od-mode-option">
                                            <input type="radio" asp-for="Policy.DistributionMode" value="@mode.Value" />
                                            <span>
                                                <strong>@mode.Label</strong>
                                                <small>@mode.Description</small>
                                            </span>
                                        </label>
                                    }
                                </div>
                            </form>
                        </section>

                        <section class="od-setup-step" data-setup-step="runtimeCredentials">
                            <div class="od-section-head">
                                <div>
                                    <h2 class="od-section-title">Runtime credentials</h2>
                                    <p class="od-item-meta">Generate these first when Design will push into Runtime.</p>
                                </div>
                                <form method="post" asp-page-handler="WizardGenerateCredentials" id="setupGenerateCredentialsForm" class="od-inline-form d-none" data-wizard-form="true">
                                    <input type="hidden" name="designNodeId" id="setupGenerateDesignNodeId" />
                                </form>
                                <button type="button" class="z-button z-button-ghost js-setup-generate-credentials">Generate credentials</button>
                            </div>
                            <div class="od-info-grid od-info-grid-compact">
                                <div class="od-info-tile"><span>Status</span><strong id="setupInboundCredentialStatus">-</strong></div>
                                <div class="od-info-tile"><span>Client ID</span><strong id="setupInboundClientId">-</strong></div>
                                <div class="od-info-tile"><span>Key ID</span><strong id="setupInboundKeyId">-</strong></div>
                                <div class="od-info-tile"><span>Scopes</span><strong id="setupInboundAllowedScopes">-</strong></div>
                                <div class="od-info-tile"><span>Created</span><strong id="setupInboundCredentialCreatedAt">-</strong></div>
                                <div class="od-info-tile"><span>Last token</span><strong id="setupInboundLastTokenIssuedAt">-</strong></div>
                            </div>
                        </section>

                        <section class="od-setup-step" data-setup-step="designCredentials">
                            <div class="od-section-head">
                                <div>
                                    <h2 class="od-section-title">Design credentials</h2>
                                    <p class="od-item-meta">Import the JSON generated by Design when Runtime will pull releases.</p>
                                </div>
                                <button type="button" class="z-button z-button-ghost js-setup-import-credentials">Import credentials</button>
                            </div>
                            <div class="od-info-grid od-info-grid-compact">
                                <div class="od-info-tile"><span>Status</span><strong id="setupOutboundCredentialStatus">-</strong></div>
                                <div class="od-info-tile"><span>Design endpoint</span><strong id="setupEndpointBaseUri">-</strong></div>
                                <div class="od-info-tile"><span>Remote runtime id</span><strong id="setupRemoteRuntimeNodeId">-</strong></div>
                                <div class="od-info-tile"><span>Client ID</span><strong id="setupOutboundClientId">-</strong></div>
                                <div class="od-info-tile"><span>Key ID</span><strong id="setupOutboundKeyId">-</strong></div>
                                <div class="od-info-tile"><span>Imported</span><strong id="setupOutboundCredentialImportedAt">-</strong></div>
                            </div>
                        </section>

                        <section class="od-setup-step" data-setup-step="verify">
                            <div class="od-section-head">
                                <div>
                                    <h2 class="od-section-title">Verify</h2>
                                    <p class="od-item-meta">Available only when Runtime can call Design and the node is enabled.</p>
                                </div>
                                <form method="post" asp-page-handler="WizardValidateConnection" id="setupValidateConnectionForm" class="od-inline-form d-none" data-wizard-form="true">
                                    <input type="hidden" name="designNodeId" id="setupValidateDesignNodeId" />
                                </form>
                                <button type="button" class="z-button z-button-ghost js-setup-validate-connection">Check connection</button>
                            </div>
                        </section>
                    </div>
                </div>
            <form method="post" asp-page-handler="WizardSetStatus" id="setupStatusForm" class="d-none" data-wizard-form="true">
                <input type="hidden" name="designNodeId" id="setupStatusDesignNodeId" />
                <input type="hidden" name="status" id="setupStatusValue" value="Enabled" />
            </form>
</div>
