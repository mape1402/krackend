@using Microsoft.Extensions.Options
@using Krackend.Sagas.Orchestrations.WebUI.Shell
@inject IOptions<OrchestratorWebUIThemeOptions> ThemeOptions
@inject IOrchestratorThemeCssRenderer ThemeCssRenderer
@inject IOrchestratorThemeModeAccessor ThemeModeAccessor
@{
    Layout = "_ZoorceLayout";
    var mode = ThemeModeAccessor.GetCssMode(ThemeOptions.Value);
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var themeUrl = Url.Page("/Theme", new { area = "OrchestratorShell" });
    var isRuntime = string.Equals(ViewContext.RouteData.Values["area"]?.ToString(), "OrchestratorRuntime", StringComparison.OrdinalIgnoreCase);
    var pageError = ViewContext.ViewData.Model?.GetType().GetProperty("ErrorMessage")?.GetValue(ViewContext.ViewData.Model)?.ToString() ?? string.Empty;
    var validationErrors = ViewContext.ModelState.Values.SelectMany(x => x.Errors)
        .Select(x => x.ErrorMessage).Where(x => !string.IsNullOrWhiteSpace(x)).ToArray();
}
<script>
    document.documentElement.dataset.zoorceTheme = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mode));
    document.documentElement.dataset.krackendTheme = document.documentElement.dataset.zoorceTheme;
    document.documentElement.dataset.bsTheme = document.documentElement.dataset.zoorceTheme;
</script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      asp-fallback-href="~/_content/Krackend.Sagas.Orchestrations.WebUI.Shell/vendor/bootstrap/bootstrap.min.css"
      asp-fallback-test-class="modal" asp-fallback-test-property="position" asp-fallback-test-value="fixed" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<style>@Html.Raw(ThemeCssRenderer.RenderThemeRules(ThemeOptions.Value))</style>
<link rel="stylesheet" href="~/_content/Krackend.Sagas.Orchestrations.WebUI.Shell/css/orchestrator-shell.css" asp-append-version="true" />
<style>.z-sidebar a { text-decoration: none; }</style>
@if (!isRuntime)
{
    <link rel="stylesheet" href="~/_content/Krackend.Sagas.Orchestrations.ControlPlane.WebUI/css/orchestrator-design.css" asp-append-version="true" />
}
@RenderSection("Head", required: false)
<form id="orchestrator-theme-sync" method="post" action="@themeUrl" hidden>
    @Html.AntiForgeryToken()
    <input name="mode" value="@mode" />
    <input name="returnUrl" value="@returnUrl" />
</form>
@RenderBody()

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            asp-fallback-src="~/_content/Krackend.Sagas.Orchestrations.WebUI.Shell/vendor/bootstrap/bootstrap.bundle.min.js"
            asp-fallback-test="window.bootstrap && window.bootstrap.Modal"></script>
    <script src="~/_content/Krackend.Sagas.Orchestrations.WebUI.Shell/js/orchestrator-messages.js" asp-append-version="true"></script>
    @if (!isRuntime)
    {
        <script src="~/_content/Krackend.Sagas.Orchestrations.ControlPlane.WebUI/js/schema-contract-autocomplete.js" asp-append-version="true"></script>
    }
    <script>
        (() => {
            const form = document.getElementById('orchestrator-theme-sync');
            try { localStorage.setItem('zoorce-theme', document.documentElement.dataset.zoorceTheme); } catch { /* Browser storage is optional. */ }
            document.addEventListener('zoorce:theme-change', async event => {
                const next = event.detail?.mode;
                if (!form || (next !== 'light' && next !== 'dark')) return;
                document.documentElement.dataset.krackendTheme = next;
                document.documentElement.dataset.bsTheme = next;
                form.elements.mode.value = next;
                try {
                    const response = await fetch(form.action, { method: 'POST', body: new FormData(form), credentials: 'same-origin' });
                    if (!response.ok) throw new Error('Theme preference could not be saved.');
                } catch {
                    window.OrchestratorMessages?.notify({ title: 'Theme', message: 'The theme preference could not be saved.', type: 'error' });
                }
            });
        })();
    </script>
    @if (validationErrors.Length > 0 || !string.IsNullOrWhiteSpace(pageError))
    {
        <script>
            window.OrchestratorMessages?.showValidation({
                title: 'Review the capture',
                errors: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(validationErrors.Length > 0 ? validationErrors : new[] { pageError }))
            });
        </script>
    }
    @if (TempData["OrchestratorMessage.Title"] is string messageTitle)
    {
        <script>
            window.OrchestratorMessages?.notify({
                title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(messageTitle)),
                message: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["OrchestratorMessage.Body"]?.ToString() ?? string.Empty)),
                type: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["OrchestratorMessage.Type"]?.ToString() ?? "info"))
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
}
