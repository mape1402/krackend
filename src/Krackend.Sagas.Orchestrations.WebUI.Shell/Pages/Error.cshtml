@page
@using Microsoft.Extensions.Options
@using Krackend.Sagas.Orchestrations.WebUI.Shell
@using Krackend.Sagas.Orchestrations.WebUI.Shell.Authentication
@using Zoorce.Web.UI.Layout.Components
@model Krackend.Sagas.Orchestrations.WebUI.Shell.Pages.ErrorModel
@inject IOptions<OrchestratorWebUIThemeOptions> Theme
@inject IOptions<OrchestratorSignInOptions> SignInOptions
@{
    Layout = "_ZoorceStandaloneLayout";
    Response.StatusCode = 500;
    ViewData["Title"] = "Unexpected Error";
    var status = ZoorceStatusPageOptions.ForStatus(500, Url.Content("~/"), SignInOptions.Value.Enabled ? SignInOptions.Value.SignInPath : null, Url.Content("~/"));
    status.ApplicationName = Theme.Value.Title;
    status.BrandSubtitle = Theme.Value.Subtitle;
}
@await Component.InvokeAsync("ZoorceStatusPage", status)
