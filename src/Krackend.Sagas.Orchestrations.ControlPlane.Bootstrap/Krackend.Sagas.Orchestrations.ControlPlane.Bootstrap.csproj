<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>Control-plane bootstrap composition for Krackend Sagas Orchestrations design, distribution, security, and UI modules.</Description>
    <PackageTags>krackend;sagas;orchestrations;control-plane;bootstrap</PackageTags>
    <NoWarn>$(NoWarn);CS1573;CS1574;CS1587;CS1591;NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Krackend.Sagas.Orchestrations.Contracts\Krackend.Sagas.Orchestrations.Contracts.csproj" />
    <ProjectReference Include="..\Krackend.Sagas.Orchestrations.Design.Interaction\Krackend.Sagas.Orchestrations.Design.Interaction.csproj" />
    <ProjectReference Include="..\Krackend.Sagas.Orchestrations.Design.Storage.SqlServer\Krackend.Sagas.Orchestrations.Design.Storage.SqlServer.csproj" />
    <ProjectReference Include="..\Krackend.Sagas.Orchestrations.Design.WebUI\Krackend.Sagas.Orchestrations.Design.WebUI.csproj" />
    <ProjectReference Include="..\Krackend.Sagas.Orchestrations.Distribution.Interaction\Krackend.Sagas.Orchestrations.Distribution.Interaction.csproj" />
    <ProjectReference Include="..\Krackend.Sagas.Orchestrations.Distribution.Storage.SqlServer\Krackend.Sagas.Orchestrations.Distribution.Storage.SqlServer.csproj" />
    <ProjectReference Include="..\Krackend.Sagas.Orchestrations.Distribution.WebUI\Krackend.Sagas.Orchestrations.Distribution.WebUI.csproj" />
    <ProjectReference Include="..\Krackend.Sagas.Orchestrations.Security.Interaction\Krackend.Sagas.Orchestrations.Security.Interaction.csproj" />
    <ProjectReference Include="..\Krackend.Sagas.Orchestrations.Security.Storage.SqlServer\Krackend.Sagas.Orchestrations.Security.Storage.SqlServer.csproj" />
    <ProjectReference Include="..\Krackend.Sagas.Orchestrations.Security.WebUI\Krackend.Sagas.Orchestrations.Security.WebUI.csproj" />
    <ProjectReference Include="..\Krackend.Sagas.Orchestrations.WebUI.Shell\Krackend.Sagas.Orchestrations.WebUI.Shell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[9.0.7,10.0.0)" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[10.0.0,11.0.0)" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
