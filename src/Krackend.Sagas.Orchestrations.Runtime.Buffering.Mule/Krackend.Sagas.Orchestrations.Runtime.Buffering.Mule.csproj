<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Krackend.Sagas.Orchestrations.Runtime.Buffering.Mule</PackageId>
    <Description>Mule durable action adapter for Krackend saga orchestration runtime intake, dispatch, and artifact projection work.</Description>
    <PackageTags>saga;orchestration;runtime;mule;durable-actions;dotnet</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mule.DurableActions" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Krackend.Sagas.Orchestrations.Runtime\Krackend.Sagas.Orchestrations.Runtime.csproj" />
  </ItemGroup>

</Project>
