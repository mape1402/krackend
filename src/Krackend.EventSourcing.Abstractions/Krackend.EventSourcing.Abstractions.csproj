<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Krackend.EventSourcing.Abstractions</PackageId>
    <Description>Krackend.EventSourcing.Abstractions provides event sourcing contracts, schema attributes, envelopes, stream references, and snapshot abstractions.</Description>
    <PackageTags>event-sourcing;event-store;abstractions;dotnet</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

</Project>
