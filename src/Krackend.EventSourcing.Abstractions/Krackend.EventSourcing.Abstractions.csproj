<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Krackend.EventSourcing.Abstractions</PackageId>
    <Description>Krackend.EventSourcing.Abstractions provides event sourcing contracts, schema attributes, envelopes, stream references, and snapshot abstractions.</Description>
    <PackageTags>event-sourcing;event-store;abstractions;dotnet</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <UseRootPackageReadme>false</UseRootPackageReadme>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\event-sourcing.md" Pack="true" PackagePath="README.md" Link="README.md" />
    <None Include="..\..\assets\image.png" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>

</Project>
