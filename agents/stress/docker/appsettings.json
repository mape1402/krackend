{
  "Logging": { "LogLevel": {
    "Default": "Information",
    "Microsoft.AspNetCore": "Warning",
    "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
    "Microsoft.EntityFrameworkCore.Infrastructure": "Warning"
  } },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Pigeon": "Warning",
        "Mule": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  }
}

