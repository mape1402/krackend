{
  "ConnectionStrings": {
    "RabbitMq": "amqp://guest:guest@localhost:5672",
    "Redis": "localhost:6379",
    "Mongo": "mongodb://localhost:27019/?replicaSet=rs0&directConnection=true"
  },
  "Mongo": {
    "DatabaseName": "krackend-runtime"
  },
  "Pigeon": {
    "Domain": "Krackend.Sagas.Orchestrations.RuntimeHost.Mongo.Sample",
    "MessageBrokers": {
      "RabbitMq": {
        "Url": "amqp://guest:guest@localhost:5672"
      }
    },
    "ConsumerExecution": {
      "MaxConcurrency": null,
      "QueueCapacity": null,
      "PrefetchCount": null
    }
  },
  "Mule": {
    "Runtime": {
      "WorkerCount": 1,
      "MaxDegreeOfParallelism": 1
    },
    "FastLane": {
      "Redis": {
        "ConnectionString": "localhost:6379",
        "KeyPrefix": "krackend:runtime:mongo"
      }
    }
  },
  "Runtime": {
    "Replica": {
      "ReplicaId": "",
      "StandupLanePrefix": "runtime-standup"
    },
    "Gossip": {
      "Enabled": true,
      "ChannelName": "krackend.runtime.artifacts.ready",
      "RedisConnectionString": ""
    }
  },
  "SeedData": {
    "DesignNode": {
      "EndpointBaseUri": "http://localhost:5085"
    },
    "HappyPath": {
      "Enabled": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
